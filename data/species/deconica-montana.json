  "nameStory": "",
  "description": "Deconica montana, commonly known as mountain moss deconica, is a small brown mushroom belonging to the Hymenogastraceae family, characterized by its modest size and preference for mossy environments. This species is found in the forested regions of New England where moisture and organic matter are abundant.",
  "idTips": [
    {
      "label": "Spore Print Color",
      "description": "Produces a dark brown to blackish spore print, a key diagnostic feature of the genus Deconica",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Gills are adnate to slightly decurrent, running close to or slightly down the stem",
      "isPrimary": false
    },
    {
      "label": "Cap Texture",
      "description": "Small brown cap (typically 1-3 cm) with a slightly hygrophanous surface that darkens when wet",
      "isPrimary": false
    }
  ],
  "habitat": "Mountain moss deconica thrives in moist, mossy substrates on forest floors, particularly in coniferous and mixed deciduous forests at higher elevations throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small, inconspicuous appearance, Deconica montana plays an important ecological role in nutrient cycling by decomposing organic matter in moss-rich forest microhabitats.",
