  "nameStory": "",
  "description": "Clavariadelphus truncatus, commonly known as the truncated club fungus, is a distinctive wood-decay fungus belonging to the Clavariadelphaceae family. It features a characteristic club-shaped fruiting body with a flattened or truncated (cut-off) apex, distinguishing it from related species.",
  "idTips": [
    {
      "label": "Truncated Apex",
      "description": "The top of the fruiting body is distinctly flattened or squared-off rather than pointed, giving the fungus its common name",
      "isPrimary": true
    },
    {
      "label": "Club Shape",
      "description": "The overall fruiting body is cylindrical to club-shaped, typically tan to pale brown in color",
      "isPrimary": false
    },
    {
      "label": "Texture and Size",
      "description": "The surface is smooth to slightly wrinkled, and fruiting bodies typically reach 2-5 cm in height",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus is found on decaying hardwood logs and woody debris in moist, shaded forest environments throughout New England, particularly in late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many club fungi that fruit from the forest floor, Clavariadelphus truncatus is a wood specialist, playing an important ecological role in decomposing dead trees and returning nutrients to forest ecosystems.",
