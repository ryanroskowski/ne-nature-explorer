  "nameStory": "",
  "description": "Marchandiomyces corallinus is a small, coral-like fungus belonging to the Corticiaceae family, characterized by its delicate branching fruiting bodies. This species is primarily found on decaying wood and plant material in the moist forests of New England.",
  "idTips": [
    {
      "label": "Coral-like branching structure",
      "description": "Fruiting bodies appear as fine, branched, coral-like projections, typically orange to reddish in color",
      "isPrimary": true
    },
    {
      "label": "Microscopic spore characteristics",
      "description": "Produces distinctive small spores visible under magnification, typical of corticioid fungi",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Found on decaying hardwood and woody debris rather than soil, distinguishing it from similar species",
      "isPrimary": false
    }
  ],
  "habitat": "Marchandiomyces corallinus thrives in moist, shaded forest environments on decaying logs and woody substrates in New England's deciduous and mixed forests.",
