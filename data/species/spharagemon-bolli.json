  "nameStory": "",
  "description": "Boll's Grasshopper (Spharagemon bolli) is a medium-sized member of the Short-horned Grasshopper family found throughout New England and northeastern North America. This species is characterized by its cryptic coloration that helps it blend seamlessly into its natural environment.",
  "idTips": [
    {
      "label": "Tegmen Pattern",
      "description": "Distinctive mottled brown and tan pattern on the wings with irregular dark markings",
      "isPrimary": true
    },
    {
      "label": "Body Size",
      "description": "Medium-sized grasshopper, typically 18-25mm in length",
      "isPrimary": false
    },
    {
      "label": "Hind Wings",
      "description": "Clear or slightly smoky hind wings that contrast with the patterned front wings",
      "isPrimary": false
    }
  ],
  "habitat": "Boll's Grasshopper inhabits dry, sandy, and rocky areas including fields, roadsides, and open woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other grasshoppers in the Spharagemon genus, Boll's Grasshopper produces loud stridulation sounds by rubbing its hind legs against its wings, with males typically calling more frequently during warm afternoons.",
