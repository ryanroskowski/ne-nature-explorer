  "nameStory": "",
  "description": "The Green-spored Parasol is a large, distinctive mushroom with a white cap covered in brown scales and a movable ring on its stem. Despite its attractive appearance, it is highly toxic and causes severe gastrointestinal distress if consumed.",
  "idTips": [
    {
      "label": "Green Spore Print",
      "description": "Produces a distinctive greenish spore print, which is unusual among mushrooms and the most reliable identification feature.",
      "isPrimary": true
    },
    {
      "label": "Scaly White Cap",
      "description": "Features a large, whitish umbrella-shaped cap with prominent brown or grayish scales radiating from the center.",
      "isPrimary": false
    },
    {
      "label": "Movable Ring",
      "description": "Has a distinctive skirt-like ring (annulus) on the stem that slides freely up and down.",
      "isPrimary": false
    }
  ],
  "habitat": "Found in lawns, gardens, fields, and disturbed areas throughout New England, especially in warm summer and fall months.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Green-spored Parasol is sometimes mistaken for edible parasol mushrooms, but its green spore print immediately distinguishes it—making a spore print an essential safety step before consuming any parasol-type mushroom.",
