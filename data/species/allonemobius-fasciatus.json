  "nameStory": "",
  "description": "The Striped Ground Cricket is a small, dark-colored cricket belonging to the family Gryllidae, commonly found throughout New England. This species is known for its distinctive striped pattern and is a frequent inhabitant of grasslands and ground-level vegetation.",
  "idTips": [
    {
      "label": "Longitudinal stripes",
      "description": "Dark brown or black body with characteristic pale longitudinal stripes running the length of the body",
      "isPrimary": true
    },
    {
      "label": "Size",
      "description": "Very small cricket, typically 6-8 mm in length, making it one of the smallest ground cricket species",
      "isPrimary": false
    },
    {
      "label": "Habitat preference",
      "description": "Found at or very close to ground level, often in leaf litter and low vegetation rather than in trees",
      "isPrimary": false
    }
  ],
  "habitat": "Striped Ground Crickets prefer moist grasslands, meadows, and areas with dense ground-level vegetation and leaf litter throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their small size, male Striped Ground Crickets produce a distinctive chirping sound by rubbing their wings together, and they are most vocal during late summer and fall evenings.",
