  "nameStory": "",
  "description": "Gymnopilus luteofolius, commonly known as the Yellow-gilled Gymnopilus, is a small woodland mushroom characterized by its distinctive yellow to golden gill coloration. This fungus belongs to the Hymenogastraceae family and is found in New England forests during late summer and fall.",
  "idTips": [
    {
      "label": "Yellow Gills",
      "description": "The most distinctive feature is the bright yellow to golden-yellow gills that do not darken significantly with age, setting it apart from many similar species.",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "The cap is typically tan to pale brown or ochre, with a diameter of 1-3 cm, and may have a slightly sticky appearance when moist.",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Found fruiting on or near wood debris, logs, and mossy areas, often in clusters or troops rather than solitary specimens.",
      "isPrimary": false
    }
  ],
  "habitat": "Gymnopilus luteofolius grows in moist, shaded New England forests with abundant woody debris, particularly in mossy areas near fallen logs and leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The yellow gills of this species are a reliable field characteristic that persists even as the mushroom ages, making it relatively straightforward to identify compared to other small woodland fungi.",
