  "nameStory": "",
  "description": "The Purple-veiled Slippery Jack (Suillus luteus) is a bolete fungus characterized by its slimy, yellow cap and distinctive purple veil that covers young specimens. This mycorrhizal species forms beneficial relationships with pine trees and is edible when properly prepared.",
  "idTips": [
    {
      "label": "Purple veil",
      "description": "Young fruiting bodies are covered with a distinctive purple or reddish membranous veil that breaks as the mushroom matures",
      "isPrimary": true
    },
    {
      "label": "Slippery yellow cap",
      "description": "The cap is bright yellow to golden and has a viscid (slimy) surface when moist, becoming sticky when touched",
      "isPrimary": false
    },
    {
      "label": "Yellow pores",
      "description": "The underside features small, rounded yellow pores that may stain brownish when bruised",
      "isPrimary": false
    }
  ],
  "habitat": "This species thrives in pine forests and mixed woodlands throughout New England, preferring sandy or acidic soils where it forms symbiotic relationships with various pine species.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The slimy coating on the cap actually helps protect the mushroom from insects and drying out, and can be peeled away before cooking to improve the texture of this edible species.",
  "confusionNotes": null,
  "contextualKnowledge": null,
