  "nameStory": "",
  "description": "Protohydnum album, commonly known as white jelly fungus, is a gelatinous fungus characterized by its translucent to white appearance and soft, rubbery texture. This delicate fungus typically grows in moist conditions and is part of the diverse fungal communities found throughout New England's forests.",
  "idTips": [
    {
      "label": "Color and Texture",
      "description": "Pure white to translucent gelatinous body with a soft, jelly-like consistency that becomes more transparent when wet",
      "isPrimary": true
    },
    {
      "label": "Morphology",
      "description": "Consists of small, rounded or irregular gelatinous structures, often forming in clusters or as individual specimens",
      "isPrimary": false
    },
    {
      "label": "Growth Pattern",
      "description": "Fruits on decaying wood, logs, and moist substrates, often appearing after heavy rains",
      "isPrimary": false
    }
  ],
  "habitat": "Protohydnum album prefers moist, shaded environments in deciduous and mixed forests, typically fruiting on decomposing hardwood logs and branches throughout New England.",
