  "nameStory": "",
  "description": "Davis's Cuckoo Sweat Bee (Sphecodes davisii) is a small, dark bee belonging to the cuckoo bee group, which are nest parasites of other sweat bee species. Found throughout New England, these bees are important indicators of healthy native bee communities.",
  "idTips": [
    {
      "label": "Dark coloration",
      "description": "Shiny black to dark brown body with minimal hair, distinguishing it from fuzzy sweat bees",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Typically 4-6mm in length, among the smallest bees in the sweat bee family",
      "isPrimary": false
    },
    {
      "label": "Sparse body hair",
      "description": "Notably less hairy than host species, an adaptation for cuckoo bee parasitism",
      "isPrimary": false
    }
  ],
  "habitat": "Davis's Cuckoo Sweat Bee inhabits open woodlands, meadows, and gardens throughout New England where host sweat bee populations are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike most bees that collect pollen and nectar, cuckoo sweat bees are brood parasites that lay their eggs in the nests of other sweat bee species, relying on the host bee to provision their offspring.",
