  "nameStory": "",
  "description": "Say's Cuckoo Leafcutter Bee (Coelioxys sayi) is a small parasitic bee that lays its eggs in the nests of leafcutter bees, allowing the host to raise its young. Despite its cuckoo behavior, it plays an important role in native pollination systems throughout New England.",
  "idTips": [
    {
      "label": "Body Color and Size",
      "description": "Small bee (6-8mm) with a predominantly black body and distinctive white or pale abdominal markings",
      "isPrimary": false
    },
    {
      "label": "Pointed Abdomen",
      "description": "Characteristic pointed or tapered abdomen tip, which is used to pierce leafcutter bee cells and lay eggs",
      "isPrimary": true
    },
    {
      "label": "Dense Body Hair",
      "description": "Covered in fine, dark body hair with sparse pale setae, giving it a duller appearance than solitary leafcutter bees",
      "isPrimary": false
    }
  ],
  "habitat": "Say's Cuckoo Leafcutter Bee inhabits open woodlands, gardens, and meadows throughout New England where host leafcutter bees are present in cavities or wood boring bee tunnels.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This bee is a 'cuckoo' or brood parasite that sneaks into the nests of leafcutter bees and lays its egg in their brood cells, allowing the host bee to unknowingly provision food for the cuckoo bee's larva instead of its own offspring.",
