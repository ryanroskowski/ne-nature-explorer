  "nameStory": "",
  "description": "Erysiphe nemopanthi is a powdery mildew fungus that specifically infects plants in the Nemopanthus genus, particularly winterberry holly, causing a characteristic white powdery coating on leaves. This obligate parasite is commonly found throughout New England where its host plants are native or cultivated.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Affected leaves develop a distinctive white to grayish powdery appearance on both upper and lower leaf surfaces",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Primarily found on Nemopanthus mucronatus (winterberry holly) and related species in the Ilex family",
      "isPrimary": false
    },
    {
      "label": "Microscopic Features",
      "description": "Examination reveals chains of colorless conidia (spores) and characteristic appendages on cleistothecia under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe nemopanthi thrives in cool, moist conditions typical of New England woodlands, wetlands, and cultivated gardens where its winterberry holly hosts grow.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews, Erysiphe nemopanthi produces overwintering structures called cleistothecia that allow it to survive harsh New England winters on infected plant debris.",
