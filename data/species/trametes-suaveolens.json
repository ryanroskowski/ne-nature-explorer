  "nameStory": "",
  "description": "Trametes suaveolens, commonly known as fragrant bracket, is a woody shelf fungus in the Polyporaceae family characterized by its distinctive sweet, anise-like aroma. This polypore grows on hardwood logs and dead trees throughout New England, breaking down cellulose and contributing to forest nutrient cycling.",
  "idTips": [
    {
      "label": "Sweet Anise Aroma",
      "description": "Releases a strong, pleasant smell reminiscent of anise or licorice when fresh or when crushed",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "Has small, angular pores on the underside rather than gills, typically white to pale cream colored",
      "isPrimary": false
    },
    {
      "label": "Cap Appearance",
      "description": "Displays zones of color with bands of white, gray, and brown, forming thin, shelf-like brackets",
      "isPrimary": false
    }
  ],
  "habitat": "Fragrant bracket grows on dead or dying hardwoods, particularly oak and other deciduous trees, in moist woodlands and forest edges throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The distinctive anise-like fragrance gives this fungus its common name and serves as a reliable field identification feature, making it one of the few polypores easily identifiable by smell alone.",
