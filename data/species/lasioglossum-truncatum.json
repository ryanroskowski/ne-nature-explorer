  "nameStory": "",
  "description": "The Truncate Sweat Bee (Lasioglossum truncatum) is a small, metallic green native bee species commonly found throughout New England. These solitary bees are important pollinators that play a vital role in maintaining healthy plant populations and ecosystems.",
  "idTips": [
    {
      "label": "Metallic Coloration",
      "description": "Distinctive shiny, metallic green body with a characteristic iridescent sheen",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Tiny bee measuring approximately 4-5mm in length, among the smallest sweat bee species",
      "isPrimary": false
    },
    {
      "label": "Abdominal Pattern",
      "description": "Truncated (cut-off) appearance to the abdomen with visible segmentation and fine punctuation",
      "isPrimary": false
    }
  ],
  "habitat": "Truncate Sweat Bees thrive in open meadows, grasslands, gardens, and flowering areas throughout New England where native wildflowers and cultivated plants bloom.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their small size, these bees are named 'sweat bees' because they are attracted to human perspiration and may land on skin to collect salt and moisture, though they are rarely aggressive.",
  "confusionNotes": null,
  "contextualKnowledge": null,
