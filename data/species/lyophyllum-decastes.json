  "nameStory": "",
  "description": "Fried Chicken Mushroom (Lyophyllum decastes) is a choice edible fungus characterized by its clustered growth pattern and mild, pleasant flavor reminiscent of fried chicken when cooked. This species belongs to the Lyophyllaceae family and is commonly found throughout New England during fall months.",
  "idTips": [
    {
      "label": "Clustered Growth",
      "description": "Fruiting bodies grow in dense clusters or fairy rings, with multiple caps emerging from a common base or close together",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Gray to brownish-gray caps, typically 1-3 inches wide, with a smooth or slightly wrinkled surface and inrolled edges when young",
      "isPrimary": false
    },
    {
      "label": "Gills and Stem",
      "description": "White to cream-colored gills that are tightly packed and run down the stem; stems are whitish, fibrous, and equal throughout",
      "isPrimary": false
    }
  ],
  "habitat": "This species thrives in hardwood and mixed forests, particularly around decaying wood, leaf litter, and disturbed soil areas throughout New England in autumn.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The common name 'Fried Chicken Mushroom' derives from its distinctive savory, chicken-like aroma and flavor when cooked, making it highly prized by foragers in the northeastern United States.",
