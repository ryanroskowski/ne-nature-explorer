  "nameStory": "",
  "description": "Big Bluet is a medium-sized damselfly in the Coenagrionidae family, characterized by its predominantly blue coloration in males and more variable coloring in females. It is one of the larger bluet species found throughout New England and eastern North America.",
  "idTips": [
    {
      "label": "Size",
      "description": "Noticeably larger than most other bluet species, with a body length of 28-32mm, making it one of the biggest in its genus",
      "isPrimary": true
    },
    {
      "label": "Male Coloration",
      "description": "Males display bright blue abdomens with black markings, particularly on the terminal segments, and blue thorax with dark stripes",
      "isPrimary": false
    },
    {
      "label": "Female Variation",
      "description": "Females may be blue like males or show greenish or brownish coloration, with less contrasting markings",
      "isPrimary": false
    }
  ],
  "habitat": "Big Bluet inhabits clear, flowing streams and rivers with sandy or rocky substrates, as well as spring-fed ponds and seepage areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many damselfly species, Big Bluet males are known for their territorial behavior along streams, where they perch on vegetation and chase away rival males to defend prime hunting and mating areas.",
  "confusionNotes": null,
  "contextualKnowledge": null,
