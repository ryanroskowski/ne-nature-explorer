  "nameStory": "",
  "description": "Trumpet Jelly Cup (Guepiniopsis buccina) is a small gelatinous fungus belonging to the Dacrymycetaceae family, characterized by its delicate, translucent fruiting bodies. This species is commonly found throughout New England, particularly in moist woodland environments where it plays an important ecological role in decomposition.",
  "idTips": [
    {
      "label": "Trumpet-shaped fruiting body",
      "description": "The distinctive funnel or trumpet-like shape with a rolled margin is the most recognizable feature of this jelly fungus.",
      "isPrimary": true
    },
    {
      "label": "Gelatinous texture",
      "description": "The fruiting body has a translucent, jelly-like consistency that is soft and easily deformable when touched.",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "Fruiting bodies typically measure 5-15mm in height, making them easy to overlook in leaf litter.",
      "isPrimary": false
    }
  ],
  "habitat": "Trumpet Jelly Cup thrives in moist, shaded woodlands and disturbed areas with rich organic matter, often appearing on rotting wood, leaf litter, and mossy substrates throughout New England.",
