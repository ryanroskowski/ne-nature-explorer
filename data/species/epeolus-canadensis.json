  "nameStory": "",
  "description": "Epeolus canadensis, commonly known as the Canadian Cellophane-cuckoo Bee, is a parasitic bee species in the Apidae family found throughout New England. Unlike most bees, this species does not collect pollen or nectar; instead, females lay their eggs in the nests of other bee species, particularly mining bees.",
  "idTips": [
    {
      "label": "Cellophane-like Bands",
      "description": "Distinctive shiny, translucent white or cream-colored bands across the abdomen that resemble cellophane, giving the species its common name",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Noticeably smaller than honey bees and most bumble bees, typically 8-10 mm in length",
      "isPrimary": false
    },
    {
      "label": "Reduced Body Hair",
      "description": "Relatively sparse body hair compared to pollen-collecting bees, adapted for a parasitic lifestyle",
      "isPrimary": false
    }
  ],
  "habitat": "Found in open woodlands, meadows, and gardens throughout New England where host bee species nest in sandy or bare ground.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, E. canadensis is a brood parasite that sneaks into the nests of other bees, most commonly Andrena mining bees, to deposit its eggs where the developing larvae will consume the host's pollen provisions.",
