  "nameStory": "",
  "description": "Gloiodon strigosus is a jelly fungus in the Auriscalpiaceae family, characterized by its gelatinous texture and delicate structure. This wood-decay fungus is commonly found throughout New England, particularly on dead hardwood substrates.",
  "idTips": [
    {
      "label": "Gelatinous texture",
      "description": "The fruiting body has a distinctly jelly-like, translucent to whitish consistency that becomes firm when dry",
      "isPrimary": true
    },
    {
      "label": "Spine arrangement",
      "description": "Features small, crowded spines or tooth-like structures on the underside rather than gills or pores",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Fruiting bodies grow on decaying hardwood logs and fallen branches, often in shaded, moist environments",
      "isPrimary": false
    }
  ],
  "habitat": "Gloiodon strigosus thrives on dead hardwood logs and branches in moist, shaded forests throughout New England, playing an important role in wood decomposition.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other jelly fungi, Gloiodon strigosus can undergo dramatic changes in appearance based on moisture levels, swelling when wet and becoming hard and shriveled when dry, only to revive again with moisture.",
