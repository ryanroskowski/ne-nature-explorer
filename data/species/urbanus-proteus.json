  "nameStory": "",
  "description": "The Long-tailed Skipper (Urbanus proteus) is a small butterfly characterized by its dark brown wings and distinctive long tail-like extensions on its hind wings. This tropical species occasionally strays north into New England during warm months, making it a rare but notable visitor to the region.",
  "idTips": [
    {
      "label": "Long tail extensions",
      "description": "Prominent tail-like projections extending from the hind wings are the most distinctive feature",
      "isPrimary": true
    },
    {
      "label": "Dark coloring with spots",
      "description": "Dark brown to blackish wings with lighter spots and markings on the wing surfaces",
      "isPrimary": false
    },
    {
      "label": "Small to medium size",
      "description": "Wingspan ranges from 1.3 to 1.6 inches, relatively small compared to other butterflies",
      "isPrimary": false
    }
  ],
  "habitat": "Long-tailed Skippers prefer warm, open areas with legume plants (beans and peas) that serve as host plants for their caterpillars.",
