  "nameStory": "",
  "description": "Lasioglossum zephyrus, commonly known as the Zephyr Sweat Bee, is a small native bee species belonging to the Halictidae family, characterized by its metallic coloration and solitary to semi-social nesting behavior. These bees are important pollinators found throughout New England, where they visit a variety of wildflowers and garden plants during the warmer months.",
  "idTips": [
    {
      "label": "Metallic Green Body",
      "description": "Distinctive shiny, metallic green coloration on the head and thorax",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Tiny bee measuring 3-4mm in length, among the smallest native bee species",
      "isPrimary": false
    },
    {
      "label": "Sparse Body Hair",
      "description": "Relatively hairless appearance compared to other native bees, with sparse setae",
      "isPrimary": false
    }
  ],
  "habitat": "Zephyr Sweat Bees thrive in open, sunny areas including meadows, gardens, and woodland edges throughout New England, preferring locations with diverse flowering plants.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their name, sweat bees are attracted to human perspiration for its salt content, though L. zephyrus is more interested in nectar and pollen than actively seeking out sweaty humans.",
