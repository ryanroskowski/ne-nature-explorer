  "nameStory": "",
  "description": "Pleated Pluteus (Pluteus longistriatus) is a small to medium-sized mushroom characterized by its distinctive radially grooved or pleated cap. This saprobic fungus belongs to the Pluteaceae family and is commonly found decomposing wood in New England forests.",
  "idTips": [
    {
      "label": "Radially Pleated Cap",
      "description": "The cap surface features prominent radial grooves or pleats extending from the center toward the margin, giving it a distinctive lined appearance.",
      "isPrimary": true
    },
    {
      "label": "Free Gills",
      "description": "The gills are free from the stem and typically white to pale pink, becoming darker as spores mature.",
      "isPrimary": false
    },
    {
      "label": "Gray to Brown Cap Color",
      "description": "The cap is typically gray-brown to grayish, often with a darker center and lighter margins.",
      "isPrimary": false
    }
  ],
  "habitat": "Pleated Pluteus grows on dead hardwood, logs, and woody debris in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Pluteus species, this fungus has a pink spore print rather than the white spore print seen in many common edible mushrooms, making it easily distinguishable in the field.",
