  "nameStory": "",
  "description": "Hebeloma albidulum is a small, pale-capped mushroom belonging to the Hymenogastraceae family, characterized by its whitish to cream-colored appearance. This species is found in New England and other temperate regions, typically fruiting in autumn.",
  "idTips": [
    {
      "label": "Pale Cap Color",
      "description": "Distinctive whitish to cream-colored cap, which gives the species its name 'albidulum' (meaning whitish)",
      "isPrimary": true
    },
    {
      "label": "Gills and Spore Print",
      "description": "Features pale gills that may develop brown tones with age, producing a brown spore print",
      "isPrimary": false
    },
    {
      "label": "Mild to Radish-like Odor",
      "description": "Often exhibits a faint fungal or slightly radish-like smell, characteristic of the Hebeloma genus",
      "isPrimary": false
    }
  ],
  "habitat": "Hebeloma albidulum grows on the forest floor in mixed woodlands and near coniferous trees throughout New England, fruiting from late summer through autumn.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many Hebeloma species, H. albidulum forms mycorrhizal relationships with tree roots, making it an important part of forest soil ecology.",
