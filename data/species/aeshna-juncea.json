  "nameStory": "",
  "description": "The Sedge Darner (Aeshna juncea) is a large dragonfly species belonging to the Darner family, characterized by its elongated body and powerful flight. Found throughout New England, it is an active predator of small flying insects and plays an important role in aquatic ecosystems.",
  "idTips": [
    {
      "label": "Thorax Stripes",
      "description": "Distinctive pale stripes on the thorax (shoulder area) that are characteristic of the species",
      "isPrimary": true
    },
    {
      "label": "Body Color",
      "description": "Dark brown to black body with blue or green markings on the abdomen, depending on age and sex",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Large dragonfly with a wingspan of 2.8 to 3.2 inches (70-80 mm), making it one of the larger darners",
      "isPrimary": false
    }
  ],
  "habitat": "Sedge Darners inhabit shallow ponds, marshes, and sedge-lined wetlands where their aquatic nymphs develop in acidic or neutral waters.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Sedge Darners are highly territorial and perform dramatic aerial displays, darting and hovering over water to defend their breeding territories from rival males.",
