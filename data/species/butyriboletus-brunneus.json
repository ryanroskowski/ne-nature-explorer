  "nameStory": "",
  "description": "Butyriboletus brunneus, commonly known as the Bay Bolete, is a medium to large fungus belonging to the boletes family, characterized by its brown cap and yellow pores that bruise blue when damaged. This edible species is prized by mushroom foragers in New England for its firm flesh and pleasant nutty flavor.",
  "idTips": [
    {
      "label": "Blue bruising on pores",
      "description": "The yellow pores beneath the cap turn blue-green when pressed or damaged, a distinctive characteristic of this species",
      "isPrimary": true
    },
    {
      "label": "Brown cap with velvety texture",
      "description": "The cap is medium to dark brown, often with a slightly velvety appearance that may fade in dry conditions",
      "isPrimary": false
    },
    {
      "label": "Yellow, angular pores",
      "description": "The pores are bright yellow when young and become more orange-yellow with age, with a finely angular structure",
      "isPrimary": false
    }
  ],
  "habitat": "Butyriboletus brunneus is found in mixed deciduous and coniferous forests throughout New England, typically fruiting from summer through fall in association with oak, beech, and pine trees.",
