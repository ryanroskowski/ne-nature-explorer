  "nameStory": "",
  "description": "Uromyces ari-triphylli is a rust fungus in the Pucciniaceae family that parasitizes Jack-in-the-Pulpit (Arisaema triphyllum) throughout New England. This obligate pathogen completes its life cycle entirely on its host plant, producing characteristic rust pustules on leaves and stems.",
  "idTips": [
    {
      "label": "Rust Pustules",
      "description": "Orange to reddish-brown powdery pustules appear on the undersides of Jack-in-the-Pulpit leaves, containing millions of fungal spores",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "This rust fungus occurs exclusively on Arisaema triphyllum (Jack-in-the-Pulpit), making host identity the most reliable identification factor",
      "isPrimary": false
    },
    {
      "label": "Spore Characteristics",
      "description": "Microscopic examination reveals echinulate (spiny) uredospores and teliospores distinctive to this rust species",
      "isPrimary": false
    }
  ],
  "habitat": "Uromyces ari-triphylli thrives in the moist woodland understory and wetland margins of New England where its host plant grows.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As an autoecious rust, this fungus requires only Jack-in-the-Pulpit to complete its entire life cycle, never needing an alternate host like many other rust species.",
