  "nameStory": "",
  "description": "Trametes lactinea, commonly known as the Latte Bracket, is a small woody fungus characterized by its pale, coffee-with-milk colored fruiting bodies. This shelf fungus plays an important ecological role in New England forests by decomposing dead hardwood.",
  "idTips": [
    {
      "label": "Pore Surface Color",
      "description": "The underside displays distinctive cream to pale tan pores that are angular and tightly packed, resembling a sponge texture",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Upper surface is light brown to grayish-tan with a velvety texture and concentric zones, ranging from 1-4 cm wide",
      "isPrimary": false
    },
    {
      "label": "Growth Pattern",
      "description": "Forms small, overlapping shelf-like brackets or rosettes on dead hardwood logs and branches",
      "isPrimary": false
    }
  ],
  "habitat": "Latte Bracket grows on dead hardwood, particularly oak and birch, in moist forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate appearance, Trametes lactinea is an incredibly efficient wood decomposer and remains fruiting on logs for multiple seasons, continuing to break down woody material year after year.",
  "confusionNotes": null,
