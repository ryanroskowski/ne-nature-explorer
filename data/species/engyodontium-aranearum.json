  "nameStory": "",
  "description": "Engyodontium aranearum is a specialized fungus in the Cordycipitaceae family that parasitizes spiders, particularly in New England forests. This entomopathogenic fungus demonstrates a fascinating evolutionary adaptation to arthropod hosts rather than insects.",
  "idTips": [
    {
      "label": "Host Association",
      "description": "Look for infected spider hosts, as this fungus is specifically adapted to parasitize arachnids rather than insects",
      "isPrimary": true
    },
    {
      "label": "Fruiting Body Structure",
      "description": "Produces small, thread-like conidiophores emerging from the spider's body with characteristic branching patterns",
      "isPrimary": false
    },
    {
      "label": "Microscopic Features",
      "description": "Exhibits distinctive conidial chains and cellular morphology visible under magnification that distinguish it from other Cordycipitaceae",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives in moist, forested ecosystems of New England where spider populations are abundant, particularly in leaf litter and vegetation near the forest floor.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many Cordycipitaceae that manipulate insect behavior, E. aranearum infects spiders and may influence their web-building behavior, representing a unique ecological interaction in fungal-arthropod relationships.",
