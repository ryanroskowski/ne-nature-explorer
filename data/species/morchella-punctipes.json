  "nameStory": "",
  "description": "The Half-free Morel is a distinctive spring mushroom characterized by its partially attached cap that hangs freely from the stem, creating a unique appearance among morels. This edible fungus is prized by foragers throughout New England and fruits in the cooler months of spring.",
  "idTips": [
    {
      "label": "Partially Attached Cap",
      "description": "The cap is attached to the stem only at the top, with the sides hanging freely like a skirt or bell, distinguishing it from true morels where the cap is fully attached.",
      "isPrimary": true
    },
    {
      "label": "Honeycomb Structure",
      "description": "The cap features irregular ridges and pits arranged in a honeycomb-like pattern, typically tan to yellowish-brown in color.",
      "isPrimary": false
    },
    {
      "label": "Hollow Interior",
      "description": "Both the cap and stem are completely hollow when sliced lengthwise, with no cotton-like tissue inside.",
      "isPrimary": false
    }
  ],
  "habitat": "Half-free Morels prefer moist, rich woodlands, often fruiting near dead elm, ash, and other hardwood trees in New England's deciduous and mixed forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike true morels that fruit directly from the soil, Half-free Morels often emerge from mulch, wood chips, and decaying wood, making them common finds in landscaped areas and disturbed forest floors.",
