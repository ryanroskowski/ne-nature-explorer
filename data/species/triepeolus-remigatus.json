  "nameStory": "",
  "description": "The Squash Longhorn-Cuckoo is a cleptoparasitic bee in the Apidae family that does not collect pollen itself, instead laying eggs in the nests of host bees, particularly squash bees. Despite its common name, it is not a plant but rather a specialized bee species found in New England during summer months.",
  "idTips": [
    {
      "label": "Long Antennae",
      "description": "Males possess notably elongated antennae that are longer than the head width, a characteristic feature of the genus Triepeolus.",
      "isPrimary": true
    },
    {
      "label": "Body Coloration",
      "description": "Generally dark brown to black body with distinctive pale or yellowish hair bands on the abdomen, giving it a striped appearance.",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Medium-sized bee, typically 10-13 mm in length, smaller than many bumble bees but larger than sweat bees.",
      "isPrimary": false
    }
  ],
  "habitat": "Found in open, sunny areas with flowering plants and squash crops where host bee populations nest, particularly in gardens, farms, and meadows throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cleptoparasitic bee, the Squash Longhorn-Cuckoo has evolved to exploit the parental care of squash bees by depositing its eggs in their nests, where the cuckoo larvae consume the host's provisions.",
