  "nameStory": "",
  "description": "Sanderson's Bumble Bee (Bombus sandersoni) is a robust, fuzzy bee species native to New England that plays a vital role in pollinating wildflowers and cultivated plants. This medium-sized bumble bee is an important pollinator for early spring blooms in northeastern ecosystems.",
  "idTips": [
    {
      "label": "Yellow and Black Bands",
      "description": "Distinctive yellow facial markings and yellow bands on the thorax and abdomen with black segments in between",
      "isPrimary": true
    },
    {
      "label": "Body Size",
      "description": "Medium-sized bumble bee, queens typically larger than workers, with a robust, densely hairy body",
      "isPrimary": false
    },
    {
      "label": "Geographic Range",
      "description": "Found specifically in New England and surrounding northeastern regions, distinguishing it from similar bumble bee species",
      "isPrimary": false
    }
  ],
  "habitat": "Sanderson's Bumble Bee prefers open meadows, gardens, and woodland edges throughout New England where early spring flowering plants provide abundant nectar and pollen sources.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other bumble bees, Sanderson's Bumble Bees can perform 'buzz pollination,' vibrating their flight muscles at a specific frequency to release pollen from flowers like tomatoes and blueberries that honeybees cannot effectively pollinate.",
  "confusionNotes": null,
  "contextualKnowledge": null,
