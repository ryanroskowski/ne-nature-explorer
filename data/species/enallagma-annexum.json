  "nameStory": "",
  "description": "The Northern Bluet is a small damselfly belonging to the Coenagrionidae family, characterized by its delicate blue and black coloring. It is commonly found throughout New England and other northeastern regions of North America during the warmer months.",
  "idTips": [
    {
      "label": "Blue coloration pattern",
      "description": "Males display bright blue segments on the abdomen with black markings, while females may be blue, green, or tan with similar black patterning",
      "isPrimary": true
    },
    {
      "label": "Size and body shape",
      "description": "Very small damselfly, typically 1.3-1.6 inches long, with a slender, elongated body and narrow wings held along the abdomen when at rest",
      "isPrimary": false
    },
    {
      "label": "Postocular spots",
      "description": "Two distinct pale spots behind the eyes are a useful field mark for distinguishing this species from similar bluets",
      "isPrimary": false
    }
  ],
  "habitat": "Northern Bluets prefer quiet freshwater environments including ponds, marshes, slow streams, and weedy lake edges where aquatic vegetation provides shelter and breeding grounds.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Northern Bluet males perform elaborate aerial courtship displays, flying in tandem with females before mating, and pairs often remain connected while the female lays eggs in aquatic plants.",
