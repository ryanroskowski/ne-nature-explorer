  "nameStory": "",
  "description": "Lingonberry Gall is a fungal disease caused by Exobasidium vaccinii that affects lingonberry and cranberry plants in the Ericaceae family. It causes abnormal swelling and discoloration of plant tissues, particularly on leaves and stems, disrupting normal plant development.",
  "idTips": [
    {
      "label": "Gall Formation",
      "description": "Distinctive swollen, warty protrusions on leaves, stems, and flower buds with a distinctive pale or reddish appearance",
      "isPrimary": true
    },
    {
      "label": "Powdery Surface",
      "description": "Affected tissues develop a fine, whitish powdery coating (the fungal spore layer) on the gall surface",
      "isPrimary": false
    },
    {
      "label": "Tissue Distortion",
      "description": "Infected plant parts become thickened, misshapen, and may eventually wither or drop prematurely",
      "isPrimary": false
    }
  ],
  "habitat": "Found in cool, moist woodland areas and cultivated berry patches throughout New England, particularly in acidic soils where lingonberries and cranberries naturally thrive.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Exobasidium vaccinii is a basidiomycete fungus that essentially hijacks the plant's growth hormones to create the galls, which serve as protected fruiting sites for the fungus to spread its spores.",
