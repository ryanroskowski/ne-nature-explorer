  "nameStory": "",
  "description": "Tubakia suttoniana is a fungal species belonging to the Tubakiaceae family, characterized by its dark, flask-shaped structures called perithecia. This pathogenic fungus is commonly found on various plant hosts throughout New England, where it causes leaf spot diseases.",
  "idTips": [
    {
      "label": "Dark Flask-shaped Perithecia",
      "description": "Look for distinctive dark brown to black, flask-shaped or globose fruiting bodies embedded in affected leaf tissue",
      "isPrimary": true
    },
    {
      "label": "Angular Leaf Spots",
      "description": "Infected leaves display dark, angular or irregular lesions that may have a red or purple border",
      "isPrimary": false
    },
    {
      "label": "Microscopic Spore Appearance",
      "description": "Under magnification, observe small, dark ascospores released from the perithecial opening",
      "isPrimary": false
    }
  ],
  "habitat": "Tubakia suttoniana thrives in moist environments on decaying leaf litter and living plant foliage throughout New England's deciduous and mixed forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite being a plant pathogen, Tubakia suttoniana plays an important ecological role by decomposing dead plant material and recycling nutrients in forest ecosystems.",
