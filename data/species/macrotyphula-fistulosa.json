  "nameStory": "",
  "description": "Pipe Club (Macrotyphula fistulosa) is a small, delicate fungus characterized by its hollow, tube-like fruiting bodies that resemble tiny pipes or straws. This wood-decaying fungus is commonly found in New England forests during late summer and fall.",
  "idTips": [
    {
      "label": "Hollow Structure",
      "description": "The fruiting body is distinctly hollow throughout, like a pipe or tube, which is the defining characteristic of this species.",
      "isPrimary": true
    },
    {
      "label": "Size and Shape",
      "description": "Typically 2-4 inches tall with a uniform diameter of about 1/8 inch, appearing as thin, upright cylindrical tubes.",
      "isPrimary": false
    },
    {
      "label": "Color",
      "description": "Usually tan, buff, or pale brown, sometimes with a slightly darker apex, and becoming more brittle as it dries.",
      "isPrimary": false
    }
  ],
  "habitat": "Pipe Club grows on rotting hardwood logs and woody debris in moist, shaded forest floors throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate appearance, Macrotyphula fistulosa plays an important ecological role as a decomposer, helping break down dead wood and return nutrients to the forest ecosystem.",
