  "nameStory": "",
  "description": "Entoloma salmoneum is a small woodland mushroom in the Entolomataceae family, characterized by its distinctive salmon-pink coloration and angular spore print. This species is commonly found throughout New England and is notable for its delicate appearance and specific ecological preferences.",
  "idTips": [
    {
      "label": "Salmon-pink coloration",
      "description": "The caps and gills display a characteristic salmon to peachy-pink hue that distinguishes this species from related Entoloma species",
      "isPrimary": true
    },
    {
      "label": "Angular spores",
      "description": "The spore print is distinctly angular or star-shaped under magnification, a defining feature of the Entoloma genus",
      "isPrimary": false
    },
    {
      "label": "Small to medium size",
      "description": "Typically 2-4 cm in cap diameter with thin, brittle flesh and delicate construction",
      "isPrimary": false
    }
  ],
  "habitat": "Entoloma salmoneum grows in mossy areas of deciduous and mixed forests throughout New England, often appearing on rich, humus-laden soil during damp seasons.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Entoloma genus are among the few mushrooms with distinctly angular, star-shaped spores, making them easily recognizable under a microscope despite their similar appearance in the field.",
  "confusionNotes": null,
  "contextualKnowledge": null,
