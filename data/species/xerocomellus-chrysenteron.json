  "nameStory": "",
  "description": "The Red-cracking Bolete is a small to medium-sized mushroom characterized by a brownish cap that distinctively cracks to reveal reddish flesh underneath. It is a common and widespread bolete found throughout New England, often appearing in mixed forests during summer and fall.",
  "idTips": [
    {
      "label": "Cracking Cap",
      "description": "The brown cap develops distinctive radial cracks that expose bright red or yellow flesh beneath, giving the mushroom its common name.",
      "isPrimary": true
    },
    {
      "label": "Yellow Pores",
      "description": "The underside features small, bright yellow pores that may bruise slightly blue or green when handled.",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "The cap typically measures 1-3 inches in diameter, making it relatively small compared to other boletes.",
      "isPrimary": false
    }
  ],
  "habitat": "The Red-cracking Bolete thrives in mixed deciduous and coniferous forests, particularly in mossy areas and near rotting wood throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its appetizing appearance with the red flesh visible through cracks, this bolete is generally considered inedible or of poor quality for consumption.",
