  "nameStory": "",
  "description": "Phyllactinia betulae is a powdery mildew fungus that specifically infects birch trees (Betula species) throughout New England. This obligate parasite creates characteristic white, powdery fungal colonies on leaf surfaces, potentially weakening host plants through reduced photosynthesis.",
  "idTips": [
    {
      "label": "Host Specificity",
      "description": "Found exclusively on birch trees (Betula spp.), making host identification crucial for proper diagnosis",
      "isPrimary": true
    },
    {
      "label": "White Powdery Coating",
      "description": "Produces distinctive white to grayish powdery fungal growth on both upper and lower leaf surfaces",
      "isPrimary": false
    },
    {
      "label": "Cleistothecia Formation",
      "description": "Develops dark, spherical fruiting bodies (cleistothecia) late in the season, appearing as tiny black dots in the white coating",
      "isPrimary": false
    }
  ],
  "habitat": "Phyllactinia betulae thrives on birch trees in New England's forests and landscaped areas, preferring cool, dry conditions with moderate humidity typical of the region's temperate climate.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews, Phyllactinia betulae produces specialized structures called appressoria that allow it to penetrate and extract nutrients directly from birch leaf cells without causing visible tissue damage initially.",
