  "nameStory": "",
  "description": "Poplar Leaf Curl is a fungal disease caused by Taphrina populina that affects poplar trees throughout New England. It causes characteristic curling and distortion of leaves, typically appearing in spring as new foliage emerges.",
  "idTips": [
    {
      "label": "Leaf Curling",
      "description": "Affected leaves curl upward and become thickened, often with a pale or reddish discoloration",
      "isPrimary": true
    },
    {
      "label": "Powdery Surface",
      "description": "Infected leaves develop a fine, whitish, powdery coating on the undersurface from asci and ascospores",
      "isPrimary": false
    },
    {
      "label": "Early Spring Appearance",
      "description": "Symptoms are most visible in spring when new leaves first unfold, then may abate as season progresses",
      "isPrimary": false
    }
  ],
  "habitat": "Poplar Leaf Curl thrives in cool, wet spring conditions typical of New England forests and urban landscapes where susceptible poplar species are planted.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many fungal pathogens, Taphrina populina causes relatively little long-term damage to the host tree, and affected leaves often recover normal appearance as temperatures warm in late spring.",
