  "nameStory": "",
  "description": "Cystofilobasidium macerans, commonly known as sap yeast, is a basidiomycete yeast species belonging to the Cystofilobasidiaceae family. This microscopic fungus is primarily found in tree sap and associated substrates throughout New England's forests.",
  "idTips": [
    {
      "label": "Cellular morphology",
      "description": "Appears as small, oval to ellipsoid cells under microscopy, typically 4-6 micrometers in length",
      "isPrimary": true
    },
    {
      "label": "Growth on nutrient media",
      "description": "Forms whitish to cream-colored colonies on malt extract agar, with a smooth, yeast-like appearance",
      "isPrimary": false
    },
    {
      "label": "Habitat association",
      "description": "Consistently isolated from fresh tree sap, particularly from wounded hardwoods and birch trees",
      "isPrimary": false
    }
  ],
  "habitat": "Cystofilobasidium macerans thrives in the flowing sap of deciduous trees, particularly in New England's maple, birch, and oak forests during spring sap flow.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Sap yeasts like C. macerans play a crucial ecological role by fermenting tree sap, which contributes to the formation of sap yeasts that attract insects and influence the nutritional composition of tree exudates.",
