  "nameStory": "",
  "description": "Smooth Patch Disease, caused by Aleurodiscus oakesii, is a fungal condition affecting hardwood trees in the Stereaceae family, characterized by smooth, patch-like fruiting bodies on wood surfaces. This wood-decay fungus is commonly found on dead or dying oak and other hardwood species throughout New England.",
  "idTips": [
    {
      "label": "Smooth, Patch-like Fruiting Bodies",
      "description": "The fungus produces distinctive smooth, flat to slightly convex patches or plates on wood, lacking the wrinkled texture of related species.",
      "isPrimary": true
    },
    {
      "label": "Host Preference",
      "description": "Most commonly found on oak species, though it can colonize other hardwoods, making host identification valuable for field diagnosis.",
      "isPrimary": false
    },
    {
      "label": "Wood Decay Pattern",
      "description": "Creates a white to cream-colored rot that softens the wood, making the affected areas noticeably lighter and weaker than surrounding wood.",
      "isPrimary": false
    }
  ],
  "habitat": "Aleurodiscus oakesii thrives on dead or weakened hardwood logs, stumps, and fallen branches in moist, shaded forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its common name suggesting disease, Aleurodiscus oakesii is actually an important decomposer that helps recycle nutrients by breaking down dead wood in forest ecosystems.",
