  "nameStory": "",
  "description": "Hollyhock Rust is a fungal disease caused by Puccinia malvacearum that affects hollyhocks and other mallow family plants throughout New England. It is an obligate rust fungus that completes its entire life cycle on a single host plant without requiring an alternate host.",
  "idTips": [
    {
      "label": "Rust-colored pustules on leaf undersides",
      "description": "Look for bright orange to rust-brown, powdery pustules appearing on the underside of infected leaves, which is the most distinctive symptom.",
      "isPrimary": true
    },
    {
      "label": "Yellow spots on upper leaf surface",
      "description": "Upper leaf surfaces develop pale yellow or chlorotic spots that correspond to pustule locations on the undersides.",
      "isPrimary": false
    },
    {
      "label": "Severe leaf distortion and drop",
      "description": "Heavy infections cause leaves to curl, distort, and eventually drop from the plant, weakening overall plant vigor.",
      "isPrimary": false
    }
  ],
  "habitat": "Hollyhock Rust thrives in cool, moist conditions typical of New England springs and falls, preferring humid environments with poor air circulation around the base of hollyhock plants.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Puccinia malvacearum is one of the few rust fungi that is autoecious, meaning it completes its entire complex life cycle on a single host plant rather than requiring migration between two different plant species.",
  "confusionNotes": null,
