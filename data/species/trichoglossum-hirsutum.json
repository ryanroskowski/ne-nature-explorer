  "nameStory": "",
  "description": "Hairy Earthtongue is a small, dark fungus that resembles a tiny blackened tongue protruding from the forest floor. This gelatinous species is part of the Geoglossaceae family, commonly known as earthtongues, and appears in moist woodland environments throughout New England.",
  "idTips": [
    {
      "label": "Hairy exterior",
      "description": "The fruiting body is distinctly covered in dark, hair-like setae (bristles) that give it a fuzzy or velvety appearance",
      "isPrimary": true
    },
    {
      "label": "Dark coloration",
      "description": "The fruiting body is dark brown to black, with a distinct separation between the fertile head and the sterile stem",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "Typically reaches only 2-4 cm in height, making it easy to overlook in leaf litter",
      "isPrimary": false
    }
  ],
  "habitat": "Hairy Earthtongue grows in moist, rich soil and decaying leaf litter in deciduous and mixed forests throughout New England, fruiting from late summer through autumn.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their tongue-like appearance, earthtongues are fungi, not plants, and they absorb nutrients from decomposing organic matter in the soil rather than photosynthesizing.",
