  "nameStory": "",
  "description": "Mycogone rosea is a fungal species in the Hypocreaceae family, notable for its distinctive pink or rose-colored structures. This microscopic fungus is commonly found in New England and plays an important ecological role in decomposition processes.",
  "idTips": [
    {
      "label": "Rose-pink coloration",
      "description": "The characteristic pink to rose-red pigmentation of conidiophores and conidia is the most distinctive feature",
      "isPrimary": true
    },
    {
      "label": "Microscopic spore structure",
      "description": "Features small, oval to globose conidia produced on specialized hyphae",
      "isPrimary": false
    },
    {
      "label": "Growth pattern",
      "description": "Forms delicate, branching hyphal networks visible under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Mycogone rosea is typically found on decaying organic matter, plant debris, and soil in the moist forest environments characteristic of New England.",
