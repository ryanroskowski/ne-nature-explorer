  "nameStory": "",
  "description": "Hydnellum aurantiacum, commonly known as Orange Rough-cap Tooth, is a small woodland fungus characterized by its distinctive orange to reddish-brown cap and tooth-like spines underneath instead of gills. This species belongs to the Boletopsidaceae family and is found in coniferous and mixed forests throughout New England.",
  "idTips": [
    {
      "label": "Orange to Reddish-Brown Cap",
      "description": "The fruiting body features a distinctive warm orange or rusty-orange colored cap with a rough or velvety texture that darkens with age",
      "isPrimary": true
    },
    {
      "label": "Tooth-like Spines",
      "description": "Underneath the cap are small, decurrent spines (teeth) rather than gills, typically whitish to pale orange in color",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "The fruiting bodies are relatively small, typically 2-6 cm in diameter, with a fragile structure",
      "isPrimary": false
    }
  ],
  "habitat": "Hydnellum aurantiacum prefers moist forest floors in coniferous and mixed woodlands of New England, often found near mosses and decaying wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Hydnellum genus, including H. aurantiacum, are sometimes called 'bleeding tooth fungi' because some species exude reddish liquid droplets from their spines when young, creating a striking appearance.",
