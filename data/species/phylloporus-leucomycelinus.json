  "nameStory": "",
  "description": "The Gilled Bolete is a distinctive fungus that bridges the gap between true boletes and gilled mushrooms, featuring thin gill-like structures beneath the cap rather than typical pores. Found throughout New England, this small to medium-sized mushroom is recognizable by its pale coloring and delicate gill arrangement.",
  "idTips": [
    {
      "label": "Gill-like pores",
      "description": "Thin, blade-like gill structures that run from cap to stem, distinguishing it from typical boletes with round pores",
      "isPrimary": true
    },
    {
      "label": "Pale coloration",
      "description": "White to pale cream-colored cap and stem, with similarly light-colored gills",
      "isPrimary": false
    },
    {
      "label": "Stem characteristics",
      "description": "Relatively thin, equal-width stem with fine white mycelium at the base",
      "isPrimary": false
    }
  ],
  "habitat": "Phylloporus leucomycelinus grows on the forest floor in mixed hardwood and coniferous forests throughout New England, typically appearing in summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its common name 'Gilled Bolete,' this fungus is actually classified separately from true boletes due to its unique gill-like pore structure, making it a transitional species between two major fungal groups.",
