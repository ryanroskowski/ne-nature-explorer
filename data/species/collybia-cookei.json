  "nameStory": "",
  "description": "Splitpea Shanklet (Collybia cookei) is a small, delicate mushroom belonging to the Clitocybaceae family, characterized by its diminutive size and slender stature. This fungus is commonly encountered in New England woodlands, where it plays a role in forest decomposition.",
  "idTips": [
    {
      "label": "Cap color and texture",
      "description": "Small, convex to flat caps typically pale tan to grayish-brown, with a thin, fragile appearance",
      "isPrimary": false
    },
    {
      "label": "Stem characteristics",
      "description": "Exceptionally thin, wiry, and dark-colored stems that are distinctly slender relative to cap size",
      "isPrimary": true
    },
    {
      "label": "Gill attachment",
      "description": "Crowded gills that are decurrent or nearly free, typically white to pale buff in color",
      "isPrimary": false
    }
  ],
  "habitat": "Splitpea Shanklet grows on decaying wood, leaf litter, and mossy substrates in moist hardwood and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'cookei' honors a mycologist, and despite its tiny size, this mushroom is a dedicated decomposer that helps break down woody debris in forest ecosystems.",
