  "nameStory": "",
  "description": "The Tawny Emperor (Asterocampa clyton) is a medium-sized butterfly in the Nymphalidae family, characterized by its warm brownish-orange coloring and distinctive eyespots. This species is common throughout New England and prefers wooded areas where its host plants thrive.",
  "idTips": [
    {
      "label": "Eyespot Pattern",
      "description": "Features prominent dark eyespots arranged in rows on both the upper and lower wing surfaces, particularly visible on the hindwings",
      "isPrimary": true
    },
    {
      "label": "Wing Color",
      "description": "Warm tawny-orange to brown coloring on wings with darker patches and lighter bands creating a mottled appearance",
      "isPrimary": false
    },
    {
      "label": "Wing Shape",
      "description": "Rounded wing margins and relatively compact wing shape distinguishing it from similar Asterocampa species",
      "isPrimary": false
    }
  ],
  "habitat": "Tawny Emperors are found in deciduous and mixed forests, woodlands, and forest edges throughout New England, where hackberry trees (their primary host plant) are abundant.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many butterflies, Tawny Emperors rarely visit flowers; instead, they prefer to feed on tree sap, rotting fruit, and animal droppings, making them challenging to observe on typical butterfly plants.",
