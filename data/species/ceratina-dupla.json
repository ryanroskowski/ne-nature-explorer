  "nameStory": "",
  "description": "Ceratina dupla, commonly known as the small carpenter bee, is a tiny solitary bee species in the family Apidae found throughout New England. Despite their small size (3-5mm), these bees are important pollinators and are noted for their metallic green coloration and wood-nesting behavior.",
  "idTips": [
    {
      "label": "Metallic coloration",
      "description": "Displays a distinctive metallic green or blue-green body with a shiny appearance",
      "isPrimary": true
    },
    {
      "label": "Tiny size",
      "description": "One of the smallest bee species at only 3-5mm in length, much smaller than honey bees",
      "isPrimary": false
    },
    {
      "label": "Body structure",
      "description": "Has a relatively robust, compact body with short antennae compared to some other small bees",
      "isPrimary": false
    }
  ],
  "habitat": "Ceratina dupla prefers open woodlands, gardens, and areas with dead stems and branches where they can excavate nesting tunnels in pithy plant material.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike most solitary bees, Ceratina dupla females sometimes remain in their nests to help raise their offspring, showing a form of maternal care that bridges solitary and social bee behavior.",
