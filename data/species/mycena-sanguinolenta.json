  "nameStory": "",
  "description": "Mycena sanguinolenta, commonly known as Bleeding Bonnet, is a small delicate mushroom in the Mycenaceae family characterized by its distinctive reddish coloration and tiny size. This species is found throughout New England, typically appearing in moist woodlands during the mushroom season.",
  "idTips": [
    {
      "label": "Red/Pink Coloration",
      "description": "Cap and stalk display distinctive deep red or pink hues, particularly on the cap surface and upper stalk",
      "isPrimary": true
    },
    {
      "label": "Tiny Size",
      "description": "Very small mushroom with caps typically 0.5-1.5 cm in diameter, easily overlooked among moss and leaf litter",
      "isPrimary": false
    },
    {
      "label": "Milk-like Exudate",
      "description": "When stalk is broken or damaged, a reddish liquid or milk-like substance oozes out, giving the species its 'bleeding' name",
      "isPrimary": true
    }
  ],
  "habitat": "Bleeding Bonnet grows on decaying wood, moss, and rich humus in damp forests and shaded woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The striking 'bleeding' appearance comes from reddish pigments that ooze from damaged tissue, a distinctive feature that inspired both its common and scientific names.",
  "confusionNotes": null,
