  "nameStory": "",
  "description": "Pycnoporellus fulgens is a wood-decay fungus belonging to the Pycnoporellaceae family, characterized by its bright, luminous appearance. This polypore species plays an important ecological role in decomposing woody substrates in forest ecosystems.",
  "idTips": [
    {
      "label": "Bright coloration",
      "description": "Displays distinctive bright yellow to orange fruiting bodies that are notably vivid compared to other polypores",
      "isPrimary": true
    },
    {
      "label": "Pore surface",
      "description": "Features small, angular pores on the underside that are typically cream to pale yellow in color",
      "isPrimary": false
    },
    {
      "label": "Growth pattern",
      "description": "Forms thin, shelf-like or bracket-like structures that may appear in overlapping clusters on hardwood logs",
      "isPrimary": false
    }
  ],
  "habitat": "Pycnoporellus fulgens is found on decaying hardwood substrates and fallen logs in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Pycnoporellus reflects the dense pore structure of these fungi, which are efficient decomposers of woody material in temperate forests.",
