  "nameStory": "",
  "description": "Green Earthtongue (Microglossum viride) is a small, gelatinous fungus in the Leotiaceae family that features a distinctive club-shaped fruiting body. Despite its plant-like common name, it is actually a fungus that plays an important role in forest ecosystems as a decomposer.",
  "idTips": [
    {
      "label": "Green coloration",
      "description": "The fruiting body displays a characteristic olive-green to dark green color that distinguishes it from related species",
      "isPrimary": true
    },
    {
      "label": "Club-shaped fruiting body",
      "description": "The ascomycete has a distinct elongated, club or tongue-like structure that is gelatinous or rubbery in texture",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "Typically reaches only 1-3 cm in height, making it easy to overlook on the forest floor",
      "isPrimary": false
    }
  ],
  "habitat": "Green Earthtongue grows on rich, moist soil and decaying wood in deciduous and mixed forests throughout New England, particularly in shaded, humid locations.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its tongue-like appearance, Green Earthtongue reproduces via microscopic spores released from the tip of its fruiting body rather than through typical plant reproduction methods.",
