  "nameStory": "",
  "description": "Lactarius vinaceorufescens, commonly known as the Yellow-latex Milkcap, is a medium-sized mushroom in the Russulaceae family characterized by its distinctive reddish-brown to vinaceous cap and yellow milk (latex) that stains tissues. This species is found in New England and other temperate regions, where it plays an important ecological role in forest ecosystems.",
  "idTips": [
    {
      "label": "Yellow Latex",
      "description": "The mushroom exudes bright yellow to yellowish-orange milk when the gills or flesh are cut or bruised, which is the most distinctive feature.",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "The cap displays reddish-brown to vinaceous (wine-colored) tones, sometimes with darker concentric zones, and can range from 2-5 cm in diameter.",
      "isPrimary": false
    },
    {
      "label": "Spore Print",
      "description": "Produces a white to pale yellow spore print, and the gills are adnate to slightly decurrent with a pale color.",
      "isPrimary": false
    }
  ],
  "habitat": "Yellow-latex Milkcap grows in mycorrhizal associations with hardwood and coniferous forests throughout New England, preferring moist woodland floors rich in organic matter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The yellow latex is a defensive mechanism that tastes extremely bitter and acrid, deterring insects and herbivores from consuming the mushroom.",
  "confusionNotes": null,
  "contextualKnowledge": null,
