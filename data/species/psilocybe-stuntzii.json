  "nameStory": "",
  "description": "Psilocybe stuntzii is a small, brown mushroom species belonging to the Hymenogastraceae family, native to the Pacific Northwest and occasionally found in New England regions. This fungus is notable for its preference for wood chips and mulched areas in disturbed habitats.",
  "idTips": [
    {
      "label": "Cap Color and Shape",
      "description": "Small reddish-brown to tan cap, typically 1-3 cm in diameter, with a bell or convex shape when young",
      "isPrimary": true
    },
    {
      "label": "Gill Characteristics",
      "description": "Dark purple-brown to blackish gills that darken with age as spores mature",
      "isPrimary": false
    },
    {
      "label": "Growth Substrate",
      "description": "Fruiting bodies typically emerge from wood chips, mulch, or highly composted wood material",
      "isPrimary": false
    }
  ],
  "habitat": "Psilocybe stuntzii prefers moist wood chips and mulched areas in gardens, landscaped zones, and disturbed habitats with high organic matter content.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This species was named after mycologist Daniel Stuntz and is one of the few psilocybin-containing mushrooms that readily fruit on cultivated wood chip substrates rather than in natural forest settings.",
