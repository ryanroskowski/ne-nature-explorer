  "nameStory": "",
  "description": "The Golden Waxcap is a small, brightly colored mushroom with a distinctive waxy texture and golden-yellow coloring that makes it unmistakable in the field. It belongs to the Hygrocybaceae family, commonly known as waxcaps, which are characterized by their bright colors and waxy gill appearance.",
  "idTips": [
    {
      "label": "Bright Golden-Yellow Color",
      "description": "Caps and stems display a vivid golden-yellow hue that persists even when dried",
      "isPrimary": true
    },
    {
      "label": "Waxy, Blunt Gills",
      "description": "Gills are thick, widely spaced, and have a characteristic greasy or waxy feel and appearance",
      "isPrimary": false
    },
    {
      "label": "Small to Medium Size",
      "description": "Caps typically measure 1-4 cm across with slender, concolorous stems",
      "isPrimary": false
    }
  ],
  "habitat": "Golden Waxcaps are found in grassy areas, meadows, and mossy woods throughout New England, preferring moist, nutrient-poor soils where they fruit from late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps like Hygrocybe chlorophana are considered indicators of healthy, unimproved grasslands and are often used by ecologists to assess pasture and meadow quality.",
