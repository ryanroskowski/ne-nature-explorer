  "nameStory": "",
  "description": "Pseudotricholoma umbrosum is a small woodland mushroom in the Tricholomataceae family, characterized by its dark, umbonate cap and pale gills. This species is relatively uncommon and appears in the autumn months across New England's forests.",
  "idTips": [
    {
      "label": "Dark umbonate cap",
      "description": "The cap is dark brownish-gray with a distinctive central bump (umbo) and typically measures 2-4 cm in diameter",
      "isPrimary": true
    },
    {
      "label": "Pale adnexed gills",
      "description": "Gills are whitish to pale gray, closely spaced, and attached to or nearly attached to the stem",
      "isPrimary": false
    },
    {
      "label": "Small slender stem",
      "description": "The stem is thin, fibrous, and often paler than the cap, lacking a prominent ring or volva",
      "isPrimary": false
    }
  ],
  "habitat": "Pseudotricholoma umbrosum prefers moist forest floors and leaf litter in hardwood and mixed forests throughout New England, fruiting in autumn.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus Pseudotricholoma was established to separate species formerly classified as Tricholoma, and umbrosum's name refers to its dusky, shadowy appearance—'umbrosum' meaning shadowy or shaded.",
