  "nameStory": "",
  "description": "Agrocybe firma, commonly known as the Attenuated Fieldcap, is a small brown mushroom belonging to the Hymenogastraceae family. This species is characterized by its modest size and delicate appearance, making it a subject of interest for mycologists studying New England fungal diversity.",
  "idTips": [
    {
      "label": "Cap Shape",
      "description": "Small, conical to bell-shaped cap that is brown and often tapers to a pointed apex",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Crowded gills that are pale to light brown, attached to the stem and often notched near the attachment point",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Slender, fibrous stem that is often curved and lighter in color than the cap",
      "isPrimary": false
    }
  ],
  "habitat": "Agrocybe firma typically grows in grassy fields, meadows, and disturbed soil areas throughout New England during cool, moist seasons.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Agrocybe genus are known for their rapid fruiting cycle, sometimes producing mushrooms within just a few days after favorable moisture conditions, making them pioneers of newly disturbed soil.",
