  "nameStory": "",
  "description": "Smith's earthstar (Astraeus smithii) is a small, star-shaped fungus that belongs to the Diplocystidaceae family and is found in New England's forest ecosystems. Like other earthstars, it has a distinctive appearance with an outer layer that splits into pointed rays, revealing a round spore sac within.",
  "idTips": [
    {
      "label": "Star-shaped outer layer",
      "description": "The peridium splits into 4-8 pointed, ray-like arms that spread open in a star pattern",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Mature fruiting bodies typically measure less than 1 inch (2-3 cm) across when fully expanded",
      "isPrimary": false
    },
    {
      "label": "Central spore sac",
      "description": "A pale, round or slightly flattened inner sac contains the spores and sits at the center of the star",
      "isPrimary": false
    }
  ],
  "habitat": "Smith's earthstar grows in sandy or well-drained soils in mixed woodlands and coniferous forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all earthstars, Astraeus smithii hygroscopically responds to moisture, with the star rays curling inward during dry conditions and spreading open again when wet to help disperse spores more effectively.",
