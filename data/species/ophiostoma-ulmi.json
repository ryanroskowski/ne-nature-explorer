  "nameStory": "",
  "description": "Dutch elm disease is a devastating fungal pathogen caused by Ophiostoma ulmi that infects and kills elm trees throughout New England. The disease is primarily spread by elm bark beetles and causes wilting, yellowing, and death of branches as the fungus blocks water-conducting vessels in the tree.",
  "idTips": [
    {
      "label": "Beetle galleries and staining",
      "description": "Look for dark staining patterns in the wood beneath bark and characteristic gallery patterns created by infected elm bark beetles",
      "isPrimary": true
    },
    {
      "label": "Branch wilting and dieback",
      "description": "Infected trees display rapid wilting of branches and yellowing of foliage, often progressing from branch tips inward",
      "isPrimary": false
    },
    {
      "label": "Vascular discoloration",
      "description": "Cross-sections of affected branches show brown or tan discoloration in the wood's vascular rings",
      "isPrimary": false
    }
  ],
  "habitat": "Dutch elm disease affects elm trees (Ulmus species) in urban and forest settings throughout New England, particularly in areas with established elm bark beetle populations.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its name, Dutch elm disease did not originate in the Netherlands; it was named after the Dutch scientists who first identified and described the disease in the 1920s.",
