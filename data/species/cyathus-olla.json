  "nameStory": "",
  "description": "Field bird's nest fungus (Cyathus olla) is a small, cup-shaped fungus that produces tiny egg-like structures called peridioles inside its hollow fruiting body. This distinctive fungus is found throughout New England, typically appearing in clusters on decomposing wood, mulch, and plant debris.",
  "idTips": [
    {
      "label": "Cup-shaped fruiting body",
      "description": "The fungus forms distinctive gray or brown cup-like structures, typically 8-15 mm tall, that are open at the top",
      "isPrimary": true
    },
    {
      "label": "Peridioles (egg-like structures)",
      "description": "Inside each cup are tiny white or tan marble-like balls called peridioles connected by thread-like cords, visible when you look inside the cup",
      "isPrimary": false
    },
    {
      "label": "Hairy or fringed rim",
      "description": "The cup opening typically has a distinctive hairy or fringed rim that helps identify it from other bird's nest fungi species",
      "isPrimary": false
    }
  ],
  "habitat": "Field bird's nest fungus grows on decaying hardwood, wood chips, straw, and mulch in moist, shaded environments throughout New England, often appearing after heavy rains.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The peridioles inside the cup are dispersed by raindrops, which splash them out like tiny projectiles; the cord-like attachment helps them stick to vegetation, where they can be carried to new growing locations.",
