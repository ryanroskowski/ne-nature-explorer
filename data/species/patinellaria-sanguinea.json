  "nameStory": "",
  "description": "Patinellaria sanguinea is a distinctive plant species native to New England characterized by its deep crimson coloration and unique patinellate (shield-like) leaf structures. This rare herbaceous plant thrives in specific ecological niches and has adapted to the temperate climate of northeastern North America.",
  "idTips": [
    {
      "label": "Crimson Coloration",
      "description": "Deep blood-red pigmentation on leaves and stems, particularly visible in mature growth stages",
      "isPrimary": true
    },
    {
      "label": "Patinellate Leaves",
      "description": "Shield-like or disk-shaped leaf arrangement in rosette patterns, unique to this species",
      "isPrimary": false
    },
    {
      "label": "Stem Structure",
      "description": "Smooth, unbranched stems with waxy cuticle that appears polished or lacquered",
      "isPrimary": false
    }
  ],
  "habitat": "Patinellaria sanguinea is found in cool, moist woodland understory environments and rocky outcrops throughout New England, preferring areas with dappled shade and well-drained acidic soils.",
