  "nameStory": "",
  "description": "The Little Prince (Agaricus nanaugustus) is a small, delicate mushroom belonging to the Field Mushrooms and Allies family, characterized by its diminutive stature and refined appearance. This New England native is a choice edible species prized by experienced foragers for its pleasant flavor and tender texture.",
  "idTips": [
    {
      "label": "Small, white cap",
      "description": "Typically 1-3 cm diameter with a smooth, pure white to pale cream surface that may bruise slightly yellow or brown with handling",
      "isPrimary": true
    },
    {
      "label": "Pink to brown gills",
      "description": "Gills start pink and gradually darken to chocolate brown as the mushroom matures, remaining free from the stem",
      "isPrimary": false
    },
    {
      "label": "Delicate ring",
      "description": "A thin, fragile annulus (ring) on the upper stem that may disappear with age or rough handling",
      "isPrimary": false
    }
  ],
  "habitat": "The Little Prince favors open grasslands, meadows, and lawn edges throughout New England, fruiting from late summer through fall after adequate moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its elegant name, Agaricus nanaugustus is one of the smallest members of the Agaricus genus, with some specimens barely exceeding the width of a pencil eraser.",
