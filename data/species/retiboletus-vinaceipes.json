  "nameStory": "",
  "description": "Retiboletus vinaceipes, commonly known as the Deceiver Bolete or Wine-footed Bolete, is a medium-sized fungus in the Boletaceae family native to Eastern North America. Despite its edible appearance, this species is inedible and can cause gastrointestinal upset if consumed.",
  "idTips": [
    {
      "label": "Stem Color",
      "description": "The stalk displays distinctive wine-red or burgundy coloration, especially toward the base, which is the most reliable identifying feature",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "Yellow pores that may bruise blue-green when pressed, becoming more olive with age",
      "isPrimary": false
    },
    {
      "label": "Cap Appearance",
      "description": "Brown to grayish-brown cap with a dry surface, typically 2-4 inches in diameter",
      "isPrimary": false
    }
  ],
  "habitat": "Retiboletus vinaceipes fruiting bodies appear in mixed hardwood and coniferous forests throughout New England during summer and fall, preferring well-drained soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'vinaceipes' literally means 'wine-footed,' directly referring to the distinctive deep red coloration of its stem that resembles red wine.",
