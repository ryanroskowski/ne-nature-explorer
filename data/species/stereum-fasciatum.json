  "nameStory": "",
  "description": "Stereum fasciatum, commonly known as the banded wood fungus, is a wood-decay fungus in the Stereaceae family characterized by its distinctive striped or banded appearance. This resupinate to slightly bracket-forming fungus plays an important ecological role in decomposing dead wood in forest ecosystems.",
  "idTips": [
    {
      "label": "Banded coloration",
      "description": "Displays striking alternating bands or zones of contrasting colors, typically orange-brown and cream or whitish tones arranged in concentric rings",
      "isPrimary": true
    },
    {
      "label": "Smooth hymenial surface",
      "description": "The fertile underside is smooth rather than pored or gilled, which distinguishes it from many other wood-decay fungi",
      "isPrimary": false
    },
    {
      "label": "Growth pattern",
      "description": "Grows as a thin, somewhat flattened or slightly bracket-like fruiting body closely adhered to decaying wood substrates",
      "isPrimary": false
    }
  ],
  "habitat": "Stereum fasciatum is found on dead hardwood, particularly on fallen branches and logs in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Stereum species, S. fasciatum produces enzymes that can break down both cellulose and lignin, making it an efficient decomposer that helps recycle nutrients back into forest soil.",
  "confusionNotes": null,
