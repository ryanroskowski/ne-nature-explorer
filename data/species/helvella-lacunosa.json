  "nameStory": "",
  "description": "Elfin Saddle (Helvella lacunosa) is a distinctive cup-shaped fungus characterized by its dark gray to black fruiting body with an irregular, folded cap resembling a tiny saddle. This ascomycete is commonly found on the forest floor during summer and fall throughout New England.",
  "idTips": [
    {
      "label": "Saddle-shaped cap",
      "description": "The cap has distinctive lobes and folds that resemble a miniature saddle, often asymmetrical and wavy at the edges",
      "isPrimary": true
    },
    {
      "label": "Hollow stem and cap",
      "description": "Both the stem and cap are completely hollow inside when cut lengthwise, with the stem often ribbed or ridged",
      "isPrimary": false
    },
    {
      "label": "Dark coloration",
      "description": "Cap and stem are typically dark gray to blackish, sometimes with lighter edges, and the spores are white",
      "isPrimary": false
    }
  ],
  "habitat": "Elfin Saddle thrives on rich, moist soil in mixed hardwood and coniferous forests, often appearing near decaying wood and leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its appealing appearance, Helvella lacunosa is considered potentially toxic when raw and should never be eaten, as it may contain compounds harmful to humans.",
