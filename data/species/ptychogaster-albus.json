  "nameStory": "",
  "description": "Ptychogaster albus, commonly known as Powderpuff Bracket, is a small polypore fungus characterized by its delicate, powder-like spore surface. This member of the Postiaceae family is notable for its ephemeral nature and fine texture.",
  "idTips": [
    {
      "label": "Powdery Spore Surface",
      "description": "The underside displays a distinctive white to cream-colored powdery or dusty appearance rather than distinct pores",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Typically forms small bracket or shelf-like fruiting bodies, usually less than 2-3 cm across",
      "isPrimary": false
    },
    {
      "label": "Delicate Texture",
      "description": "The fruiting body is fragile and easily crumbles, with a thin, papery cap",
      "isPrimary": false
    }
  ],
  "habitat": "Ptychogaster albus grows on decaying hardwood logs and dead branches in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Ptychogaster derives from Greek words meaning 'folded stomach,' referring to the unique folded or wrinkled spore-bearing surface that gives this fungus its powder-puff appearance.",
