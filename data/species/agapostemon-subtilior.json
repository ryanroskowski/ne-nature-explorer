  "nameStory": "",
  "description": "The Fine striped sweat bee (Agapostemon subtilior) is a small metallic bee belonging to the sweat bee family, known for its attraction to human perspiration as a source of salt and moisture. These solitary to semi-social bees are important native pollinators found throughout New England during the warmer months.",
  "idTips": [
    {
      "label": "Metallic coloration",
      "description": "Displays a bright metallic green body with fine striping patterns on the abdomen, distinguishing it from duller bee species",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Typically 8-10 mm in length, making it one of the smaller bee species in the region",
      "isPrimary": false
    },
    {
      "label": "Sexual dimorphism",
      "description": "Males often display more vibrant metallic coloring than females, with varying abdomen patterns between sexes",
      "isPrimary": false
    }
  ],
  "habitat": "Fine striped sweat bees prefer open, sunny areas including gardens, meadows, and disturbed habitats where native wildflowers and early blooming plants provide nectar and pollen sources.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "These bees are attracted to human sweat and will land on skin to collect salts and minerals, earning the family their common name 'sweat bees,' though they rarely sting unless threatened.",
