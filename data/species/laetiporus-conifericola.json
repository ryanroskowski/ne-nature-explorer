  "nameStory": "",
  "description": "Conifer Chicken of the Woods (Laetiporus conifericola) is a bright orange and yellow polypore fungus that fruitsBody on coniferous trees throughout New England. Despite its name suggesting culinary use, this species is potentially toxic and should not be consumed, unlike its hardwood-dwelling relative L. sulphureus.",
  "idTips": [
    {
      "label": "Host Preference",
      "description": "Fruits exclusively on conifer trees, particularly Douglas fir, true firs, and spruce, distinguishing it from the hardwood-loving L. sulphureus",
      "isPrimary": true
    },
    {
      "label": "Color Pattern",
      "description": "Displays vibrant orange upper surface with yellow pore surface and yellow margins on the underside",
      "isPrimary": false
    },
    {
      "label": "Pore Size",
      "description": "Features fine, angular pores (3-4 per millimeter) that are smaller and more regular than L. sulphureus",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus grows as a wood decay specialist on dead or dying coniferous trees, logs, and stumps in mixed forests and mountainous regions of New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "L. conifericola was only scientifically distinguished from its hardwood-loving cousin in 2012 through DNA analysis, revealing that the two species had long been confused despite their different ecological niches.",
  "confusionNotes": null,
