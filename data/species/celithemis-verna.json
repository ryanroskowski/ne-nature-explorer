  "nameStory": "",
  "description": "The Double-ringed Pennant is a small dragonfly in the Skimmers family (Libellulidae) characterized by distinctive markings on its wings and body. This species is commonly found throughout New England during the warmer months, where it hunts small insects near freshwater habitats.",
  "idTips": [
    {
      "label": "Wing Markings",
      "description": "Look for dark bands or rings on the wings, particularly near the base and middle sections, which give this species its distinctive 'double-ringed' appearance",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Adults are typically 28-32 mm in length, making them one of the smaller dragonfly species in New England",
      "isPrimary": false
    },
    {
      "label": "Body Color",
      "description": "Males display a dark brown or black body with amber or yellowish wing bases, while females are more tan or brownish overall",
      "isPrimary": false
    }
  ],
  "habitat": "The Double-ringed Pennant prefers shallow, weedy ponds, marshes, and slow-moving streams with abundant vegetation in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their small size, Double-ringed Pennants are agile fliers that can hover in place and are known for their rapid, erratic flight patterns when pursuing prey.",
