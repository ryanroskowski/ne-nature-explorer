  "nameStory": "",
  "description": "Birch Woodwart (Jackrogersella multiformis) is a wood-decay fungus in the Hypoxylaceae family, characterized by its dark, crusty fruiting bodies that develop on dead hardwood. This species is an important decomposer in New England forests, breaking down woody material and recycling nutrients back into the ecosystem.",
  "idTips": [
    {
      "label": "Stromatal Surface",
      "description": "Look for dark, black to dark brown crusty structures with a wrinkled or pustular surface texture",
      "isPrimary": true
    },
    {
      "label": "Host Wood",
      "description": "Found primarily on dead birch branches and logs, though it may colonize other hardwoods",
      "isPrimary": false
    },
    {
      "label": "Perithecia Arrangement",
      "description": "Multiple flask-shaped fruiting bodies (perithecia) are embedded within the dark stroma in various developmental stages",
      "isPrimary": false
    }
  ],
  "habitat": "Birch Woodwart thrives on dead or decaying birch wood and other hardwood substrates in moist, shaded forest environments throughout New England.",
