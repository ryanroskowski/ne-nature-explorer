  "nameStory": "",
  "description": "Coccomyces triangularis is a fungal pathogen belonging to the Rhytismataceae family, commonly found on leaves of hardwood trees throughout New England. This ascomycete causes leaf spot diseases and is an important part of forest fungal ecology in northeastern North America.",
  "idTips": [
    {
      "label": "Triangular Apothecia",
      "description": "The reproductive structures (apothecia) are distinctively triangular or angular in shape, which is the defining characteristic of this species.",
      "isPrimary": true
    },
    {
      "label": "Dark Fruiting Bodies",
      "description": "The apothecia appear as small, dark, raised spots on the leaf surface, typically appearing on the underside of infected leaves.",
      "isPrimary": false
    },
    {
      "label": "Leaf Spot Formation",
      "description": "Infected leaves develop necrotic spots or lesions that may be surrounded by lighter halos before the fungal structures emerge.",
      "isPrimary": false
    }
  ],
  "habitat": "Coccomyces triangularis is typically found on the leaves of broadleaf trees in moist, deciduous forests and woodlands throughout New England, thriving in humid conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other members of the Rhytismataceae family, Coccomyces triangularis completes part of its life cycle within the leaf tissue, overwintering in fallen leaves and releasing spores in spring to infect new foliage.",
