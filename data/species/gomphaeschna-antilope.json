  "nameStory": "",
  "description": "The Taper-tailed Darner (Gomphaeschna antilope) is a large dragonfly species belonging to the Darner family, characterized by its elongated body and distinctive tapered abdomen. This impressive aerial hunter is found throughout New England and other regions of North America.",
  "idTips": [
    {
      "label": "Tapered Abdomen",
      "description": "The abdomen gradually narrows toward the tip, giving this species its common name and distinguishing it from other darners with more uniform abdomens",
      "isPrimary": true
    },
    {
      "label": "Body Coloration",
      "description": "Males typically display blue coloring on the face and thorax, while females are more greenish-brown",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Among the largest darners, with a body length of 2.75 to 3.25 inches, making it easily recognizable in flight",
      "isPrimary": false
    }
  ],
  "habitat": "This species prefers marshes, swamps, and areas near permanent water bodies with emergent vegetation where it hunts for small flying insects.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Taper-tailed Darner is one of the earliest dragonflies to emerge in spring, often appearing in April and May, making it a welcome sign of warmer weather in New England.",
