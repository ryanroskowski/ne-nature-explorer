  "nameStory": "",
  "description": "The Skillet Clubtail is a medium-sized dragonfly belonging to the Clubtails family, characterized by its distinctive clubbed abdomen and robust build. This species is primarily found in New England and prefers clear, flowing waters for breeding and hunting.",
  "idTips": [
    {
      "label": "Clubbed Abdomen",
      "description": "The abdomen is noticeably swollen or clubbed at the tip, which is the defining feature of clubtail dragonflies and gives this species its common name.",
      "isPrimary": true
    },
    {
      "label": "Yellow Markings",
      "description": "Features yellow or pale stripes along the sides of the thorax and segments of the abdomen, contrasting with darker coloring.",
      "isPrimary": false
    },
    {
      "label": "Body Size",
      "description": "Medium-sized dragonfly with a body length typically ranging from 1.5 to 2 inches.",
      "isPrimary": false
    }
  ],
  "habitat": "The Skillet Clubtail inhabits fast-flowing streams and rivers with rocky or sandy bottoms in New England's temperate regions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Clubtail dragonflies are known for their unique mating behavior where males patrol their territory along streams, perching frequently on rocks and vegetation to watch for females.",
