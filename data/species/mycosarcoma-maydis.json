  "nameStory": "",
  "description": "Corn smut (Ustilago maydis, formerly Mycosarcoma maydis) is a fungal disease that transforms corn kernels and other plant tissues into dark, sooty masses of spores. This plant pathogen is a member of the Ustilaginaceae family and occurs throughout New England wherever corn is cultivated.",
  "idTips": [
    {
      "label": "Black Sooty Masses",
      "description": "Distinctive galls or tumors on corn ears, husks, and stalks that eventually rupture to release black, powdery spore masses",
      "isPrimary": true
    },
    {
      "label": "Gall Formation",
      "description": "Abnormal swollen growths that can range from small pustules to large, balloon-like structures on any above-ground corn tissue",
      "isPrimary": false
    },
    {
      "label": "Spore Color",
      "description": "Released spores appear as black or dark gray powder that easily rubs off infected tissues",
      "isPrimary": false
    }
  ],
  "habitat": "Corn smut thrives in New England cornfields, particularly in warm, humid conditions during the growing season, and requires direct contact with corn plants to spread.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "In Mexico, corn smut is considered a culinary delicacy called 'huitlacoche' and is used in traditional dishes, making it one of the few plant diseases valued as food.",
