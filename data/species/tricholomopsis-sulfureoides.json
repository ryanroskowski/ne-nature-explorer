  "nameStory": "",
  "description": "Tricholomopsis sulfureoides is a distinctive yellow fungus belonging to the Phyllotopsidaceae family, characterized by its bright sulfur coloring and wood-decay habit. It is commonly found in the forests of New England, where it plays an important ecological role as a decomposer of woody materials.",
  "idTips": [
    {
      "label": "Bright Yellow Coloration",
      "description": "The fruiting body displays a distinctive sulfur-yellow to pale yellow color on the cap, gills, and stem",
      "isPrimary": true
    },
    {
      "label": "Decurrent Gills",
      "description": "The gills are typically decurrent (running down the stem) and yellow, matching the overall color of the mushroom",
      "isPrimary": false
    },
    {
      "label": "Wood Association",
      "description": "This species grows on rotting logs, stumps, and woody debris rather than from soil, making habitat observation essential for identification",
      "isPrimary": false
    }
  ],
  "habitat": "Tricholomopsis sulfureoides is found on decaying hardwood logs and stumps in moist forests throughout New England, preferring shaded woodland environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many wood-decaying fungi, Tricholomopsis sulfureoides is one of the few yellow wood-decay species in northeastern North America, making it relatively easy to spot during mushroom forays.",
