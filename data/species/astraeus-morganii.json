  "nameStory": "",
  "description": "Astraeus morganii is a small, star-shaped fungus belonging to the Diplocystidaceae family, characterized by its distinctive geometric appearance and earthen coloration. This gasteromycete is found in New England forests where it plays a role in nutrient cycling within soil ecosystems.",
  "idTips": [
    {
      "label": "Star-shaped structure",
      "description": "The fruiting body splits into pointed, ray-like arms that resemble a star when viewed from above, distinguishing it from more rounded puffball relatives",
      "isPrimary": true
    },
    {
      "label": "Hygroscopic arms",
      "description": "The outer layer of the arms is sensitive to moisture, curling inward when dry and expanding when wet, creating a dynamic appearance that changes with weather",
      "isPrimary": false
    },
    {
      "label": "Inner spore mass",
      "description": "The interior contains a powdery brown or purplish spore mass that is dispersed when the mature fruiting body breaks apart",
      "isPrimary": false
    }
  ],
  "habitat": "Astraeus morganii typically grows in sandy or well-drained soils in deciduous and mixed forests throughout New England, often appearing in clusters during late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The star-shaped arms of Astraeus morganii can repeatedly open and close in response to moisture changes, allowing spore dispersal to be triggered multiple times over the fungus's fruiting period rather than all at once.",
