  "nameStory": "",
  "description": "False Yellowfoot (Chrysomphalina chrysophylla) is a small, delicate mushroom in the Waxcaps and Allies family characterized by its bright yellow coloring and waxy appearance. Despite its name suggesting similarity to true chanterelles, it is actually more closely related to the waxcap group and is distinguished by its unique gill structure and smaller stature.",
  "idTips": [
    {
      "label": "Bright Yellow Color",
      "description": "Distinctive golden-yellow to chrome-yellow caps and stems that are vibrant and eye-catching",
      "isPrimary": true
    },
    {
      "label": "Waxy Gills",
      "description": "Decurrent to subdecurrent gills that are thick, waxy, and typically the same yellow color as the cap",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Fruiting bodies are typically quite diminutive, with caps rarely exceeding 1-2 cm in diameter",
      "isPrimary": false
    }
  ],
  "habitat": "False Yellowfoot grows in mossy areas of damp forests, woodlands, and grassy areas throughout New England, preferring acidic soils rich in organic matter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its common name suggesting a relationship to the true Chanterelle (Cantharellus cibarius), the False Yellowfoot belongs to a completely different family and lacks the true chanterelle's characteristic false gills.",
