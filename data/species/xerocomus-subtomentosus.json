  "nameStory": "",
  "description": "The Suede Bolete (Xerocomelus subtomentosus) is a small to medium-sized bolete with a distinctive velvety or suede-like brown cap that readily bruises blue when handled. It features yellow pores that darken to olive-green with age and a pale, often yellowish stem.",
  "idTips": [
    {
      "label": "Suede-like Cap",
      "description": "The cap has a characteristic soft, velvety texture with a matte brown color, distinguishing it from smoother boletes",
      "isPrimary": true
    },
    {
      "label": "Bruising Reaction",
      "description": "Flesh and pores quickly turn bright blue when cut or pressed, a key identifying feature",
      "isPrimary": false
    },
    {
      "label": "Pore Color Progression",
      "description": "Yellow pores gradually change to olive-green or brownish tones as the mushroom matures",
      "isPrimary": false
    }
  ],
  "habitat": "Suede Boletes are commonly found in mixed hardwood and coniferous forests throughout New England, particularly in moist areas with rich soil and leaf litter during late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their striking blue bruising, Suede Boletes are edible when cooked thoroughly and are considered a good edible mushroom in Europe, though some foragers avoid them due to their fragile texture.",
