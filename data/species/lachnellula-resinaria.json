  "nameStory": "",
  "description": "Lachnellula resinaria is a small ascomycete fungus in the Lachnaceae family that forms delicate, cup-shaped fruiting bodies on coniferous wood and debris. This species is commonly found in the forests of New England where it plays an important ecological role in wood decomposition.",
  "idTips": [
    {
      "label": "Cup-shaped asci",
      "description": "Distinctive small, brownish or reddish cup-shaped fruiting bodies (apothecia) that are the primary reproductive structures",
      "isPrimary": true
    },
    {
      "label": "Hairy exterior",
      "description": "The outer surface of the cups is covered with hair-like structures (setae) that give it a fuzzy appearance",
      "isPrimary": false
    },
    {
      "label": "Resinous substrate preference",
      "description": "Typically found on coniferous wood, bark, and resinous materials, which is reflected in its scientific name",
      "isPrimary": false
    }
  ],
  "habitat": "Lachnellula resinaria thrives on decaying coniferous wood, branches, and debris in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is particularly attracted to resinous wood, and its name 'resinaria' reflects this preference, making it a helpful indicator species for studying decomposition in coniferous forests.",
