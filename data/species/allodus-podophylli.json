  "nameStory": "",
  "description": "Mayapple Rust (Allodus podophylli) is a fungal rust disease that specifically infects mayapple plants, causing distinctive pustules and discoloration on leaves and stems. This pathogen is an important indicator of mayapple health in New England ecosystems and primarily affects plants in moist woodland environments.",
  "idTips": [
    {
      "label": "Rust pustules on leaf undersides",
      "description": "Small, orange to reddish-brown pustules typically appear on the undersides of mayapple leaves, releasing spores when mature",
      "isPrimary": true
    },
    {
      "label": "Host specificity",
      "description": "This rust exclusively infects Podophyllum peltatum (American mayapple), making host identification crucial for diagnosis",
      "isPrimary": false
    },
    {
      "label": "Seasonal appearance",
      "description": "Rust symptoms typically become visible in mid to late summer as moisture increases and mayapple foliage matures",
      "isPrimary": false
    }
  ],
  "habitat": "Mayapple Rust thrives in the moist, shaded understory of deciduous and mixed forests throughout New England where its mayapple hosts grow in colonies.",
