  "nameStory": "",
  "description": "The Nimble Ceratina is a small, metallic green sweat bee native to New England and eastern North America. Despite their diminutive size, these bees are important pollinators of native plants and wildflowers throughout their range.",
  "idTips": [
    {
      "label": "Metallic Green Coloration",
      "description": "Brilliant metallic green body with a smooth, shiny appearance, distinguishing it from duller bee species",
      "isPrimary": true
    },
    {
      "label": "Tiny Size",
      "description": "One of the smallest bee species, typically 4-5mm in length, making it easy to overlook in the field",
      "isPrimary": false
    },
    {
      "label": "Hairless Appearance",
      "description": "Relatively sparse body hair compared to other bees, giving it a sleek, polished look",
      "isPrimary": false
    }
  ],
  "habitat": "Nimble Ceratinas thrive in open woodlands, gardens, and meadows with abundant flowering plants and dead wood for nesting.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike most bee species, Ceratina bees are communal nesters and bore tunnels into dead plant stems to create their nests, sometimes with multiple females sharing the same tunnel system.",
