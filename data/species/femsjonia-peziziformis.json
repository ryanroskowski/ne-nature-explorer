  "nameStory": "",
  "description": "Femsjonia peziziformis is a small, gelatinous fungus belonging to the Dacrymycetaceae family, characterized by its distinctive cup or disc-shaped fruiting bodies. This jelly fungus is a wood-decomposer that plays an important ecological role in forest ecosystems across New England.",
  "idTips": [
    {
      "label": "Cup-shaped fruiting bodies",
      "description": "Displays characteristic peziza-like (cup or disc) morphology that distinguishes it from other jelly fungi",
      "isPrimary": true
    },
    {
      "label": "Gelatinous texture",
      "description": "The fruiting body has a soft, translucent, gel-like consistency that is wet or moist in appearance",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "Typically measures just a few millimeters across, making it easy to overlook on dead wood",
      "isPrimary": false
    }
  ],
  "habitat": "Femsjonia peziziformis grows on decaying hardwood and woody debris in moist forests throughout New England, preferring areas with high humidity and shade.",
