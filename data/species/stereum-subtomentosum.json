  "nameStory": "",
  "description": "Yellowing curtain crust (Stereum subtomentosum) is a wood-decaying fungus characterized by its thin, shelf-like fruiting bodies with a distinctive yellowish to tan coloration. This species is a common saprotroph found throughout New England, playing an important ecological role in decomposing deadwood.",
  "idTips": [
    {
      "label": "Color and Texture",
      "description": "Upper surface is yellowish to tan with a velvety or finely hairy texture that often develops a darker appearance with age",
      "isPrimary": true
    },
    {
      "label": "Underside Surface",
      "description": "The fertile underside displays a smooth to slightly wrinkled hymenium that is pale yellow or cream-colored",
      "isPrimary": false
    },
    {
      "label": "Growth Pattern",
      "description": "Forms thin, bracket-like or curtain-like shelves that typically grow in overlapping clusters on dead hardwood logs and branches",
      "isPrimary": false
    }
  ],
  "habitat": "Yellowing curtain crust grows on dead hardwood, particularly on fallen logs and dead branches in forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many shelf fungi that become woody and hard, Stereum subtomentosum remains relatively soft and flexible when fresh, earning it the common name 'curtain crust' for its thin, draping appearance.",
