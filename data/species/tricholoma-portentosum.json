  "nameStory": "",
  "description": "Tricholoma portentosum, commonly known as Sticky Gray Trich, is a medium-sized mushroom characterized by its gray to brownish cap and distinctive sticky surface when wet. Found throughout New England, this fungus is a saprotroph that decomposes organic matter in forest ecosystems.",
  "idTips": [
    {
      "label": "Sticky Gray Cap",
      "description": "The cap is gray to brownish with a noticeably viscid (sticky) surface, particularly when moist, distinguishing it from related species.",
      "isPrimary": true
    },
    {
      "label": "White Gills",
      "description": "Gills are white to cream-colored and are adnexed (attached but not reaching the stem), with occasional shorter gills between longer ones.",
      "isPrimary": false
    },
    {
      "label": "Mild Odor and Taste",
      "description": "The mushroom has a pleasant, mild odor and slightly peppery taste when raw, though it should not be consumed raw.",
      "isPrimary": false
    }
  ],
  "habitat": "Sticky Gray Trich thrives in mixed coniferous and hardwood forests of New England, particularly near oak, pine, and birch trees during fall months from September through November.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its name, Tricholoma portentosum is considered edible in some European countries where it is traditionally foraged and cooked, though it is less commonly harvested in North America.",
