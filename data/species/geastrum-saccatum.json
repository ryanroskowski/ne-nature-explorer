  "nameStory": "",
  "description": "The rounded earthstar (Geastrum saccatum) is a small, distinctive fungus that begins as a rounded, puffball-like structure before its outer layer splits into pointed star-shaped rays. This terrestrial fungus belongs to the Geastraceae family and is commonly found throughout New England.",
  "idTips": [
    {
      "label": "Star-shaped appearance",
      "description": "The outer peridium (skin) splits into 4-8 pointed rays that curl back, creating a characteristic star shape around the central spore sac",
      "isPrimary": true
    },
    {
      "label": "Central pore opening",
      "description": "A small mouth or opening at the apex of the central spore sac releases spores when squeezed or moistened",
      "isPrimary": false
    },
    {
      "label": "Compact size",
      "description": "Typically small, rarely exceeding 1 inch in diameter, with a rounded central spore sac",
      "isPrimary": false
    }
  ],
  "habitat": "Rounded earthstars grow in rich, moist soil and leaf litter in woodlands, gardens, and disturbed areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The spore sacs of earthstars are hygroscopic, meaning they respond to moisture by opening their pores to release spores—this clever mechanism ensures spores disperse when conditions favor germination.",
