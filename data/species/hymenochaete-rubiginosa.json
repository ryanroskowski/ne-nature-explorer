  "nameStory": "",
  "description": "Oak Curtain Crust Fungus (Hymenochaete rubiginosa) is a wood-decay fungus that forms thin, crusty fruiting bodies on dead hardwood, particularly oak. This species is a saprotroph that plays an important role in nutrient cycling and decomposition in forest ecosystems.",
  "idTips": [
    {
      "label": "Rusty-brown coloration",
      "description": "The fruiting body displays a distinctive rusty-brown to reddish-brown color, which is reflected in its scientific name 'rubiginosa'",
      "isPrimary": true
    },
    {
      "label": "Thin crust form",
      "description": "Forms a thin, tightly adhered crusty layer on wood surfaces rather than a bracket or shelf-like structure",
      "isPrimary": false
    },
    {
      "label": "Smooth to finely textured underside",
      "description": "The hymenium (spore-bearing surface) underneath is typically smooth or finely poroid rather than gill-like",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus grows on dead or decaying hardwood, especially oak branches and logs, commonly found in forests and wooded areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Hymenochaete rubiginosa is one of the longest-lived fruit bodies in the fungal world, persisting on wood for multiple years and continuing to produce spores throughout this extended period.",
