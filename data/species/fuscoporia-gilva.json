  "nameStory": "",
  "description": "Mustard Yellow Polypore (Fuscoporia gilva) is a woody fungus in the Hymenochaetaceae family that forms shelf-like fruiting bodies on dead hardwood. This species is notable for its distinctive color and role as a wood decomposer in forest ecosystems.",
  "idTips": [
    {
      "label": "Color",
      "description": "Upper surface displays a characteristic mustard yellow to golden-brown hue, often with concentric zones",
      "isPrimary": true
    },
    {
      "label": "Pore surface",
      "description": "Underside features small, angular pores that are yellow to rust-colored and become darker with age or bruising",
      "isPrimary": false
    },
    {
      "label": "Texture and form",
      "description": "Develops as a hard, woody, shelf or bracket-like fruiting body that is difficult to break",
      "isPrimary": false
    }
  ],
  "habitat": "Fuscoporia gilva grows on dead and dying hardwood trees throughout New England forests, preferring oak and other deciduous species.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other polypores in the Hymenochaetaceae family, Mustard Yellow Polypore produces dark spores and can persist on wood for several years, slowly breaking down lignin and cellulose.",
