  "nameStory": "",
  "description": "Ganoderma lobatum is a woody bracket fungus in the Ganoderma genus, characterized by its lobed or wavy fruiting bodies that grow on decaying hardwood. Like other Ganoderma species, it is a wood-decay fungus that plays an important ecological role in decomposing dead trees in forest ecosystems.",
  "idTips": [
    {
      "label": "Lobed or Wavy Cap Edge",
      "description": "The fruiting body has a distinctly lobed or wavy margin, which distinguishes it from related Ganoderma species with smoother edges.",
      "isPrimary": true
    },
    {
      "label": "Reddish-Brown to Dark Coloring",
      "description": "The upper surface is typically reddish-brown, mahogany, or dark brown, often with a glossy or lacquered appearance.",
      "isPrimary": false
    },
    {
      "label": "Pore Surface",
      "description": "The underside has a fine pore surface (not gills) that may appear yellowish to brown and bruises darker when pressed.",
      "isPrimary": false
    }
  ],
  "habitat": "Ganoderma lobatum is found on dead or dying hardwoods in deciduous and mixed forests throughout New England, particularly on oak, maple, and other broadleaf trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Ganoderma species, G. lobatum produces bioactive compounds that have been studied for potential medicinal properties in traditional medicine practices.",
