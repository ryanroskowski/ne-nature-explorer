  "nameStory": "",
  "description": "Dufourea monardae, commonly known as the Beebalm Shortface, is a small sweat bee native to New England that specializes in collecting pollen exclusively from bee balm (Monarda) flowers. This oligolectic bee is perfectly adapted to its single host plant through morphological and behavioral specializations.",
  "idTips": [
    {
      "label": "Short Face Structure",
      "description": "Notably short mouthparts and facial proportions compared to other sweat bees, with a compact head suited for accessing bee balm flowers",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Measures approximately 5-7 mm in length, making it one of the smaller sweat bee species",
      "isPrimary": false
    },
    {
      "label": "Metallic Coloring",
      "description": "Exhibits a dark body with greenish or bluish metallic luster, typical of Dufourea genus members",
      "isPrimary": false
    }
  ],
  "habitat": "Beebalm Shortfaces are found in open woodlands, meadows, and gardens throughout New England where their host plant, bee balm, blooms during mid to late summer.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This bee is a specialist pollinator that feeds exclusively on bee balm flowers, demonstrating remarkable co-evolutionary adaptation where the bee's short face perfectly matches the flower's tubular structure.",
