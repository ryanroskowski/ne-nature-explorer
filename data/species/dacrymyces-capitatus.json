  "nameStory": "",
  "description": "Yellow Hat Jelly (Dacrymyces capitatus) is a gelatinous fungus characterized by its bright yellow, cup-shaped fruiting bodies that appear after rain or in moist conditions. This jelly fungus belongs to the Dacrymycetaceae family and is commonly found decomposing wood throughout New England.",
  "idTips": [
    {
      "label": "Bright Yellow Color",
      "description": "Distinctive bright to golden yellow fruiting bodies that stand out against wood and leaf litter",
      "isPrimary": true
    },
    {
      "label": "Gelatinous Texture",
      "description": "Soft, jelly-like consistency that becomes firmer when dry and revives when wet",
      "isPrimary": false
    },
    {
      "label": "Cup or Hat Shape",
      "description": "Small fruiting bodies, typically 2-8mm wide, with a characteristic cup or hat-like form",
      "isPrimary": false
    }
  ],
  "habitat": "Yellow Hat Jelly thrives on moist, decaying hardwood logs, branches, and woody debris throughout New England forests and woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its jelly-like appearance, Dacrymyces capitatus is not actually a true jelly fungus but belongs to the tremelloid fungi, which can rapidly absorb and release water, allowing it to survive dry periods by entering a dormant state.",
