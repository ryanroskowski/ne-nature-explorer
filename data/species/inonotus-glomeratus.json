  "nameStory": "",
  "description": "Inonotus glomeratus is a small, clustered polypore fungus in the Hymenochaetaceae family, characterized by its grouped fruiting bodies and rusty-brown coloration. It typically grows on hardwood substrates and is relatively inconspicuous compared to larger shelf fungi.",
  "idTips": [
    {
      "label": "Clustered Growth",
      "description": "Fruiting bodies grow in dense, overlapping clusters rather than as solitary individuals, which is highly distinctive for this species.",
      "isPrimary": true
    },
    {
      "label": "Pore Surface Color",
      "description": "The underside displays small, rusty-brown to orange-brown pores that are angular and often become darker with age.",
      "isPrimary": false
    },
    {
      "label": "Cap Texture",
      "description": "The upper surface is typically velvety or pubescent with a brownish hue and lacks the pronounced bumps or ridges seen in related species.",
      "isPrimary": false
    }
  ],
  "habitat": "Inonotus glomeratus is found on dead or dying hardwoods, particularly oak and other broad-leaved trees, throughout New England's deciduous and mixed forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Inonotus species, this fungus is a wood-decay specialist that produces brown rot, breaking down the cellulose and hemicellulose in wood while leaving the darker lignin relatively intact.",
  "confusionNotes": null,
