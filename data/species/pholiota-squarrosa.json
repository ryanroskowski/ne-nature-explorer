  "nameStory": "",
  "description": "Pholiota squarrosa, commonly known as shaggy scalycap, is a wood-decaying fungus characterized by its distinctive scaly, shaggy appearance on the cap and stem. This mushroom belongs to the Strophariaceae family and is commonly encountered throughout New England during fall months.",
  "idTips": [
    {
      "label": "Shaggy scales on cap and stem",
      "description": "The cap and upper stem are covered with prominent, upturned brown or yellowish scales that give the mushroom a distinctive shaggy appearance",
      "isPrimary": true
    },
    {
      "label": "Yellow color beneath scales",
      "description": "The base color underneath the scales is bright yellow to pale yellow, which becomes visible on the lower stem and in damaged areas",
      "isPrimary": false
    },
    {
      "label": "Dense crowded gills",
      "description": "The gills are closely spaced and typically yellow when young, darkening with age as spores mature",
      "isPrimary": false
    }
  ],
  "habitat": "Shaggy scalycap grows on dead wood, particularly on the stumps, logs, and base of hardwood trees in forests and wooded areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its somewhat appealing appearance, Pholiota squarrosa causes mild gastrointestinal upset if consumed and is considered inedible, making it an important mushroom to recognize and avoid.",
