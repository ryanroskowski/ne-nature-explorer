  "nameStory": "",
  "description": "Eutypella parasitica is a wood-decay fungus in the Diatrypaceae family that parasitizes dead or weakened branches of hardwood trees throughout New England. It plays an important ecological role as a decomposer, breaking down woody tissue and returning nutrients to forest ecosystems.",
  "idTips": [
    {
      "label": "Perithecia appearance",
      "description": "Look for small, dark flask-shaped fruiting bodies (perithecia) embedded in the wood or bark surface, often arranged in groups",
      "isPrimary": true
    },
    {
      "label": "Host material",
      "description": "Typically found on dead hardwood branches, logs, or stressed tree limbs rather than healthy living tissue",
      "isPrimary": false
    },
    {
      "label": "Spore color",
      "description": "Produces dark brown to black spores visible in the perithecial opening when examined closely",
      "isPrimary": false
    }
  ],
  "habitat": "Eutypella parasitica thrives on dead or declining hardwood branches in moist forest environments typical of New England woodlands and mixed deciduous forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its name suggesting parasitism, Eutypella parasitica primarily colonizes already-weakened or dead wood, functioning more as a saprotroph that helps recycle dead plant material in forest ecosystems.",
