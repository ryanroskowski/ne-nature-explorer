  "nameStory": "",
  "description": "Phellinus betulinus, commonly known as the birch polypore, is a woody fungus in the Hymenochaetaceae family that forms hard, shelf-like fruiting bodies on birch trees. This decomposer plays an important ecological role in breaking down dead birch wood and returning nutrients to forest ecosystems.",
  "idTips": [
    {
      "label": "Host tree specificity",
      "description": "Grows almost exclusively on birch trees (Betula species), making the host tree the primary clue to identification",
      "isPrimary": true
    },
    {
      "label": "Hoof-shaped fruiting bodies",
      "description": "Forms distinctive hard, grayish-brown, convex shelf-like structures that resemble a horse's hoof protruding from the tree trunk",
      "isPrimary": false
    },
    {
      "label": "Pore surface appearance",
      "description": "Displays tiny, rust-colored to cinnamon-brown pores on the underside that are not easily visible without magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Phellinus betulinus is found on dead or dying birch trees throughout New England's forests, preferring moist woodlands and forest edges where birch trees are common.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Indigenous peoples and traditional healers have used birch polypore for centuries to make medicinal teas believed to support immune function and treat various ailments.",
