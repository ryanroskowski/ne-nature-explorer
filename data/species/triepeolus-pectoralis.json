  "nameStory": "",
  "description": "The Goldenrod Longhorn-Cuckoo Bee (Triepeolus pectoralis) is a small parasitic bee in the family Apidae, found throughout New England during late summer and fall. Unlike most bees, this species is a cleptoparasite that lays its eggs in the nests of other bee species rather than collecting pollen itself.",
  "idTips": [
    {
      "label": "Body coloration",
      "description": "Golden-yellow hair on the thorax and abdomen with distinctive patterning",
      "isPrimary": true
    },
    {
      "label": "Lack of pollen baskets",
      "description": "Absence of specialized structures (corbiculae) for pollen collection on hind legs",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "Generally 8-10mm in length, making it noticeably smaller than most native bees",
      "isPrimary": false
    }
  ],
  "habitat": "This bee is found in open areas and gardens with abundant late-season flowers, particularly near goldenrod blooms where it searches for host bee nests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Rather than building its own nest, the Goldenrod Longhorn-Cuckoo Bee is a brood parasite that sneaks into nests of sweat bees and mining bees, laying eggs so its larvae can consume the host's food stores.",
