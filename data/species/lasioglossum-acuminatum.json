  "nameStory": "",
  "description": "The Pointed Sweat Bee is a small, metallic green native bee species belonging to the Halictidae family, commonly found throughout New England. These solitary bees are important pollinators that are attracted to human sweat, hence their common name.",
  "idTips": [
    {
      "label": "Metallic Coloration",
      "description": "Distinctive iridescent green to blue-green body with a shiny, metallic appearance",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Tiny bee measuring approximately 4-5 mm in length, making it one of the smallest bee species",
      "isPrimary": false
    },
    {
      "label": "Pointed Abdomen",
      "description": "Tapered, pointed rear end that gives the species its common name",
      "isPrimary": false
    }
  ],
  "habitat": "Pointed Sweat Bees thrive in open, sunny areas including gardens, meadows, and woodland edges throughout New England where flowering plants are abundant.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike honeybees, Pointed Sweat Bees are solitary insects that nest individually in small burrows in bare ground, and females will sometimes share nesting sites with other females in small communal groups.",
  "confusionNotes": null,
  "contextualKnowledge": null,
