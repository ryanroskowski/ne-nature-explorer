  "nameStory": "",
  "description": "Soapy Trich (Tricholoma saponaceum) is a medium-sized mushroom with a distinctive soapy or radish-like odor and grayish to brownish coloring. Found throughout New England, it is inedible and potentially toxic, making proper identification important for foragers.",
  "idTips": [
    {
      "label": "Soapy Odor",
      "description": "Characteristic strong soapy or chemical smell, sometimes compared to phenol or radish",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "Grayish-brown to olive-brown cap with white fibrils, often with darker streaks toward the center",
      "isPrimary": false
    },
    {
      "label": "White Gills",
      "description": "White to cream-colored gills that are free to slightly attached, crowded together",
      "isPrimary": false
    }
  ],
  "habitat": "Soapy Trich grows in coniferous and mixed forests throughout New England, appearing singly or in small groups from late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'saponaceum' comes from the Latin word for soap, referring to the mushroom's distinctive soapy smell that can be detected from several feet away.",
  "confusionNotes": null,
  "contextualKnowledge": null,
