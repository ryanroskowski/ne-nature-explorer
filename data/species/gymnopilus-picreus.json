  "nameStory": "",
  "description": "Bitter Rustgill (Gymnopilus picreus) is a small, rusty-colored mushroom belonging to the Hymenogastraceae family, characterized by its distinctive bitter taste and gilled undersurface. Found throughout New England, it is a wood-decay fungus that typically appears in clusters on decaying logs and wood debris.",
  "idTips": [
    {
      "label": "Rusty-Orange Coloring",
      "description": "The cap and gills display a distinctive rusty-orange to rust-brown hue, which is the source of its common name.",
      "isPrimary": true
    },
    {
      "label": "Bitter Taste",
      "description": "The flesh has an intensely bitter taste (spit it out immediately if tasting), which is a reliable field characteristic.",
      "isPrimary": true
    },
    {
      "label": "Gilled Structure",
      "description": "Gills are attached to the stem, rusty-colored, and crowded closely together, distinguishing it from similar-looking species.",
      "isPrimary": false
    }
  ],
  "habitat": "Gymnopilus picreus grows on decaying hardwood logs, stumps, and wood chips in forests throughout New England, often appearing in small clusters during late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its bitter taste making it inedible, Bitter Rustgill plays an important ecological role as a decomposer, breaking down dead wood and returning nutrients to the forest ecosystem.",
  "confusionNotes": null,
