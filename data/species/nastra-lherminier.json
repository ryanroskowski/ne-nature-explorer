  "nameStory": "",
  "description": "The Swarthy Skipper is a small butterfly belonging to the Hesperiidae family, characterized by its dark coloring and rapid, darting flight pattern. Native to the eastern United States, this skipper is a common but often overlooked resident of New England's open woodlands and grasslands.",
  "idTips": [
    {
      "label": "Dark coloration",
      "description": "Uniformly dark brown to blackish wings with minimal markings distinguish this species from lighter skippers",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Wing span of approximately 0.9-1.1 inches makes it one of the smaller skipper species",
      "isPrimary": false
    },
    {
      "label": "Hooked antennae",
      "description": "Characteristic clubbed antennae with a prominent hook at the tip, typical of skipper butterflies",
      "isPrimary": false
    }
  ],
  "habitat": "The Swarthy Skipper inhabits open woodlands, forest edges, and disturbed areas with low grasses and sedges that serve as larval host plants.",
