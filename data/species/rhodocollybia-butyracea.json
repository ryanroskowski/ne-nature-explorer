  "nameStory": "",
  "description": "Buttery Collybia (Rhodocollybia butyracea) is a small woodland mushroom characterized by its delicate, waxy appearance and buttery coloration. This common fungus belongs to the Omphalotaceae family and is frequently encountered in New England forests throughout the growing season.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Pale brown to grayish-brown cap with a distinctive waxy or greasy sheen, often appearing moist or buttery even when dry",
      "isPrimary": true
    },
    {
      "label": "Stalk Structure",
      "description": "Thin, hollow, pale stalk that is often twisted or flattened, becoming darker toward the base",
      "isPrimary": false
    },
    {
      "label": "Gills and Size",
      "description": "Small mushroom (1-2 inches tall) with crowded, pale pink or whitish gills that are broadly attached to the stem",
      "isPrimary": false
    }
  ],
  "habitat": "Buttery Collybia grows in clusters on decaying wood, leaf litter, and humus-rich soil in mixed hardwood and coniferous forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'butyracea' refers to the mushroom's characteristic buttery or greasy appearance, which persists even in dry conditions due to a special waxy coating on its cap.",
