  "nameStory": "",
  "description": "Datroniella scutellata is a small, shelf-like bracket fungus belonging to the polypore family, characterized by its diminutive fruiting bodies and delicate structure. This species is commonly found decomposing hardwood substrates throughout New England forests.",
  "idTips": [
    {
      "label": "Tiny Shelf Appearance",
      "description": "Produces very small, bracket-shaped fruiting bodies typically less than 1 cm wide, appearing almost scale-like on wood surfaces",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "Features small, angular pores on the underside that are whitish to pale cream-colored and minute in size",
      "isPrimary": false
    },
    {
      "label": "Wood Substrate",
      "description": "Grows exclusively on hardwood, particularly on fallen logs, branches, and dead wood in moist forest conditions",
      "isPrimary": false
    }
  ],
  "habitat": "Datroniella scutellata thrives on decomposing hardwood in damp, shaded forest environments typical of New England woodlands.",
