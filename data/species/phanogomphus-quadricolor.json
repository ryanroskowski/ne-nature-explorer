  "nameStory": "",
  "description": "The Rapids Clubtail (Phanogomphus quadricolor) is a dragonfly species in the Clubtail family characterized by its robust body and distinctive markings. It is found in fast-flowing streams and rivers throughout New England.",
  "idTips": [
    {
      "label": "Club-shaped Abdomen",
      "description": "The abdomen widens noticeably toward the tip, creating the characteristic 'club' shape that gives the family its name.",
      "isPrimary": true
    },
    {
      "label": "Yellow Striping",
      "description": "Bright yellow or greenish-yellow stripes run along the sides of the black or dark brown body and legs.",
      "isPrimary": false
    },
    {
      "label": "Large Eyes",
      "description": "Prominent compound eyes that are typically green or yellowish-green, positioned on the sides of the head.",
      "isPrimary": false
    }
  ],
  "habitat": "Rapids Clubtails inhabit clear, fast-flowing streams and rivers with rocky substrates and good water quality, where nymphs develop in well-oxygenated waters.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Rapids Clubtails are highly territorial and perch on rocks or vegetation near rapids, darting out to intercept passing females or chase away rival males during the breeding season.",
