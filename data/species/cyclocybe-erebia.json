  "nameStory": "",
  "description": "The Dark Fieldcap (Cyclocybe erebia) is a small, delicate mushroom belonging to the Tubariaceae family, characterized by its dark brown to blackish coloring. This species is commonly found in New England and prefers moist, shaded environments.",
  "idTips": [
    {
      "label": "Dark Brown to Black Caps",
      "description": "The mushroom features distinctly dark brown or nearly black pilei (caps) that are typically 1-3 cm in diameter, which gives the species its common name.",
      "isPrimary": true
    },
    {
      "label": "Attached Gills",
      "description": "The gills are adnate (attached directly to the stem) and range from pale brown to darker brown as they mature, creating a distinctive gill pattern.",
      "isPrimary": false
    },
    {
      "label": "Thin Stem Structure",
      "description": "The stipe (stem) is thin, delicate, and typically dark brown, often matching the cap color and lacking a prominent ring or volva.",
      "isPrimary": false
    }
  ],
  "habitat": "Dark Fieldcap thrives in moist, shaded woodlands and forest floors of New England, often appearing in groups on rich soil, leaf litter, and decomposing organic matter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their small and inconspicuous appearance, Dark Fieldcaps play an important ecological role as decomposers, breaking down dead plant material and returning nutrients to the forest soil.",
