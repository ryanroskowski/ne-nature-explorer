  "nameStory": "",
  "description": "Tatraea macrospora is a small ascomycete fungus belonging to the Helotiaceae family, characterized by its distinctive large spores and cup-shaped fruiting bodies. This species is found in New England, where it plays a role in wood decomposition and nutrient cycling in forest ecosystems.",
  "idTips": [
    {
      "label": "Large Spores",
      "description": "The species name 'macrospora' refers to its notably large spores, which are a key diagnostic feature when viewed under a microscope",
      "isPrimary": true
    },
    {
      "label": "Cup-shaped Ascomata",
      "description": "The fruiting bodies form small, delicate cup or disc-like structures typical of the Helotiaceae family",
      "isPrimary": false
    },
    {
      "label": "Substrate Association",
      "description": "Typically found fruiting on decaying wood and plant debris, which helps distinguish it from related species",
      "isPrimary": false
    }
  ],
  "habitat": "Tatraea macrospora occurs in moist, wooded areas of New England where it decomposes dead wood and leaf litter on the forest floor.",
