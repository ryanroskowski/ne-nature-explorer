  "nameStory": "",
  "description": "The Speckled Bush-cricket is a small, green katydid native to Europe that has become established in parts of New England. Despite its name, it is actually an insect in the Katydidae family, not a true cricket, and is known for its distinctive speckled appearance and acoustic behavior.",
  "idTips": [
    {
      "label": "Speckled Pattern",
      "description": "Dark speckles or spots covering the body and wing surfaces distinguish this species from solid-colored katydids",
      "isPrimary": true
    },
    {
      "label": "Size and Color",
      "description": "Small, bright green body typically 12-15 mm long with a compact, robust shape",
      "isPrimary": false
    },
    {
      "label": "Wing Structure",
      "description": "Wings are shorter than the body (brachypterous), covering only part of the abdomen",
      "isPrimary": false
    }
  ],
  "habitat": "Speckled Bush-crickets inhabit dense shrubs, tall grasses, and weedy areas in open to partially shaded environments across New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Males produce loud, persistent chirping sounds by rubbing their wings together, often calling throughout the night during late summer and fall to attract females.",
