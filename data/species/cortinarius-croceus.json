  "nameStory": "",
  "description": "Cortinarius croceus, commonly known as the Saffron Webcap, is a small to medium-sized mushroom characterized by its distinctive golden-yellow to saffron coloring throughout the fruiting body. This fungus belongs to the Cortinariaceae family and is found in coniferous and mixed forests across New England.",
  "idTips": [
    {
      "label": "Bright Saffron Color",
      "description": "The entire mushroom displays a vibrant golden-yellow to saffron hue on both the cap and stem, which is the most distinctive feature.",
      "isPrimary": true
    },
    {
      "label": "Cortina (Cobweb-like Veil)",
      "description": "A delicate, gossamer-like partial veil (cortina) connects the stem to the cap margin in young specimens, characteristic of the Cortinarius genus.",
      "isPrimary": false
    },
    {
      "label": "Rusty Spore Print",
      "description": "The mushroom produces a rust-brown to cinnamon spore print, which helps differentiate it from other yellow species.",
      "isPrimary": false
    }
  ],
  "habitat": "Saffron Webcaps typically fruit in the damp soil and moss of coniferous forests, particularly under spruce and fir trees, from late summer through fall in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus Cortinarius is one of the largest fungal genera in the Northern Hemisphere, with over 2,000 described species, though many—including C. croceus—remain poorly understood in terms of their ecological roles.",
  "confusionNotes": null,
  "contextualKnowledge": null,
