  "nameStory": "",
  "description": "The Mesilla Masked Bee (Hylaeus mesillae) is a small solitary bee belonging to the Colletidae family, commonly known as plasterer bees due to their use of plant resins and oils to line their nesting tunnels. This species is found in New England and plays an important role as a pollinator of native plants.",
  "idTips": [
    {
      "label": "Facial Markings",
      "description": "Distinctive white or pale yellow markings on the face, giving this species its 'masked' common name",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Tiny bee measuring approximately 4-5mm in length, making it one of the smallest bee species",
      "isPrimary": false
    },
    {
      "label": "Dark Body",
      "description": "Predominantly black body with minimal body hair compared to other bee families",
      "isPrimary": false
    }
  ],
  "habitat": "Mesilla Masked Bees prefer open woodlands, gardens, and meadows with abundant flowering plants and available nesting sites in plant stems or dead wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "These bees are excellent solo architects—females construct individual nest cells lined with a cellophane-like secretion, creating waterproof chambers where they lay their eggs alongside pollen and nectar provisions.",
