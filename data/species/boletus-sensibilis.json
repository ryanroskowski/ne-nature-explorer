  "nameStory": "",
  "description": "The Curry Bolete (Boletus sensibilis) is a medium-sized bolete mushroom characterized by its distinctive curry-like aroma, which is its most recognizable feature. Found throughout New England, it is inedible and should not be consumed due to its unpleasant smell and taste.",
  "idTips": [
    {
      "label": "Curry Aroma",
      "description": "Emits a strong, unmistakable curry or celery-like smell, especially when bruised or crushed",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "Brown to olive-brown cap, often with a pale margin and can develop reddish tones with age",
      "isPrimary": false
    },
    {
      "label": "Pore Surface",
      "description": "Yellow pores that may turn blue-green when bruised, with a decurrent or slightly decurrent arrangement",
      "isPrimary": false
    }
  ],
  "habitat": "The Curry Bolete grows on the forest floor in mixed hardwood and coniferous forests throughout New England, typically appearing in summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The distinctive curry smell that gives this bolete its common name is so strong and persistent that even a small piece can heavily scent a mushroom collection or foraging basket.",
  "confusionNotes": null,
