  "nameStory": "",
  "description": "The Delicate Emerald is a small to medium-sized dragonfly characterized by its brilliant emerald green coloration and slender body. This species is relatively uncommon in New England and is typically found near specific freshwater habitats during summer months.",
  "idTips": [
    {
      "label": "Emerald Green Coloration",
      "description": "Distinctive bright metallic green body that gives the species its common name",
      "isPrimary": true
    },
    {
      "label": "Slender Abdomen",
      "description": "Noticeably thin and elongated abdomen compared to other dragonfly species",
      "isPrimary": false
    },
    {
      "label": "Large Compound Eyes",
      "description": "Prominent eyes that meet on top of the head, typical of emerald dragonflies",
      "isPrimary": false
    }
  ],
  "habitat": "The Delicate Emerald prefers cool, clear streams and small ponds with abundant vegetation in forested or semi-forested areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their delicate appearance, Delicate Emeralds are skilled aerial hunters that can hover in place and dart rapidly to catch small flying insects with impressive precision.",
