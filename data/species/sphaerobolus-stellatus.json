  "nameStory": "",
  "description": "Sphaerobolus stellatus, commonly known as cannonball fungus, is a small puffball-like fungus that explosively ejects spore packets when mature. This remarkable fungus belongs to the Geastraceae family and is found throughout New England in moist, decaying wood habitats.",
  "idTips": [
    {
      "label": "Explosive spore dispersal",
      "description": "The mature fruiting body forcefully launches a dark, spherical spore packet (peridiole) several meters away when disturbed or when conditions trigger release",
      "isPrimary": true
    },
    {
      "label": "Starred outer cup",
      "description": "The outer peridium splits into 5-8 pointed star-like segments that curve backward, resembling an open flower",
      "isPrimary": false
    },
    {
      "label": "Tiny fruiting bodies",
      "description": "Very small fungal bodies, typically 5-10mm in diameter, with a whitish to pale brown color",
      "isPrimary": false
    }
  ],
  "habitat": "Cannonball fungus grows on decaying wood, wood chips, and mulch in moist environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus can launch its spore packets up to 6 meters away with impressive force, making it one of nature's most efficient ballistic seed dispersers relative to its size.",
