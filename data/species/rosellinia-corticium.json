  "nameStory": "",
  "description": "Rosellinia corticium is a fungal species in the Xylariaceae family that forms dark, stromatic structures on dead wood and bark. This ascomycete plays an important ecological role as a wood decomposer in New England forests.",
  "idTips": [
    {
      "label": "Dark stromata",
      "description": "Forms black or dark brown, crusty or corky surface structures on decaying wood",
      "isPrimary": true
    },
    {
      "label": "Perithecia arrangement",
      "description": "Contains numerous small flask-shaped perithecia (fruiting bodies) embedded in the stroma",
      "isPrimary": false
    },
    {
      "label": "Host substrate",
      "description": "Typically found on dead hardwood branches and bark rather than herbaceous material",
      "isPrimary": false
    }
  ],
  "habitat": "Rosellinia corticium inhabits decaying hardwood logs, fallen branches, and dead bark in moist woodlands and forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a saprotroph, Rosellinia corticium helps break down dead wood and recycle nutrients back into forest ecosystems, making it an essential member of the decomposer community.",
