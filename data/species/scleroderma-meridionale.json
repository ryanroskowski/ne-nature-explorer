  "nameStory": "",
  "description": "Scleroderma meridionale is a small, earthball fungus belonging to the Sclerodermataceae family, characterized by its hard, round fruiting bodies that contain a dark spore mass. Found in New England forests, this species is part of a diverse genus of gasteromycetes that release spores through an apical opening.",
  "idTips": [
    {
      "label": "Hard, rounded fruiting body",
      "description": "Produces small, firm, ball-shaped structures (peridium) that are woody and difficult to break apart",
      "isPrimary": true
    },
    {
      "label": "Spore mass color",
      "description": "Interior contains dark brown to black gleba (spore mass) that becomes powdery when mature",
      "isPrimary": false
    },
    {
      "label": "Apical opening",
      "description": "Distinctive pore at the top of the fruiting body through which spores are dispersed",
      "isPrimary": false
    }
  ],
  "habitat": "Scleroderma meridionale grows in sandy or well-drained soils of New England deciduous and mixed forests, often found near or attached to tree roots.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Earthballs like S. meridionale were historically mistaken for truffles but are toxic and inedible, distinguishing them from their more prized fungal relatives.",
