  "nameStory": "",
  "description": "Xylaria flabelliformis, commonly known as the fan-shaped candlestick fungus, is a wood-decomposing fungus in the Xylariaceae family that produces distinctive fan or club-shaped fruiting bodies. This species plays an important ecological role in breaking down dead wood in forest ecosystems throughout New England.",
  "idTips": [
    {
      "label": "Fan-shaped fruiting bodies",
      "description": "Produces flattened, fan or spatula-like black fruiting bodies that are diagnostic of this species",
      "isPrimary": true
    },
    {
      "label": "Surface texture",
      "description": "Features a characteristic granular or bumpy surface with visible perithecia (spore-producing structures) dotting the dark fruiting body",
      "isPrimary": false
    },
    {
      "label": "Growth substrate",
      "description": "Grows exclusively on decaying hardwood logs and branches, particularly in moist forest conditions",
      "isPrimary": false
    }
  ],
  "habitat": "Xylaria flabelliformis thrives on dead hardwood logs and decaying branches in moist, shaded forests throughout New England, preferring areas with high humidity and adequate moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite appearing lifeless and coal-like, Xylaria flabelliformis fruiting bodies contain millions of spores and can remain viable and reproductive for several years, making them persistent decomposers on forest floors.",
