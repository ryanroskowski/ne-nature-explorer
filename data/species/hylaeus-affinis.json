  "nameStory": "",
  "description": "Hylaeus affinis is a small solitary bee belonging to the plasterer bee family (Colletidae), native to New England and northeastern North America. These delicate bees are named for their use of plant resins and saliva to construct smooth, cellophane-like nest linings in cavities.",
  "idTips": [
    {
      "label": "Small Size",
      "description": "Typically 4-6 mm in length, making it one of the smallest bee species in North America",
      "isPrimary": false
    },
    {
      "label": "Yellow Facial Markings",
      "description": "Males display distinctive yellow or pale markings on the face and body; females are mostly black with minimal markings",
      "isPrimary": true
    },
    {
      "label": "Smooth Appearance",
      "description": "Lacks the dense hair covering found on many bee species, giving it a sleek, almost polished appearance",
      "isPrimary": false
    }
  ],
  "habitat": "Hylaeus affinis inhabits gardens, meadows, and woodland edges throughout New England, preferring areas with diverse flowering plants and suitable nesting cavities in dead stems or beetle tunnels.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike most bees that carry pollen in specialized leg structures, Hylaeus affinis swallows pollen and regurgitates it at the nest, making it an efficient pollinator for small flowers.",
