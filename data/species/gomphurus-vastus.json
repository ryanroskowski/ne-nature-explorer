  "nameStory": "",
  "description": "The Cobra Clubtail is a medium-sized dragonfly belonging to the Clubtails family, characterized by its distinctive clubbed abdomen and robust build. Found throughout New England, it is an important aquatic predator during both its aquatic nymph and aerial adult stages.",
  "idTips": [
    {
      "label": "Clubbed Abdomen",
      "description": "The abdomen noticeably widens toward the tip, creating a club-like shape that is the defining feature of the Clubtails family.",
      "isPrimary": true
    },
    {
      "label": "Body Coloration",
      "description": "Adults display a dark brown or blackish body with pale yellow or green markings on the thorax and abdomen.",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Medium-sized dragonfly, typically measuring 1.5 to 2 inches in length.",
      "isPrimary": false
    }
  ],
  "habitat": "The Cobra Clubtail inhabits clean, fast-flowing streams and rivers with rocky substrates, where aquatic vegetation and leaf litter provide shelter for developing nymphs.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Cobra Clubtails are highly territorial and perform dramatic aerial displays over water to defend their breeding grounds from rival males.",
