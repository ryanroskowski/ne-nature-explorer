  "nameStory": "",
  "description": "Violet pinkgill is a small woodland mushroom characterized by its distinctive violet to lavender coloring on the cap and stem. It belongs to the Entolomataceae family, known for their pink spore prints, which develop as the mushroom matures.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Violet to lavender cap that may fade with age, typically small (1-3 cm) and convex",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Pink or salmon-colored gills that develop as spores mature, running from adnate to adnexed",
      "isPrimary": false
    },
    {
      "label": "Stem Appearance",
      "description": "Slender, violet-tinged stem that is relatively fragile and may have a fibrous texture",
      "isPrimary": false
    }
  ],
  "habitat": "Violet pinkgill is typically found on the forest floor among mosses, leaf litter, and decaying wood in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all Entoloma species, violet pinkgill produces a distinctive pink spore print, making it relatively easy to confirm identification once the mushroom has matured sufficiently.",
  "confusionNotes": null,
  "contextualKnowledge": null,
