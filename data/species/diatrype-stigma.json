  "nameStory": "",
  "description": "Diatrype stigma, commonly known as tar spot or common tarcrust fungus, is a wood-decaying fungus in the Diatrypaceae family that forms dark, crusty fruiting bodies on dead hardwood branches and logs. This fungus is a saprotroph that plays an important ecological role in decomposing woody debris in forests.",
  "idTips": [
    {
      "label": "Dark crusty fruiting bodies",
      "description": "Look for small, black, tarry or crusty spots and streaks on the surface of dead wood, often appearing slightly raised or pustular",
      "isPrimary": true
    },
    {
      "label": "White interior tissue",
      "description": "When scraped or cut, the fruiting bodies reveal white or cream-colored tissue beneath the dark exterior crust",
      "isPrimary": false
    },
    {
      "label": "Preferred wood type",
      "description": "Most commonly found on dead or dying hardwood branches, particularly oak, ash, and beech in New England",
      "isPrimary": false
    }
  ],
  "habitat": "Diatrype stigma thrives on dead or dying hardwood branches and logs in woodlands and forests throughout New England, preferring areas with adequate moisture and shade.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its dark, crusty appearance, Diatrype stigma is harmless to humans and actually helps recycle nutrients back into forest ecosystems by breaking down dead wood.",
