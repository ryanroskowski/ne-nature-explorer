  "nameStory": "",
  "description": "Podosphaera septentrionalis is a fungal pathogen belonging to the powdery mildew family that primarily affects members of the Rosaceae family, including hawthorns and related plants. This obligate parasite is common in New England and creates characteristic white, powdery coatings on host plant leaves and stems.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish fungal growth on leaves, stems, and flowers that can be easily wiped off",
      "isPrimary": true
    },
    {
      "label": "Host Plant Association",
      "description": "Commonly found on hawthorns, serviceberries, and other Rosaceae family members in the region",
      "isPrimary": false
    },
    {
      "label": "Microscopic Features",
      "description": "Produces specialized spore structures called conidia and develops dark overwintering structures (chasmothecia) on infected tissue",
      "isPrimary": false
    }
  ],
  "habitat": "Podosphaera septentrionalis thrives in cool to moderate temperatures and moderate humidity conditions typical of New England woodlands, gardens, and ornamental plantings where susceptible host plants grow.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many fungi, powdery mildews like P. septentrionalis prefer dry conditions and can actually be inhibited by water, making them unusual among plant pathogens.",
