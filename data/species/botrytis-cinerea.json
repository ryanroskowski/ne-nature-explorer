  "nameStory": "",
  "description": "Grey mould (Botrytis cinerea) is a fungal pathogen belonging to the Sclerotiniaceae family that causes significant crop damage across New England. It infects a wide range of plants including berries, grapes, vegetables, and ornamentals, thriving in cool, humid conditions.",
  "idTips": [
    {
      "label": "Grey Fuzzy Growth",
      "description": "Affected areas develop a distinctive grey or brown fuzzy mycelial growth that resembles dust or mold",
      "isPrimary": true
    },
    {
      "label": "Soft Tissue Rot",
      "description": "Infected plant tissues become soft, watery, and collapse, often spreading rapidly under wet conditions",
      "isPrimary": false
    },
    {
      "label": "Black Sclerotia",
      "description": "Hard, black resting structures (sclerotia) may develop within or on infected tissues during advanced infection",
      "isPrimary": false
    }
  ],
  "habitat": "Botrytis cinerea thrives in cool, damp environments with high humidity (85-95%) and moderate temperatures (60-70°F), making New England's spring and fall seasons particularly favorable for infection.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Botrytis cinerea is also known as 'noble rot' when it infects wine grapes under specific conditions, concentrating sugars and producing prized dessert wines like Sauternes, despite being destructive to most crops.",
