  "nameStory": "",
  "description": "Agrocybe acericola is a small brown mushroom in the Hymenogastraceae family, characterized by its modest fruiting bodies and association with decaying wood substrates. It is found in New England and other temperate regions of North America.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Brown to tan caps with a smooth to slightly fibrillose surface, typically 1-3 cm in diameter",
      "isPrimary": true
    },
    {
      "label": "Gills and Spore Print",
      "description": "Crowded, pale gills that darken with age, producing a brown spore print",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Slender, hollow or chambered stems with a fragile texture and fibrillose covering",
      "isPrimary": false
    }
  ],
  "habitat": "Agrocybe acericola typically fruits on decaying hardwood logs and woody debris in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'acericola' refers to its association with maple (Acer) wood, though it may also be found on other hardwood substrates in the region.",
