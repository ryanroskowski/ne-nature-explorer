  "nameStory": "",
  "description": "Arachnopeziza trabinelloides is a small cup fungus belonging to the Arachnopezizaceae family, characterized by its delicate, spider-like appearance. This species is commonly found decomposing woody substrates in the moist forests of New England.",
  "idTips": [
    {
      "label": "Cup-shaped fruiting bodies",
      "description": "Distinctive small, open cups or saucers with a pale to whitish color and hair-like setae covering the exterior surface",
      "isPrimary": true
    },
    {
      "label": "Hairy exterior",
      "description": "The outer surface is covered with fine, spider-like hairs (setae) that give the fungus its characteristic appearance",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Found fruiting on decaying wood, bark, or leaf litter in moist conditions",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives in cool, moist forests of New England, where it decomposes fallen branches, rotting wood, and woody debris on the forest floor.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name 'Arachnopeziza' literally means 'spider cup' in reference to the fine, hair-like structures that resemble spider legs covering the fungal cup.",
