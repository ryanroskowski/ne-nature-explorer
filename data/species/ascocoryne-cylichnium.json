  "nameStory": "",
  "description": "Ascocoryne cylichnium is a small, gelatinous fungus belonging to the Gelatinodiscaceae family, characterized by its cup-shaped fruiting bodies that appear on decaying wood. This species is commonly found throughout New England and plays an important role in wood decomposition in forest ecosystems.",
  "idTips": [
    {
      "label": "Cup-shaped fruiting bodies",
      "description": "Distinctive disc or cup-like apothecia that are typically dark red to purple in color and have a gelatinous texture",
      "isPrimary": true
    },
    {
      "label": "Size and texture",
      "description": "Fruiting bodies are small (2-5 mm diameter) and appear translucent and jelly-like when moist, becoming more wrinkled when dry",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Found exclusively on decaying hardwood, especially on moist, shaded logs and fallen branches",
      "isPrimary": false
    }
  ],
  "habitat": "Ascocoryne cylichnium thrives on moist, decaying hardwood in shaded forest environments throughout New England, particularly in areas with high humidity and adequate moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate, gelatinous appearance, this fungus is a wood-decay specialist that produces powerful enzymes capable of breaking down lignin and cellulose in dead wood.",
