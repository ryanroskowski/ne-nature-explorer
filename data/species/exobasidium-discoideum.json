  "nameStory": "",
  "description": "Exobasidium discoideum is a basidiomycete fungus in the Exobasidiaceae family that parasitizes plants in the Ericaceae family, particularly blueberries and related species in New England. It causes distinctive gall-like growths and leaf deformations on its host plants.",
  "idTips": [
    {
      "label": "Disc-shaped fruiting bodies",
      "description": "The fungus produces characteristic flat, disc-shaped or cushion-like structures on infected plant tissues, which is reflected in its species name 'discoideum'",
      "isPrimary": true
    },
    {
      "label": "Host plant association",
      "description": "It primarily infects members of the heath family (Ericaceae), especially blueberry and huckleberry species in New England woodlands",
      "isPrimary": false
    },
    {
      "label": "Pale coloration",
      "description": "The fruiting structures typically appear whitish to pale pink or tan, contrasting with the green healthy plant tissue",
      "isPrimary": false
    }
  ],
  "habitat": "Found in acidic woodlands and shrublands of New England where wild blueberries and huckleberries grow, thriving in moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Exobasidium species, this fungus is a biotrophic parasite that doesn't kill its host but instead manipulates plant growth to create elaborate gall structures that serve as spore-producing surfaces.",
