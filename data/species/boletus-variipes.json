  "nameStory": "",
  "description": "Boletus variipes is a medium-sized bolete with a brown cap and yellow pores that bruise blue when handled. It is found throughout New England and is considered edible by some mushroom foragers, though it should be properly identified before consumption.",
  "idTips": [
    {
      "label": "Variable stem coloration",
      "description": "The stem is distinctively colored with red or reddish tones near the base, fading to yellow higher up, giving the species its name 'variipes' (variable foot).",
      "isPrimary": true
    },
    {
      "label": "Blue bruising",
      "description": "The flesh and yellow pores quickly turn blue when cut or pressed, a key characteristic of many choice boletes.",
      "isPrimary": false
    },
    {
      "label": "Cap and pores",
      "description": "The cap is brown and typically 2-5 inches wide, with small yellow pores underneath that are smaller and more densely packed than in related species.",
      "isPrimary": false
    }
  ],
  "habitat": "Boletus variipes grows in mixed deciduous and coniferous forests throughout New England, often fruiting in summer and fall near oak, birch, and pine trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The blue bruising reaction occurs because the fungus contains compounds that oxidize when exposed to air, creating a natural chemical defense mechanism against insects.",
  "confusionNotes": null,
