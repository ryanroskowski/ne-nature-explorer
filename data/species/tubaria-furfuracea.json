  "nameStory": "",
  "description": "Tubaria furfuracea, commonly known as the scurfy twiglet, is a small brown mushroom belonging to the Tubariaceae family. It is characterized by its delicate appearance and fine, powdery surface texture.",
  "idTips": [
    {
      "label": "Powdery Cap Surface",
      "description": "The cap has a distinctive scurfy (fine, powdery or flaky) texture that gives the mushroom its common name",
      "isPrimary": true
    },
    {
      "label": "Small Size and Brown Color",
      "description": "Typically small mushrooms (5-15mm cap diameter) with brown to reddish-brown coloring on both cap and stem",
      "isPrimary": false
    },
    {
      "label": "Pale Gills",
      "description": "Gills are pale yellow to tan and decurrent (running down the stem), with unequal lengths",
      "isPrimary": false
    }
  ],
  "habitat": "Found throughout New England on decaying wood, leaf litter, and mossy substrates in moist woodlands and forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its tiny size, Tubaria furfuracea is one of the most commonly encountered small brown mushrooms in temperate forests and can fruit year-round under suitable conditions.",
