  "nameStory": "",
  "description": "Coriolopsis trogii is a small bracket fungus in the polypore family, characterized by its thin, delicate fruiting bodies that grow on decaying hardwood. This species is part of a diverse group of wood-decomposing fungi that play a crucial ecological role in forest nutrient cycling throughout New England.",
  "idTips": [
    {
      "label": "Pore surface",
      "description": "The underside features very small, angular pores that are typically white to cream-colored, becoming slightly yellowed with age",
      "isPrimary": true
    },
    {
      "label": "Cap appearance",
      "description": "Thin, fan-shaped or shelf-like fruiting bodies with a finely velvety or woolly texture on the upper surface, usually gray to tan in color",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Grows exclusively on hardwood species, typically forming small, overlapping brackets or shelves on rotting logs and branches",
      "isPrimary": false
    }
  ],
  "habitat": "Coriolopsis trogii thrives on dead hardwood logs, branches, and stumps in mixed and deciduous forests throughout New England, preferring moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other polypores, Coriolopsis trogii produces enzymes that break down lignin in wood, making it an essential decomposer that helps return nutrients to the forest soil and sustains the entire woodland ecosystem.",
