  "nameStory": "",
  "description": "Shiitake (Lentinula edodes) is a prized edible mushroom native to East Asia that has become widely cultivated and naturalized in New England. This fungus is characterized by its distinctive dark brown cap and white gills, making it a highly sought-after culinary and medicinal species.",
  "idTips": [
    {
      "label": "Cap and Gill Appearance",
      "description": "Dark brown to black umbrella-shaped cap (2-4 inches) with white to cream-colored gills that are attached to the stem",
      "isPrimary": true
    },
    {
      "label": "Stem Features",
      "description": "Fibrous white stem with a ring-like zone or remnants of a partial veil; stem is solid and doesn't separate easily from the cap",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Found growing in clusters or singly on hardwood logs (especially oak, chestnut, and maple), rarely on living trees",
      "isPrimary": false
    }
  ],
  "habitat": "Shiitake thrives on decaying hardwood logs and woody debris in moist, shaded forests throughout New England, particularly in areas with moderate humidity and temperatures between 55-70°F.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Shiitake mushrooms have been cultivated in Japan for over 1,000 years and are the second most widely cultivated mushroom globally, valued for both their rich umami flavor and immune-boosting compounds like lentinan.",
