  "nameStory": "",
  "description": "Trametes sanguinea, commonly known as the Cinnabar Bracket, is a vibrant polypore fungus that grows on hardwood logs and stumps throughout New England. This small but striking fungus is easily recognized by its distinctive blood-red to dark crimson coloring.",
  "idTips": [
    {
      "label": "Deep Crimson Color",
      "description": "Bright blood-red to dark cinnabar-colored upper surface that distinguishes it from other bracket fungi",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Typically grows in small shelves or rosettes, usually 1-3 inches wide, making it compact compared to other brackets",
      "isPrimary": false
    },
    {
      "label": "Yellow Pore Surface",
      "description": "Undersurface displays tiny yellow to orange pores that may fade to white or gray with age",
      "isPrimary": false
    }
  ],
  "habitat": "Trametes sanguinea grows on dead or dying hardwood logs, stumps, and fallen branches, particularly favoring oak and beech in moist New England forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The striking crimson color of Cinnabar Bracket earned it the name 'sanguinea' from the Latin word for blood, and this pigmentation may help the fungus absorb light for energy production.",
  "confusionNotes": null,
