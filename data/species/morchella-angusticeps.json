  "nameStory": "",
  "description": "The black morel (Morchella angusticeps) is a highly prized edible fungus characterized by its dark, honeycomb-like cap and hollow interior. This spring mushroom is a favorite among foragers in New England and across North America.",
  "idTips": [
    {
      "label": "Cap color and texture",
      "description": "Dark brown to nearly black cap with a distinctive network of ridges and pits forming a honeycomb pattern",
      "isPrimary": true
    },
    {
      "label": "Hollow interior",
      "description": "The entire fruiting body from cap through stem is completely hollow when sliced lengthwise",
      "isPrimary": false
    },
    {
      "label": "Cap attachment",
      "description": "The cap is attached directly to the stem at the base, with no free space between them",
      "isPrimary": false
    }
  ],
  "habitat": "Black morels fruit in spring (April-May in New England) in mixed hardwood forests, often appearing near ash, elm, and apple trees on disturbed soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Black morels are believed to fruit in response to spring temperature fluctuations and soil moisture, making their appearance somewhat unpredictable and highly anticipated by foragers each season.",
