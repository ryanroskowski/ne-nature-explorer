  "nameStory": "",
  "description": "The Black-sided Meadow Katydid is a medium-sized insect belonging to the Katydids family (Tettigoniidae), characterized by its distinctive dark coloring along the sides of its body. Found throughout New England, this species is a common inhabitant of open grasslands and meadow ecosystems.",
  "idTips": [
    {
      "label": "Black lateral stripes",
      "description": "Dark or blackish coloring along the sides of the body, which gives the species its common name",
      "isPrimary": true
    },
    {
      "label": "Wing structure",
      "description": "Long, narrow wings held tent-like over the back, typical of meadow katydids in the Conocephalus genus",
      "isPrimary": false
    },
    {
      "label": "Size and shape",
      "description": "Slender body approximately 13-16mm in length with an overall green to brown coloration on the dorsal surface",
      "isPrimary": false
    }
  ],
  "habitat": "The Black-sided Meadow Katydid thrives in open meadows, grasslands, and weedy fields throughout New England where tall grasses and herbaceous plants provide shelter and food sources.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Black-sided Meadow Katydids produce their distinctive chirping songs by rubbing their wings together, and females can locate them in the dark by following the sound vibrations.",
