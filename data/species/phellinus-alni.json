  "nameStory": "",
  "description": "Phellinus alni is a wood-decaying fungus that forms hard, shelf-like fruiting bodies on alder trees throughout New England. This species is a pathogenic bracket fungus that causes brown rot in the heartwood of its host trees.",
  "idTips": [
    {
      "label": "Host Specificity",
      "description": "Almost exclusively found on alder trees (Alnus species), making host identification crucial for species recognition.",
      "isPrimary": true
    },
    {
      "label": "Fruiting Body Appearance",
      "description": "Forms hard, woody, hoof or shelf-shaped brackets that are rusty-brown to dark brown with a characteristic uneven, cracked surface.",
      "isPrimary": false
    },
    {
      "label": "Pore Surface",
      "description": "The underside displays small, round pores (4-6 per millimeter) that are typically rust-colored to brown.",
      "isPrimary": false
    }
  ],
  "habitat": "Phellinus alni grows on living and dead alder trees in moist woodlands, wetland margins, and riparian zones throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Once established on an alder tree, Phellinus alni can persist for many years, gradually degrading the tree's structural integrity while providing habitat for insects and other woodland organisms.",
  "confusionNotes": null,
