  "nameStory": "",
  "description": "Sycamore powdery mildew (Erysiphe platani) is a fungal disease that primarily affects American sycamore and London plane trees, coating leaves with a distinctive white powdery substance. This pathogen is common in New England and can reduce tree vigor and aesthetic appeal, particularly during warm, humid growing seasons.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Affected leaves develop a fine white or grayish powder on both upper and lower surfaces, which can be rubbed off easily.",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "The disease primarily affects sycamore trees (Platanus species), with symptoms most visible on young, tender foliage.",
      "isPrimary": false
    },
    {
      "label": "Leaf Distortion",
      "description": "Heavily infected leaves may become curled, stunted, or yellowed as the fungus develops.",
      "isPrimary": false
    }
  ],
  "habitat": "Sycamore powdery mildew thrives in New England on leaves of American sycamore and London plane trees, preferring areas with moderate temperatures, high humidity, and poor air circulation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildew species, Erysiphe platani actually prefers cool, moist conditions and can be more problematic in spring and fall rather than during hot, dry summers.",
  "confusionNotes": null,
  "contextualKnowledge": null,
