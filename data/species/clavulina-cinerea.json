  "nameStory": "",
  "description": "Clavulina cinerea, commonly known as grey coral fungus, is a small, branching fungal fruiting body that belongs to the Hydnaceae family. It is characterized by its delicate, coral-like structure and grey coloration, making it a distinctive sight on the forest floor.",
  "idTips": [
    {
      "label": "Branching Structure",
      "description": "Distinctive coral-like branches that fork repeatedly and taper toward pointed tips",
      "isPrimary": true
    },
    {
      "label": "Color",
      "description": "Pale to dark grey coloring on the branches, sometimes with a slight purple or lavender tint",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Small fruiting bodies, typically 1-4 inches tall, with a fragile, brittle texture",
      "isPrimary": false
    }
  ],
  "habitat": "Clavulina cinerea thrives in moist, rich forest soils and leaf litter in deciduous and mixed woodlands throughout New England, often appearing in late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many fungi that release spores from gills or pores underneath, Clavulina cinerea produces spores on the smooth surfaces of its branches, making it one of the more primitive fungal fruiting body designs.",
