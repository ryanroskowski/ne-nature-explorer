  "nameStory": "",
  "description": "Golovinomyces artemisiae is a fungal pathogen belonging to the powdery mildew family that specifically infects plants in the Artemisia genus, commonly known as wormwood or mugwort. This obligate parasite is found throughout New England and produces the characteristic white, powdery coating of spores on infected plant surfaces.",
  "idTips": [
    {
      "label": "Host Specificity",
      "description": "Primarily infects Artemisia species, making the host plant identity the strongest diagnostic clue",
      "isPrimary": true
    },
    {
      "label": "White Powdery Coating",
      "description": "Visible white to grayish fungal growth appears on leaves, stems, and buds, easily wiped off with a finger",
      "isPrimary": false
    },
    {
      "label": "Microscopic Features",
      "description": "Requires magnification to observe spherical conidia and distinctive appressoria characteristic of the Golovinomyces genus",
      "isPrimary": false
    }
  ],
  "habitat": "Golovinomyces artemisiae thrives in cool, dry conditions on Artemisia plants in open woodlands, disturbed areas, and gardens throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other powdery mildews, Golovinomyces artemisiae is unusual among fungi because it actually prefers dry conditions and can spread its spores more effectively in low humidity, making it well-adapted to New England's variable climate.",
  "confusionNotes": null,
