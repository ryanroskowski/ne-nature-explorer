  "nameStory": "",
  "description": "Boreostereum radiatum is a wood-decaying fungus in the Gloeophyllaceae family characterized by its distinctive radiating gill-like structures and pale coloration. This species is found in New England forests where it plays an important ecological role in breaking down dead wood.",
  "idTips": [
    {
      "label": "Radiating Gill Structure",
      "description": "The underside features distinctive radial gill-like ridges that extend from a central point, resembling spokes on a wheel",
      "isPrimary": true
    },
    {
      "label": "Color and Texture",
      "description": "Typically whitish to pale cream-colored with a smooth to slightly velvety upper surface",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "Found exclusively on dead hardwood or conifer logs and branches, indicating its wood-rotting ecology",
      "isPrimary": false
    }
  ],
  "habitat": "Boreostereum radiatum thrives in moist, shaded forest environments of New England, growing on decomposing fallen logs and dead branches of both deciduous and coniferous trees.",
