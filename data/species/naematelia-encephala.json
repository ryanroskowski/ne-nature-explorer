  "nameStory": "",
  "description": "Naematelia encephala, commonly known as Conifer Brain or jelly brain fungus, is a gelatinous fungus in the Naemateliaceae family characterized by its distinctive brain-like appearance. This wood-decay fungus is commonly found in New England and other temperate regions where coniferous trees are present.",
  "idTips": [
    {
      "label": "Brain-like texture",
      "description": "Distinctive convoluted, wrinkled surface resembling a brain or walnut",
      "isPrimary": true
    },
    {
      "label": "Gelatinous consistency",
      "description": "Soft, jelly-like texture that is translucent to opaque and changes with moisture",
      "isPrimary": false
    },
    {
      "label": "Color variation",
      "description": "Ranges from pale yellow to orange-red, often darker when wet",
      "isPrimary": false
    }
  ],
  "habitat": "Found on dead or dying coniferous wood, particularly on logs and branches of pine, spruce, and fir trees in moist, shaded forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is edible and has been used in traditional Asian cuisine and medicine, though it is more commonly appreciated by naturalists for its striking gelatinous appearance and role in wood decomposition.",
