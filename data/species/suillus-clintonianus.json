  "nameStory": "",
  "description": "Suillus clintonianus, commonly known as the Larch Suillus, is a mycorrhizal fungus that forms symbiotic relationships with larch trees in coniferous forests. This boletoid mushroom is characterized by its distinctive appearance and is found primarily in the northeastern United States, particularly in New England.",
  "idTips": [
    {
      "label": "Pores and Stem",
      "description": "Small, angular yellow pores that are decurrent (running down the stem) and often staining brown when bruised; stem typically has a ring or annular zone",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "Reddish-brown to tan cap with a viscid (sticky) surface when moist, often with a distinctive radial pattern of fibrils",
      "isPrimary": false
    },
    {
      "label": "Host Association",
      "description": "Found exclusively or nearly exclusively fruiting near larch trees (Larix species), making the host a key identification clue",
      "isPrimary": false
    }
  ],
  "habitat": "Suillus clintonianus grows in mycorrhizal association with larch trees in moist coniferous and mixed forests throughout New England and northeastern North America.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Suillus species, the Larch Suillus produces a specialized slimy outer layer (viscid cap) that helps disperse spores by adhering to the feet and fur of forest animals.",
  "confusionNotes": null,
  "contextualKnowledge": null,
