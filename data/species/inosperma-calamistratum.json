  "nameStory": "",
  "description": "The greenfoot fibrecap (Inosperma calamistratum) is a small woodland mushroom characterized by its distinctive greenish base and fibrous cap texture. It belongs to the Fibercaps and Allies family (Inocybaceae) and is found in New England forests during summer and fall.",
  "idTips": [
    {
      "label": "Greenish Stalk Base",
      "description": "The base of the stalk displays a distinctive greenish or olive-green coloration, which is the primary identifying feature.",
      "isPrimary": true
    },
    {
      "label": "Fibrous Cap",
      "description": "The cap has a characteristic silky or fibrous texture with radial fibers, typically brown or tan in color.",
      "isPrimary": false
    },
    {
      "label": "Crowded Gills",
      "description": "The gills are crowded, pale, and often become spotted or stained with age.",
      "isPrimary": false
    }
  ],
  "habitat": "The greenfoot fibrecap grows on the forest floor among leaf litter and mosses in mixed deciduous and coniferous woodlands throughout New England.",
