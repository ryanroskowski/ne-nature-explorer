  "nameStory": "",
  "description": "Honeysuckle Leaf Blight, caused by Insolibasidium deformans, is a fungal disease that affects honeysuckle plants throughout New England by causing leaf discoloration and deformation. This member of the Platygloeaceae family primarily impacts the foliage, reducing plant vigor and aesthetic appeal.",
  "idTips": [
    {
      "label": "Leaf Deformation",
      "description": "Affected leaves exhibit characteristic curling, puckering, or distortion with an abnormal appearance distinct from healthy foliage.",
      "isPrimary": true
    },
    {
      "label": "Discoloration Patterns",
      "description": "Infected leaves develop brown, reddish, or purplish patches, often with a blotchy appearance spreading across the leaf surface.",
      "isPrimary": false
    },
    {
      "label": "Fungal Structures",
      "description": "Fine fruiting bodies or spore-producing structures may be visible on the undersides of severely affected leaves under magnification.",
      "isPrimary": false
    }
  ],
  "habitat": "Honeysuckle Leaf Blight thrives in the moist, temperate conditions of New England woodlands, gardens, and hedgerows where honeysuckle species are cultivated or naturalized.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Insolibasidium deformans belongs to the rust fungi group (Platygloeaceae), which are among the most specialized plant pathogens, often infecting only specific host plants.",
