  "nameStory": "",
  "description": "The Cuneate Nomad Bee (Nomada cuneata) is a small parasitic bee in the Apidae family, known for laying its eggs in the nests of other bee species. Despite being called a 'bee,' it is actually a cuckoo bee that relies on host bees to raise its offspring.",
  "idTips": [
    {
      "label": "Body shape and size",
      "description": "Small, slender bee (6-8mm) with a distinctly wedge-shaped abdomen",
      "isPrimary": true
    },
    {
      "label": "Coloration pattern",
      "description": "Black body with yellow or reddish-orange markings on the face and abdomen segments",
      "isPrimary": false
    },
    {
      "label": "Hairless appearance",
      "description": "Notably less hairy than typical bees, with a smooth, shiny exoskeleton",
      "isPrimary": false
    }
  ],
  "habitat": "Found in open woodlands, meadows, and gardens throughout New England where host bee species are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Nomada cuneata is a brood parasite that sneaks into the nests of mining bees and sweat bees, laying eggs that are cared for by the unsuspecting host bee parents.",
