  "nameStory": "",
  "description": "The common stinkhorn (Phallus impudicus) is a distinctive fungus known for its phallic shape and foul odor resembling rotting flesh. Native to Europe, it has become established in parts of New England and other regions, typically appearing in summer and fall.",
  "idTips": [
    {
      "label": "Phallic Shape",
      "description": "Fruiting body is tall and cylindrical, resembling a pale flesh-colored penis, typically 4-8 inches tall",
      "isPrimary": true
    },
    {
      "label": "Foul Odor",
      "description": "Releases a strong, putrid smell similar to rotting meat or feces, most noticeable on warm days",
      "isPrimary": false
    },
    {
      "label": "Dark Cap with Pores",
      "description": "Top of fruiting body is covered with a dark olive or black, slimy, pitted cap (gleba) containing spores",
      "isPrimary": false
    }
  ],
  "habitat": "Found in wood chips, mulch, disturbed soil, and gardens throughout New England, often emerging near landscaping materials or in lawns.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The foul smell attracts flies and other insects that feed on the sticky spore-bearing cap and then disperse the spores, making this fungus dependent on carrion-feeding insects rather than wind for reproduction.",
  "confusionNotes": null,
