  "nameStory": "",
  "description": "Black Spot of Elm is a fungal disease caused by Stegophora ulmea, a member of the Sydowiellaceae family that primarily affects elm trees throughout New England. The disease is characterized by the development of dark, necrotic lesions on elm leaves, which can lead to premature leaf drop and weakened tree vigor.",
  "idTips": [
    {
      "label": "Dark Lesions",
      "description": "Small to medium-sized black or dark brown spots with irregular margins appear on elm leaves, often surrounded by a yellow halo",
      "isPrimary": true
    },
    {
      "label": "Leaf Drop",
      "description": "Infected leaves may yellow and drop prematurely from the tree, particularly during wet growing seasons",
      "isPrimary": false
    },
    {
      "label": "Fungal Fruiting Bodies",
      "description": "Microscopic examination reveals dark fruiting structures (pycnidia) embedded in the leaf tissue",
      "isPrimary": false
    }
  ],
  "habitat": "This fungal pathogen thrives in the cool, moist conditions typical of New England springs and falls, primarily infecting susceptible elm species in both urban and woodland settings.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Stegophora ulmea is one of several fungal pathogens that can weaken elm trees, making them more susceptible to other serious threats like Dutch elm disease, which has devastated elm populations across North America.",
