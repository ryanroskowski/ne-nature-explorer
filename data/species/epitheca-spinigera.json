  "nameStory": "",
  "description": "The Spiny Baskettail is a medium-sized dragonfly belonging to the Emerald Dragonflies family, characterized by its robust build and distinctive spiny abdomen. Found throughout New England, this species is an important indicator of healthy aquatic ecosystems.",
  "idTips": [
    {
      "label": "Spiny Abdomen",
      "description": "The male's abdomen features prominent spines or projections, giving the species its common name and serving as its most distinctive feature.",
      "isPrimary": true
    },
    {
      "label": "Metallic Green Coloration",
      "description": "The body displays a metallic green sheen typical of emerald dragonflies, with darker markings along the abdomen.",
      "isPrimary": false
    },
    {
      "label": "Wing Position",
      "description": "The wings are held mostly forward or to the sides when at rest, unlike many dragonflies that fold them back along the body.",
      "isPrimary": false
    }
  ],
  "habitat": "Spiny Baskettails inhabit clear, fast-flowing streams and rivers with rocky substrates and emergent vegetation in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The spiny projections on male Spiny Baskettails are used during mating competitions, with males engaging in aerial battles to establish dominance over stretches of river.",
