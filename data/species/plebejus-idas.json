  "nameStory": "",
  "description": "The Northern Blue (Plebejus idas) is a small butterfly belonging to the Gossamer-winged family, characterized by delicate wings and subtle coloring. Found in New England and other northern regions, it inhabits open areas and meadows during the warmer months.",
  "idTips": [
    {
      "label": "Wing Color",
      "description": "Males display bright violet-blue upperside wings, while females are predominantly brown with blue scaling at the wing base",
      "isPrimary": true
    },
    {
      "label": "Wing Underside",
      "description": "Pale gray-white underside with small black spots and faint orange lunules near the hindwing margins",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Very small butterfly with a wingspan of 0.9 to 1.2 inches (23-30 mm)",
      "isPrimary": false
    }
  ],
  "habitat": "Northern Blues prefer open, sunny meadows, grasslands, and rocky areas with low vegetation, typically found at higher elevations or in northern climates.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Northern Blue has a unique mutualistic relationship with certain ant species, which protect and care for the butterfly's caterpillars in exchange for sweet secretions.",
