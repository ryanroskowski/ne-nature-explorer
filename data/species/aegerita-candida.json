  "nameStory": "",
  "description": "Aegerita candida, commonly known as couscous crust, is a dark fungus that forms thin, crusty layers on decaying wood and plant material. This cosmopolitan species is named for its distinctive granular appearance resembling couscous grains.",
  "idTips": [
    {
      "label": "Granular texture",
      "description": "The fruiting body has a characteristic coarse, granular or powdery surface resembling couscous",
      "isPrimary": true
    },
    {
      "label": "Dark coloration",
      "description": "Appears as dark brown to black thin crusts or patches on substrate",
      "isPrimary": false
    },
    {
      "label": "Thin growth form",
      "description": "Forms as a thin, adherent crust rather than thick fruiting bodies",
      "isPrimary": false
    }
  ],
  "habitat": "Aegerita candida thrives on dead hardwood, decaying logs, and decomposing plant material in moist forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its crusty appearance, Aegerita candida is an important wood-decay fungus that helps accelerate nutrient cycling in forest ecosystems by breaking down recalcitrant plant materials.",
