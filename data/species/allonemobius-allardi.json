  "nameStory": "",
  "description": "Allard's Ground Cricket is a small, ground-dwelling cricket species belonging to the family Gryllacrididae, commonly found throughout New England. These crickets are known for their distinctive chirping calls and preference for leaf litter and grassy areas.",
  "idTips": [
    {
      "label": "Body size and color",
      "description": "Small cricket, typically 8-12mm in length, with a brown or tan coloration that helps it blend into leaf litter and soil environments.",
      "isPrimary": false
    },
    {
      "label": "Ovipositor presence",
      "description": "Females possess a characteristic long, pointed ovipositor extending from the rear of the abdomen, used for laying eggs in soil.",
      "isPrimary": true
    },
    {
      "label": "Leg structure",
      "description": "Robust hind legs adapted for jumping, with distinctly thickened femurs and specialized tibiae.",
      "isPrimary": false
    }
  ],
  "habitat": "Allard's Ground Cricket inhabits moist leaf litter, grass clumps, and soil areas in woodlands, meadows, and gardens throughout New England.",
