  "nameStory": "",
  "description": "Podosphaera erigerontis-canadensis is a powdery mildew fungus that primarily infects plants in the Asteraceae family, particularly fleabane species (Erigeron) in New England. This obligate parasite forms characteristic white, powdery fungal colonies on leaf surfaces and can significantly impact host plant health.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish fungal coating on leaf surfaces, particularly on the upper side of leaves",
      "isPrimary": true
    },
    {
      "label": "Host Plant Specificity",
      "description": "Primarily found on Erigeron species (fleabane) and related Asteraceae family members",
      "isPrimary": false
    },
    {
      "label": "Microscopic Structures",
      "description": "Presence of distinctive appendages on spores visible under magnification that aid in identification",
      "isPrimary": false
    }
  ],
  "habitat": "Podosphaera erigerontis-canadensis thrives in dry, warm conditions on Erigeron species in open fields, roadsides, and disturbed areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews that require high humidity, this species prefers dry conditions, making it more prevalent during summer dry spells rather than wet spring weather.",
