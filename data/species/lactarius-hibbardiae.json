  "nameStory": "",
  "description": "Lactarius hibbardiae is a small to medium-sized milkcap mushroom characterized by its pale coloring and delicate structure. It is a woodland fungus found in New England that produces a distinctive white or pale latex when the gills are damaged.",
  "idTips": [
    {
      "label": "White Latex Production",
      "description": "When gills or flesh are cut or bruised, the mushroom exudes a white or cream-colored milk that is a defining characteristic of Lactarius species",
      "isPrimary": true
    },
    {
      "label": "Pale Cap Coloration",
      "description": "Features a whitish to pale tan or grayish cap, often with subtle concentric zones or a slightly depressed center",
      "isPrimary": false
    },
    {
      "label": "Small to Medium Size",
      "description": "Typically has a cap diameter of 1-3 inches with proportionally crowded, narrow gills that run down the stem",
      "isPrimary": false
    }
  ],
  "habitat": "Lactarius hibbardiae grows in deciduous and mixed forests throughout New England, typically fruiting in summer and fall in association with hardwood trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other milkcaps, Lactarius hibbardiae produces latex as a defense mechanism against insects and microorganisms, making the mushroom unpalatable to most potential consumers.",
  "confusionNotes": null,
