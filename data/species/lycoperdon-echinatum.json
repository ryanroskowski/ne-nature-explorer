  "nameStory": "",
  "description": "Lycoperdon echinatum, commonly known as the Spiny Puffball, is a small fungus characterized by its distinctive spiky or echinate (spiny) surface covering. When mature, it releases spores through an apical pore, dispersing them via air currents like other puffballs.",
  "idTips": [
    {
      "label": "Spiny Surface",
      "description": "Covered with prominent spine-like projections that are easily rubbed off, revealing a smooth or reticulated layer beneath",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Typically 1-2 cm in diameter, making it one of the smaller puffball species in the region",
      "isPrimary": false
    },
    {
      "label": "Apical Opening",
      "description": "Features a single pore at the top for spore dispersal, characteristic of the Lycoperdon genus",
      "isPrimary": false
    }
  ],
  "habitat": "Found in woodlands, grassy areas, and disturbed soils throughout New England, preferring well-drained areas with rich organic matter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The spiny spines on young puffballs provide protection from small insects and moisture loss, but they readily fall away as the fungus matures, earning it the nickname 'hedgehog puffball' in some regions.",
