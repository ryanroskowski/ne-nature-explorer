  "nameStory": "",
  "description": "Vinegar Cup (Helvella acetabulum) is a distinctive cup-shaped fungus belonging to the Helvellaceae family, characterized by its pale, delicate fruiting bodies. Despite its common name suggesting a vinegar-like odor, it is primarily identified by its unique morphology rather than smell.",
  "idTips": [
    {
      "label": "Cup Shape",
      "description": "Distinctive cup or goblet-like fruiting body with an upturned, wavy rim and pale whitish to grayish coloration",
      "isPrimary": true
    },
    {
      "label": "Stem Structure",
      "description": "Features a short, ridged or fluted stem (stalk) that is typically hollow and fragile",
      "isPrimary": false
    },
    {
      "label": "Size and Texture",
      "description": "Small fruiting bodies, usually 1-2 inches tall, with a smooth to slightly wrinkled interior surface",
      "isPrimary": false
    }
  ],
  "habitat": "Vinegar Cup grows in moist woodlands, particularly in rich soil near decaying wood and leaf litter throughout New England during spring and early summer.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Helvella comes from Latin, and these fungi are sometimes called 'elfin saddles' due to their whimsical, otherworldly appearance that resembles tiny mushroom chairs.",
