  "nameStory": "",
  "description": "Pine Bracket (Porodaedalea pini) is a woody, shelf-forming fungus that causes heart rot in conifers, particularly pine trees throughout New England. This perennial polypore is a significant decomposer of dead wood and can persist on trees for many years.",
  "idTips": [
    {
      "label": "Bracket Shape and Texture",
      "description": "Forms hard, hoof or shelf-shaped brackets with a dark brown to blackish upper surface that is often concentrically zoned; undersurface has small, angular pores",
      "isPrimary": true
    },
    {
      "label": "Host Preference",
      "description": "Primarily found on pine species (Pinus spp.) and other conifers, rarely on hardwoods, making host identification helpful for confirmation",
      "isPrimary": false
    },
    {
      "label": "Woody Consistency",
      "description": "Extremely hard and woody texture that does not soften when wet, distinguishing it from softer bracket fungi",
      "isPrimary": false
    }
  ],
  "habitat": "Porodaedalea pini grows on dead or dying conifer wood, particularly pine trees in forests and wooded areas throughout New England, where it aids in wood decomposition.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Pine Bracket is a perennial fungus that can grow for decades, adding new growth layers each year and creating visibly concentric rings that reflect its age.",
