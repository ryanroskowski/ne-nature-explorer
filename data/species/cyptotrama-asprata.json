  "nameStory": "",
  "description": "Cryptotrama asprata, commonly known as the Golden-scruffy Collybia, is a small woodland mushroom characterized by its delicate appearance and golden-brown coloration. This fungus is a member of the Physalacriaceae family and is found in wooded areas throughout New England.",
  "idTips": [
    {
      "label": "Golden-brown caps with scruffy texture",
      "description": "The caps are small (typically 1-3 cm), golden to tan-brown, and have a distinctive scruffy or slightly fibrillose surface that helps distinguish it from similar species",
      "isPrimary": true
    },
    {
      "label": "Pale gills and thin stem",
      "description": "The gills are pale, narrow, and crowded, while the stem is thin, wiry, and similarly colored to the cap",
      "isPrimary": false
    },
    {
      "label": "Clustered growth pattern",
      "description": "This species typically fruits in small clusters or groups on decaying wood and leaf litter",
      "isPrimary": false
    }
  ],
  "habitat": "Cryptotrama asprata grows in moist, shaded woodlands of New England, typically appearing on well-decayed hardwood logs, woody debris, and rich forest floors from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size and delicate appearance, Golden-scruffy Collybia is remarkably resilient and can continue to fruit even after freezing temperatures, making it a notable late-season mushroom in New England forests.",
