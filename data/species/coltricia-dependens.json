  "nameStory": "",
  "description": "Coltricia dependens is a small, delicate polypore fungus belonging to the Coltriciaceae family, characterized by its thin fruiting bodies and fine pores. Found in New England, this species plays an important ecological role as a wood decomposer in forest ecosystems.",
  "idTips": [
    {
      "label": "Pore surface",
      "description": "Distinctively small, fine pores (typically 4-6 per mm) that are often angular and tightly packed together",
      "isPrimary": true
    },
    {
      "label": "Cap texture and color",
      "description": "Thin, delicate cap with a pale yellowish to tan or brownish coloration that may fade with age or exposure",
      "isPrimary": false
    },
    {
      "label": "Brittleness",
      "description": "The fruiting body is notably brittle and fragile, breaking easily when handled",
      "isPrimary": false
    }
  ],
  "habitat": "Coltricia dependens grows on decaying hardwood and softwood logs, stumps, and woody debris in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its tiny, delicate appearance, Coltricia dependens is an efficient wood decomposer that helps break down dead trees and recycle nutrients back into forest soils.",
