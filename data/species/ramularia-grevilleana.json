  "nameStory": "",
  "description": "Common Strawberry Spot (Ramularia grevilleana) is a fungal leaf disease that affects strawberry plants throughout New England, causing distinctive spotted lesions on foliage. This member of the Mycosphaerellaceae family thrives in cool, moist conditions typical of the region's growing season.",
  "idTips": [
    {
      "label": "Circular leaf spots",
      "description": "Small, round lesions with reddish-purple borders and tan or gray centers appear on strawberry leaves",
      "isPrimary": true
    },
    {
      "label": "Spore appearance",
      "description": "Gray to olive-colored sporulation (spore masses) develops in the center of spots under humid conditions",
      "isPrimary": false
    },
    {
      "label": "Progressive spread",
      "description": "Spots start on lower, older leaves and gradually progress upward through the canopy as the season advances",
      "isPrimary": false
    }
  ],
  "habitat": "Ramularia grevilleana prefers cool, moist environments and is particularly problematic in New England during spring and fall when humidity levels remain high and temperatures are moderate.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many strawberry pathogens, Ramularia grevilleana rarely affects the fruit itself, making it primarily a foliar disease that impacts plant vigor and photosynthetic capacity rather than fruit quality.",
