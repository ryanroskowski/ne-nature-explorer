  "nameStory": "",
  "description": "The Spotted Camel Cricket (Ceuthophilus maculatus) is a small, humped-backed insect belonging to the family Rhaphidophoridae, commonly known as camel crickets or cave crickets. These nocturnal creatures are found throughout New England and are known for their distinctive spotted pattern and elongated hind legs.",
  "idTips": [
    {
      "label": "Humped Back",
      "description": "Distinctive arched, camel-like posture with a rounded back",
      "isPrimary": true
    },
    {
      "label": "Spotted Pattern",
      "description": "Dark spots or mottled markings scattered across the body and legs",
      "isPrimary": false
    },
    {
      "label": "Long Hind Legs",
      "description": "Significantly elongated back legs used for jumping",
      "isPrimary": false
    }
  ],
  "habitat": "Spotted Camel Crickets prefer cool, damp environments such as caves, cellars, basements, and leaf litter throughout New England, though they can also inhabit woodpiles and rocky outcrops.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their name, camel crickets are not true crickets and produce no sound, unlike their singing cricket relatives; instead, they communicate through vibrations.",
