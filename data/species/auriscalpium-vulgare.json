  "nameStory": "",
  "description": "Auriscalpium vulgare, commonly known as Earpick Fungus, is a small woodland fungus characterized by its distinctive ear-like or spoon-shaped fruiting bodies. Named for its historical use as a natural tool for ear cleaning, this species is found decomposing wood debris in moist forest environments.",
  "idTips": [
    {
      "label": "Ear-like or spoon shape",
      "description": "Fruiting bodies are uniquely flattened and resemble tiny ears or spoons, typically 1-3 cm in diameter",
      "isPrimary": true
    },
    {
      "label": "Thin, brittle texture",
      "description": "The caps are thin, translucent, and papery when dry, becoming more gelatinous when moist",
      "isPrimary": false
    },
    {
      "label": "Small spines underneath",
      "description": "The underside features small, fine spines or teeth rather than traditional gills, ranging from whitish to pale gray in color",
      "isPrimary": false
    }
  ],
  "habitat": "Earpick Fungus grows on decaying conifer logs, fallen branches, and wood debris in cool, moist forests throughout New England, preferring shaded woodland floors with high humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Auriscalpium comes from Latin words meaning 'ear' and 'to scrape,' reflecting the fungus's traditional use in folk medicine as a natural tool for cleaning ears.",
