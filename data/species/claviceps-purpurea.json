  "nameStory": "",
  "description": "Rye Ergot is a fungal pathogen that infects rye and other grain crops, replacing the grain with dark, hard structures called sclerotia. This parasitic fungus has historically caused ergotism in humans and livestock that consumed contaminated grain.",
  "idTips": [
    {
      "label": "Dark Sclerotia",
      "description": "Look for dark purple-black, horn-like structures protruding from the grain head where normal seeds would develop",
      "isPrimary": true
    },
    {
      "label": "Honeydew Stage",
      "description": "Early infection produces sticky, sweet-smelling liquid (honeydew) on affected florets, which attracts insects",
      "isPrimary": false
    },
    {
      "label": "Size and Shape",
      "description": "Sclerotia are typically 2-4 times larger than the host grain and are distinctly curved or comma-shaped",
      "isPrimary": false
    }
  ],
  "habitat": "Rye Ergot thrives in cool, moist conditions typical of New England springs and early summers, particularly in rye fields and wild grain stands with high humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Ergot fungus contains ergotamine, a compound related to LSD; ergotism outbreaks in medieval Europe likely caused hallucinations and were sometimes attributed to witchcraft.",
