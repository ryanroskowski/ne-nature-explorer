  "nameStory": "",
  "description": "Orange Disco (Aleurodiscus amorphus) is a small, bright orange fungus belonging to the Stereaceae family, characterized by its disc-like fruiting bodies. This wood-decay fungus is commonly found throughout New England on dead hardwood branches and logs.",
  "idTips": [
    {
      "label": "Bright Orange Color",
      "description": "Distinctive vibrant orange to orange-red fruiting bodies that stand out against dark wood",
      "isPrimary": true
    },
    {
      "label": "Disc-shaped Fruitbodies",
      "description": "Small, flat to slightly convex disc or cup-like structures, typically 2-8mm in diameter",
      "isPrimary": false
    },
    {
      "label": "Smooth Underside",
      "description": "The hymenium (spore-bearing surface) is smooth rather than pored, ridged, or gilled",
      "isPrimary": false
    }
  ],
  "habitat": "Orange Disco thrives on dead or decaying hardwood substrates including branches, twigs, and fallen logs in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size, Orange Disco plays an important ecological role as a wood decomposer, helping break down dead plant material and returning nutrients to forest ecosystems.",
