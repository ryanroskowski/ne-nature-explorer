  "nameStory": "",
  "description": "Erysiphe alliariicola is a powdery mildew fungus that specifically infects plants in the mustard family (Brassicaceae), particularly garlic mustard and related species. This pathogen forms characteristic white, powdery fungal colonies on leaf surfaces and is commonly encountered in New England woodlands and gardens.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish powder covers affected leaf surfaces, which easily rubs off to reveal the leaf underneath",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Found primarily on garlic mustard (Alliaria petiolata) and other Brassicaceae family members, rarely on unrelated plants",
      "isPrimary": false
    },
    {
      "label": "Cleistothecia Formation",
      "description": "Dark, spherical fruiting bodies (cleistothecia) develop within the powdery coating as the infection matures",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe alliariicola thrives in moist, shaded woodlands and disturbed areas of New England where its host plants, particularly invasive garlic mustard, grow abundantly.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This powdery mildew is so host-specific that it has become a focus of research for potential biological control of invasive garlic mustard in North American forests.",
  "confusionNotes": null,
