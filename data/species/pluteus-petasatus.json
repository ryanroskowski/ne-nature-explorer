  "nameStory": "",
  "description": "Pluteus petasatus, commonly known as the scaly shield, is a small wood-decomposing mushroom characterized by its distinctive brown, scaly cap and delicate structure. This species belongs to the Pluteaceae family and is commonly found throughout New England, fruiting on decaying hardwood logs and stumps.",
  "idTips": [
    {
      "label": "Scaly Cap",
      "description": "Brown cap with prominent, darker radial scales or fibrils arranged in a distinctive pattern, giving it a scaled appearance",
      "isPrimary": true
    },
    {
      "label": "Free Gills",
      "description": "White to pink gills that are completely free from the stem, which is characteristic of the Pluteus genus",
      "isPrimary": false
    },
    {
      "label": "Cap Size",
      "description": "Small umbrella-shaped caps typically 2-5 cm in diameter with a central umbo or slight peak",
      "isPrimary": false
    }
  ],
  "habitat": "Pluteus petasatus grows on dead or decaying hardwood, particularly on logs, stumps, and fallen branches in moist woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other members of the Pluteus genus, scaly shields have free gills that are initially white but gradually turn pink as the mushroom matures, due to the development of spores.",
