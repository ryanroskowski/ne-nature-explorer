  "nameStory": "",
  "description": "Hygrocybe parvula is a small, delicate waxcap mushroom characterized by its diminutive size and bright coloration. This fungus is part of the diverse Hygrocybaceae family, known for their waxy, translucent gill structures and preference for grassland habitats.",
  "idTips": [
    {
      "label": "Tiny Size",
      "description": "Caps typically measure only 5-15 mm across, making it one of the smallest waxcaps in New England",
      "isPrimary": true
    },
    {
      "label": "Waxy Gills",
      "description": "Distinctive waxy, widely-spaced gills that are characteristic of the Hygrocybe genus",
      "isPrimary": false
    },
    {
      "label": "Translucent Appearance",
      "description": "The thin, translucent fruiting body becomes somewhat translucent when wet",
      "isPrimary": false
    }
  ],
  "habitat": "Hygrocybe parvula thrives in moist, nutrient-poor grasslands, lawns, and mossy areas throughout New England, favoring undisturbed grassland habitats.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their tiny size, waxcaps like H. parvula are considered indicators of ancient, unimproved grasslands and are increasingly rare due to modern agricultural practices.",
  "confusionNotes": null,
  "contextualKnowledge": null,
