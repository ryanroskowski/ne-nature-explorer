  "nameStory": "",
  "description": "Neobulgaria pura, commonly known as Beech Jelly-disc, is a gelatinous fungus that forms small, translucent disc-shaped fruiting bodies on decaying wood. This species belongs to the Gelatinodiscaceae family and is notable for its jelly-like texture and preference for hardwood substrates.",
  "idTips": [
    {
      "label": "Gelatinous Texture",
      "description": "Fruiting bodies are distinctly soft, rubbery, and translucent with a gelatinous consistency",
      "isPrimary": true
    },
    {
      "label": "Disc Shape",
      "description": "Small, cup or disc-shaped fruiting bodies, typically 2-5mm in diameter, often appearing in clusters",
      "isPrimary": false
    },
    {
      "label": "Color",
      "description": "Dark brown to blackish coloring, sometimes appearing glossy when moist",
      "isPrimary": false
    }
  ],
  "habitat": "Neobulgaria pura grows on decaying hardwood, particularly on fallen beech logs and branches in moist, shaded New England forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its jelly-like appearance, Neobulgaria pura is remarkably durable and can persist on wood for extended periods, slowly decomposing the substrate and contributing to nutrient cycling in forest ecosystems.",
