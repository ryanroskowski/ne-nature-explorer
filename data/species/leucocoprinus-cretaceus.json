  "nameStory": "",
  "description": "Leucocoprinus cretaceus, commonly known as the white chalk mushroom, is a small, delicate fungus characterized by its pure white coloration and chalky appearance. This species belongs to the Agaricaceae family and is occasionally encountered in New England, typically appearing in disturbed areas and cultivated soil.",
  "idTips": [
    {
      "label": "Pure White Color",
      "description": "The entire fruiting body, including cap, stem, and gills, is distinctly white or off-white with a chalky, powdery appearance",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Caps typically measure 1-3 cm in diameter, with slender, fragile stems that are easily broken",
      "isPrimary": false
    },
    {
      "label": "Free Gills",
      "description": "The gills are free from the stem and have a pale white color, sometimes with a slight yellowish tint at maturity",
      "isPrimary": false
    }
  ],
  "habitat": "Leucocoprinus cretaceus grows in disturbed soil, potted plants, greenhouses, compost, and mulched garden beds throughout New England, preferring warm, moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This species is often called the 'pot mushroom' because it frequently appears in indoor potted plants and planters, sometimes emerging unexpectedly from commercial potting soil.",
