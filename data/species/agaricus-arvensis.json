  "nameStory": "",
  "description": "The Horse Mushroom (Agaricus arvensis) is a large, robust field mushroom that closely resembles the common cultivated mushroom but is typically larger and more robust. It is an edible species highly prized by foragers in New England and Europe, known for its pleasant anise-like or almond scent.",
  "idTips": [
    {
      "label": "Anise or almond aroma",
      "description": "A distinctive sweet smell reminiscent of anise seed or almonds, especially when crushed, is a key identifying feature.",
      "isPrimary": true
    },
    {
      "label": "Large white cap",
      "description": "The cap is typically 5-12 inches wide, white to creamy colored, often with a floccose or fibrous texture that may brown with age or handling.",
      "isPrimary": false
    },
    {
      "label": "Free gills and double ring",
      "description": "Gills are free (not attached to the stem), white becoming pink then brown; the stem has a distinctive double or thick ring (annulus), often with a skirt-like appearance.",
      "isPrimary": false
    }
  ],
  "habitat": "Horse Mushrooms fruit in open grasslands, pastures, meadows, and field edges throughout New England, typically appearing in late summer through fall after rainfall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Horse Mushroom gets its name from its large size and traditional association with horse manure, on which it was sometimes cultivated historically, though it actually prefers nutrient-rich soils in open fields.",
