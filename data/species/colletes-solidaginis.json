  "nameStory": "",
  "description": "The Goldenrod Cellophane Bee (Colletes solidaginis) is a small, solitary bee species belonging to the Plasterer Bee family, native to New England and other eastern regions of North America. These bees are specialist pollinators of goldenrod flowers, from which they derive their common name.",
  "idTips": [
    {
      "label": "Size and Color",
      "description": "Small bee, approximately 8-10mm in length, with a dark body and sparse, fine hair covering",
      "isPrimary": false
    },
    {
      "label": "Temporal Activity",
      "description": "Active in late summer and fall (August-October), coinciding with goldenrod bloom time",
      "isPrimary": true
    },
    {
      "label": "Plasterer Bee Characteristics",
      "description": "Secretes a cellophane-like lining in nest cells, which gives the family its common name",
      "isPrimary": false
    }
  ],
  "habitat": "Colletes solidaginis inhabits open areas, gardens, and meadows throughout New England where goldenrod plants grow abundantly.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many bee species, Colletes solidaginis is a strict specialist that forages almost exclusively on goldenrod pollen and nectar, making it an important pollinator for this late-season wildflower.",
