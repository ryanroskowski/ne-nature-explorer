  "nameStory": "",
  "description": "Williamson's Emerald is a medium-sized dragonfly belonging to the family Corduliidae, characterized by its metallic green body and swift, agile flight patterns. This species is endemic to New England and prefers cool, clean freshwater environments.",
  "idTips": [
    {
      "label": "Metallic Green Coloration",
      "description": "Distinctive bright emerald-green thorax and abdomen with a metallic sheen that catches sunlight",
      "isPrimary": true
    },
    {
      "label": "Wing Venation",
      "description": "Clear wings with dark pterostigma (wing spot) and characteristic emerald dragonfly venation patterns",
      "isPrimary": false
    },
    {
      "label": "Body Size",
      "description": "Medium-sized dragonfly with body length typically between 40-45mm",
      "isPrimary": false
    }
  ],
  "habitat": "Williamson's Emerald inhabits cool, clear streams and small rivers with dense riparian vegetation in New England's forested regions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other emerald dragonflies, Williamson's Emerald has large compound eyes that nearly meet on top of its head, giving it exceptional 360-degree vision for hunting flying insects.",
