  "nameStory": "",
  "description": "The saffron milkcap is a distinctive orange mushroom with a funnel-shaped cap that produces orange-red latex when cut or bruised. This edible species is prized by foragers in New England and is known for its fruity, slightly peppery flavor.",
  "idTips": [
    {
      "label": "Orange latex/milk",
      "description": "Produces bright orange to reddish latex when the gills or flesh are cut or damaged, which stains green or darker over time",
      "isPrimary": true
    },
    {
      "label": "Cap appearance",
      "description": "Orange cap with a funnel or depressed center, often with faint concentric zones and a slightly sticky surface when moist",
      "isPrimary": false
    },
    {
      "label": "Habitat association",
      "description": "Found exclusively under coniferous trees, particularly spruce and pine, in a mycorrhizal relationship",
      "isPrimary": false
    }
  ],
  "habitat": "Saffron milkcaps fruit from late summer through fall in coniferous forests and plantations throughout New England, forming symbiotic relationships with spruce, pine, and fir trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The orange latex from this mushroom was historically used by some cultures as a natural dye, and the color intensifies to greenish hues as the latex oxidizes when exposed to air.",
  "confusionNotes": null,
  "contextualKnowledge": null,
