  "nameStory": "",
  "description": "Angelina rufescens is a fungal species in the Rhytismataceae family, characterized by its reddish-brown fruiting bodies that appear on plant material. This ascomycete fungus is commonly found in New England woodlands and forests.",
  "idTips": [
    {
      "label": "Reddish-brown coloration",
      "description": "The fruiting bodies display distinctive reddish-brown to rust-colored pigmentation that distinguishes it from related species",
      "isPrimary": true
    },
    {
      "label": "Inoperculate structure",
      "description": "The apothecia lack an operculum (lid-like structure), instead opening irregularly to release spores",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Typically found on decaying wood and plant debris in moist forest conditions",
      "isPrimary": false
    }
  ],
  "habitat": "Angelina rufescens thrives in the moist, shaded understory of deciduous and mixed forests throughout New England, particularly on decomposing hardwood substrates.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other members of Rhytismataceae, this fungus plays an important ecological role as a decomposer, helping to break down dead plant material and recycle nutrients in forest ecosystems.",
