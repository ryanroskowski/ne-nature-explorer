  "nameStory": "",
  "description": "Tyromyces fumidiceps is a wood-decay fungus in the Incrustoporiaceae family, characterized by its small, delicate fruiting bodies and pale coloration. It plays an important ecological role as a decomposer of dead wood in forest ecosystems.",
  "idTips": [
    {
      "label": "Pore Surface",
      "description": "Displays small, angular pores (3-4 per mm) that are white to pale cream-colored, becoming darker with age or bruising",
      "isPrimary": true
    },
    {
      "label": "Fruiting Body Size",
      "description": "Produces thin, bracket-like or resupinate (crust-like) fruiting bodies that are typically small and delicate",
      "isPrimary": false
    },
    {
      "label": "Texture and Color",
      "description": "Upper surface is whitish to pale gray with a finely granular or slightly bumpy texture",
      "isPrimary": false
    }
  ],
  "habitat": "Tyromyces fumidiceps is found on decaying hardwood and softwood logs and branches in moist, shaded forest environments throughout New England.",
