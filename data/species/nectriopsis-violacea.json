  "nameStory": "",
  "description": "Nectriopsis violacea is a small fungal species belonging to the Bionectriaceae family, characterized by its distinctive violet or purple coloration. This ascomycete fungus is found in New England ecosystems where it plays a role in wood decomposition and nutrient cycling.",
  "idTips": [
    {
      "label": "Violet Coloration",
      "description": "The most distinctive feature is the violet to purple pigmentation of the fruiting bodies (perithecia), which gives the species its name violacea.",
      "isPrimary": true
    },
    {
      "label": "Small Fruiting Bodies",
      "description": "Produces minute, flask-shaped perithecia that are barely visible to the naked eye, typically requiring magnification for detailed observation.",
      "isPrimary": false
    },
    {
      "label": "Wood Substrate",
      "description": "Found exclusively on decaying wood and woody substrates, where the fruiting bodies emerge from the surface of degraded plant material.",
      "isPrimary": false
    }
  ],
  "habitat": "Nectriopsis violacea thrives in moist, shaded forest environments of New England, particularly on dead or decomposing hardwood logs and branches.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size, this fungus is an important decomposer in forest ecosystems, helping break down dead wood and returning essential nutrients to the soil.",
