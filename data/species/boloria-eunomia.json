  "nameStory": "",
  "description": "The Bog Fritillary is a small to medium-sized butterfly in the Brush-footed Butterflies family, characterized by orange-brown wings with black markings and a distinctive checkered pattern. This species is highly specialized for wetland habitats and is an indicator of healthy bog ecosystems in New England.",
  "idTips": [
    {
      "label": "Wing Pattern",
      "description": "Orange-brown upperwings with black spots and a checkered appearance on the hindwings, creating a distinctive latticed effect",
      "isPrimary": true
    },
    {
      "label": "Size",
      "description": "Small fritillary with a wingspan of 1.3 to 1.6 inches, noticeably smaller than most other fritillary species",
      "isPrimary": false
    },
    {
      "label": "Underside Coloration",
      "description": "Pale yellow or whitish hindwing undersides with distinctive silver spots arranged in specific patterns",
      "isPrimary": false
    }
  ],
  "habitat": "The Bog Fritillary is found exclusively in wet, acidic sphagnum bogs and fens where its host plant, cloudberry, grows in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Bog Fritillary's caterpillars feed almost exclusively on cloudberry plants, making this butterfly a specialized specialist that depends on pristine bog habitats for survival.",
