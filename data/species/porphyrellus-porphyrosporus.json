  "nameStory": "",
  "description": "The Dusky Bolete is a medium-sized fungus in the Boletaceae family, characterized by its dark coloring and distinctive spore print. It is found in New England woodlands and is generally considered inedible due to its unpalatable qualities.",
  "idTips": [
    {
      "label": "Pore Surface Color",
      "description": "Bright yellow pores that stain blue when bruised or handled, distinguishing it from similar species",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Dark brown to grayish-brown cap that is often dull and matte in texture",
      "isPrimary": false
    },
    {
      "label": "Spore Print",
      "description": "Purple-brown to olive-brown spore print, which gives the species its scientific name porphyrosporus",
      "isPrimary": false
    }
  ],
  "habitat": "The Dusky Bolete grows in mixed hardwood and coniferous forests throughout New England, typically fruiting from summer through fall on the forest floor.",
