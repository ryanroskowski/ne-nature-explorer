  "nameStory": "",
  "description": "Thuemenella cubispora is a small, wood-decaying fungus in the Hypoxylaceae family, characterized by its distinctive cubic or cuboid spores. This species is found on decaying hardwood substrates throughout New England forests.",
  "idTips": [
    {
      "label": "Cubic Spores",
      "description": "The most diagnostic feature is the presence of distinctly cubic or cuboid-shaped ascospores, which is unusual among fungi.",
      "isPrimary": true
    },
    {
      "label": "Dark Perithecia",
      "description": "Small, dark brown to black flask-shaped fruiting bodies (perithecia) embedded in wood or wood debris.",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "Found on well-decayed hardwood, particularly in damp conditions on fallen logs and woody debris.",
      "isPrimary": false
    }
  ],
  "habitat": "Thuemenella cubispora inhabits moist forest floors and decaying hardwood substrates in New England's deciduous and mixed forests.",
