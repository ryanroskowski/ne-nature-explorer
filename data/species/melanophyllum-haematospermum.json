  "nameStory": "",
  "description": "Melanophyllum haematospermum, commonly known as the redspored dapperling, is a small delicate mushroom characterized by its distinctive reddish spores and fragile fruiting body. This species belongs to the Verrucosporaceae family and is found in forest ecosystems throughout New England.",
  "idTips": [
    {
      "label": "Reddish spore print",
      "description": "The most diagnostic feature is the distinctive reddish or blood-red spore print, which gives this species its common name",
      "isPrimary": true
    },
    {
      "label": "Delicate white cap",
      "description": "Small, thin-fleshed white to pale cap, typically 1-3 cm in diameter, with a fragile structure",
      "isPrimary": false
    },
    {
      "label": "Thin gills and stem",
      "description": "Pale gills and a slender, fragile white stem that is easily damaged or broken",
      "isPrimary": false
    }
  ],
  "habitat": "Melanophyllum haematospermum grows on rich forest soil and decaying wood in moist hardwood and mixed forests throughout New England, fruiting from late summer through autumn.",
