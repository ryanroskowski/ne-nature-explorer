  "nameStory": "",
  "description": "Hypoxylon howeanum is a wood-decay fungus in the Hypoxylaceae family that produces dark, crusty fruiting bodies on dead hardwood substrates throughout New England. This species is an important decomposer that helps break down woody debris in forest ecosystems.",
  "idTips": [
    {
      "label": "Fruiting Body Color",
      "description": "Produces dark brown to black, crustose (crust-like) perithecia that form clusters on wood surfaces",
      "isPrimary": true
    },
    {
      "label": "Substrate Preference",
      "description": "Typically found on decaying hardwood logs and branches, particularly oak and birch species",
      "isPrimary": false
    },
    {
      "label": "Surface Texture",
      "description": "Displays a distinctive granular or powdery appearance with visible perithecial ostioles (small pore openings)",
      "isPrimary": false
    }
  ],
  "habitat": "Hypoxylon howeanum thrives on dead hardwood in moist, shaded forest environments and woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their appearance as simple crusty growths, Hypoxylon species are complex ascomycete fungi that can remain viable on wood for many years, slowly releasing spores to colonize new deadwood.",
