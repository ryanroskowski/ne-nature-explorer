  "nameStory": "",
  "description": "Suillus brevipes, commonly known as Short-stalked Suillus, is a small bolete fungus characterized by its distinctly short, sturdy stem and sticky cap surface. This mycorrhizal species forms beneficial relationships with conifer trees, particularly pines and firs throughout New England.",
  "idTips": [
    {
      "label": "Short, Thick Stem",
      "description": "The stalk is noticeably short, stout, and often eccentric (off-center), distinguishing it from taller Suillus species",
      "isPrimary": true
    },
    {
      "label": "Sticky, Viscid Cap",
      "description": "The cap surface is consistently moist, slimy, and sticky to the touch, ranging from yellowish-brown to tan",
      "isPrimary": false
    },
    {
      "label": "Yellow Pores",
      "description": "The underside features small, angular pores that are bright yellow, becoming darker and olive-toned with age or pressure",
      "isPrimary": false
    }
  ],
  "habitat": "Short-stalked Suillus grows in association with two-needle and three-needle pine species in acidic, sandy soils throughout New England, often appearing in summer and early fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Suillus species, S. brevipes produces a symbiotic relationship with pine roots called mycorrhizae, where the fungus helps the tree absorb nutrients while receiving sugars from photosynthesis.",
  "confusionNotes": null,
  "contextualKnowledge": null,
