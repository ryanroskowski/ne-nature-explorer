  "nameStory": "",
  "description": "Bolbitius titubans, commonly known as the yellow fieldcap, is a small delicate mushroom characterized by its pale yellow to ochre cap and thin, fragile stem. This species belongs to the Bolbitiaceae family and is commonly found in grassy areas throughout New England during warm, wet periods.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Pale yellow to ochre colored cap that may fade with age, typically 1-3 cm in diameter",
      "isPrimary": true
    },
    {
      "label": "Stem Texture",
      "description": "Thin, hollow, fragile stem that is typically yellowish and easily bruises or breaks",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "Adnate to slightly decurrent gills that start yellowish and darken to brown as spores mature",
      "isPrimary": false
    }
  ],
  "habitat": "Yellow fieldcaps prefer moist grasslands, lawns, and disturbed areas with rich soil, fruiting abundantly after heavy rains in summer and early autumn throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
