  "nameStory": "",
  "description": "The Curry Milkcap is a small to medium woodland mushroom recognizable by its distinctive spicy curry aroma and pale orange to tan coloring. This member of the Lactarius genus produces a white milk-like latex when cut, a defining characteristic of milkcaps.",
  "idTips": [
    {
      "label": "Curry Aroma",
      "description": "Crushing or breaking the mushroom releases a strong, unmistakable curry or fenugreek-like smell, which is the most reliable identification feature",
      "isPrimary": true
    },
    {
      "label": "Pale Orange Cap",
      "description": "The cap is typically pale orange, tan, or buff-colored, with a slightly inrolled margin when young",
      "isPrimary": false
    },
    {
      "label": "White Milk",
      "description": "When the gills or flesh are cut or broken, a white latex exudes from the tissue, eventually staining yellowish",
      "isPrimary": false
    }
  ],
  "habitat": "Curry Milkcaps fruit on the forest floor in mixed hardwood and coniferous forests throughout New England, typically appearing in summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The distinctive curry smell of this mushroom comes from volatile organic compounds similar to those found in curry spices, making it one of the most aromatic mushroom species.",
  "confusionNotes": null,
