  "nameStory": "",
  "description": "The Incurvate Emerald (Somatochlora incurvata) is a medium-sized dragonfly belonging to the Emerald family, characterized by its metallic green coloring and streamlined body. This species is found throughout New England and is an active flier that hunts small insects near freshwater habitats.",
  "idTips": [
    {
      "label": "Curved Abdomen",
      "description": "The abdomen is distinctly incurved (curved downward), which gives this species its common name and is its most reliable identifying feature.",
      "isPrimary": true
    },
    {
      "label": "Metallic Green Color",
      "description": "Bright metallic green coloring on the head, thorax, and base of the abdomen, typical of emerald dragonflies.",
      "isPrimary": false
    },
    {
      "label": "Yellow Leg Stripe",
      "description": "A yellow or pale stripe running along the inner surface of the hind legs helps distinguish it from similar emerald species.",
      "isPrimary": false
    }
  ],
  "habitat": "Incurvate Emeralds prefer clear, cool streams and small rivers with dense vegetation and shaded areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many dragonflies, Incurvate Emeralds are relatively weak fliers and prefer to hunt by perching on vegetation rather than patrolling open water.",
