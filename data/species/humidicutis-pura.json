  "nameStory": "",
  "description": "Humidicutis pura is a small, delicate waxcap fungus belonging to the family Hygrocybaceae, characterized by its pale coloration and waxy gill texture. This species is a saprotroph found in mossy environments throughout New England, playing a role in nutrient cycling in moist forest ecosystems.",
  "idTips": [
    {
      "label": "Waxy Gills",
      "description": "Distinctive waxy, widely-spaced gills that are a hallmark of the waxcap family, giving them a smooth, slippery feel",
      "isPrimary": true
    },
    {
      "label": "Pale Coloration",
      "description": "Small mushrooms with whitish to pale gray caps and stems, lacking vibrant colors typical of many waxcap species",
      "isPrimary": false
    },
    {
      "label": "Small Fruiting Bodies",
      "description": "Miniature mushrooms typically less than 2-3 cm in diameter, often overlooked in moss mats",
      "isPrimary": false
    }
  ],
  "habitat": "Humidicutis pura thrives in damp, mossy habitats such as moist forest floors, lawns, and boggy areas throughout New England.",
