  "nameStory": "",
  "description": "The Tinkling Ground Cricket is a small, dark-colored cricket belonging to the family Gryllacrididae, commonly found throughout New England. These crickets are known for their distinctive tinkling calls produced by males during breeding season.",
  "idTips": [
    {
      "label": "Small Size",
      "description": "Typically 8-11 mm in length, making it one of the smallest cricket species in the region",
      "isPrimary": false
    },
    {
      "label": "Distinctive Call",
      "description": "Produces a rapid, high-pitched tinkling or jingling sound, quite different from other local cricket species",
      "isPrimary": true
    },
    {
      "label": "Dark Coloration",
      "description": "Generally brown to dark brown in color with a somewhat flattened body shape",
      "isPrimary": false
    }
  ],
  "habitat": "Found in leaf litter, under logs, and in damp soil areas of woodlands, gardens, and fields throughout New England during late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The tinkling call of males can reach over 100 decibels in intensity despite the cricket's tiny size, making it one of the loudest insects relative to its body size.",
