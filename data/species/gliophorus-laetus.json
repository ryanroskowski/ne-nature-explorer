  "nameStory": "",
  "description": "The Heath Waxcap is a small, delicate fungus characterized by its bright red to orange-red coloring and waxy appearance. This species is part of the diverse waxcap family, known for their vibrant colors and distinctive texture.",
  "idTips": [
    {
      "label": "Bright Red-Orange Color",
      "description": "Distinctive vivid red to orange-red cap that fades slightly with age",
      "isPrimary": true
    },
    {
      "label": "Waxy Texture",
      "description": "Smooth, shiny, waxy surface on both cap and gills that feels slippery to the touch",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Typically 1-3 cm in diameter with thin, delicate stems",
      "isPrimary": false
    }
  ],
  "habitat": "Heath Waxcaps prefer acidic, nutrient-poor grasslands and heathland areas common throughout New England, particularly in areas with moss and low vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps are indicators of healthy, unimproved grasslands and are increasingly rare in agricultural regions, making them valuable for conservation monitoring.",
