  "nameStory": "",
  "description": "The Tropical House Cricket is a small, dark-colored cricket species that has adapted to indoor environments and is commonly found in heated buildings throughout New England. Despite its tropical origins, this species thrives in human structures where it can find warmth, food, and shelter.",
  "idTips": [
    {
      "label": "Body Color",
      "description": "Dark brown to black coloration with a compact, robust body shape",
      "isPrimary": true
    },
    {
      "label": "Size",
      "description": "Small cricket, typically 16-20 mm in length",
      "isPrimary": false
    },
    {
      "label": "Cerci",
      "description": "Short cerci (tail-like appendages) at the rear of the abdomen",
      "isPrimary": false
    }
  ],
  "habitat": "Found exclusively in warm indoor environments such as basements, attics, and heated buildings in New England, where they cannot survive outdoors during winter months.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Tropical House Crickets produce their characteristic chirping sound by rubbing their wings together at rates of 160 chirps per minute, and the frequency of their chirping increases with temperature.",
