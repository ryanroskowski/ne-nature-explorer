  "nameStory": "",
  "description": "Bleeding porecrust (Meripilus sanguinolentus) is a polypore fungus in the Meripilaceae family characterized by its distinctive reddish-brown coloration and tendency to produce blood-like droplets when fresh. This wood-decay fungus forms shelf-like fruiting bodies that typically appear in clusters on hardwood trees and logs.",
  "idTips": [
    {
      "label": "Red bleeding droplets",
      "description": "Fresh specimens produce distinctive reddish or blood-like liquid droplets on the surface, especially in humid conditions",
      "isPrimary": true
    },
    {
      "label": "Pore surface color",
      "description": "The underside displays small, angular pores that are initially white to pale yellow, darkening to brown with age or when bruised",
      "isPrimary": false
    },
    {
      "label": "Clustered shelf growth",
      "description": "Fruiting bodies grow in tiered, overlapping shelves or brackets directly from hardwood substrates",
      "isPrimary": false
    }
  ],
  "habitat": "Bleeding porecrust typically grows on dead or dying hardwood trees, logs, and stumps throughout New England, preferring oak and other deciduous species in moist forest environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The red droplets that give this fungus its common name are actually a form of guttation—the fungus actively exudes liquid through its pores, possibly to facilitate spore dispersal or regulate moisture.",
