  "nameStory": "",
  "description": "Hypomyces cervinigenus is a parasitic fungus belonging to the Hypocreaceae family that infects other fungi, particularly those in the bolete and russulae groups. This ascomycete is found in the moist forest ecosystems of New England and plays an important ecological role as a mycoparasite.",
  "idTips": [
    {
      "label": "Host fungus transformation",
      "description": "Appears as a whitish to tan, cobweb-like coating that gradually transforms the host fungus's appearance, making it appear mummified or desiccated",
      "isPrimary": true
    },
    {
      "label": "Fruiting body characteristics",
      "description": "Produces tiny flask-shaped perithecia (fruiting bodies) embedded in the host tissue, visible under magnification as small dark points",
      "isPrimary": false
    },
    {
      "label": "Host association",
      "description": "Specifically targets boletes and russulas, causing them to become distorted, discolored, and crumbly in texture",
      "isPrimary": false
    }
  ],
  "habitat": "Hypomyces cervinigenus thrives in the damp deciduous and mixed forests of New England, particularly in areas with high humidity and abundant host fungi during late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is a 'fungus-eater' that hijacks other fungi for reproduction, turning its hosts into mummified structures—a fascinating example of parasitism in the fungal kingdom that demonstrates nature's complex food webs.",
  "confusionNotes": null,
