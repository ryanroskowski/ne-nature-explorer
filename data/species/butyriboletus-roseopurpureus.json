  "nameStory": "",
  "description": "Butyriboletus roseopurpureus, commonly known as the Rosy Bolete, is a medium-sized fungus in the bolete family characterized by its distinctive pinkish-red coloring on the cap and stem. It is found in New England woodlands where it plays an important ecological role as a mycorrhizal fungus associated with trees.",
  "idTips": [
    {
      "label": "Cap and Stem Color",
      "description": "Distinctive rosy-pink to purplish-red coloring on the cap surface and stem, particularly prominent when young",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "Yellow pores on the underside that may develop reddish tones with age or when bruised",
      "isPrimary": false
    },
    {
      "label": "Flesh Texture",
      "description": "Soft, buttery flesh (hence the genus name Butyriboletus) that bruises easily and may show color changes",
      "isPrimary": false
    }
  ],
  "habitat": "This species favors mixed deciduous and coniferous forests throughout New England, typically appearing in summer and fall months in association with hardwoods and conifers.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Butyriboletus refers to the mushroom's characteristically soft, butter-like flesh that is unusually fragile compared to other boletes.",
