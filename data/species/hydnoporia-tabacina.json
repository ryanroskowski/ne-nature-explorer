  "nameStory": "",
  "description": "Hydnoporia tabacina, commonly known as willow glue, is a wood-decay fungus in the Hymenochaetaceae family characterized by its distinctive sticky, glue-like appearance. This polypore typically forms shelf-like fruiting bodies on dead or dying hardwood, particularly willow and other deciduous trees throughout New England.",
  "idTips": [
    {
      "label": "Sticky, Gelatinous Surface",
      "description": "The upper surface is wet and viscous to the touch, feeling distinctly glue-like or sticky, especially when fresh",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "The underside features small, angular pores that are typically rusty-brown to dark brown in color",
      "isPrimary": false
    },
    {
      "label": "Host Preference",
      "description": "Most commonly found fruiting on willow (Salix species), though it can occur on other hardwoods",
      "isPrimary": false
    }
  ],
  "habitat": "Willow glue grows on dead or declining hardwood, particularly willow trees, in moist woodlands and riparian areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The sticky, gelatinous nature of this fungus is thought to help it retain moisture in its environment and may aid in spore dispersal.",
