  "nameStory": "",
  "description": "Peroneutypa scoparia is a fungal species in the Diatrypaceae family that acts as a wood decomposer and plant pathogen in New England forests. It produces distinctive fruiting bodies and plays an important ecological role in nutrient cycling within hardwood ecosystems.",
  "idTips": [
    {
      "label": "Perithecia arrangement",
      "description": "Organized in a distinctive stromatic structure (flask-shaped fruiting bodies) embedded in host wood",
      "isPrimary": true
    },
    {
      "label": "Host wood appearance",
      "description": "Causes darkened, charred-looking cankers on dead or dying hardwood branches and stems",
      "isPrimary": false
    },
    {
      "label": "Spore characteristics",
      "description": "Produces hyaline (clear), elongated ascospores visible under microscopic examination",
      "isPrimary": false
    }
  ],
  "habitat": "Peroneutypa scoparia colonizes dead and dying hardwood branches in deciduous and mixed forests throughout New England, particularly on stressed or recently killed trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Diatrypaceae family like P. scoparia are master wood recyclers, breaking down fallen branches and dead trees into nutrients that feed the forest soil.",
