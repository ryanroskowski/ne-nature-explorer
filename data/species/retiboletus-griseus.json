  "nameStory": "",
  "description": "The Grey Bolete (Retiboletus griseus) is a medium-sized bolete with a distinctive grayish-brown cap and yellow pores that bruise blue when handled. It is found throughout New England and other temperate regions of North America, typically fruiting in summer and fall.",
  "idTips": [
    {
      "label": "Blue-bruising pores",
      "description": "The yellow pores underneath the cap quickly turn blue when pressed or bruised, a key diagnostic feature.",
      "isPrimary": true
    },
    {
      "label": "Grayish-brown cap",
      "description": "The cap is typically gray to grayish-brown with a slightly velvety texture and can reach 3-7 inches in diameter.",
      "isPrimary": false
    },
    {
      "label": "Yellow stem with reticulation",
      "description": "The stem is yellow and often has a fine net-like pattern (reticulation), particularly in the upper portion.",
      "isPrimary": false
    }
  ],
  "habitat": "The Grey Bolete fruitsolicitorily in mixed hardwood and coniferous forests throughout New England, often appearing near oak, beech, and pine trees on well-drained forest floors.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its striking blue bruising reaction—which occurs due to oxidation of boletol compounds—the Grey Bolete is considered inedible and may cause gastrointestinal upset if consumed.",
