  "nameStory": "",
  "description": "Albatrellopsis confluens is a polypore fungus belonging to the Albatrellaceae family, characterized by its small, shelf-like fruiting bodies with decurrent pores. This species is a wood-decay fungus commonly found in coniferous and mixed forests throughout New England.",
  "idTips": [
    {
      "label": "Confluent Pores",
      "description": "The pores are notably angular and often merge or run together (confluent), distinguishing it from related species with more uniform, separate pores.",
      "isPrimary": true
    },
    {
      "label": "Cap Texture",
      "description": "The cap surface is typically tan to ochre-brown and has a somewhat wrinkled or uneven appearance.",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Fruiting bodies are relatively small and clustered or overlapping, rarely exceeding 5 cm in diameter.",
      "isPrimary": false
    }
  ],
  "habitat": "Albatrellopsis confluens grows on decaying wood and woody debris in cool, moist coniferous and mixed forests, particularly in areas with abundant fallen logs and dead wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Albatrellaceae family are among the few polypores that fruit from the ground or wood at the base of trees, making them important decomposers in forest ecosystems.",
