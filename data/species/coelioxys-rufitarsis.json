  "nameStory": "",
  "description": "The Red-footed Cuckoo Leafcutter (Coelioxys rufitarsis) is a small parasitic bee species belonging to the leafcutter bee family, found throughout New England. Unlike other leafcutter bees, this species is a cuckoo bee that lays its eggs in the nests of host bees rather than constructing its own nests.",
  "idTips": [
    {
      "label": "Red/Reddish Tarsi",
      "description": "Distinctive reddish or rust-colored hind legs (tarsi) are the defining characteristic that gives this species its common name.",
      "isPrimary": true
    },
    {
      "label": "Pointed Abdomen",
      "description": "The abdomen typically has a sharp point or spine at the tip, which is characteristic of Coelioxys cuckoo bees and used for depositing eggs in host nests.",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "This bee is relatively small, typically measuring 6-8mm in length, making it smaller than many other leafcutter bee species.",
      "isPrimary": false
    }
  ],
  "habitat": "Red-footed Cuckoo Leafcutters are found in open woodlands, gardens, and meadows throughout New England where their host leafcutter bees are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, the Red-footed Cuckoo Leafcutter practices brood parasitism, sneaking into the nests of other leafcutter bees to lay its eggs, allowing the host bee to raise its young without the parasite contributing any parental care.",
