  "nameStory": "",
  "description": "Woolly Velvet Polypore is a small, shelf-like fungus characterized by its soft, velvety surface and russet-brown coloring. This wood-decomposing species belongs to the Hymenochaetaceae family and plays an important role in nutrient cycling in forest ecosystems.",
  "idTips": [
    {
      "label": "Velvety Surface Texture",
      "description": "The upper surface has a distinctive soft, fuzzy, velvet-like appearance that feels almost woolly to the touch",
      "isPrimary": true
    },
    {
      "label": "Pore Color and Size",
      "description": "The underside features small, angular pores that are typically rust-brown to cinnamon-colored",
      "isPrimary": false
    },
    {
      "label": "Small Fruiting Bodies",
      "description": "Generally forms small brackets or shelf-like structures, usually less than 5 cm wide, with a thin, fragile structure",
      "isPrimary": false
    }
  ],
  "habitat": "Woolly Velvet Polypore grows on dead hardwood logs and branches throughout New England forests, preferring oak and other deciduous trees in moist, shaded woodland environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate, fuzzy appearance, this polypore is a persistent wood-decomposer that helps break down tough lignin in dead trees, making nutrients available to the forest floor ecosystem.",
