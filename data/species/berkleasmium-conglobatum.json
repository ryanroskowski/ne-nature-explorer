  "nameStory": "",
  "description": "Berkleasmium conglobatum is a fungal species in the Tubeufiaceae family, characterized by its distinctive globose (spherical) fruiting bodies and dark pigmentation. This saprotroph plays an important ecological role in decomposing woody plant material throughout New England forests.",
  "idTips": [
    {
      "label": "Globose Ascomata",
      "description": "Distinctive round, ball-shaped fruiting bodies that are tightly clustered together on the substrate",
      "isPrimary": true
    },
    {
      "label": "Dark Pigmentation",
      "description": "Black to dark brown coloration of the perithecial walls when viewed under magnification",
      "isPrimary": false
    },
    {
      "label": "Spore Morphology",
      "description": "Eight ascospores per ascus with characteristic shape and wall ornamentation visible in microscopic examination",
      "isPrimary": false
    }
  ],
  "habitat": "Berkleasmium conglobatum is typically found on decaying hardwood substrates and woody debris in moist, shaded forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its cryptic nature and small size, Berkleasmium conglobatum is an important member of the decomposer community, helping to recycle nutrients back into forest ecosystems by breaking down dead plant material that other organisms cannot easily access.",
