  "nameStory": "",
  "description": "Pluteus hongoi is a small woodland mushroom in the Pluteaceae family, characterized by its delicate appearance and distinctive features. It is found in New England and other temperate regions, typically fruiting on decaying wood.",
  "idTips": [
    {
      "label": "Pink Spore Print",
      "description": "Produces a distinctive pink spore print, a key characteristic of the Pluteus genus",
      "isPrimary": true
    },
    {
      "label": "Free Gills",
      "description": "Gills are free (not attached to the stem) and crowded together, differentiating it from similar species",
      "isPrimary": false
    },
    {
      "label": "Small Cap Size",
      "description": "Features a small, convex to bell-shaped cap typically 1-3 cm in diameter with a pale to grayish coloration",
      "isPrimary": false
    }
  ],
  "habitat": "Pluteus hongoi grows on decaying hardwood logs, stumps, and woody debris in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all members of the Pluteus genus, this mushroom is saprophytic, meaning it plays an important ecological role by breaking down dead wood and recycling nutrients back into the forest ecosystem.",
