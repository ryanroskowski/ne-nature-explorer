  "nameStory": "",
  "description": "The Pavement Mushroom (Agaricus bitorquis) is a small, robust fungus in the Field Mushrooms and Allies family, characterized by its ability to fruit in urban and disturbed environments. It produces white to grayish caps and has a distinctive double ring on its stem, making it readily identifiable among similar species.",
  "idTips": [
    {
      "label": "Double Ring on Stem",
      "description": "Features two distinct rings (annuli) on the stem, a characteristic that distinguishes it from most other Agaricus species which typically have only one ring",
      "isPrimary": true
    },
    {
      "label": "Cap Color and Texture",
      "description": "White to pale grayish cap with a smooth to slightly scaly surface, typically 2-5 cm in diameter",
      "isPrimary": false
    },
    {
      "label": "Crowded Gills",
      "description": "Pink to brown gills that are closely spaced and free from the stem, aging from white to dark brown",
      "isPrimary": false
    }
  ],
  "habitat": "Found in disturbed urban and suburban environments, including sidewalk cracks, landscaped beds, and compacted soil throughout New England during spring and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Pavement Mushroom is remarkably resilient and can push through asphalt and concrete, earning its common name as one of the few mushrooms adapted to thrive in highly urbanized settings.",
