  "nameStory": "",
  "description": "Collybiopsis subnuda is a small, delicate mushroom belonging to the Omphalotaceae family, characterized by its thin flesh and modest stature. Found throughout New England, it inhabits moist forest floors and decomposing wood substrates.",
  "idTips": [
    {
      "label": "Cap appearance",
      "description": "Small, convex to flat cap that is pale grayish-brown to tan, often with a slightly depressed center",
      "isPrimary": true
    },
    {
      "label": "Stem characteristics",
      "description": "Thin, fibrous, hollow stem that is lighter in color than the cap and lacks a distinct ring or cup-like base",
      "isPrimary": false
    },
    {
      "label": "Gill attachment",
      "description": "Narrow, crowded gills that are adnate to slightly decurrent, typically pale whitish to grayish",
      "isPrimary": false
    }
  ],
  "habitat": "Collybiopsis subnuda thrives in moist, shaded deciduous and mixed forests, typically fruiting on decomposing leaves, woody debris, and humus-rich soil throughout New England's temperate woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Omphalotaceae family, including Collybiopsis subnuda, are sometimes called 'bonnet fungi' due to their small, hat-like appearance, and many species in this family are saprotrophs that play an important ecological role in forest nutrient cycling.",
