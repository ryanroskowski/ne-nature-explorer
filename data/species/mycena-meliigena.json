  "nameStory": "",
  "description": "Mycena meliigena, commonly known as the mauve bonnet, is a small delicate mushroom characterized by its distinctive mauve to lilac-colored cap. This species belongs to the Mycenaceae family, a group of tiny fungi commonly found decomposing wood and leaf litter in forest ecosystems.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Distinctive mauve to lilac coloration on the small, bell-shaped cap",
      "isPrimary": true
    },
    {
      "label": "Stem Appearance",
      "description": "Thin, fragile stem that is typically paler than the cap with a delicate texture",
      "isPrimary": false
    },
    {
      "label": "Gill Structure",
      "description": "Closely spaced, narrow gills that are pale or whitish and adnate to adnexed",
      "isPrimary": false
    }
  ],
  "habitat": "Mycena meliigena grows on decaying hardwood logs, stumps, and leaf litter in moist woodland areas throughout New England, particularly in late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Mycena genus are among the smallest mushrooms in the forest, and some species in this group produce bioluminescent displays, earning them the nickname 'ghost fungi.'",
