  "nameStory": "",
  "description": "The Hairy Sweat Bee (Lasioglossum pilosum) is a small, solitary bee species belonging to the Halictidae family, commonly found throughout New England. These native bees are important pollinators that are attracted to human perspiration, hence their common name.",
  "idTips": [
    {
      "label": "Body Hair",
      "description": "Dense, noticeable body hair covering the abdomen and thorax, giving it a distinctly fuzzy appearance",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Typically 4-6mm in length, making it one of the smallest bee species in the region",
      "isPrimary": false
    },
    {
      "label": "Metallic Coloring",
      "description": "Dark body with greenish or bluish metallic reflections visible on the head and thorax",
      "isPrimary": false
    }
  ],
  "habitat": "Hairy Sweat Bees inhabit open woodlands, meadows, gardens, and other sunny areas with diverse flowering plants throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "These bees are attracted to human sweat for its salt content, which they need for their diet, leading to their charming common name despite being harmless to people.",
  "confusionNotes": null,
  "contextualKnowledge": null,
