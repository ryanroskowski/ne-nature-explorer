  "nameStory": "",
  "description": "Lentil Shanklet (Collybia tuberosa) is a small, delicate mushroom characterized by its thin, wiry stem and tiny lentil-shaped sclerotium at its base. This fungus belongs to the Clitocybaceae family and is found in New England forests during the cooler months.",
  "idTips": [
    {
      "label": "Lentil-shaped Sclerotium",
      "description": "A distinctive hard, brown, lentil-like tuber at the base of the stem that connects to decaying wood or other fungi",
      "isPrimary": true
    },
    {
      "label": "Thin, Wiry Stem",
      "description": "The stalk is exceptionally thin, brittle, and often appears translucent or pale, contrasting sharply with the small cap",
      "isPrimary": false
    },
    {
      "label": "Tiny Cap",
      "description": "The mushroom cap is very small (typically 0.5-1 cm), whitish or pale brown, and convex to nearly flat",
      "isPrimary": false
    }
  ],
  "habitat": "Lentil Shanklet grows in moist woodlands and forests of New England, typically appearing on decaying wood, leaf litter, and mossy substrates during fall and early winter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The sclerotium at the base of Collybia tuberosa appears to be a survival structure that allows the fungus to persist through harsh conditions and sprout new fruiting bodies when conditions improve.",
