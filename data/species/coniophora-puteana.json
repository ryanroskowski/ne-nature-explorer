  "nameStory": "",
  "description": "Coniophora puteana, commonly known as wet rot, is a wood-decaying fungus in the Coniophoraceae family that causes significant structural damage to buildings in damp conditions. It is particularly prevalent in New England due to the region's moisture-rich climate and is one of the most economically important wood-decay fungi in northern temperate regions.",
  "idTips": [
    {
      "label": "Fruiting Body Color",
      "description": "The fruiting bodies are typically dark brown to black, appearing as thin, paper-like sheets or crusts on affected wood",
      "isPrimary": true
    },
    {
      "label": "Wood Damage Pattern",
      "description": "Produces cubical cracking patterns in heavily decayed wood, with affected areas becoming dark brown and deeply fissured",
      "isPrimary": false
    },
    {
      "label": "Musty Odor",
      "description": "Infected wood emits a distinctive musty, unpleasant smell characteristic of active wet rot decay",
      "isPrimary": false
    }
  ],
  "habitat": "Coniophora puteana thrives in persistently moist wood with moisture content above 25%, commonly found in damp basements, crawl spaces, and areas with poor ventilation or water intrusion in New England buildings.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Wet rot produces a network of thin, thread-like structures called rhizomorphs that can transport water across non-decayed wood, allowing the fungus to spread beyond its initial infection site even in relatively dry conditions.",
