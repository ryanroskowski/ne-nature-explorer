  "nameStory": "",
  "description": "The Spotted Ground Cricket (Allonemobius maculatus) is a small cricket belonging to the family Gryllidae, characterized by its diminutive size and distinctive spotted pattern. Found throughout New England, this species is a common inhabitant of grassy areas and is known for its chirping calls during late summer and fall.",
  "idTips": [
    {
      "label": "Dark spots on pale background",
      "description": "The body displays characteristic dark spots or blotches on a lighter tan or brown background, giving the species its 'spotted' name",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "This is one of the smallest cricket species in North America, typically measuring only 6-8 mm in length",
      "isPrimary": false
    },
    {
      "label": "Cerci and antennae",
      "description": "Possesses long, thread-like antennae and prominent cerci (tail-like appendages) at the rear of the abdomen",
      "isPrimary": false
    }
  ],
  "habitat": "Spotted Ground Crickets thrive in grassy meadows, fields, roadsides, and the margins of woodlands throughout New England, preferring areas with dense vegetation and moderate moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
