  "nameStory": "",
  "description": "The Blackwater Bluet is a small damselfly belonging to the Coenagrionidae family, characterized by its slender body and delicate wings. It is endemic to New England and prefers acidic, nutrient-poor waters, making it an indicator species for pristine blackwater habitats.",
  "idTips": [
    {
      "label": "Dark coloration",
      "description": "Males display a distinctive dark blue or black coloration on the abdomen with minimal pale markings, darker than most other bluet species",
      "isPrimary": true
    },
    {
      "label": "Wing venation",
      "description": "Narrow wings with a characteristic venation pattern typical of Enallagma species, appearing delicate and transparent",
      "isPrimary": false
    },
    {
      "label": "Habitat association",
      "description": "Found exclusively in blackwater and acidic bog pools with sphagnum moss, a habitat preference that distinguishes it from related species",
      "isPrimary": false
    }
  ],
  "habitat": "The Blackwater Bluet inhabits acidic blackwater streams, ponds, and sphagnum bogs throughout New England, preferring nutrient-poor waters with abundant aquatic vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a species dependent on acidic, oligotrophic (nutrient-poor) waters, the Blackwater Bluet serves as a bioindicator of healthy bog and blackwater ecosystems in New England, making it valuable for environmental monitoring.",
