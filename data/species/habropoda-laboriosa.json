  "nameStory": "",
  "description": "The Blueberry Digger Bee (Habropoda laboriosa) is a solitary bee species native to the southeastern United States that has become important for pollinating cultivated blueberries. Despite being called a 'digger bee,' it belongs to the family Apidae, which includes honey bees and bumble bees, and is known for its efficiency in buzz pollinating blueberry flowers.",
  "idTips": [
    {
      "label": "Dark coloration with golden hairs",
      "description": "Medium-sized bee with predominantly black body and distinctive golden or tan-colored hair on the thorax and legs",
      "isPrimary": true
    },
    {
      "label": "Robust, stocky build",
      "description": "Compact body shape typical of solitary bees, slightly smaller than bumble bees",
      "isPrimary": false
    },
    {
      "label": "Prominent pollen baskets",
      "description": "Visible concave areas on hind legs (corbiculae) for carrying pollen",
      "isPrimary": false
    }
  ],
  "habitat": "Blueberry Digger Bees inhabit open woodlands, fields, and cultivated blueberry farms in warm, sunny areas with sandy or loose soil suitable for nesting.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "These bees are such specialized and efficient blueberry pollinators that commercial blueberry growers in the Southeast actively manage nesting sites and transport hives to farms during blueberry bloom season.",
