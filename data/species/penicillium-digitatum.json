  "nameStory": "",
  "description": "Penicillium digitatum, commonly known as citrus green mold, is a fungal pathogen belonging to the Aspergillaceae family that primarily affects citrus fruits during storage and transportation. This economically important mold causes significant postharvest losses in citrus crops, including those grown in cooler New England regions.",
  "idTips": [
    {
      "label": "Distinctive Green Coloration",
      "description": "Produces characteristic blue-green to olive-green mold growth on infected fruit surfaces, making it visually distinctive from other citrus pathogens.",
      "isPrimary": true
    },
    {
      "label": "Soft, Watery Lesions",
      "description": "Infections begin as small, soft, water-soaked lesions on the fruit skin that rapidly enlarge and become colonized by the mold.",
      "isPrimary": false
    },
    {
      "label": "Citrus Preference",
      "description": "Shows strong host specificity for citrus fruits, particularly affecting lemons, limes, and oranges through wounds and natural fruit openings.",
      "isPrimary": false
    }
  ],
  "habitat": "Penicillium digitatum thrives in cool, humid storage facilities and during postharvest handling of citrus fruits, making it a particular concern in New England's cool-storage agricultural environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus was one of the first organisms used to produce penicillin, the antibiotic that revolutionized medicine, though the strains used medicinally differ from the agricultural pest variety.",
