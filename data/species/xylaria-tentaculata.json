  "nameStory": "",
  "description": "Fairy sparklers (Xylaria tentaculata) are small, dark fungi in the Xylariaceae family that produce distinctive club-shaped fruiting bodies. These wood-decomposing organisms are commonly found in forested areas throughout New England, particularly on decaying hardwood.",
  "idTips": [
    {
      "label": "Tentacle-like Branches",
      "description": "Multiple thin, finger-like projections extending from a common base, resembling tiny sparklers or sea anemones",
      "isPrimary": true
    },
    {
      "label": "Dark Coloration",
      "description": "Black or very dark brown fruiting bodies that become powdery white when spores mature",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Fruiting bodies typically 1-3 cm tall, making them easy to overlook on forest floors",
      "isPrimary": false
    }
  ],
  "habitat": "Fairy sparklers thrive on decaying hardwood logs and woody debris in moist, shaded forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The common name 'fairy sparklers' comes from their whimsical, branched appearance that resembles miniature fireworks frozen in time.",
