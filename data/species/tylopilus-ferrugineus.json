  "nameStory": "",
  "description": "Tylopilus ferrugineus, commonly known as the Boletus ferrugineus or rusty bolete, is a member of the Boletaceae family characterized by its distinctive reddish-brown coloration and pored underside. This edible bolete is found throughout New England and is recognized by mushroom foragers as a choice edible when properly prepared.",
  "idTips": [
    {
      "label": "Rusty-Red Coloration",
      "description": "The cap and stem display a distinctive rusty-red to reddish-brown color that is the primary identifying feature",
      "isPrimary": true
    },
    {
      "label": "Yellow Pores",
      "description": "The underside features bright yellow pores that may bruise greenish when handled or pressed",
      "isPrimary": false
    },
    {
      "label": "Solid Flesh",
      "description": "The flesh is firm and solid throughout, with a pale color that does not significantly change when cut",
      "isPrimary": false
    }
  ],
  "habitat": "Tylopilus ferrugineus grows on the forest floor in deciduous and mixed forests throughout New England, typically fruiting in summer and early fall under hardwood trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its edible status in some regions, this bolete has a somewhat bitter taste and is best enjoyed when young and fresh, or after proper preparation methods that help reduce any bitter compounds.",
