  "nameStory": "",
  "description": "Cedar-Hawthorn Rust is a fungal disease caused by Gymnosporangium globosum that affects juniper and hawthorn species throughout New England. This heteroecious rust requires two different host plants to complete its life cycle, alternating between cedar/juniper and hawthorn trees.",
  "idTips": [
    {
      "label": "Gelatinous Orange Horns on Juniper",
      "description": "Look for distinctive bright orange, gelatinous, horn-like structures (telial horns) that emerge from infected juniper branches in spring, especially after wet weather",
      "isPrimary": true
    },
    {
      "label": "Yellow-Orange Spots on Hawthorn Leaves",
      "description": "Yellow to orange circular lesions appear on hawthorn leaves and fruit during summer, often with a red halo around the infection area",
      "isPrimary": false
    },
    {
      "label": "Galls on Juniper Twigs",
      "description": "Swollen, irregular galls may develop on juniper branches where the fungus overwinters and produces spores",
      "isPrimary": false
    }
  ],
  "habitat": "Cedar-Hawthorn Rust thrives in cool, moist conditions typical of New England forests and gardens where both juniper and hawthorn species grow in proximity to each other.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This rust fungus is one of the few plant pathogens that requires two completely different plant species to survive—it cannot complete its life cycle on a single host, making it an obligate heteroecious parasite.",
