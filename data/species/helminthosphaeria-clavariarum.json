  "nameStory": "",
  "description": "Helminthosphaeria clavariarum is a fungal species belonging to the Helminthosphaeriaceae family, characterized by its dark, club-shaped or cylindrical fruiting structures. This saprotroph is commonly found decomposing plant debris in New England forests and moist environments.",
  "idTips": [
    {
      "label": "Club-shaped Ascomata",
      "description": "Distinctive dark, clavate (club-shaped) or cylindrical fruiting bodies that are easily visible to the naked eye",
      "isPrimary": true
    },
    {
      "label": "Dark Pigmentation",
      "description": "Deep brown to black coloration of the fruiting structures and perithecia",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Found exclusively on decomposing wood and plant matter in moist forest settings",
      "isPrimary": false
    }
  ],
  "habitat": "Helminthosphaeria clavariarum thrives in moist, shaded forest environments across New England, growing on decaying wood, leaf litter, and decomposing plant debris.",
