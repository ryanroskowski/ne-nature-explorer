  "nameStory": "",
  "description": "Lycoperdon subincarnatum, commonly known as the rosy puffball, is a small to medium-sized fungus in the puffball family found in New England woodlands and grassy areas. This species is notable for its distinctive pinkish or reddish coloration that fades to tan or brown as it matures.",
  "idTips": [
    {
      "label": "Color",
      "description": "Young fruiting bodies display a characteristic rosy or flesh-pink exterior that gradually fades to tan, brown, or grayish with age",
      "isPrimary": true
    },
    {
      "label": "Size and Shape",
      "description": "Small, rounded or pear-shaped fruiting bodies typically 1-2 inches tall with a distinctive stalk-like base (pseudostipe)",
      "isPrimary": false
    },
    {
      "label": "Surface Texture",
      "description": "Covered with small spines or granules that eventually wear away, leaving a smooth or slightly wrinkled surface",
      "isPrimary": false
    }
  ],
  "habitat": "Lycoperdon subincarnatum prefers moist woodlands, forest edges, and grassy meadows throughout New England, often appearing in clusters on rich soil or mossy ground.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all puffballs, this fungus disperses its spores through a small opening at the top called an ostiole, releasing a visible cloud of spores when the mature fruiting body is squeezed by rain or animals.",
