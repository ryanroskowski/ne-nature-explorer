  "nameStory": "",
  "description": "Bruner's Sweat Bee (Lasioglossum bruneri) is a small, solitary bee species native to New England and eastern North America. These metallic green bees are important native pollinators that visit a variety of flowering plants throughout the summer months.",
  "idTips": [
    {
      "label": "Metallic coloration",
      "description": "Distinctive bright green to blue-green metallic body, particularly on the head and thorax",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Tiny bee, typically 4-5mm in length, making it one of the smaller sweat bee species",
      "isPrimary": false
    },
    {
      "label": "Sparse body hair",
      "description": "Relatively fine and sparse hair compared to other bee species, with visible smooth abdominal segments",
      "isPrimary": false
    }
  ],
  "habitat": "Bruner's Sweat Bee prefers open meadows, gardens, and woodland edges with abundant flowering plants and access to nesting sites in bare ground or soft soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their name, sweat bees are attracted to human perspiration for the salt content, though they are generally docile and rarely sting unless directly threatened.",
  "confusionNotes": null,
  "contextualKnowledge": null,
