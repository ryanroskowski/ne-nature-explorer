  "nameStory": "",
  "description": "The Little Yellow is a small butterfly with a wingspan of 1.2-1.5 inches, belonging to the Pieridae family (Whites, Yellows, and Sulphurs). It is one of the most common and widespread yellow butterflies throughout New England and eastern North America.",
  "idTips": [
    {
      "label": "Small Size",
      "description": "Noticeably smaller than most other yellow butterflies in the region, making size one of the easiest first indicators.",
      "isPrimary": false
    },
    {
      "label": "Bright Yellow Wings",
      "description": "Males are bright yellow with small black spots on the forewing tips; females are paler yellow or white with darker markings.",
      "isPrimary": true
    },
    {
      "label": "Black Border on Hindwing",
      "description": "Look for a distinctive narrow black border along the edges of the hindwings, especially visible when wings are closed.",
      "isPrimary": false
    }
  ],
  "habitat": "Little Yellows prefer open, sunny areas including roadsides, fields, gardens, and disturbed areas where their host plants (clover and other legumes) are abundant.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Little Yellows are one of the first butterflies to emerge in spring and one of the last to disappear in fall, sometimes having three or more generations per year in New England.",
