  "nameStory": "",
  "description": "The Patchwork Leafcutter Bee is a medium-sized solitary bee known for its distinctive patterned abdomen with alternating light and dark bands. Native to Europe but now established in New England, this species is an important pollinator that cuts circular pieces from leaves to line its nesting tunnels.",
  "idTips": [
    {
      "label": "Patterned Abdomen",
      "description": "Distinctive alternating bands of light and dark coloration on the abdomen, giving it a patchwork appearance",
      "isPrimary": true
    },
    {
      "label": "Body Size",
      "description": "Medium-sized bee, approximately 8-10mm in length, slightly smaller than honeybees",
      "isPrimary": false
    },
    {
      "label": "Leaf-Cutting Behavior",
      "description": "Often observed making precise, circular cuts from leaves of roses, beans, and other plants",
      "isPrimary": false
    }
  ],
  "habitat": "Patchwork Leafcutter Bees prefer open woodlands, gardens, and meadows in New England where suitable nesting sites and flowering plants are abundant.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female Patchwork Leafcutter Bees use their powerful mandibles to cut perfect circular pieces from leaves, which they use to construct individual brood cells inside hollow stems or tunnels, creating a living nursery for their offspring.",
  "confusionNotes": null,
  "contextualKnowledge": null,
