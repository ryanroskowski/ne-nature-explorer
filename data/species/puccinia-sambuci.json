  "nameStory": "",
  "description": "Elderberry Rust (Puccinia sambuci) is a fungal pathogen belonging to the Pucciniaceae family that primarily affects elderberry plants throughout New England. This rust disease produces distinctive pustules on plant tissues and requires specific environmental conditions to complete its complex life cycle.",
  "idTips": [
    {
      "label": "Pustule Appearance",
      "description": "Look for small, reddish-orange to brown pustules (spore-producing structures) that appear on the undersides of elderberry leaves and stems",
      "isPrimary": true
    },
    {
      "label": "Leaf Discoloration",
      "description": "Infected leaves often display yellowish or reddish spots on the upper surface that correspond to pustule locations underneath",
      "isPrimary": false
    },
    {
      "label": "Seasonal Timing",
      "description": "Pustules are most visible during wet weather in spring and early summer when humidity favors fungal development",
      "isPrimary": false
    }
  ],
  "habitat": "Puccinia sambuci thrives in moist environments on elderberry (Sambucus species) plants found in woodlands, field edges, and cultivated areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many rust fungi, Puccinia sambuci has a complex life cycle involving multiple spore stages and may require an alternate host plant to complete its full reproductive cycle.",
