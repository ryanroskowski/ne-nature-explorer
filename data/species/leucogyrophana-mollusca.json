  "nameStory": "",
  "description": "Leucogyrophana mollusca is a small, delicate fungus belonging to the Hygrophoropsidaceae family, characterized by its distinctive gelatinous texture and pale coloration. This species is found in moist forest environments throughout New England, where it plays a role in wood decomposition.",
  "idTips": [
    {
      "label": "Gelatinous Texture",
      "description": "The fruiting bodies have a distinctly slimy, gelatinous consistency that is wet and translucent",
      "isPrimary": true
    },
    {
      "label": "Pale Coloration",
      "description": "Typically whitish to cream-colored with minimal pigmentation",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Fruiting bodies are generally less than 5mm in diameter, requiring magnification for detailed observation",
      "isPrimary": false
    }
  ],
  "habitat": "Leucogyrophana mollusca is found on decaying wood and leaf litter in damp, shaded forest habitats throughout New England, preferring areas with high moisture and rich humus content.",
