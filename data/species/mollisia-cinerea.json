  "nameStory": "",
  "description": "Common grey disco (Mollisia cinerea) is a small ascomycete fungus in the Mollisiaceae family, characterized by its tiny, disc-shaped fruiting bodies. This wood-decay fungus is commonly found throughout New England on decaying hardwood substrates.",
  "idTips": [
    {
      "label": "Disc Shape and Size",
      "description": "Forms minute, dark grey to black disc-shaped fruiting bodies (apothecia) typically 0.5-2 mm in diameter",
      "isPrimary": true
    },
    {
      "label": "Substrate Preference",
      "description": "Grows exclusively on decaying hardwood, particularly on exposed wood surfaces of fallen logs and branches",
      "isPrimary": false
    },
    {
      "label": "Spore Characteristics",
      "description": "Produces hyaline (clear), elongated ascospores visible only under microscopic examination",
      "isPrimary": false
    }
  ],
  "habitat": "Common grey disco thrives on moist, decaying hardwood in forests, woodlands, and disturbed areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its tiny size, Mollisia cinerea plays an important ecological role in wood decomposition, helping break down dead plant material and recycling nutrients back into forest ecosystems.",
