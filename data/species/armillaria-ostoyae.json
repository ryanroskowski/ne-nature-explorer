  "nameStory": "",
  "description": "Armillaria ostoyae, commonly known as Honey Mushroom, is an edible fungus characterized by its golden-brown caps and distinctive ring on the stem. This wood-decomposing species is one of the largest organisms on Earth by mass, with some colonies spanning multiple acres.",
  "idTips": [
    {
      "label": "Ring on Stem",
      "description": "A prominent, movable white or yellowish ring (annulus) encircles the upper stem, which is the most reliable distinguishing feature.",
      "isPrimary": true
    },
    {
      "label": "Cap Color and Texture",
      "description": "Golden-brown to honey-colored caps with small dark fibrils or scales, becoming smoother with age.",
      "isPrimary": false
    },
    {
      "label": "Crowded Gills",
      "description": "Pale yellow to white gills that run down the stem and are tightly packed together.",
      "isPrimary": false
    }
  ],
  "habitat": "Honey Mushrooms grow in clusters on dead or dying hardwood and conifer logs, stumps, and roots throughout New England forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "An Armillaria ostoyae colony in Oregon spans over 2,384 acres and is considered the largest living organism on Earth by mass.",
