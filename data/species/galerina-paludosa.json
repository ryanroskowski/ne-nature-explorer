  "nameStory": "",
  "description": "Bog Bell (Galerina paludosa) is a small, delicate mushroom belonging to the Hymenogastraceae family, characterized by its bell-shaped cap and thin stem. This species is typically found in moist, acidic environments across New England and other temperate regions.",
  "idTips": [
    {
      "label": "Bell-shaped Cap",
      "description": "Distinctive conical to bell-shaped tan or brownish cap that remains relatively intact even when mature",
      "isPrimary": true
    },
    {
      "label": "Thin, Fragile Stem",
      "description": "Slender, hollow stalk that is often the same color as the cap or slightly paler",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Typically measures 1-3 cm in cap diameter, making it easily overlooked in the field",
      "isPrimary": false
    }
  ],
  "habitat": "Bog Bell thrives in wet, boggy areas with dense moss, sphagnum mats, and acidic soils, particularly in shaded woodland wetlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate appearance, Galerina paludosa is remarkably resilient in harsh bog environments where many other fungi cannot survive, playing a role in nutrient cycling in these specialized ecosystems.",
