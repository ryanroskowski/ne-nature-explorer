  "nameStory": "",
  "description": "Colletes nudus, commonly known as the Sumac Cellophane Bee, is a small solitary bee belonging to the Plasterer Bee family (Colletidae), native to New England and eastern North America. These bees are named for their habit of lining their nest cells with a cellophane-like secretion, earning them their distinctive common name.",
  "idTips": [
    {
      "label": "Cellophane-like nest lining",
      "description": "Unlike many bees, C. nudus secretes a waterproof, cellophane-like material to line their underground nest cells, which is diagnostic for the Colletidae family.",
      "isPrimary": true
    },
    {
      "label": "Small size and dark coloration",
      "description": "This species is relatively small (5-7mm) with a predominantly dark brown to black body and minimal body hair compared to other bee species.",
      "isPrimary": false
    },
    {
      "label": "Bilobed tongue",
      "description": "Plasterer bees have a distinctive short, bilobed (split) tongue, which differs from the rounded tongues of many other bee families.",
      "isPrimary": false
    }
  ],
  "habitat": "Colletes nudus inhabits open, sandy or well-drained soil areas throughout New England, including meadows, roadsides, and disturbed areas where host plants like sumac and other wildflowers bloom.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female Sumac Cellophane Bees are solitary nesters, each digging individual underground burrows where they line cells with their remarkable cellophane-like secretion to waterproof and protect their developing offspring.",
