  "nameStory": "",
  "description": "Ophiocordyceps variabilis is an entomopathogenic fungus in the Ophiocordycipitaceae family that parasitizes insects, primarily ants and other arthropods in New England forests. It represents a specialized fungal adaptation where the organism infects its host and produces distinctive fruiting structures.",
  "idTips": [
    {
      "label": "Infected Host Presence",
      "description": "Look for mummified insect remains, particularly ants, as the fungus typically grows from the body of its parasitized host",
      "isPrimary": true
    },
    {
      "label": "Fruiting Body Structure",
      "description": "Distinctive elongated, thread-like ascomatal structures (fertile heads) emerge from the infected insect's body",
      "isPrimary": false
    },
    {
      "label": "Forest Floor Habitat",
      "description": "Found among leaf litter and soil in deciduous and mixed forests where ant colonies are active",
      "isPrimary": false
    }
  ],
  "habitat": "Ophiocordyceps variabilis thrives in the moist leaf litter and soil of New England's forests, where it parasitizes arthropods in temperate woodland ecosystems.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is part of a remarkable group of 'zombie-ant fungi' that manipulate host behavior, causing infected insects to climb to specific heights before the fungus kills them—a strategy that optimizes spore dispersal.",
