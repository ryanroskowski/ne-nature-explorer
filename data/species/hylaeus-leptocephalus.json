  "nameStory": "",
  "description": "The Slender-faced Masked Bee (Hylaeus leptocephalus) is a small, solitary bee belonging to the plasterer bee family, characterized by its delicate build and distinctive facial markings. These native New England bees are important pollinators that nest in hollow plant stems and dead wood.",
  "idTips": [
    {
      "label": "Slender Face",
      "description": "Notably narrow and elongated head compared to other Hylaeus species, giving the bee its distinctive 'slender-faced' appearance",
      "isPrimary": true
    },
    {
      "label": "Yellow Facial Markings",
      "description": "Bright yellow or cream-colored marks on the face and clypeus against a dark body, resembling a mask",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Tiny bee measuring only 5-7mm in length, making it one of the smallest native bees",
      "isPrimary": false
    }
  ],
  "habitat": "Found in diverse New England habitats including gardens, meadows, woodlands, and shrubby areas with abundant flowering plants and available nesting cavities.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Plasterer bees line their nesting tunnels with a thin, cellophane-like secretion that waterproofs the brood cells, giving the family its distinctive name.",
