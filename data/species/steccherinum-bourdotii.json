  "nameStory": "",
  "description": "Steccherinum bourdotii is a small, wood-decay fungus in the Steccherinaceae family, characterized by its delicate structure and distinctive spore-bearing surfaces. Found throughout New England, it plays an important ecological role in decomposing dead hardwood.",
  "idTips": [
    {
      "label": "Spine-like projections",
      "description": "Features distinctive tooth-like or spine-like structures (rather than typical gills or pores) on the underside of the fruiting body",
      "isPrimary": true
    },
    {
      "label": "Small, white to cream-colored caps",
      "description": "Produces tiny, thin fruiting bodies that are typically white or pale cream in color and often appear in overlapping clusters",
      "isPrimary": false
    },
    {
      "label": "Brittle texture",
      "description": "Has a delicate, brittle consistency that readily breaks when handled, distinguishing it from tougher polypore fungi",
      "isPrimary": false
    }
  ],
  "habitat": "Steccherinum bourdotii grows on decaying hardwood logs and fallen branches in moist forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The distinctive tooth-like spines of Steccherinum species represent an evolutionary middle ground between gills and pores, offering insights into how different fungal fruiting structures evolved.",
