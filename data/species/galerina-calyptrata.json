  "nameStory": "",
  "description": "Galerina calyptrata, commonly known as the hooded bell, is a small woodland mushroom characterized by its delicate, bell-shaped cap and thin stem. This species belongs to the Hymenogastraceae family and is found throughout New England in moist forest environments.",
  "idTips": [
    {
      "label": "Bell-shaped cap with hood-like veil",
      "description": "The distinctive bell-shaped cap often retains remnants of a veil that gives it a hooded appearance, which is the origin of its common name.",
      "isPrimary": true
    },
    {
      "label": "Small, delicate fruiting body",
      "description": "This species is notably small, typically with caps under 1.5 cm in diameter and thin, fragile stems that are easily damaged.",
      "isPrimary": false
    },
    {
      "label": "Decurrent gill attachment",
      "description": "The gills run slightly down the stem and are typically whitish to pale yellowish in color.",
      "isPrimary": false
    }
  ],
  "habitat": "Galerina calyptrata grows in moist, shaded areas on decaying wood, mossy logs, and rich forest floors throughout New England's deciduous and mixed forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small and seemingly fragile appearance, Galerina calyptrata plays an important ecological role in decomposing woody debris and contributing to nutrient cycling in forest ecosystems.",
