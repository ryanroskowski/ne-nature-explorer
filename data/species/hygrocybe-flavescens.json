  "nameStory": "",
  "description": "The Golden Waxy Cap is a small, delicate mushroom characterized by its bright yellow to golden coloring and distinctively waxy, translucent appearance. It belongs to the Hygrocybaceae family, a group known for their colorful fruiting bodies and preference for mossy habitats.",
  "idTips": [
    {
      "label": "Golden-yellow color",
      "description": "Bright yellow to golden cap and stem that may fade slightly with age or drying",
      "isPrimary": true
    },
    {
      "label": "Waxy texture",
      "description": "Distinctive waxy or greasy appearance on the cap and gills, giving them a translucent quality",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Typically 1-3 cm in cap diameter with thin, fragile stems",
      "isPrimary": false
    }
  ],
  "habitat": "Found in mossy grasslands, meadows, and lawns throughout New England, favoring acidic soils and areas with persistent moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Golden Waxy Caps are part of a group of waxcaps that are considered indicators of unimproved, species-rich grasslands and are increasingly rare due to agricultural intensification and habitat loss.",
