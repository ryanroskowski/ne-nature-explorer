  "nameStory": "",
  "description": "Lactarius mutabilis is a small to medium milkcap mushroom characterized by its variable coloration that changes with age and moisture conditions. This fungus is part of the Russulaceae family and is found in New England forests, where it plays a role in the woodland ecosystem through its mycorrhizal relationships with trees.",
  "idTips": [
    {
      "label": "Color Changes",
      "description": "The cap color is highly variable and changes dramatically from light tan or buff when young to darker brown or greenish tones as it matures and with moisture exposure",
      "isPrimary": true
    },
    {
      "label": "Milk Residue",
      "description": "When gills are bruised or broken, the fungus exudes a white to pale yellow latex that stains brown over time, a characteristic feature of Lactarius species",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "The gills are adnate to slightly decurrent and are crowded, with shorter gills interspersed between longer ones",
      "isPrimary": false
    }
  ],
  "habitat": "Lactarius mutabilis grows in mixed forests throughout New England, typically appearing in summer and fall months in association with hardwoods and conifers on moist, rich soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'mutabilis' literally means 'changeable,' referring to the mushroom's remarkable ability to shift colors throughout its fruiting stage, making it a challenging species for identification even for experienced mycologists.",
  "confusionNotes": null,
  "contextualKnowledge": null,
