  "nameStory": "",
  "description": "Burnt-sugar Milky (Lactarius helvus) is a small to medium-sized milkcap mushroom with a distinctive caramel or burnt-sugar odor that becomes stronger when the fruiting body is dried or bruised. Despite its pleasant aroma, it is inedible and may cause gastrointestinal upset if consumed.",
  "idTips": [
    {
      "label": "Burnt-sugar smell",
      "description": "The most distinctive feature is a sweet, maple syrup or burnt-sugar odor that intensifies when handled or dried",
      "isPrimary": true
    },
    {
      "label": "Cap color and texture",
      "description": "Pale tan to brownish caps with a dry, matte surface and a slightly depressed center, typically 2-4 inches wide",
      "isPrimary": false
    },
    {
      "label": "Milk consistency",
      "description": "Produces white or pale milk that does not change color when exposed to air, and gills are close together and decurrent",
      "isPrimary": false
    }
  ],
  "habitat": "Burnt-sugar Milky grows in coniferous and mixed forests throughout New England, fruiting from summer through fall in mossy areas and near decaying wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The mushroom's odor is so distinctive that it has been used by foragers and naturalists for centuries as a reliable identifier, and the scent actually becomes more pronounced as the mushroom dries out.",
  "confusionNotes": null,
