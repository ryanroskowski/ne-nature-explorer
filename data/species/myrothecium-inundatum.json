  "nameStory": "",
  "description": "Myrothecium inundatum is a dematiaceous fungus belonging to the Stachybotryaceae family, characterized by dark spore masses and small fruiting structures. This species is commonly found in moist environments throughout New England and plays a role in the decomposition of organic matter.",
  "idTips": [
    {
      "label": "Dark Spore Masses",
      "description": "Produces distinctive black or dark brown conidial masses that are easily visible to the naked eye",
      "isPrimary": true
    },
    {
      "label": "Small Pycnidia",
      "description": "Forms tiny, flask-shaped fruiting bodies (pycnidia) arranged in characteristic patterns on substrate",
      "isPrimary": false
    },
    {
      "label": "Mucoid Consistency",
      "description": "Spore masses have a wet, slimy or mucoid appearance, especially when fresh",
      "isPrimary": false
    }
  ],
  "habitat": "Myrothecium inundatum thrives in consistently moist environments such as wet wood, damp soil, and decomposing plant material in New England's humid forests and wetlands.",
