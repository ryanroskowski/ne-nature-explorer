  "nameStory": "",
  "description": "Deconica coprophila is a small, brown coprophilous mushroom belonging to the Hymenogastraceae family, commonly found in New England. This dung-loving fungus plays an important ecological role in nutrient cycling by decomposing herbivore feces.",
  "idTips": [
    {
      "label": "Habitat Association",
      "description": "Found exclusively on dung of herbivores such as deer, cattle, and horses—the most reliable identifying feature",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Small brown to tan cap, typically 5-15mm in diameter, with a convex shape and hygrophanous texture that fades when dry",
      "isPrimary": false
    },
    {
      "label": "Gill Color",
      "description": "Dark brown to blackish gills that darken with age as spores mature",
      "isPrimary": false
    }
  ],
  "habitat": "Deconica coprophila grows on decomposing dung in moist, shaded areas throughout New England forests, grasslands, and pastures.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is part of a specialized guild of coprophilous fungi that can only complete their life cycle on animal dung, having evolved specific mechanisms to survive the acidic and antimicrobial environment of herbivore feces.",
