  "nameStory": "",
  "description": "Porodaedalea chrysoloma is a wood-decay fungus in the Hymenochaetaceae family, characterized by its distinctive golden-yellow pore surface. This bracket fungus plays an important ecological role as a decomposer in New England forests.",
  "idTips": [
    {
      "label": "Golden-Yellow Pores",
      "description": "The diagnostic feature is the bright golden-yellow to ochre-colored pore surface on the underside of the fruiting body",
      "isPrimary": true
    },
    {
      "label": "Bracket Form",
      "description": "Forms shelf-like or hoof-shaped brackets projecting from dead wood and tree stumps",
      "isPrimary": false
    },
    {
      "label": "Hard, Woody Texture",
      "description": "The fruiting body is very hard and woody when dry, with a rusty-brown upper surface",
      "isPrimary": false
    }
  ],
  "habitat": "Porodaedalea chrysoloma is found on dead hardwood logs, stumps, and fallen trees throughout New England forests, particularly in areas with oak and other deciduous wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Porodaedalea refers to the intricate pore-like structures on the underside, while chrysoloma means 'golden-edged,' perfectly describing this fungi's most striking feature.",
