  "nameStory": "",
  "description": "Erysiphe amphicarpaeicola is a powdery mildew fungus that specifically infects plants in the Fabaceae (legume) family, particularly amphicarpa species in New England. This pathogenic fungus creates characteristic white, powdery coatings on plant leaves and stems.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Visible white to grayish powdery growth on leaf surfaces, petioles, and stems",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Found primarily on Amphicarpaea bracteata (hog peanut) and related legume hosts",
      "isPrimary": false
    },
    {
      "label": "Cleistothecia Formation",
      "description": "Small dark reproductive structures may develop within the powdery coating as the season progresses",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives on legume plants in woodland edges, disturbed areas, and gardens throughout New England, preferring warm, dry conditions with moderate humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'amphicarpaeicola' literally means 'dweller on Amphicarpaea,' reflecting this fungus's highly specialized relationship with its legume host plant.",
  "confusionNotes": null,
  "contextualKnowledge": null,
