  "nameStory": "",
  "description": "Gymnopus androsaceus, commonly known as horsehair fungus, is a small delicate mushroom characterized by its thin, hair-like stems and tiny caps. This wood-decomposing fungus belongs to the Omphalotaceae family and plays an important role in nutrient cycling in forest ecosystems.",
  "idTips": [
    {
      "label": "Hair-like stems",
      "description": "Extremely thin, wiry, dark brown to black stems that resemble horsehair",
      "isPrimary": true
    },
    {
      "label": "Tiny pale caps",
      "description": "Small mushroom caps (3-8mm) that are white to pale gray and often become darker with age",
      "isPrimary": false
    },
    {
      "label": "Clustered growth",
      "description": "Grows in dense clusters on decaying wood, leaves, and debris",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus is found throughout New England on dead hardwood branches, fallen logs, and leaf litter in moist forest environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The common name 'horsehair fungus' comes from the mushroom's remarkable resemblance to actual horsehair, making it one of nature's most delicate and hair-like fungi.",
