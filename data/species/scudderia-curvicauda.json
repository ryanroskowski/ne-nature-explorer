  "nameStory": "",
  "description": "The Curve-tailed Bush Katydid is a medium-sized insect belonging to the Tettigoniidae family, characterized by its distinctive curved ovipositor that resembles a scimitar. This nocturnal creature is commonly found throughout New England and is known for its loud, persistent chirping during late summer and fall.",
  "idTips": [
    {
      "label": "Curved Ovipositor",
      "description": "The most distinctive feature is the female's dramatically curved, sword-like ovipositor that gives the species its name",
      "isPrimary": true
    },
    {
      "label": "Wing Pattern",
      "description": "Green or brown wings with darker markings and a characteristic narrow, elongated shape typical of bush katydids",
      "isPrimary": false
    },
    {
      "label": "Body Size",
      "description": "Medium-sized katydid, typically 16-20mm in length, smaller than true crickets but larger than many grasshoppers",
      "isPrimary": false
    }
  ],
  "habitat": "Curve-tailed Bush Katydids inhabit deciduous and mixed forests, shrubby areas, and gardens with dense vegetation throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Curve-tailed Bush Katydids produce their distinctive loud, rasping song by rubbing their wing covers together, and this sound can be heard up to 100 feet away on quiet summer nights.",
  "confusionNotes": null,
