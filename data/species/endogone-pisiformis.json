  "nameStory": "",
  "description": "Endogone pisiformis is a fungal species in the Endogonaceae family that forms underground structures and symbiotic relationships with plant roots. This mycorrhizal fungus plays an important ecological role in New England forest and soil ecosystems.",
  "idTips": [
    {
      "label": "Spore morphology",
      "description": "Produces distinctive pea-shaped (pisiform) spores that are characteristic of the species",
      "isPrimary": true
    },
    {
      "label": "Hyphal structure",
      "description": "Forms thick-walled hyphae and distinctive sporocarps underground",
      "isPrimary": false
    },
    {
      "label": "Root association",
      "description": "Forms endogonous mycorrhizal associations within root tissues rather than external arbuscules",
      "isPrimary": false
    }
  ],
  "habitat": "Endogone pisiformis inhabits forest soils and mineral-rich substrates throughout New England, particularly in deciduous and mixed woodland areas.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite being invisible to the naked eye, Endogone pisiformis plays a crucial role in nutrient cycling by helping plants absorb phosphorus and other minerals from soil.",
