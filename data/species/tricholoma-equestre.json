  "nameStory": "",
  "description": "The Yellow Knight (Tricholoma equestre) is a medium-sized mushroom characterized by its bright yellow cap and stem, making it one of the more visually distinctive members of the Tricholomataceae family. Once considered edible, this species has been associated with poisoning cases in Europe and should be avoided.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Bright yellow to golden-yellow cap, often with darker fibrils or staining, typically 4-8 cm in diameter",
      "isPrimary": true
    },
    {
      "label": "Gills and Stem",
      "description": "Pale yellow gills that are crowded and don't reach the stem; yellow stem that may have a ring zone or be plain",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Grows near coniferous trees, particularly pines, which is a key distinguishing feature from similar species",
      "isPrimary": false
    }
  ],
  "habitat": "The Yellow Knight is found in coniferous forests, especially near pine trees, fruiting in fall across New England woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This mushroom was traditionally considered edible in Europe, but cases of severe poisoning in the 1990s revealed it can accumulate toxic compounds, leading to its reclassification as potentially dangerous.",
