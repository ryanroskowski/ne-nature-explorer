  "nameStory": "",
  "description": "The Sunflower Burrowing-Resin bee is a solitary bee species belonging to the family Megachilidae, known for its use of plant resins in nest construction. This small bee is native to New England and plays an important role in pollinating wildflowers, particularly sunflowers.",
  "idTips": [
    {
      "label": "Resin collection behavior",
      "description": "Observable carrying of sticky plant resins on body parts to line nest tunnels",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Typically 8-10 mm in length, making it one of the smaller bees in the region",
      "isPrimary": false
    },
    {
      "label": "Dark coloration",
      "description": "Generally dark brown to black body with sparse hair coverage",
      "isPrimary": false
    }
  ],
  "habitat": "Found in open, sunny areas of New England where sunflowers and other resin-producing plants grow, typically nesting in abandoned insect tunnels or beetle borings in dead wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike honeybees, this solitary bee creates individual nesting chambers lined with plant resins as a waterproofing mechanism, making it one of the few bees that actively harvests and uses plant materials beyond nectar and pollen.",
