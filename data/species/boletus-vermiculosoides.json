  "nameStory": "",
  "description": "Boletus vermiculosoides is a bolete fungus characterized by small pores instead of gills underneath its cap, making it a member of the Boletaceae family. Found in New England forests, this species is relatively uncommon and represents an interesting component of the region's fungal diversity.",
  "idTips": [
    {
      "label": "Pore Surface",
      "description": "Small, angular pores on the underside of the cap that are yellowish and may bruise blue when pressed",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Brown to tan colored cap with a slightly convex to flat shape, typically 3-8 cm in diameter",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Slender stem with yellow coloring near the cap that may have a reticulated (net-like) pattern",
      "isPrimary": false
    }
  ],
  "habitat": "Boletus vermiculosoides grows in mixed deciduous and coniferous forests throughout New England, typically appearing in summer and fall months in association with various tree species.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many boletes, Boletus vermiculosoides forms mycorrhizal relationships with trees, meaning the fungus and tree roots work together in a mutually beneficial partnership that helps both organisms thrive.",
  "confusionNotes": null,
  "contextualKnowledge": null,
