  "nameStory": "",
  "description": "The Boreal Bluet is a small damselfly belonging to the Coenagrionidae family, characterized by its delicate blue and black coloration. This species is primarily found in the northern regions of New England, where it inhabits cool, clear freshwater environments.",
  "idTips": [
    {
      "label": "Blue and Black Pattern",
      "description": "Males display bright blue abdomens with black markings, while females are typically duller with greenish or tan coloring",
      "isPrimary": true
    },
    {
      "label": "Narrow Wings",
      "description": "Like all members of Coenagrionidae, it has characteristically narrow, elongated wings held parallel to the body when at rest",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "This damselfly is notably small, typically measuring 24-28mm in total length",
      "isPrimary": false
    }
  ],
  "habitat": "Boreal Bluets prefer cool, spring-fed streams and cold-water ponds with dense aquatic vegetation in boreal and northern temperate regions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many damselfly species, Boreal Bluets are more active during cooler weather and early morning hours, making them well-adapted to New England's shorter summers.",
