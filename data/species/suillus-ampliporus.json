  "nameStory": "",
  "description": "Western Hollow Jack (Suillus ampliporus) is a boletoid fungus belonging to the Suillaceae family, characterized by its distinctive pores and mycorrhizal relationship with conifers. Found throughout New England, it is a terrestrial species that fruiting bodies typically appear in summer and fall.",
  "idTips": [
    {
      "label": "Large Angular Pores",
      "description": "Features notably large, angular pores on the underside that are yellowish and may bruise brownish, distinguishing it from related species",
      "isPrimary": true
    },
    {
      "label": "Hollow Stem",
      "description": "The stem is characteristically hollow or chambered, which is reflected in the common name 'Hollow Jack'",
      "isPrimary": false
    },
    {
      "label": "Cap Surface",
      "description": "The cap is typically ochre to brownish with a somewhat viscid surface when wet, and may display partial veil remnants",
      "isPrimary": false
    }
  ],
  "habitat": "Western Hollow Jack grows in mycorrhizal association with coniferous trees, particularly pine and spruce, in forest settings throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Suillaceae family have evolved specialized relationships with specific conifers, and Suillus species are considered reliable indicators of healthy conifer forest ecosystems.",
