  "nameStory": "",
  "description": "Keeler's Spur-throat Grasshopper is a medium-sized member of the Acrididae family found in New England's grasslands and open areas. Named for the prominent spur on its hind legs, this grasshopper is an important part of local ecosystems as both herbivore and prey.",
  "idTips": [
    {
      "label": "Hind Leg Spur",
      "description": "Distinctive pointed spur projecting from the inner surface of the hind leg, diagnostic of spur-throat grasshoppers",
      "isPrimary": true
    },
    {
      "label": "Body Coloration",
      "description": "Typically brown to tan with darker markings along the back and sides",
      "isPrimary": false
    },
    {
      "label": "Antennae Length",
      "description": "Short antennae characteristic of short-horned grasshoppers, much shorter than the body length",
      "isPrimary": false
    }
  ],
  "habitat": "This species prefers open grasslands, meadows, and prairie-like habitats with low to moderate vegetation in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Keeler's Spur-throat Grasshoppers produce their characteristic chirping sounds by rubbing their hind legs against their wings, a behavior used to attract mates during breeding season.",
