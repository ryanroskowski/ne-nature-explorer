  "nameStory": "",
  "description": "Larch Bolete is a mycorrhizal fungus that forms a symbiotic relationship exclusively with larch trees, particularly European larch. It is a medium-sized bolete with a distinctive slimy cap and yellow pores that are characteristic of the Suillus genus.",
  "idTips": [
    {
      "label": "Cap appearance",
      "description": "Honey to ochre-yellow cap that is sticky or slimy when wet, becoming shiny when dry",
      "isPrimary": true
    },
    {
      "label": "Pore surface",
      "description": "Bright yellow pores that may develop reddish staining or bruising with age or handling",
      "isPrimary": false
    },
    {
      "label": "Associated tree",
      "description": "Found only in association with larch trees, which is the most reliable identification clue",
      "isPrimary": false
    }
  ],
  "habitat": "Larch Bolete grows on the forest floor beneath larch trees in mixed woodlands and plantations throughout New England, fruiting from late summer into fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Larch Bolete is edible and considered choice by some mushroom foragers in Europe, though it requires careful cleaning due to its slimy cap that readily traps debris.",
  "confusionNotes": null,
  "contextualKnowledge": null,
