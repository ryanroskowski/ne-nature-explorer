  "nameStory": "",
  "description": "Erysiphe pseudoextensa is a fungal pathogen belonging to the powdery mildew family that infects various plant species throughout New England. This obligate parasite creates characteristic white, powdery fungal coatings on plant leaves and stems, potentially weakening host plants if infections become severe.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish powder covering leaf surfaces, which can be easily wiped off",
      "isPrimary": true
    },
    {
      "label": "Chasmothecia Formation",
      "description": "Dark, round fruiting bodies (cleistothecia) that develop within the powdery coating as the season progresses",
      "isPrimary": false
    },
    {
      "label": "Leaf Distortion",
      "description": "Infected leaves may show slight curling or yellowing beneath the fungal coating",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe pseudoextensa thrives in warm, dry conditions with moderate humidity on a variety of herbaceous and woody plants commonly found in New England gardens, woodlands, and disturbed areas.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many fungal diseases, powdery mildews like E. pseudoextensa actually prefer dry conditions and can spread effectively even when leaves are dry, making them unique among leaf-infecting fungi.",
  "confusionNotes": null,
  "contextualKnowledge": null,
