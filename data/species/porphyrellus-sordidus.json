  "nameStory": "",
  "description": "Porphyrellus sordidus, commonly known as the Sordid Bolete, is a medium-sized fungus in the Boletaceae family characterized by its dark, dingy appearance and porous underside. It is found in woodlands throughout New England and is inedible due to its unpalatable taste.",
  "idTips": [
    {
      "label": "Pore Surface Color",
      "description": "The pores underneath the cap are gray to grayish-brown, becoming darker and more olive-toned with age or when bruised",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "The cap is brown to dark grayish-brown with a matte, somewhat dull or sordid appearance, lacking the glossiness of related species",
      "isPrimary": false
    },
    {
      "label": "Stalk Characteristics",
      "description": "The stem is yellowish at the base with a reddish or brownish top portion, often with fine longitudinal ridges",
      "isPrimary": false
    }
  ],
  "habitat": "Porphyrellus sordidus grows on the forest floor in mixed hardwood and coniferous forests throughout New England, appearing from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'sordidus' means dingy or dirty in Latin, referring to the mushroom's characteristically dull, unimpressive appearance that makes it easy to overlook in the forest.",
