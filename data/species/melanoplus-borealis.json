  "nameStory": "",
  "description": "The Northern Spur-throat Grasshopper (Melanoplus borealis) is a medium-sized member of the Short-horned Grasshopper family (Acrididae) found throughout New England and other northern regions. This grasshopper is named for the distinctive spur-like projection on its hind legs, which helps distinguish it from related species.",
  "idTips": [
    {
      "label": "Hind Leg Spur",
      "description": "A prominent spur-like projection on the inner surface of the hind femur is the defining characteristic of this species.",
      "isPrimary": true
    },
    {
      "label": "Body Coloration",
      "description": "Typically brown to olive-green in color with a somewhat robust body shape typical of Melanoplus species.",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Medium-sized grasshopper, generally 14-18 mm in length, fitting between smaller and larger grasshopper species in the region.",
      "isPrimary": false
    }
  ],
  "habitat": "This species prefers open grasslands, prairies, and weedy meadows throughout New England, thriving in areas with diverse herbaceous vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many grasshoppers, the Northern Spur-throat produces sound by rubbing its hind legs against its wings, creating species-specific calls used for communication and mate attraction.",
