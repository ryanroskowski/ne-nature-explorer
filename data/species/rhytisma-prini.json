  "nameStory": "",
  "description": "Rhytisma prini is a fungal leaf spot disease that affects scrub oak and other oak species in the Rhytismataceae family, characterized by distinctive black, tar-like lesions on leaves. This ascomycete fungus is commonly found throughout New England and other eastern North American forests.",
  "idTips": [
    {
      "label": "Black tar-like lesions",
      "description": "Look for shiny, raised black or dark brown lesions that resemble tar spots on oak leaves, typically appearing in late summer",
      "isPrimary": true
    },
    {
      "label": "Host specificity",
      "description": "Primarily affects scrub oak (Quercus ilicifolia) and other oak species, making host identification helpful for confirmation",
      "isPrimary": false
    },
    {
      "label": "Seasonal appearance",
      "description": "Lesions become most visible and prominent in August through fall as the fungus matures",
      "isPrimary": false
    }
  ],
  "habitat": "Rhytisma prini thrives in oak-dominated woodlands and scrublands throughout New England, preferring moist conditions that favor fungal development.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its dramatic appearance, Rhytisma prini causes minimal harm to host trees and is considered more of a cosmetic leaf disease than a serious threat to oak health.",
