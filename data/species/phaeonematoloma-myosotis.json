  "nameStory": "",
  "description": "Phaeonematoloma myosotis, commonly known as the olive brownie, is a small woodland mushroom belonging to the Strophariaceae family, characterized by its delicate appearance and subtle coloration. This species is distributed throughout New England and typically fruits during the wetter months of fall and spring.",
  "idTips": [
    {
      "label": "Olive-brown cap",
      "description": "Small cap (1-3 cm) with a distinctive olive to grayish-brown color that fades toward the margins when moist",
      "isPrimary": true
    },
    {
      "label": "Thin whitish veil",
      "description": "Young specimens display a delicate partial veil that may leave slight ring remnants on the stem",
      "isPrimary": false
    },
    {
      "label": "Dark spore print",
      "description": "Produces a dark brown to purplish-brown spore print, typical of Strophariaceae family members",
      "isPrimary": false
    }
  ],
  "habitat": "Phaeonematoloma myosotis grows on decaying hardwood, wood chips, and enriched soil in moist forests and disturbed areas throughout New England.",
