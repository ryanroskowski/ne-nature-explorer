  "nameStory": "",
  "description": "Lavender Baeospora (Baeospora myriadophylla) is a small, delicate fungus belonging to the Cyphellaceae family, characterized by its distinctive lavender to purple coloring. This species is found in moist forest environments throughout New England and plays a role in decomposing woody substrates.",
  "idTips": [
    {
      "label": "Lavender Coloration",
      "description": "Distinctive pale lavender to purple caps and stems that fade with age, making it immediately recognizable among similar small fungi",
      "isPrimary": true
    },
    {
      "label": "Cup or Bell Shape",
      "description": "Small, delicate fruiting bodies typically 2-5mm wide with a characteristic cup or bell-shaped structure",
      "isPrimary": false
    },
    {
      "label": "Habitat Preference",
      "description": "Grows on decaying wood, leaf litter, and mossy substrates in damp, shaded forest floors",
      "isPrimary": false
    }
  ],
  "habitat": "Baeospora myriadophylla thrives in moist, shaded deciduous and mixed forests of New England where decomposing wood and rich organic matter are abundant.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'myriadophylla' refers to the countless gill-like structures (lamellae) on the underside of its tiny fruiting bodies, which are visible only under magnification.",
