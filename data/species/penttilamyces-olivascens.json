  "nameStory": "",
  "description": "Penttilamyces olivascens is a wood-decay fungus belonging to the Coniophoraceae family, characterized by its dark, olivaceous coloration and microscopic spore structures. This species plays an important ecological role in decomposing woody substrates in temperate forest ecosystems of New England.",
  "idTips": [
    {
      "label": "Olive-brown coloration",
      "description": "The fungus displays distinctive dark olive to brownish tones in its fruiting structures and mycelium",
      "isPrimary": true
    },
    {
      "label": "Conidiophore morphology",
      "description": "Features characteristic branched conidiophores with conical phialides typical of Coniophoraceae",
      "isPrimary": false
    },
    {
      "label": "Wood substrate preference",
      "description": "Typically found colonizing decaying hardwood and softwood logs and stumps",
      "isPrimary": false
    }
  ],
  "habitat": "Penttilamyces olivascens inhabits moist, decaying woody substrates in New England forests, particularly in areas with high humidity and shade.",
