  "nameStory": "",
  "description": "The Black-and-gold Bumble Bee (Bombus auricomus) is a robust native bumble bee characterized by its striking black body with bright golden-yellow markings. This important pollinator is commonly found throughout New England, where it plays a vital role in pollinating native plants and crops.",
  "idTips": [
    {
      "label": "Golden-yellow bands",
      "description": "Distinctive bright yellow hair on the thorax and abdomen creates bold contrasting bands against the black body",
      "isPrimary": true
    },
    {
      "label": "Size",
      "description": "Medium to large bumble bee, with queens noticeably larger than workers, measuring approximately 13-25mm",
      "isPrimary": false
    },
    {
      "label": "Face pattern",
      "description": "Black face with minimal yellow markings, helping distinguish it from similar yellow-faced bumble bee species",
      "isPrimary": false
    }
  ],
  "habitat": "Black-and-gold Bumble Bees thrive in open meadows, gardens, forest edges, and disturbed areas throughout New England where flowering plants are abundant.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike honeybees, bumble bees like B. auricomus can regulate their body temperature through muscle contractions, allowing them to forage in cool spring and fall weather when other pollinators are inactive.",
