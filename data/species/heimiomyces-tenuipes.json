  "nameStory": "",
  "description": "Heimiomyces tenuipes, commonly known as the Orange Faint Foot Mushroom, is a small delicate fungus characterized by its pale orange to yellowish coloring and thin, fragile stem. This species belongs to the Xeromphalinaceae family, a group of small woodland mushrooms adapted to dry conditions.",
  "idTips": [
    {
      "label": "Thin, thread-like stem",
      "description": "The distinctive tenuipes (thin foot) feature gives this mushroom its name—the stem is notably slender and delicate compared to its cap",
      "isPrimary": true
    },
    {
      "label": "Orange to pale yellow cap",
      "description": "The cap ranges from pale orange to yellowish hues, typically small (5-15mm) and convex in shape",
      "isPrimary": false
    },
    {
      "label": "Faint coloring and translucent appearance",
      "description": "The overall fruiting body appears somewhat faint and semi-transparent, particularly visible when backlit",
      "isPrimary": false
    }
  ],
  "habitat": "This species is found in New England's woodlands and forest floors, preferring moist leaf litter and decaying wood in areas with adequate shade and humidity.",
