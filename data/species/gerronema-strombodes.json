  "nameStory": "",
  "description": "Gerronema strombodes, commonly known as the golden-gilled gerronema, is a small delicate mushroom characterized by its distinctive golden to yellow gill coloration. This species belongs to the Porotheleaceae family and is found in the forests of New England.",
  "idTips": [
    {
      "label": "Golden Gills",
      "description": "Bright golden to yellow gills that are narrow, crowded, and often forked near the stem",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Typically has a cap diameter of 0.5-2 cm with a similarly slender stem, making it a miniature mushroom",
      "isPrimary": false
    },
    {
      "label": "Pale Cap",
      "description": "Light-colored cap that ranges from whitish to pale cream or tan with a delicate, thin appearance",
      "isPrimary": false
    }
  ],
  "habitat": "Gerronema strombodes grows on decaying wood, leaf litter, and mossy substrates in moist hardwood and mixed forests throughout New England.",
  "seasonality": {
