  "nameStory": "",
  "description": "Clitocybe subditopoda is a small to medium-sized mushroom in the Clitocybaceae family, characterized by its delicate appearance and pale coloration. This species is found in forest ecosystems throughout New England, where it fruits on soil and among leaf litter.",
  "idTips": [
    {
      "label": "Gill arrangement",
      "description": "Gills are decurrent to subdecurrent (running down the stem), crowded, and pale whitish to cream-colored",
      "isPrimary": true
    },
    {
      "label": "Cap appearance",
      "description": "Small convex to plane cap, typically whitish-gray to pale brown, often with a wavy or irregular margin",
      "isPrimary": false
    },
    {
      "label": "Spore print",
      "description": "White to pale cream-colored spore print, which is characteristic of the Clitocybe genus",
      "isPrimary": false
    }
  ],
  "habitat": "Clitocybe subditopoda typically grows in mixed deciduous and coniferous forests in New England, fruiting on humus-rich soil and among mosses and leaf litter from late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many Clitocybe species, this mushroom is mycorrhizal or saprophytic, playing an important role in nutrient cycling by breaking down organic matter in forest ecosystems.",
