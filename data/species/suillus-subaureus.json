  "nameStory": "",
  "description": "Suillus subaureus, commonly known as the Subalpin Suillus, is a mycorrhizal fungus that forms symbiotic relationships with conifer trees, particularly larches and pines. This small to medium-sized bolete is characterized by its distinctive coloring and slimy texture when wet.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Golden to yellowish-brown cap that becomes slimy or viscid when wet, with a distinctive greasy appearance",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "Yellow to olive-yellow pores that may stain brownish when bruised, with angular to somewhat irregular pore shapes",
      "isPrimary": false
    },
    {
      "label": "Partial Veil",
      "description": "Presence of a fibrillose ring or partial veil remnants on the young fruiting bodies",
      "isPrimary": false
    }
  ],
  "habitat": "Suillus subaureus is found in coniferous forests throughout New England, particularly in association with larch and pine trees in moist, acidic soils of higher elevations.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The slimy cap of Suillus subaureus serves an ecological purpose—the viscid coating helps retain moisture and may assist in spore dispersal during humid conditions.",
  "confusionNotes": null,
