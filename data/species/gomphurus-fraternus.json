  "nameStory": "",
  "description": "The Midland Clubtail is a medium-sized dragonfly belonging to the Gomphidae family, characterized by its clubbed abdomen and distinctive coloration. This species is found in flowing freshwater habitats throughout New England and is an important indicator of water quality.",
  "idTips": [
    {
      "label": "Clubbed Abdomen",
      "description": "The abdomen is noticeably swollen or clubbed toward the tip, which is the defining feature of all clubtail dragonflies",
      "isPrimary": true
    },
    {
      "label": "Yellow and Black Markings",
      "description": "The body displays a pattern of yellow stripes and spots on a dark brown or black background, particularly visible on the thorax and abdomen",
      "isPrimary": false
    },
    {
      "label": "Eye Color and Position",
      "description": "Greenish or yellowish eyes that are separated on the top of the head, distinguishing it from other dragonfly families",
      "isPrimary": false
    }
  ],
  "habitat": "Midland Clubtails prefer cool, fast-flowing streams and rivers with rocky or sandy bottoms, thriving in well-oxygenated waters typical of New England's watershed systems.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Midland Clubtails engage in aggressive territorial behavior along stream banks, patrolling specific sections of water and performing elaborate aerial displays to defend their breeding grounds from rival males.",
