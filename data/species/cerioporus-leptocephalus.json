  "nameStory": "",
  "description": "Blackfoot Polypore is a small, delicate bracket fungus characterized by its distinctive dark-staining base and pale, fan-shaped fruiting bodies. This wood-decaying fungus is commonly found throughout New England, where it plays an important ecological role in decomposing dead hardwood.",
  "idTips": [
    {
      "label": "Dark Base",
      "description": "The most distinctive feature is the blackened or dark brown staining at the base of the fruiting body, giving the fungus its 'blackfoot' common name.",
      "isPrimary": true
    },
    {
      "label": "Pale Fan Shape",
      "description": "The fruiting body is small (typically 2-5 cm), fan or shelf-shaped, with a whitish to pale tan upper surface and a cream-colored underside with tiny pores.",
      "isPrimary": false
    },
    {
      "label": "Clustered Growth",
      "description": "Often grows in overlapping clusters or tiers on dead hardwood, particularly oak and birch, creating distinctive bracket formations.",
      "isPrimary": false
    }
  ],
  "habitat": "Blackfoot Polypore grows on dead hardwood logs, stumps, and branches of deciduous trees, preferring moist conditions in forests and wooded areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size and delicate appearance, Blackfoot Polypore is an efficient decomposer that can persist on wood for several years, slowly breaking down cellulose and releasing nutrients back into the forest ecosystem.",
