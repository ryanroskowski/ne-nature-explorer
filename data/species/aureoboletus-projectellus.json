  "nameStory": "",
  "description": "Aureoboletus projectellus is a striking bolete fungus characterized by its bright yellow to golden coloration on both the cap and stem. This species is commonly found in New England forests and is edible, though not particularly choice for culinary purposes.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Bright yellow to golden-yellow cap that may fade slightly with age",
      "isPrimary": true
    },
    {
      "label": "Stem Appearance",
      "description": "Yellow stem with fine red or reddish spots or streaks, especially in the upper portion",
      "isPrimary": true
    },
    {
      "label": "Flesh Reaction",
      "description": "Flesh bruises or stains blue-green when cut, a key characteristic of Aureoboletus species",
      "isPrimary": false
    }
  ],
  "habitat": "Aureoboletus projectellus grows in mycorrhizal association with hardwood and mixed forests, typically appearing in summer through fall in New England woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Aureoboletus means 'golden bolete,' referring to the characteristically brilliant yellow coloring that makes this mushroom one of the more visually striking boletes in eastern forests.",
