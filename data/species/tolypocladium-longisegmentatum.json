  "nameStory": "",
  "description": "Tolypocladium longisegmentatum is a fungal species belonging to the Ophiocordycipitaceae family, characterized by its distinctive long, segmented conidiophores and specialized spore-producing structures. This organism is found in New England ecosystems where it plays an ecological role as an entomopathogenic fungus, infecting insects and arthropods.",
  "idTips": [
    {
      "label": "Long Segmented Conidiophores",
      "description": "Distinctively elongated conidiophores with multiple segments, which is the defining characteristic reflected in the species name 'longisegmentatum'",
      "isPrimary": true
    },
    {
      "label": "Spore Chain Arrangement",
      "description": "Produces chains of spores (conidia) in a characteristic linear pattern along the conidiophore branches",
      "isPrimary": false
    },
    {
      "label": "Microscopic Colony Appearance",
      "description": "Forms white to pale yellow colonies on culture media with a distinctive branched, tree-like appearance under microscopy",
      "isPrimary": false
    }
  ],
  "habitat": "Tolypocladium longisegmentatum is found in moist, forested environments throughout New England, typically in soil and leaf litter where it parasitizes arthropods and insects.",
