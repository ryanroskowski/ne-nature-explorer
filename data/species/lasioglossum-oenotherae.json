  "nameStory": "",
  "description": "The Evening Primrose Sweat Bee is a small native bee species in the Halictidae family, measuring only 4-6mm in length. These solitary bees are important pollinators of evening primrose flowers and other native plants throughout New England.",
  "idTips": [
    {
      "label": "Tiny size",
      "description": "One of the smallest sweat bee species at 4-6mm, easily distinguished from larger bee species",
      "isPrimary": true
    },
    {
      "label": "Metallic coloring",
      "description": "Body exhibits a subtle green or bronze metallic sheen, particularly visible on the head and thorax",
      "isPrimary": false
    },
    {
      "label": "Preference for evening primrose",
      "description": "Commonly observed foraging on evening primrose flowers (Oenothera species), which is their primary pollen source",
      "isPrimary": false
    }
  ],
  "habitat": "This bee species thrives in open fields, meadows, and disturbed areas where evening primrose and other wildflowers bloom throughout New England's temperate climate.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Evening Primrose Sweat Bees are named for their attraction to human perspiration, which they drink for essential salts and minerals, though they are generally non-aggressive.",
  "confusionNotes": null,
  "contextualKnowledge": null,
