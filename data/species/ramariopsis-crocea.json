  "nameStory": "",
  "description": "Orange coral (Ramariopsis crocea) is a small, branching fungus belonging to the Clavariaceae family, characterized by its bright orange to golden-yellow fruiting bodies. This delicate coral fungus is found in woodlands and forests throughout New England during summer and fall months.",
  "idTips": [
    {
      "label": "Bright Orange Color",
      "description": "The fruiting body displays a distinctive bright orange to golden-yellow hue that sets it apart from similar coral fungi",
      "isPrimary": true
    },
    {
      "label": "Small, Branched Structure",
      "description": "Forms compact, delicate branches typically 1-3 inches tall with a somewhat bush-like or coral-like appearance",
      "isPrimary": false
    },
    {
      "label": "Fragile Texture",
      "description": "The fruiting body is brittle and easily breaks apart, distinguishing it from more robust coral fungi species",
      "isPrimary": false
    }
  ],
  "habitat": "Orange coral grows on moist soil and decaying wood in deciduous and mixed forests throughout New England, preferring shaded woodland areas with high humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its plant-like appearance, orange coral is a fungus that plays an important ecological role by helping decompose organic matter and recycling nutrients in forest ecosystems.",
