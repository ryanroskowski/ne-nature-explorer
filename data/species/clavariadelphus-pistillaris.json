  "nameStory": "",
  "description": "Clavariadelphus pistillaris, commonly known as the club coral fungus, is a distinctive woodland mushroom characterized by its club-shaped fruiting body that resembles a pestle or baseball bat. This species belongs to the Clavariadelphaceae family and is found in forested areas throughout New England.",
  "idTips": [
    {
      "label": "Club-shaped fruiting body",
      "description": "The fungus has a distinctive pestle or club-like shape, typically 4-8 inches tall, with a rounded, bulbous head tapering to a narrower stalk",
      "isPrimary": true
    },
    {
      "label": "Color and texture",
      "description": "Ranges from pale whitish-tan to light orange-buff, with a smooth or slightly wrinkled surface that may become hollow with age",
      "isPrimary": false
    },
    {
      "label": "Brittle consistency",
      "description": "The fruiting body is firm but quite fragile, breaking easily when handled or bent",
      "isPrimary": false
    }
  ],
  "habitat": "Clavariadelphus pistillaris grows on the forest floor in hardwood and mixed forests, particularly in moist areas with rich organic soil and abundant leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its club-like appearance, this fungus produces microscopic spores from ridges on its surface that run down the sides of its pestle-shaped body, making it a hydnoid fungus rather than a true coral.",
