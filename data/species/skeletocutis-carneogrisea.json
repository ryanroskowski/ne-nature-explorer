  "nameStory": "",
  "description": "Skeletocutis carneogrisea is a wood-decay fungus in the Incrustoporiaceae family that forms small, crusty shelf-like fruiting bodies on dead hardwood. This species is characterized by its pale coloring and diminutive size, making it easily overlooked in the forest.",
  "idTips": [
    {
      "label": "Pore Surface Color",
      "description": "Pale grayish or flesh-toned pore surface that may become slightly darker with age or handling",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Fruiting bodies are typically very small, usually under 2-3 cm wide, appearing as thin, delicate shelves",
      "isPrimary": false
    },
    {
      "label": "Crusty Texture",
      "description": "The upper surface has a rough, crusty or granular appearance with minimal cap development",
      "isPrimary": false
    }
  ],
  "habitat": "Found on decaying hardwood substrates in forests throughout New England, preferring moist conditions on logs and fallen branches.",
