  "nameStory": "",
  "description": "Cresson's Sweat Bee is a small native bee species belonging to the Halictidae family, commonly found throughout New England. These solitary to semi-social bees are important pollinators that are attracted to human perspiration, hence their common name.",
  "idTips": [
    {
      "label": "Small Size",
      "description": "Typically 4-6 mm in length, making it one of the smallest bee species",
      "isPrimary": false
    },
    {
      "label": "Metallic Green Coloration",
      "description": "Distinctive iridescent green or bronze-green exoskeleton that shimmers in sunlight",
      "isPrimary": true
    },
    {
      "label": "Sparse Body Hair",
      "description": "Relatively short and fine body hair compared to other bee species, adapted for salt-seeking behavior",
      "isPrimary": false
    }
  ],
  "habitat": "Cresson's Sweat Bees thrive in open woodlands, meadows, gardens, and disturbed areas throughout New England where flowering plants and nesting sites in bare ground are available.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their small size, female Cresson's Sweat Bees are solitary nesters that dig individual burrows in bare soil, and they are particularly attracted to human sweat as a source of essential salts and minerals.",
  "confusionNotes": null,
  "contextualKnowledge": null,
