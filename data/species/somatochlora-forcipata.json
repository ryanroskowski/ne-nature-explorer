  "nameStory": "",
  "description": "Somatochlora forcipata, commonly known as the Forcipate Emerald, is a medium-sized dragonfly characterized by its metallic green coloration and distinctive abdominal features. This species is a member of the Emeraldidae family and is found throughout New England and other northeastern regions of North America.",
  "idTips": [
    {
      "label": "Forcipate Cerci",
      "description": "Males possess distinctively forked or forcipate (pincer-like) cerci at the end of the abdomen, which is the defining characteristic that gives this species its common name.",
      "isPrimary": true
    },
    {
      "label": "Metallic Green Coloration",
      "description": "The body displays a bright, iridescent metallic green coloration on the thorax and face, with a darker green abdomen.",
      "isPrimary": false
    },
    {
      "label": "Size and Build",
      "description": "Medium-sized emerald dragonfly with a total body length of approximately 50-55 mm and relatively slender abdomen.",
      "isPrimary": false
    }
  ],
  "habitat": "The Forcipate Emerald inhabits cool, clear streams and small rivers with dense vegetation, preferring flowing water habitats in forested areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Forcipate Emeralds are highly territorial and can often be seen patrolling their chosen stretches of stream, perching on vegetation and rocks while defending their territory from rival males.",
