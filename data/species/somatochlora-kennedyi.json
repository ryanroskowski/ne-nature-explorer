  "nameStory": "",
  "description": "Kennedy's Emerald is a medium-sized dragonfly species belonging to the family Corduliidae, characterized by its brilliant emerald-green coloration. This species is found in the northeastern United States, particularly in New England, where it inhabits clean freshwater environments.",
  "idTips": [
    {
      "label": "Emerald Coloration",
      "description": "Distinctive bright metallic green thorax and body, which is the defining characteristic of emerald dragonflies",
      "isPrimary": true
    },
    {
      "label": "Eye Color",
      "description": "Large compound eyes that are typically dark green or greenish-black, meeting or nearly meeting at the top of the head",
      "isPrimary": false
    },
    {
      "label": "Wing Appearance",
      "description": "Clear wings with a dark stigma (marking) and a relatively robust body compared to other dragonfly species",
      "isPrimary": false
    }
  ],
  "habitat": "Kennedy's Emerald prefers clear, fast-flowing streams and rivers with sandy or rocky substrates in forested regions of New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all emerald dragonflies, Kennedy's Emerald exhibits a behavior called 'perching' where it rests on vegetation near water, allowing it to quickly dart out to catch small flying insects with remarkable aerial agility.",
