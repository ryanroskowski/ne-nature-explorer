  "nameStory": "",
  "description": "The Sleepy Orange is a small butterfly belonging to the Pieridae family (Whites, Yellows, and Sulphurs), characterized by its bright orange wings with distinctive markings. This species is found throughout New England during warm months and is known for its rapid, erratic flight pattern.",
  "idTips": [
    {
      "label": "Wing Color",
      "description": "Bright orange-yellow wings with black markings on the forewings and orange coloring on the hindwings",
      "isPrimary": true
    },
    {
      "label": "Underside Pattern",
      "description": "The underside of wings displays a mottled gray or brown coloration with scattered orange spots, creating a cryptic appearance",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Small butterfly with a wingspan of 1.5 to 2 inches, making it one of the smaller members of the Pieridae family",
      "isPrimary": false
    }
  ],
  "habitat": "Sleepy Oranges prefer open, sunny areas including fields, roadsides, disturbed areas, and gardens where their host plants (Cassia and related legumes) are abundant.",
