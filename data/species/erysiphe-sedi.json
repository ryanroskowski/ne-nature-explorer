  "nameStory": "",
  "description": "Erysiphe sedi is a fungal pathogen that causes powdery mildew on sedums and other succulent plants, appearing as a white, dusty coating on leaves and stems. This obligate parasite is part of the Erysiphaceae family and is commonly encountered on ornamental sedums throughout New England gardens.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish fungal mycelium covers infected plant surfaces, giving them a chalky appearance",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Primarily affects Sedum species and related succulents, making host plant identification useful for diagnosis",
      "isPrimary": false
    },
    {
      "label": "Cleistothecia Formation",
      "description": "Small dark fruiting bodies develop within the white coating as the fungus matures, visible under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe sedi thrives on sedums and other drought-tolerant succulents in well-drained sites throughout New England, often appearing in late summer and fall when humidity increases.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews that prefer humid conditions, Erysiphe sedi can develop on plants in relatively dry environments, taking advantage of the waxy leaf surfaces that characterize succulents.",
  "confusionNotes": null,
  "contextualKnowledge": null,
