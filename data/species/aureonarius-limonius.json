  "nameStory": "",
  "description": "The sunset webcap is a striking mushroom characterized by its vibrant reddish-orange to golden-yellow cap, making it one of the most colorful webcaps in New England. Like other members of the Cortinariaceae family, it features a distinctive cobweb-like partial veil (cortina) that connects the cap margin to the stem.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Bright reddish-orange to golden-yellow cap that often fades with age, resembling a sunset",
      "isPrimary": true
    },
    {
      "label": "Cortina",
      "description": "Delicate, gossamer-like partial veil visible on young specimens, eventually leaving rusty-brown spore deposits on the stem",
      "isPrimary": false
    },
    {
      "label": "Gills",
      "description": "Rusty-brown to cinnamon-colored gills that darken with maturity due to spore production",
      "isPrimary": false
    }
  ],
  "habitat": "Found in mixed hardwood and coniferous forests throughout New England, typically fruiting from late summer through fall in association with various tree species.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The rusty-brown color that develops on the stem and gills comes from the mushroom's dark reddish-brown spores, which give the entire mature fruiting body a distinctive rust-colored appearance.",
