  "nameStory": "",
  "description": "Spruce witch's broom rust is a fungal disease caused by Chrysomyxa arctostaphyli that affects spruce trees in New England, characterized by abnormal branching patterns and stunted growth. This heteroecious rust requires both spruce and bearberry plants to complete its life cycle.",
  "idTips": [
    {
      "label": "Witch's Broom Formation",
      "description": "Dense clusters of abnormally short, twisted branches develop on infected spruce limbs, resembling a broom or bird's nest",
      "isPrimary": true
    },
    {
      "label": "Yellow Pustules",
      "description": "Small yellow or orange pustules appear on the underside of bearberry leaves during the alternate host phase of infection",
      "isPrimary": false
    },
    {
      "label": "Needle Discoloration",
      "description": "Infected spruce needles may show yellowing or browning before the characteristic broom-like deformity becomes visible",
      "isPrimary": false
    }
  ],
  "habitat": "This rust thrives in moist coniferous forests and mixed woodlands of New England where spruce and bearberry plants grow in proximity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its destructive appearance, witch's broom rust requires a fascinating two-host system, alternating between spruce trees and low-growing bearberry plants to complete its reproductive cycle.",
