  "nameStory": "",
  "description": "Copper Penny Fungus (Pachyella clypeata) is a small cup fungus belonging to the Pezizaceae family, characterized by its distinctive copper or bronze coloring and penny-sized fruiting bodies. This woodland fungus is commonly found in New England and plays a role in forest ecosystems as a decomposer.",
  "idTips": [
    {
      "label": "Copper-Bronze Coloring",
      "description": "The fruiting body displays a distinctive copper or bronze metallic sheen on the outer surface, resembling a tarnished penny.",
      "isPrimary": true
    },
    {
      "label": "Small Cup Shape",
      "description": "The apothecia (fruiting bodies) are typically 0.5-1.5 cm in diameter and form shallow, disc-like cups with a pale inner surface.",
      "isPrimary": false
    },
    {
      "label": "Hairy Exterior",
      "description": "The outer surface is covered with fine hairs or bristles that give it a slightly fuzzy appearance, distinguishing it from similar cup fungi.",
      "isPrimary": false
    }
  ],
  "habitat": "Copper Penny Fungus grows on well-decayed wood, leaf litter, and disturbed soil in moist woodlands and forest floors throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size, this fungus produces millions of microscopic spores that are dispersed by wind and rain, making it an important contributor to forest nutrient cycling.",
