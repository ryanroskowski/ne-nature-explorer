  "nameStory": "",
  "description": "Tricholoma aurantium is a medium-sized mushroom characterized by its distinctive orange to reddish-orange cap and white to pale gills. This species belongs to the Tricholomataceae family and is found in mixed forests throughout New England.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Bright orange to reddish-orange cap that may fade with age",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "White to pale yellowish gills that are broadly attached to the stem",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Solid white stem with a slight bulbous base and no ring present",
      "isPrimary": false
    }
  ],
  "habitat": "Tricholoma aurantium typically fruitsalone or in small groups on the forest floor in mixed coniferous and deciduous woodlands, often near oak or pine trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its appetizing appearance, Tricholoma aurantium is generally considered inedible to poisonous, with some reports of gastrointestinal upset in those who have consumed it.",
  "confusionNotes": null,
  "contextualKnowledge": null,
