  "nameStory": "",
  "description": "Patellaria atrata is a small, crustose lichen species belonging to the Patellariaceae family, characterized by its dark, disk-like fruiting bodies. This lichenized fungus is found in New England where it grows on various substrates in cool, moist environments.",
  "idTips": [
    {
      "label": "Dark Apothecia",
      "description": "Look for small, black or dark brown disk-shaped fruiting bodies (apothecia) that are slightly raised from the surface",
      "isPrimary": true
    },
    {
      "label": "Crustose Form",
      "description": "The thallus appears as a thin, compact crust tightly adhering to the substrate without visible lobes",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Apothecia are typically minute, usually less than 1mm in diameter, requiring magnification for proper identification",
      "isPrimary": false
    }
  ],
  "habitat": "Patellaria atrata grows on bark, rock, and decaying wood in shaded, humid forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all lichens, Patellaria atrata is a symbiotic organism composed of a fungus and photosynthetic algae or cyanobacteria living together, making it an excellent indicator of air quality in forest ecosystems.",
