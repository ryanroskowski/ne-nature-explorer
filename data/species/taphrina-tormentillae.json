  "nameStory": "",
  "description": "Taphrina tormentillae is a fungal pathogen belonging to the Taphrinaceae family that infects plants in the Rosaceae family, particularly tormentil (Potentilla erecta) and related species throughout New England. This ascomycete causes characteristic leaf distortions and produces a distinctive fruiting layer visible on infected plant surfaces.",
  "idTips": [
    {
      "label": "Leaf Curling and Distortion",
      "description": "Infected leaves become severely curled, puckered, and thickened with abnormal growth patterns on both upper and lower surfaces.",
      "isPrimary": true
    },
    {
      "label": "Powdery Spore Layer",
      "description": "A fine, powdery white or yellowish coating of asci and ascospores appears on the underside of affected leaves.",
      "isPrimary": false
    },
    {
      "label": "Host Plant Association",
      "description": "The fungus is typically found on tormentil (Potentilla erecta) and other low-growing Potentilla species in acidic soils.",
      "isPrimary": false
    }
  ],
  "habitat": "Taphrina tormentillae thrives in moist, shaded areas of woodlands, meadows, and heathlands where its host plants grow, particularly in acidic soil conditions common throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other members of the Taphrinaceae family, Taphrina tormentillae completely lacks a dikaryotic stage in its life cycle, making it unique among ascomycetes in its streamlined reproductive strategy.",
