  "nameStory": "",
  "description": "Powdery Goldspeck is a crustose lichen that forms thin, golden-yellow to orange-yellow crusts on rock surfaces throughout New England. It is a member of the Candelariaceae family, characterized by its bright coloration and powdery, granular appearance.",
  "idTips": [
    {
      "label": "Bright Golden-Yellow Color",
      "description": "The lichen displays a distinctive bright golden to orange-yellow crust that is easily recognizable among other lichens",
      "isPrimary": true
    },
    {
      "label": "Powdery Granular Surface",
      "description": "The surface appears granular and powdery rather than smooth, giving it a distinctive texture under magnification",
      "isPrimary": false
    },
    {
      "label": "Crustose Growth Form",
      "description": "It grows as a thin, adherent crust tightly attached to rock substrates without raised edges or leaflike lobes",
      "isPrimary": false
    }
  ],
  "habitat": "Powdery Goldspeck thrives on exposed rock surfaces, particularly acidic rocks and boulders in sunny to partially shaded locations throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The bright golden pigmentation of Powdery Goldspeck comes from usnic acid, which not only gives it its distinctive color but also provides UV protection and antimicrobial properties.",
