  "nameStory": "",
  "description": "Inocybe geophylla, commonly known as the White Fibrecap, is a small terrestrial mushroom characterized by its distinctive white to pale gray coloring and fibrous cap texture. This species belongs to the Inocybaceae family and is commonly encountered in woodlands and gardens throughout New England.",
  "idTips": [
    {
      "label": "White fibrous cap",
      "description": "Pale white to grayish cap with fine, radial fibers or striations visible on the surface, distinguishing it from other fibrecaps.",
      "isPrimary": true
    },
    {
      "label": "Radish-like odor",
      "description": "Distinctive smell resembling raw potatoes or radishes when crushed, a characteristic feature of the genus Inocybe.",
      "isPrimary": false
    },
    {
      "label": "Angular spores",
      "description": "Microscopic examination reveals distinctively angular or star-shaped spores, typical of Inocybe species.",
      "isPrimary": false
    }
  ],
  "habitat": "White Fibrecaps are saprotrophic fungi found on rich, moist soil in mixed hardwood and coniferous forests, gardens, and disturbed areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "All Inocybe species, including I. geophylla, contain trace amounts of muscarine, a toxic alkaloid, making them poisonous if ingested despite their small, inconspicuous appearance.",
