  "nameStory": "",
  "description": "Sowerbyella rhenana, commonly known as Stalked Orange-peel Fungus, is a small cup fungus characterized by its distinctive orange coloration and elevated stalk. This species belongs to the Pyronemataceae family and is found in moist forest environments throughout New England.",
  "idTips": [
    {
      "label": "Orange Cup Shape",
      "description": "Distinctive bright orange, cup-shaped fruiting bodies that resemble tiny pieces of orange peel",
      "isPrimary": true
    },
    {
      "label": "Stalked Base",
      "description": "Elevated on a thin stalk or stem, distinguishing it from sessile (stalkless) cup fungi",
      "isPrimary": false
    },
    {
      "label": "Microscopic Features",
      "description": "Spores are typically smooth and hyaline (colorless) when viewed under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives in moist, shaded areas of deciduous and mixed forests, typically fruiting on disturbed soil, leaf litter, or mossy substrates in spring through early summer.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'orange-peel fungus' refers to the fruiting body's striking resemblance to a tiny piece of orange peel, making it one of the more visually appealing microscopic fungi found in New England woodlands.",
