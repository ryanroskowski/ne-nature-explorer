  "nameStory": "",
  "description": "Rhodocollybia maculata, commonly known as Spotted Collybia, is a small woodland mushroom characterized by its delicate structure and distinctive spotted or stained appearance on the cap. This fungus belongs to the Omphalotaceae family and is commonly found decomposing leaf litter throughout New England forests.",
  "idTips": [
    {
      "label": "Spotted Cap",
      "description": "Whitish to pale cap with reddish-brown or rust-colored spots and stains that become more prominent with age",
      "isPrimary": true
    },
    {
      "label": "Thin Stem",
      "description": "Slender, tough stem that is lighter colored than the cap and often has a slightly reddish base",
      "isPrimary": false
    },
    {
      "label": "Crowded Gills",
      "description": "Pale to whitish gills that are closely spaced and attached to the stem",
      "isPrimary": false
    }
  ],
  "habitat": "Spotted Collybia grows on decaying wood, leaf litter, and humus-rich soil in mixed deciduous and coniferous forests throughout New England, fruiting in spring through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their small size and delicate appearance, Spotted Collybia mushrooms are quite tough and can survive repeated freezing and thawing cycles, allowing them to fruit over extended periods.",
