  "nameStory": "",
  "description": "Stereum sanguinolentum, commonly known as Bleeding Conifer Crust, is a thin, shelf-like fungus that forms orange-red fruiting bodies on dead or dying conifer wood. When damaged, it exudes distinctive blood-red droplets, giving it both its common and scientific name.",
  "idTips": [
    {
      "label": "Bleeding reaction",
      "description": "Produces bright blood-red or rusty-red droplets when the surface is scratched or bruised, a diagnostic characteristic",
      "isPrimary": true
    },
    {
      "label": "Growth form",
      "description": "Forms thin, shelf-like or crust-like fruiting bodies that are tightly attached to wood, typically orange-red to reddish-brown on the upper surface",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Found exclusively or primarily on dead conifer wood, particularly pine, spruce, and fir species",
      "isPrimary": false
    }
  ],
  "habitat": "Stereum sanguinolentum grows on dead or declining conifer logs, branches, and stumps throughout New England forests, preferring moist, shaded environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The blood-like droplets that appear when this fungus is wounded likely serve as a defense mechanism to protect against herbivorous insects and other wood-boring organisms.",
