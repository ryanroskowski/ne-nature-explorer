  "nameStory": "",
  "description": "Botryosphaeria dothidea is a fungal pathogen that causes cankers and dieback on various woody plants throughout New England, often associated with plant stress or injury. This fungus is a member of the Botryosphaeriaceae family and can significantly impact tree health when environmental conditions favor infection.",
  "idTips": [
    {
      "label": "Dark Cankers",
      "description": "Look for sunken, dark lesions on branches and stems that may girdle the wood",
      "isPrimary": true
    },
    {
      "label": "Pycnidia",
      "description": "Small dark fruiting bodies (pycnidia) appear as black dots embedded in dead bark tissue",
      "isPrimary": false
    },
    {
      "label": "Branch Dieback",
      "description": "Affected branches show progressive dieback starting from the canker, often with yellowing foliage above the infection site",
      "isPrimary": false
    }
  ],
  "habitat": "Botryosphaeria dothidea thrives on stressed or weakened woody plants in New England, particularly on hosts like dogwood, oak, and apple trees in areas with wounds, frost crack damage, or drought stress.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is considered a latent pathogen, meaning it can remain dormant in plant tissue without causing symptoms until the host plant becomes sufficiently stressed by environmental factors like drought or extreme weather.",
