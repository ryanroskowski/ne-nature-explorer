  "nameStory": "",
  "description": "The Allegheny River Cruiser is a medium-sized dragonfly in the Macromiidae family, characterized by its slender abdomen and distinctive flight behavior. It is primarily found in New England and is adapted to fast-flowing river ecosystems.",
  "idTips": [
    {
      "label": "Abdomen coloration",
      "description": "Metallic green to bronze abdomen with darker markings along the segments",
      "isPrimary": true
    },
    {
      "label": "Wing venation",
      "description": "Clear wings with a distinctive pattern of veins and a characteristic pterostigma",
      "isPrimary": false
    },
    {
      "label": "Body size",
      "description": "Medium-sized dragonfly, typically 50-60mm in length with a notably slender build",
      "isPrimary": false
    }
  ],
  "habitat": "The Allegheny River Cruiser inhabits swift, clean-flowing rivers and streams with rocky substrates, typically found in areas with good water quality and moderate to high current.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This species is named after the Allegheny River in Pennsylvania and is known for its exceptional hovering abilities, which allow it to maintain position while hunting for small insects over flowing water.",
