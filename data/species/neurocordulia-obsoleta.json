  "nameStory": "",
  "description": "The Umber Shadowdragon is a medium-sized dragonfly belonging to the Emerald family, characterized by its dark coloration and streamlined body adapted for swift, agile flight. This species is primarily found throughout New England, where it inhabits freshwater environments during its aquatic nymph stage.",
  "idTips": [
    {
      "label": "Dark Coloration",
      "description": "Exhibits a uniformly dark brown to blackish coloration on the body and wings, distinguishing it from brighter emerald dragonflies",
      "isPrimary": true
    },
    {
      "label": "Eye Color",
      "description": "Features distinctive dark eyes that appear nearly black, contrasting with the lighter eye coloration of related species",
      "isPrimary": false
    },
    {
      "label": "Wing Pattern",
      "description": "Wings are typically clear with a subtle smoky tint and characteristic venation patterns typical of the Neurocordulia genus",
      "isPrimary": false
    }
  ],
  "habitat": "The Umber Shadowdragon thrives near clear, fast-flowing streams and rivers with rocky substrates and abundant aquatic vegetation in New England.",
