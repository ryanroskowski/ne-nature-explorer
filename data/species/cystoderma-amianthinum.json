  "nameStory": "",
  "description": "Cystoderma amianthinum, commonly known as the Earthy Powdercap, is a small woodland mushroom characterized by its granular or powdery cap surface and delicate appearance. This fungus belongs to the Squamanitaceae family and is commonly found in New England during summer and fall months.",
  "idTips": [
    {
      "label": "Granular Cap Surface",
      "description": "The cap has a distinctive powdery or granular texture that appears beige to tan, giving it a rough, mealy appearance that is easily recognizable.",
      "isPrimary": true
    },
    {
      "label": "White Gills",
      "description": "The gills are white to pale cream-colored and are adnate (attached) to the stem, distinguishing it from other small woodland mushrooms.",
      "isPrimary": false
    },
    {
      "label": "Ring on Stem",
      "description": "A delicate, moveable ring (annulus) is present on the stem, though it may be subtle or disappear with age.",
      "isPrimary": false
    }
  ],
  "habitat": "This species thrives in mossy areas, coniferous and mixed forests, and acidic soils throughout New England, often fruiting in clusters near decomposing wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The granular coating on Cystoderma amianthinum's cap is composed of modified cells called dermatocystidia, which give the mushroom its distinctive powdery appearance and feel.",
