  "nameStory": "",
  "description": "The Brown Purplepore Bracket is a small, woody shelf fungus characterized by its distinctive purple to violet pores on the underside. It is a wood-decay fungus commonly found throughout New England, contributing to the decomposition of dead hardwood.",
  "idTips": [
    {
      "label": "Purple Pores",
      "description": "The underside displays distinctive purple, violet, or blue-purple pores that may fade to brown with age",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Upper surface is typically brown, tan, or gray with a velvety or hairy texture and concentric zones",
      "isPrimary": false
    },
    {
      "label": "Size and Shape",
      "description": "Forms small bracket or shelf-like fruiting bodies, usually less than 5 cm wide, with a thin, woody consistency",
      "isPrimary": false
    }
  ],
  "habitat": "Brown Purplepore Bracket grows on dead or dying hardwood logs, stumps, and branches throughout New England forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The vibrant purple coloration of its pores is thought to fade over time as the fruiting body matures, transitioning from deep violet to duller brown tones.",
