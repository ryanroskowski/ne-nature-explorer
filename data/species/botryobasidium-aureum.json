  "nameStory": "",
  "description": "Botryobasidium aureum is a wood-decay fungus belonging to the Botryobasidiaceae family, characterized by its golden or yellow coloration. This corticioid fungus plays an important ecological role in decomposing deadwood in forest ecosystems across New England.",
  "idTips": [
    {
      "label": "Golden-Yellow Color",
      "description": "Distinctive bright golden to yellow fruiting bodies that fade with age",
      "isPrimary": true
    },
    {
      "label": "Corticioid Form",
      "description": "Thin, crust-like or mat-like growth pattern spread across wood surfaces",
      "isPrimary": false
    },
    {
      "label": "Microscopic Features",
      "description": "Contains characteristic basidia and spores visible under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Botryobasidium aureum is found on decaying hardwood and softwood logs, stumps, and dead branches in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The golden color of Botryobasidium aureum is thought to help protect the fungus from UV radiation while it performs the vital work of breaking down dead wood and recycling nutrients back into forest ecosystems.",
