  "nameStory": "",
  "description": "Colletes productus is a small solitary bee species belonging to the plasterer bee family, named for their habit of lining nest cells with a cellophane-like secretion. Found throughout New England, these bees are important native pollinators that emerge in late summer and early fall.",
  "idTips": [
    {
      "label": "Size and Color",
      "description": "Small bee (8-10mm) with a dark body and sparse, short body hair giving it a relatively bare appearance compared to other bees",
      "isPrimary": true
    },
    {
      "label": "Facial Structure",
      "description": "Distinctive broad, flat face with large compound eyes positioned close together, characteristic of Colletes genus",
      "isPrimary": false
    },
    {
      "label": "Abdominal Bands",
      "description": "Light-colored hair bands visible on the abdomen, contrasting with the darker body",
      "isPrimary": false
    }
  ],
  "habitat": "Colletes productus prefers open, sandy or bare ground areas in meadows, gardens, and woodland edges where they can excavate nesting burrows.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female plasterer bees secrete a waterproof, cellophane-like lining from glands in their abdomen to waterproof their underground nest cells, which gives the entire family its distinctive common name.",
