  "nameStory": "",
  "description": "Trichoderma leucopus is a soil-dwelling fungus in the Hypocreaceae family commonly found throughout New England. This ascomycete plays an important ecological role as a decomposer and biocontrol agent against plant pathogens.",
  "idTips": [
    {
      "label": "White sporulation",
      "description": "Produces distinctive white to pale green conidial pustules on culture media",
      "isPrimary": true
    },
    {
      "label": "Growth rate",
      "description": "Exhibits rapid growth on standard agar plates, colonizing cultures within 3-5 days",
      "isPrimary": false
    },
    {
      "label": "Pigmentation",
      "description": "Shows minimal pigmentation compared to other Trichoderma species, remaining pale throughout development",
      "isPrimary": false
    }
  ],
  "habitat": "Trichoderma leucopus thrives in moist forest soils, leaf litter, and decaying wood throughout New England's temperate woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is commercially valuable as a biological control agent, naturally suppressing harmful plant pathogens through antibiotic production and competitive exclusion.",
