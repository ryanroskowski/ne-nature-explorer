  "nameStory": "",
  "description": "Deerberry Blunt-Horn is a specialized melittid bee native to New England that has evolved a unique relationship with deerberry plants. This small, solitary bee is an important pollinator adapted to the specific floral characteristics of its preferred plant host.",
  "idTips": [
    {
      "label": "Blunt Antenna Tips",
      "description": "The most distinctive feature is the notably blunt or rounded terminal segments of the antennae, rather than the pointed tips seen in many other bee species.",
      "isPrimary": true
    },
    {
      "label": "Small Body Size",
      "description": "This bee is relatively small compared to other native bees, making it well-suited to visiting the smaller flowers of deerberry plants.",
      "isPrimary": false
    },
    {
      "label": "Sparse Body Hairs",
      "description": "The bee has relatively fine, sparse body hair compared to fuzzy bees, which aids in its specialized pollination efficiency.",
      "isPrimary": false
    }
  ],
  "habitat": "Deerberry Blunt-Horn is found in open woodlands, forest edges, and areas with understory vegetation where deerberry (Vaccinium arboreum) and related plants thrive throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This bee demonstrates oligolectic behavior, meaning it is highly specialized and preferentially collects pollen from deerberry and closely related plants, making it a keystone pollinator for its host plant species.",
