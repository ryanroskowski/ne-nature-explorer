  "nameStory": "",
  "description": "Hebard's Green-legged Grasshopper (Melanoplus eurycercus) is a medium-sized member of the Short-horned Grasshopper family found throughout New England. This species is characterized by its distinctive green hind legs and relatively robust body structure.",
  "idTips": [
    {
      "label": "Green Hind Legs",
      "description": "The most distinctive feature is the bright green coloration of the hind legs and femurs, which contrasts with the darker body.",
      "isPrimary": true
    },
    {
      "label": "Body Coloration",
      "description": "Brown to olive-brown overall body color with a somewhat stocky build typical of Melanoplus species.",
      "isPrimary": false
    },
    {
      "label": "Antennae Length",
      "description": "Short antennae relative to body length, characteristic of short-horned grasshoppers in the Acrididae family.",
      "isPrimary": false
    }
  ],
  "habitat": "Hebard's Green-legged Grasshopper inhabits open grasslands, meadows, and prairie-like environments throughout New England, preferring areas with native grasses and herbaceous vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The green coloration of the hind legs may serve as a visual signal or play a role in species recognition during mating behaviors common to grasshoppers.",
