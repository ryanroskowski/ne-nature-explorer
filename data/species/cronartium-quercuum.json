  "nameStory": "",
  "description": "Pine-oak gall rust (Cronartium quercuum) is a heteroecious rust fungus that requires two different host plants to complete its life cycle, alternating between pine trees and oak trees. This pathogen is part of the Coleosporiaceae family and is commonly found throughout New England forests.",
  "idTips": [
    {
      "label": "Gall Formation on Pine",
      "description": "Distinctive spindle-shaped or cylindrical galls form on pine branches and stems, becoming perennial structures that persist for years",
      "isPrimary": true
    },
    {
      "label": "Aecial Cups on Oak",
      "description": "Yellow to orange cup-shaped aecia develop on the underside of oak leaves during spring, releasing powdery spores",
      "isPrimary": false
    },
    {
      "label": "Host Specificity",
      "description": "Galls only develop on certain pine species (particularly red and jack pines), while the alternate stage occurs on oak species",
      "isPrimary": false
    }
  ],
  "habitat": "Pine-oak gall rust thrives in mixed conifer-hardwood forests throughout New England, preferring areas where susceptible pine and oak species grow in proximity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This rust fungus is one of the few pathogens that requires completing its complex life cycle on two entirely different tree species, making forest composition a critical factor in its survival and spread.",
