  "nameStory": "",
  "description": "Beauveria bassiana, commonly known as icing sugar fungus, is an entomopathogenic fungus in the Cordycipitaceae family that naturally parasitizes insects. This fungus is found throughout New England and is notable for its white, powdery appearance that resembles icing sugar when it colonizes infected insects.",
  "idTips": [
    {
      "label": "White powdery coating",
      "description": "Distinctive fine, white, flour-like or icing sugar-like powder covering infected insects",
      "isPrimary": true
    },
    {
      "label": "Host insects",
      "description": "Commonly found on aphids, beetles, grasshoppers, and other arthropods in various stages of infection",
      "isPrimary": false
    },
    {
      "label": "Microscopic spores",
      "description": "Produces characteristic blastospores and conidia visible under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Beauveria bassiana thrives in moist soil and vegetation throughout New England, particularly in gardens, forests, and agricultural areas where it naturally infects insect populations.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is commercially produced and used as a biological pesticide to control crop-damaging insects, making it a valuable tool in organic farming and integrated pest management.",
