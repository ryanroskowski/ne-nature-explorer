  "nameStory": "",
  "description": "Lanmaoa pseudosensibilis is a small bolete fungus characterized by its delicate structure and subtle coloring, belonging to the diverse family of pored fungi found in temperate forests. This species is relatively inconspicuous and requires careful observation to distinguish from closely related species in New England woodlands.",
  "idTips": [
    {
      "label": "Pore Surface Color",
      "description": "Yellow to olive-yellow pores that may bruise or discolor when handled",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Small, pale tan to grayish cap with a delicate, often slightly wrinkled surface",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Slender stem with fine longitudinal striations and similar coloring to the cap",
      "isPrimary": false
    }
  ],
  "habitat": "Lanmaoa pseudosensibilis typically fruitsm in mixed hardwood and coniferous forests of New England, often appearing in moist leaf litter and mossy areas during summer and fall.",
