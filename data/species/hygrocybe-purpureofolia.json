  "nameStory": "",
  "description": "Hygrocybe purpureofolia, commonly known as the Purple-gilled Waxy Cap, is a small mushroom characterized by its distinctive purple to violet gills and waxy appearance. This delicate fungus belongs to the Hygrocybaceae family and is found in grassy areas throughout New England during late summer and fall.",
  "idTips": [
    {
      "label": "Purple Gills",
      "description": "The most distinctive feature is the bright purple to violet-colored gills that become darker with age",
      "isPrimary": true
    },
    {
      "label": "Waxy Texture",
      "description": "The cap and gills have a characteristically waxy, translucent appearance with a moist sheen",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Fruiting bodies are typically small, with caps rarely exceeding 2 cm in diameter",
      "isPrimary": false
    }
  ],
  "habitat": "Purple-gilled Waxy Caps prefer moist, grassy meadows and lawns with good drainage, often appearing in areas with low vegetation and minimal leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps are thought to be indicators of healthy grassland ecosystems, as they thrive in undisturbed, species-rich meadows and are becoming increasingly rare due to agricultural intensification.",
