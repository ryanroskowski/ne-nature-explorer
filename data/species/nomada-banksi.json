  "nameStory": "",
  "description": "Banks' Nomad Bee is a small, solitary bee species belonging to the family Apidae, native to New England and eastern North America. Despite their common name referencing honey bees, nomad bees are actually cuckoo bees that parasitize the nests of other bee species rather than producing their own colonies.",
  "idTips": [
    {
      "label": "Small size and smooth appearance",
      "description": "Banks' Nomad Bee is notably small (typically 7-9mm) with a relatively smooth, polished body lacking the dense hair typical of many other bees",
      "isPrimary": true
    },
    {
      "label": "Dark coloration with yellow markings",
      "description": "The bee displays a predominantly black body with yellow or light-colored facial markings and abdominal bands that distinguish it from bumble bees",
      "isPrimary": false
    },
    {
      "label": "Reduced pollen baskets",
      "description": "Like other cuckoo bees, this species lacks the enlarged hind tibiae (pollen baskets) seen in other bees, as it does not collect pollen for offspring",
      "isPrimary": false
    }
  ],
  "habitat": "Banks' Nomad Bee is found in open woodlands, meadows, and gardens throughout New England where populations of host bee species, particularly mining bees (Andrena spp.), are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, the female Banks' Nomad Bee sneaks into the nests of other bee species, laying her eggs so that the host bee unknowingly raises the nomad bee's offspring instead of her own.",
