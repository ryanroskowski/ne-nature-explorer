  "nameStory": "",
  "description": "Alder scalycap (Flammula alnicola) is a small, delicate mushroom characterized by its distinctive scaly cap and tendency to fruit in clusters. This fungus belongs to the Hymenogastraceae family and is commonly found in New England's moist woodlands.",
  "idTips": [
    {
      "label": "Scaly Cap",
      "description": "The cap features prominent, fibrous scales that radiate from the center, giving it a distinctive textured appearance",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Gills are typically decurrent to adnexed and often appear pale yellow to tan in color",
      "isPrimary": false
    },
    {
      "label": "Clustered Growth",
      "description": "Fruiting bodies typically emerge in tight clusters or tufts from decaying wood or soil",
      "isPrimary": false
    }
  ],
  "habitat": "Alder scalycap prefers moist, shaded environments in New England, particularly near alder trees and in decomposing woody debris in riparian zones and damp forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its association with alder trees, this species is a saprobe that feeds on decaying organic matter rather than parasitizing the living trees.",
