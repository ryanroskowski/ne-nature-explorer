  "nameStory": "",
  "description": "The Black Velvet Bolete is a striking fungus with a dark, velvety black or charcoal-colored cap and yellowish pores underneath that may bruise blue when handled. This bolete is found in New England forests and belongs to the family Boletaceae, known for their distinctive pore structure rather than gills.",
  "idTips": [
    {
      "label": "Velvety Black Cap",
      "description": "The cap surface is distinctively dark and velvety or felted in appearance, giving the mushroom its common name",
      "isPrimary": true
    },
    {
      "label": "Yellow Pores with Blue Bruising",
      "description": "Yellow or greenish-yellow pores on the underside turn blue when pressed or bruised, a diagnostic feature of this species",
      "isPrimary": false
    },
    {
      "label": "Pale to Whitish Stem",
      "description": "The stem is typically pale, whitish, or yellowish with minimal surface texture, contrasting sharply with the dark cap",
      "isPrimary": false
    }
  ],
  "habitat": "Black Velvet Boletes grow on the forest floor in hardwood and mixed forests throughout New England, typically appearing in summer and fall months.",
