  "nameStory": "",
  "description": "Strobilomyces confusus, commonly known as the Old Man of the Woods, is a bolete fungus characterized by its grayish-brown cap and distinctive grayish pores that bruise blue-black when touched. Despite its blue-staining reaction, this species is generally considered inedible or of poor culinary quality.",
  "idTips": [
    {
      "label": "Blue-black bruising",
      "description": "The pores and flesh turn dark blue to black when damaged, making this a key diagnostic feature",
      "isPrimary": true
    },
    {
      "label": "Scutellate cap",
      "description": "The cap surface has a distinctive quilted or tiled appearance with raised polygonal areas",
      "isPrimary": false
    },
    {
      "label": "Gray pores and stem",
      "description": "The underside pores are distinctly gray (not yellow or white) and the stem has a similar gray coloring",
      "isPrimary": false
    }
  ],
  "habitat": "Strobilomyces confusus is found in mixed hardwood and coniferous forests throughout New England, typically fruiting in summer through fall on well-drained forest floors.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'Old Man of the Woods' likely refers to the grayish, aged appearance of its cap and the whitish veil remnants that give it a weathered look.",
  "confusionNotes": null,
