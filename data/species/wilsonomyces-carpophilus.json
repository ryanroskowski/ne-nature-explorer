  "nameStory": "",
  "description": "Cherry Shot Hole (Wilsonomyces carpophilus) is a fungal disease that primarily affects cherry and plum trees, causing distinctive small holes in leaves as the diseased tissue falls away. This pathogen belongs to the Dothideomycetes class and is a common problem in New England's humid climate.",
  "idTips": [
    {
      "label": "Shot Hole Symptom",
      "description": "Small, circular lesions with a reddish-brown border that eventually drop out, leaving clean round holes in the leaf that resemble bullet holes",
      "isPrimary": true
    },
    {
      "label": "Affected Plant Parts",
      "description": "Lesions appear on leaves, fruit, and twigs; on fruit, they create dark, sunken spots that make cherries unmarketable",
      "isPrimary": false
    },
    {
      "label": "Seasonal Timing",
      "description": "Symptoms typically appear in spring and early summer during wet, cool conditions favorable for fungal spore dispersal",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives in New England's temperate climate, particularly in orchards and gardens where cherry and plum trees experience spring rainfall and cool, moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The disease gets its common name from the appearance of shot holes in leaves, which historically reminded observers of small bullet holes in fabric or paper.",
