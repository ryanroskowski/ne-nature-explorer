  "nameStory": "",
  "description": "The Eastern Bare-Miner (Protandrena andrenoides) is a small, solitary bee belonging to the Andrenidae family, native to New England and eastern North America. These bees are important early-season pollinators that emerge in spring to forage on wildflowers and fruit tree blossoms.",
  "idTips": [
    {
      "label": "Body Size and Color",
      "description": "Small bee, typically 6-8mm long, with a dark brown to black body and sparse body hair compared to other bee species",
      "isPrimary": true
    },
    {
      "label": "Bare Appearance",
      "description": "Noticeably less hairy than most other bees, with a relatively smooth, shiny appearance on the abdomen",
      "isPrimary": false
    },
    {
      "label": "Spring Emergence",
      "description": "One of the earliest bees to emerge in spring, often seen in March through May in New England",
      "isPrimary": false
    }
  ],
  "habitat": "Eastern Bare-Miners prefer open woodlands, meadows, and gardens with abundant early spring wildflowers and are often found nesting in bare ground or sandy patches.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female Eastern Bare-Miners are solitary nesters that dig their own burrows in bare soil, laying eggs in individual cells provisioned with pollen and nectar for their larvae.",
