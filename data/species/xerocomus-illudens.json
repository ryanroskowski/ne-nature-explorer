  "nameStory": "",
  "description": "Xerocomelus illudens, commonly known as the Deceptive Bolete, is a small woodland mushroom belonging to the boletes family, characterized by its modest size and subtle coloring. Despite its unassuming appearance, it is a distinctive species found in the forests of New England and northeastern North America.",
  "idTips": [
    {
      "label": "Pore Surface Color",
      "description": "Yellow pores that may bruise or stain blue-green when handled, a key diagnostic feature of this species",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Small brown to grayish-brown cap, typically 1-3 inches in diameter, with a dry, velvety texture",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Thin, fragile stem that is yellow at the base and may display faint red coloration in the middle section",
      "isPrimary": false
    }
  ],
  "habitat": "Xerocomelus illudens grows on the forest floor in mixed deciduous and coniferous forests of New England, often appearing in mossy areas near rotting wood and leaf litter during late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'illudens' means 'deceptive' or 'mocking,' referring to how easily this small bolete can be confused with other similar-looking species in the genus.",
