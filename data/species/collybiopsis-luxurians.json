  "nameStory": "",
  "description": "Luxury Caps (Collybiopsis luxurians) are small, delicate mushrooms belonging to the Omphalotaceae family, characterized by their elegant appearance and preference for moist forest environments. These fungi play an important ecological role as decomposers in New England woodlands, breaking down organic matter on the forest floor.",
  "idTips": [
    {
      "label": "Cap appearance",
      "description": "Small, convex to flat caps (typically 1-3 cm) with a distinctive pale to whitish color, often with subtle radial striations",
      "isPrimary": true
    },
    {
      "label": "Gill attachment",
      "description": "Gills are decurrent (running down the stem) and relatively distant, a characteristic feature of the Omphalotaceae family",
      "isPrimary": false
    },
    {
      "label": "Stem characteristics",
      "description": "Slender, fragile stems that are pale and may appear translucent when moist",
      "isPrimary": false
    }
  ],
  "habitat": "Luxury Caps thrive in moist, shaded areas of New England forests, typically growing on decaying wood, leaf litter, and rich humus in cool, humid conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their delicate appearance, Luxury Caps are resilient decomposers that help recycle nutrients back into the forest ecosystem, supporting the health of surrounding plants and trees.",
