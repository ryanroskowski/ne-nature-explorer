  "nameStory": "",
  "description": "Etheirodon fimbriatum is a wood-decaying fungus in the Steccherinaceae family, characterized by its distinctive tooth-like or spine-like structures beneath the cap. This species is found in New England where it plays an important ecological role in decomposing hardwood substrates.",
  "idTips": [
    {
      "label": "Fimbriate Spines",
      "description": "The underside features distinctive fringed or fimbriate (finely divided) tooth-like spines that are branched or irregularly arranged, which is the primary diagnostic feature giving the species its name.",
      "isPrimary": true
    },
    {
      "label": "Cream to Pale Coloring",
      "description": "The fruiting bodies are typically pale cream, whitish, or light tan colored, becoming darker or bruised with age or handling.",
      "isPrimary": false
    },
    {
      "label": "Thin, Bracket-like Form",
      "description": "The fruiting bodies grow as thin, shelf-like or bracket-form structures on wood, often appearing delicate compared to other tooth fungi.",
      "isPrimary": false
    }
  ],
  "habitat": "Etheirodon fimbriatum occurs on dead hardwood, particularly on fallen logs and dead branches in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Steccherinaceae family are sometimes called 'tooth fungi' because their spine-like structures evolved as an alternative to gills, allowing them to efficiently release spores in various orientations.",
