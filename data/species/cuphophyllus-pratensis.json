  "nameStory": "",
  "description": "Meadow Waxcap is a small, delicate fungus belonging to the Waxcap family, characterized by its bright coloration and waxy texture. This grassland specialist is an important indicator of unimproved, nutrient-poor meadows in New England and beyond.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Bright yellow to orange or red cap, often with a convex shape becoming flattened with age",
      "isPrimary": true
    },
    {
      "label": "Waxy Texture",
      "description": "Distinctive waxy or greasy appearance on both cap and gills, giving the fungus a polished look",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Decurrent or subdecurrent gills that are thick, waxy, and often yellow or pale in color",
      "isPrimary": false
    }
  ],
  "habitat": "Meadow Waxcap thrives in unimproved, nutrient-poor grasslands and meadows throughout New England, preferring areas that have not been treated with fertilizers or pesticides.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps like Cuphophyllus pratensis are considered ecological indicators of pristine meadows; their presence signals a healthy, chemically untreated grassland ecosystem.",
