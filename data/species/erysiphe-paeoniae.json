  "nameStory": "",
  "description": "Peony Powdery Mildew (Erysiphe paeoniae) is a fungal disease that affects peony plants, causing a white, powdery coating on leaves and stems. This pathogen is particularly common in New England gardens during warm, humid summers with poor air circulation.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish powder covering leaf surfaces, petioles, and sometimes flower buds",
      "isPrimary": true
    },
    {
      "label": "Leaf Distortion",
      "description": "Affected leaves may become curled, stunted, or yellowed beneath the fungal coating",
      "isPrimary": false
    },
    {
      "label": "Early Season Appearance",
      "description": "Symptoms typically appear in late spring to early summer, often starting on lower leaves first",
      "isPrimary": false
    }
  ],
  "habitat": "Peony Powdery Mildew thrives in New England gardens on peony plants (both herbaceous and tree peonies) in areas with moderate temperatures (60-75°F), high humidity, and limited air circulation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews, Erysiphe paeoniae requires moisture on leaves to germinate, making it particularly problematic during humid New England springs and early summers.",
