  "nameStory": "",
  "description": "The noble bolete (Boletus nobilis) is a large, impressive fungus belonging to the boletes family, characterized by its robust appearance and distinctive coloring. This edible species is prized by mushroom foragers in New England for its culinary value and meaty texture.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Dark brown to blackish-brown cap with a velvety or suede-like surface that can reach 4-10 inches in diameter",
      "isPrimary": true
    },
    {
      "label": "Stem Characteristics",
      "description": "Thick, robust stem with yellow reticulation (net-like pattern) on a lighter background, bulbous at the base",
      "isPrimary": false
    },
    {
      "label": "Pore Surface",
      "description": "Yellow pores that may bruise slightly blue-green when handled, turning from yellow to olive-green with age",
      "isPrimary": false
    }
  ],
  "habitat": "Noble boletes grow on the forest floor in mixed hardwood and coniferous forests throughout New England, typically fruiting in summer and fall near oaks and other deciduous trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The noble bolete is sometimes confused with the poisonous Satan's bolete, but can be reliably distinguished by its darker cap, thicker stem with yellow reticulation, and lack of red coloring on the pore surface.",
  "confusionNotes": null,
  "contextualKnowledge": null,
