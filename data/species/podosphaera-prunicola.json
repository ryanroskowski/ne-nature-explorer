  "nameStory": "",
  "description": "Podosphaera prunicola is a powdery mildew fungus that specifically infects stone fruits, particularly plums and cherries, causing a white powdery coating on leaves and fruit. This pathogen is a significant agricultural concern in New England and other temperate regions where stone fruits are cultivated.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Affected leaves, flowers, and fruit develop a distinctive white to grayish powdery film that can be wiped off, covering both upper and lower leaf surfaces.",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "This species primarily attacks Prunus species (plums, cherries, and apricots), making host plant identification crucial for diagnosis.",
      "isPrimary": false
    },
    {
      "label": "Chasmothecia Formation",
      "description": "In autumn, the fungus produces small dark overwintering structures (chasmothecia) on infected leaf tissue, appearing as tiny black dots within the white coating.",
      "isPrimary": false
    }
  ],
  "habitat": "Podosphaera prunicola thrives in warm, dry conditions with moderate humidity and is commonly found on cultivated and wild stone fruit trees throughout New England's orchards and gardens.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews that prefer cool conditions, Podosphaera prunicola actually performs better in warm weather, making late spring and early summer its peak infection period in New England.",
