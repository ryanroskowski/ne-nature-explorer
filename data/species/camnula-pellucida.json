  "nameStory": "",
  "description": "The Clear-winged Grasshopper (Camnula pellucida) is a medium-sized member of the Short-horned Grasshopper family found throughout New England and North America. It is named for its distinctive transparent or lightly-tinted wings that set it apart from many other grasshopper species.",
  "idTips": [
    {
      "label": "Transparent Wings",
      "description": "The wings are notably clear or have a pale, translucent appearance, which is the defining characteristic of this species.",
      "isPrimary": true
    },
    {
      "label": "Body Coloration",
      "description": "The body is typically tan, brown, or grayish in color with a somewhat mottled pattern.",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Adults are medium-sized grasshoppers, typically measuring 0.75 to 1 inch in length.",
      "isPrimary": false
    }
  ],
  "habitat": "Clear-winged Grasshoppers are found in open, dry grasslands, meadows, and brushy areas throughout New England.",
