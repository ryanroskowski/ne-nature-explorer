  "nameStory": "",
  "description": "Stalked Bonfire Cup (Geopyxis carbonaria) is a small fungal fruiting body belonging to the Tarzettaceae family, characterized by its distinctive cup or goblet shape. This species is commonly found throughout New England and other temperate regions, typically appearing in disturbed soil and burnt areas.",
  "idTips": [
    {
      "label": "Cup Shape with Stalk",
      "description": "The fruiting body has a characteristic cup or goblet form with a distinct stalk (peduncle) at the base, distinguishing it from sessile cup fungi",
      "isPrimary": true
    },
    {
      "label": "Color and Size",
      "description": "Small cups typically 0.5-1.5 cm wide, ranging from tan to brownish in color, often with a lighter inner surface",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Frequently found in burnt or charred soil areas, wood chips, and disturbed ground, which is a key identifying clue",
      "isPrimary": false
    }
  ],
  "habitat": "Stalked Bonfire Cup thrives in disturbed soils, particularly in burnt areas, around campfires, on mulched beds, and in fire-prone regions throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This species has a remarkable affinity for charred wood and burnt soil, often appearing shortly after forest fires or in areas where bonfires have been lit, earning it the common name 'Bonfire Cup.'",
