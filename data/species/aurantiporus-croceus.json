  "nameStory": "",
  "description": "Orange Polypore (Aurantiporus croceus) is a striking bracket fungus characterized by its vibrant orange to golden-yellow coloring and small, angular pores on its underside. This wood-decay fungus belongs to the Meruliaceae family and is commonly encountered throughout New England on dead hardwood logs and stumps.",
  "idTips": [
    {
      "label": "Bright Orange Color",
      "description": "Distinctive bright orange to golden-yellow upper surface that fades slightly with age",
      "isPrimary": true
    },
    {
      "label": "Small Angular Pores",
      "description": "Underside features small, angular pores that are orange to yellowish and may stain darker when bruised",
      "isPrimary": false
    },
    {
      "label": "Thin Fruiting Body",
      "description": "Relatively thin, shelf-like fruiting body (typically 2-5 mm thick) with a velvety texture on top",
      "isPrimary": false
    }
  ],
  "habitat": "Orange Polypore primarily grows on dead hardwood logs, branches, and stumps in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its stunning appearance, Orange Polypore is a saprotroph that plays an important ecological role by breaking down dead wood and returning nutrients to the forest soil.",
