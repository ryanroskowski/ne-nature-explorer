  "nameStory": "",
  "description": "Arachnopeziza aurelia is a small cup fungus belonging to the Arachnopezizaceae family, characterized by its delicate, orange to golden-yellow fruiting bodies. This species is commonly found on decaying wood and plant debris throughout New England forests.",
  "idTips": [
    {
      "label": "Cup-shaped fruiting body",
      "description": "Distinctive bright orange to golden-yellow apothecia (cup-like structures) that are small, typically 2-5mm in diameter",
      "isPrimary": true
    },
    {
      "label": "Hairy exterior",
      "description": "The outer surface of the cups is covered with characteristic spider-like hairs (setae), giving the genus its name",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Fruiting bodies appear on decaying wood, bark, and plant litter in moist forest environments",
      "isPrimary": false
    }
  ],
  "habitat": "Arachnopeziza aurelia thrives in moist New England forests on decaying hardwood, bark, and accumulated plant debris where moisture is consistently present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name 'Arachnopeziza' literally means 'spider cup,' referring to the spider-like hairs that cover the exterior of these tiny fungal fruiting bodies.",
