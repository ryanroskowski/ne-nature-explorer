  "nameStory": "",
  "description": "The American Shieldback (Atlanticus americanus) is a cricket-like insect belonging to the katydid family, characterized by its compact body and shield-shaped pronotum. Despite their name, shieldbacks are more closely related to katydids than true crickets and are primarily nocturnal ground dwellers.",
  "idTips": [
    {
      "label": "Shield-shaped Pronotum",
      "description": "The most distinctive feature is the broad, shield-like covering of the thorax that extends backward, giving the insect a compact, armored appearance",
      "isPrimary": true
    },
    {
      "label": "Short Wings",
      "description": "Shieldbacks have reduced or vestigial wings that do not extend the length of the abdomen, unlike many katydids",
      "isPrimary": false
    },
    {
      "label": "Robust Build",
      "description": "They have a stockier, more heavily-built body compared to long-winged katydids, appearing more like crickets",
      "isPrimary": false
    }
  ],
  "habitat": "American Shieldbacks are found in dry grasslands, scrublands, and woodland edges throughout New England, preferring areas with dense low vegetation and leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many katydids that produce loud calls, shieldbacks create very quiet sounds by rubbing their wings together, making them difficult to locate despite their presence in an area.",
