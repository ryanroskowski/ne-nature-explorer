  "nameStory": "",
  "description": "The Bristle Sweat Bee (Lasioglossum imitatum) is a small, metallic green native bee species found throughout New England. These solitary to semi-social bees are important pollinators that visit a wide variety of flowering plants during the warmer months.",
  "idTips": [
    {
      "label": "Metallic Green Coloration",
      "description": "Body displays a distinctive shiny, metallic green sheen, particularly on the head and thorax",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Measures approximately 4-5mm in length, making it one of the smaller bee species",
      "isPrimary": false
    },
    {
      "label": "Sparse Body Hair",
      "description": "Features relatively sparse, fine hair on the body compared to other bee species",
      "isPrimary": false
    }
  ],
  "habitat": "Bristle Sweat Bees are found in open, sunny areas including gardens, meadows, and woodland edges throughout New England, preferring flowers with accessible nectar and pollen.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their name, sweat bees are attracted to human perspiration for the salt content, though Lasioglossum imitatum is more interested in flowers than actively seeking out people.",
  "confusionNotes": null,
  "contextualKnowledge": null,
