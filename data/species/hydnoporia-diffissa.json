  "nameStory": "",
  "description": "Glue Crust Fungus (Hydnoporia diffissa) is a wood-decay fungus in the Hymenochaetaceae family characterized by its distinctive sticky or gelatinous surface when moist. It forms thin, crusty fruiting bodies on dead hardwood and produces small pores rather than gills for spore dispersal.",
  "idTips": [
    {
      "label": "Sticky Texture",
      "description": "The fruiting body feels gelatinous or glue-like when wet, distinguishing it from related dry crust fungi",
      "isPrimary": true
    },
    {
      "label": "Pore Structure",
      "description": "Tiny, angular pores on the undersurface are visible with magnification and appear rust to brown in color",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "Forms thin, adherent crusts on hardwood logs and branches, often appearing as dark, thin patches",
      "isPrimary": false
    }
  ],
  "habitat": "Hydnoporia diffissa grows on dead hardwood, particularly on logs and fallen branches in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The gelatinous quality of this fungus increases dramatically when wet, making it nearly impossible to separate from wood without damaging it—a trait that gives it its common name.",
