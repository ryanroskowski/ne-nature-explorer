  "nameStory": "",
  "description": "The Crimson Waxcap is a striking fungus characterized by its brilliant red to crimson coloring and waxy texture that gives the waxcap family its name. This small to medium-sized mushroom is a saprotroph that fruits in grasslands and meadows throughout New England.",
  "idTips": [
    {
      "label": "Brilliant Red Color",
      "description": "Vibrant crimson to scarlet cap and stem that may fade to orange or yellow with age",
      "isPrimary": true
    },
    {
      "label": "Waxy Appearance",
      "description": "Distinctive smooth, slick, and somewhat translucent appearance to the cap and gills",
      "isPrimary": false
    },
    {
      "label": "Decurrent Gills",
      "description": "Gills that run down the stem, are widely spaced, and typically yellow to orange in color",
      "isPrimary": false
    }
  ],
  "habitat": "Found in nutrient-poor, acidic grasslands, meadows, and mossy areas where it fruits in small groups or scattered, particularly in late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their brilliant colors, waxcaps like Hygrocybe punicea are edible but have minimal nutritional value and a watery, bland taste, making them more valued by mushroom enthusiasts for their striking appearance than culinary purposes.",
  "confusionNotes": null,
  "contextualKnowledge": null,
