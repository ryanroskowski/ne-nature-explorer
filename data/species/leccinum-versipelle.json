  "nameStory": "",
  "description": "The Orange Birch Bolete (Leccinum versipelle) is a striking mushroom characterized by its orange to reddish-orange cap and distinctive white pores that bruise blue-black when handled. This bolete is commonly found in New England forests and is prized by mushroom foragers, though it requires careful preparation before consumption.",
  "idTips": [
    {
      "label": "Orange Cap",
      "description": "Bright orange to reddish-orange rounded cap, often with a white margin that overhangs the stem",
      "isPrimary": true
    },
    {
      "label": "Blue-Black Bruising",
      "description": "White or pale yellow pores beneath the cap rapidly turn blue-black when pressed or damaged",
      "isPrimary": false
    },
    {
      "label": "Scabrouse Stem",
      "description": "White stem covered with dark orange, red, or brown fibrous scales or dots, creating a distinctive spotted appearance",
      "isPrimary": false
    }
  ],
  "habitat": "Orange Birch Boletes grow on the forest floor in association with birch trees, preferring mixed hardwood forests and areas with adequate moisture throughout New England from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its edibility, the Orange Birch Bolete requires thorough cooking and sometimes parboiling to remove toxins that can cause gastrointestinal upset in some people, making proper preparation essential before eating.",
