  "nameStory": "",
  "description": "Crepidotus cinnabarinus, commonly known as the cinnabar oysterling, is a small shelf or bracket fungus characterized by its distinctive reddish to cinnabar-colored fruiting bodies. This species belongs to the Crepidotaceae family and is commonly found decomposing woody debris throughout New England.",
  "idTips": [
    {
      "label": "Distinctive Red-Orange Color",
      "description": "The fruiting bodies display a vibrant cinnabar red to orange-red coloration, making this the most recognizable feature",
      "isPrimary": true
    },
    {
      "label": "Small Shelf-like Form",
      "description": "Fruiting bodies are typically small (1-3 cm) and grow in shelf or bracket formations, often in overlapping clusters",
      "isPrimary": false
    },
    {
      "label": "Decurrent Gills",
      "description": "The fungus has closely spaced gills that run down the stalk, which are whitish to pale pink and turn rusty with age",
      "isPrimary": false
    }
  ],
  "habitat": "This species thrives on decaying hardwood logs, branches, and fallen wood in moist, shaded forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The cinnabar oysterling's vivid red coloration intensifies when wet and fades as the fruiting body dries, making its appearance dramatically variable depending on weather conditions.",
