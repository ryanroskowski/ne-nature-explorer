  "nameStory": "",
  "description": "Mycena filopes, commonly known as the Iodine Bonnet, is a small delicate mushroom with a distinctive iodine-like smell that gives it its common name. This tiny fungus is a saprotroph, breaking down decaying wood and leaf litter in forest ecosystems.",
  "idTips": [
    {
      "label": "Iodine Odor",
      "description": "Emits a characteristic strong iodine or chemical smell, particularly when crushed or bruised",
      "isPrimary": true
    },
    {
      "label": "Thin Stem",
      "description": "Has a very slender, hair-like stem (filamentous) that is often longer than the cap diameter",
      "isPrimary": false
    },
    {
      "label": "Small Bell-shaped Cap",
      "description": "Produces a delicate, pale gray to brown cap typically 0.5-1.5 cm wide with fine grooves radiating from the center",
      "isPrimary": false
    }
  ],
  "habitat": "Found in moist, shaded hardwood and mixed forests of New England, typically growing on decaying logs, leaf litter, and woody debris from late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The iodine-like chemical odor produced by Mycena filopes may serve as a defense mechanism or play a role in attracting insects for spore dispersal.",
  "confusionNotes": null,
  "contextualKnowledge": null,
