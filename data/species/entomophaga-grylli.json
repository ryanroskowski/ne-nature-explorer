  "nameStory": "",
  "description": "Entomophaga grylli is a fungal pathogen in the Entomophthoraceae family that specifically infects grasshoppers and crickets, causing fatal infections. This entomopathogenic fungus is found throughout New England and plays an important role in natural pest control by reducing grasshopper populations.",
  "idTips": [
    {
      "label": "Host Specificity",
      "description": "Primarily infects grasshoppers and crickets (order Orthoptera), making the infected host insect the most reliable identification feature",
      "isPrimary": true
    },
    {
      "label": "Fungal Fruiting Bodies",
      "description": "Produces distinctive conidial masses that appear as sticky, whitish or yellowish structures protruding from the host's body, particularly around the abdomen and legs",
      "isPrimary": false
    },
    {
      "label": "Behavioral Changes in Host",
      "description": "Infected grasshoppers exhibit abnormal climbing behavior and positioning, often found clinging to vegetation in exposed locations before death occurs",
      "isPrimary": false
    }
  ],
  "habitat": "Entomophaga grylli thrives in grassy meadows, grasslands, and agricultural areas throughout New England where grasshopper and cricket populations are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus exhibits 'summit disease' behavior, manipulating infected grasshoppers to climb to elevated positions before death, which allows the fungus to better disperse its spores to new hosts below.",
