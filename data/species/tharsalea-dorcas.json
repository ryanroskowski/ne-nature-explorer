  "nameStory": "",
  "description": "The Dorcas Copper is a small butterfly in the Lycaenidae family, characterized by brilliant copper-colored wings with distinctive dark markings. This New England resident is one of the most attractive copper species found in the region.",
  "idTips": [
    {
      "label": "Wing Color",
      "description": "Forewings display bright orange-red coloring with black spots and margins; hindwings are orange with dark borders",
      "isPrimary": true
    },
    {
      "label": "Underside Pattern",
      "description": "Wing undersides are pale gray or whitish with small black spots and orange hindwing borders",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Very small butterfly with a wingspan of only 0.8 to 1.1 inches, among the smallest copper species",
      "isPrimary": false
    }
  ],
  "habitat": "Dorcas Coppers inhabit open grasslands, meadows, and disturbed areas where their host plants, dock and sorrel species, grow abundantly.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Dorcas Coppers are highly territorial and engage in vigorous aerial chases with rival males, perching on low vegetation to survey their domain.",
