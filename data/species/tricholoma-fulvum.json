  "nameStory": "",
  "description": "Birch Knight (Tricholoma fulvum) is a medium-sized woodland mushroom characterized by its distinctive tawny to russet-brown cap and robust appearance. It is a mycorrhizal fungus that forms symbiotic relationships with birch trees throughout New England forests.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Tawny, russet-brown to golden-brown cap that may fade slightly with age, often with a slightly darker center",
      "isPrimary": true
    },
    {
      "label": "Gills and Stem",
      "description": "White to pale cream gills that are crowded and may develop yellowish stains; white to pale stem with no ring",
      "isPrimary": false
    },
    {
      "label": "Birch Association",
      "description": "Found exclusively or primarily near birch trees, which is a key field clue for identification",
      "isPrimary": false
    }
  ],
  "habitat": "Birch Knight fruiting bodies appear in mixed forests with abundant birch trees, typically from summer through fall in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'Birch Knight' reflects its obligate relationship with birch trees—the fungus cannot fruit without a suitable birch host to exchange nutrients with underground.",
  "confusionNotes": null,
  "contextualKnowledge": null,
