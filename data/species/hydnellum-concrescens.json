  "nameStory": "",
  "description": "Hydnellum concrescens, commonly known as Zoned Tooth, is a wood-decaying fungus characterized by its distinctive tiered, concentric color zones on the cap surface. This species belongs to the Boletopsidaceae family and is found throughout New England, where it plays an important ecological role in forest decomposition.",
  "idTips": [
    {
      "label": "Concentric Zones",
      "description": "Cap displays prominent, alternating bands of light and dark brown colors in a circular pattern",
      "isPrimary": true
    },
    {
      "label": "Spiny Undersurface",
      "description": "The hymenium consists of small, tooth-like spines (hydnoid surface) rather than gills or pores, typically white to pale tan in color",
      "isPrimary": false
    },
    {
      "label": "Cap Appearance",
      "description": "Cap is convex to irregular, often becoming funnel-shaped with age, measuring 2-6 cm in diameter",
      "isPrimary": false
    }
  ],
  "habitat": "Hydnellum concrescens grows on decaying hardwood logs and stumps in mixed deciduous and coniferous forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The concentric zones on the cap represent annual growth rings, allowing mycologists to estimate the fungus's age by counting the alternating color bands.",
