  "nameStory": "",
  "description": "Asterophora parasitica, commonly known as Silky Piggyback, is a small fungus in the Lyophyllaceae family that grows parasitically on the fruiting bodies of other mushrooms, particularly brittlegills and milk caps. This delicate fungus features a silky appearance and represents a fascinating example of fungal parasitism in nature.",
  "idTips": [
    {
      "label": "Parasitic Growth",
      "description": "Grows directly on the caps of other mushrooms, especially Russula and Lactarius species, rather than from the ground",
      "isPrimary": true
    },
    {
      "label": "Silky Texture",
      "description": "Caps have a distinctive silky or velvety appearance with a pale, whitish to grayish color",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Produces very small fruiting bodies, typically 5-15mm in diameter, with thin delicate stems",
      "isPrimary": false
    }
  ],
  "habitat": "Found in New England woodlands and forests where it parasitizes the fruiting bodies of other mushrooms on moist forest floors and decaying wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike most fungi that compete for resources, Asterophora parasitica has evolved a specialized parasitic lifestyle, feeding directly on the fruiting bodies of host mushrooms while leaving the host's mycelium intact.",
