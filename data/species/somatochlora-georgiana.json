  "nameStory": "",
  "description": "The Coppery Emerald is a medium-sized dragonfly belonging to the Emerald family (Corduliidae), characterized by its distinctive coppery-bronze coloration. Found throughout New England, this species is an agile flier commonly seen near freshwater habitats during summer months.",
  "idTips": [
    {
      "label": "Coppery Coloration",
      "description": "Metallic coppery-bronze sheen on the body and thorax, distinguishing it from other green emeralds",
      "isPrimary": true
    },
    {
      "label": "Abdominal Pattern",
      "description": "Dark abdomen with a distinctly metallic appearance when viewed in sunlight",
      "isPrimary": false
    },
    {
      "label": "Eye Color",
      "description": "Large, dark compound eyes that are characteristic of emerald dragonflies",
      "isPrimary": false
    }
  ],
  "habitat": "The Coppery Emerald inhabits clear, cool streams and small lakes with aquatic vegetation, preferring areas with minimal pollution and good water quality.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all emerald dragonflies, the Coppery Emerald is an excellent hunter that can reach speeds up to 30 mph while pursuing prey mid-air, using its superior maneuverability to catch small insects.",
