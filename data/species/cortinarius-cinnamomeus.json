  "nameStory": "",
  "description": "Cortinarius cinnamomeus, commonly known as the Cinnamon Webcap, is a small to medium-sized mushroom in the diverse Webcaps family characterized by its distinctive russet-brown coloring. This terrestrial fungus forms mycorrhizal relationships with trees and is commonly found throughout New England's forests.",
  "idTips": [
    {
      "label": "Cinnamon-colored caps and stems",
      "description": "The distinctive russet to cinnamon-brown caps and matching stems are the hallmark feature that gives this mushroom its common name.",
      "isPrimary": true
    },
    {
      "label": "Cobweb-like veil",
      "description": "A thin, delicate cortina (cobweb-like partial veil) connects the cap margin to the stem, characteristic of the Cortinarius genus.",
      "isPrimary": false
    },
    {
      "label": "Brown spore print",
      "description": "Produces a rusty-brown spore print, typical of Cortinarius species and useful for definitive identification.",
      "isPrimary": false
    }
  ],
  "habitat": "Cortinarius cinnamomeus grows in coniferous and mixed deciduous forests of New England, forming mycorrhizal associations with trees such as pine, spruce, and birch.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many webcaps, Cortinarius cinnamomeus contains compounds that make it toxic if consumed, making proper identification essential for foragers exploring New England woodlands.",
  "confusionNotes": null,
