  "nameStory": "",
  "description": "Tricholoma subresplendens is a medium-sized woodland mushroom in the Tricholomataceae family characterized by its subtle gray-brown coloring and somewhat metallic sheen. This species is found in New England forests and is primarily of mycological interest rather than culinary value.",
  "idTips": [
    {
      "label": "Cap appearance",
      "description": "Gray-brown to brownish cap with a slightly metallic or silky sheen, typically 4-8 cm in diameter with a convex shape",
      "isPrimary": true
    },
    {
      "label": "Gill characteristics",
      "description": "White to pale cream-colored gills that are notched or unequal in length, running close to but not touching the stem",
      "isPrimary": false
    },
    {
      "label": "Stem features",
      "description": "White to pale gray stem that may have a slightly fibrous texture and bruises slightly when handled",
      "isPrimary": false
    }
  ],
  "habitat": "This species typically fruits in mixed deciduous and coniferous forests throughout New England, often appearing in late summer and fall near mossy areas and decaying leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'subresplendens' refers to its somewhat subdued metallic sheen compared to closely related Tricholoma species, making it challenging to distinguish in the field without careful examination.",
  "confusionNotes": null,
