  "nameStory": "",
  "description": "Hypomyces armeniacus is a parasitic fungus belonging to the Hypocreaceae family that infects and transforms the fruiting bodies of other fungi in New England forests. This ascomycete is part of a group of fungi known for their ability to mummify host mushrooms, creating distinctive altered fruiting structures.",
  "idTips": [
    {
      "label": "Host Specificity",
      "description": "Look for this fungus growing on specific host mushrooms; it typically parasitizes certain gill fungi and changes their appearance significantly",
      "isPrimary": true
    },
    {
      "label": "Mummified Appearance",
      "description": "Infected mushrooms appear hardened, discolored, and mummified rather than normal, with a wrinkled or altered texture",
      "isPrimary": false
    },
    {
      "label": "Perithecia Formation",
      "description": "Examine for small flask-shaped fruiting bodies (perithecia) embedded in the host tissue under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Hypomyces armeniacus thrives in moist forest environments throughout New England, particularly on decaying wood and the fruiting bodies of susceptible fungi during humid months.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is a biological controller that essentially 'zombifies' its host mushrooms, transforming them into hardened, unpalatable mummies that cannot successfully reproduce, making it an important natural regulator of fungal populations.",
  "confusionNotes": null,
