  "nameStory": "",
  "description": "The Gladiator Meadow Katydid is a medium-sized insect belonging to the family Tettigoniidae, commonly found throughout New England's grasslands and meadows. These green katydids are known for their loud, distinctive calls produced by males during summer and fall evenings.",
  "idTips": [
    {
      "label": "Green coloration",
      "description": "Bright green body that provides excellent camouflage in vegetation",
      "isPrimary": false
    },
    {
      "label": "Sword-like ovipositor",
      "description": "Females possess a long, blade-like ovipositor extending from the abdomen, distinctive of Orchelimum genus",
      "isPrimary": true
    },
    {
      "label": "Wing structure",
      "description": "Wings are held tent-like over the back and feature prominent veining patterns",
      "isPrimary": false
    }
  ],
  "habitat": "The Gladiator Meadow Katydid thrives in tall grass meadows, prairie-like areas, and weedy fields throughout New England where it feeds on vegetation and small insects.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Gladiator Meadow Katydids produce their species-specific calls by rubbing their wings together in a process called stridulation, which can reach volumes of up to 90 decibels and can be heard from considerable distances on quiet summer nights.",
