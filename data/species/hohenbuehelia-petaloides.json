  "nameStory": "",
  "description": "The Shoehorn Oyster (Hohenbuehelia petaloides) is a small, delicate oyster mushroom in the Pleurotaceae family, characterized by its pale coloring and distinctive shape. It is commonly found throughout New England and is considered inedible to unpalatable.",
  "idTips": [
    {
      "label": "Shell-like shape",
      "description": "The fruiting body resembles a small oyster shell or shoehorn, giving the species its common name",
      "isPrimary": true
    },
    {
      "label": "Pale coloration",
      "description": "Typically whitish, cream, or pale gray caps with gills running down the stem",
      "isPrimary": false
    },
    {
      "label": "Size and attachment",
      "description": "Small mushrooms (1-3 inches) that grow in shelf-like clusters on dead hardwood",
      "isPrimary": false
    }
  ],
  "habitat": "Found on decaying hardwood logs, stumps, and fallen branches in forests throughout New England, fruiting from late spring through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its resemblance to edible oyster mushrooms, the Shoehorn Oyster's tough, bitter flesh makes it unsuitable for culinary use, though it plays an important ecological role in wood decomposition.",
