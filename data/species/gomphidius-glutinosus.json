  "nameStory": "",
  "description": "Gomphidius glutinosus, commonly known as Slimy Spike, is a distinctive fungus featuring a dark cap and decurrent gills that are initially white before darkening with age. This species is found in coniferous forests throughout New England and is easily recognized by its characteristic slimy, sticky surface.",
  "idTips": [
    {
      "label": "Slimy Cap Surface",
      "description": "The cap is covered with a thick, viscous slime layer that makes the mushroom slippery and sticky to the touch, giving it its common name.",
      "isPrimary": true
    },
    {
      "label": "Gill Color Progression",
      "description": "Gills start white or pale yellow and gradually darken to gray or blackish as the mushroom matures.",
      "isPrimary": false
    },
    {
      "label": "Decurrent Gills",
      "description": "The gills run down the stem and are relatively widely spaced, which is characteristic of the Gomphidiaceae family.",
      "isPrimary": false
    }
  ],
  "habitat": "Slimy Spike grows in coniferous forests, particularly under spruce and fir trees, often appearing in clusters from late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The slime coating on Gomphidius glutinosus is thought to help protect the mushroom from insects and may aid in spore dispersal.",
