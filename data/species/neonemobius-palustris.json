  "nameStory": "",
  "description": "The Sphagnum Ground Cricket is a small, dark cricket species belonging to the family Trigonidiidae, found in the northeastern United States. Despite its common name, it is actually an insect, not a plant, and is named for its preference for sphagnum moss habitats.",
  "idTips": [
    {
      "label": "Small size and dark coloration",
      "description": "This cricket is notably tiny, typically 6-8mm in length, with a dark brown to black body that helps it blend into mossy environments.",
      "isPrimary": true
    },
    {
      "label": "Sword-like ovipositor",
      "description": "Females possess a distinctive long, thin ovipositor used for laying eggs in moss and soil, characteristic of sword-tailed crickets.",
      "isPrimary": false
    },
    {
      "label": "Short wings",
      "description": "This species has reduced or vestigial wings, making it primarily a ground-dwelling cricket rather than an active flier.",
      "isPrimary": false
    }
  ],
  "habitat": "Neonemobius palustris thrives in wet, boggy areas and sphagnum moss-dominated ecosystems throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Sphagnum Ground Crickets produce quiet chirping sounds by rubbing their wings together, but their calls are so faint that they are rarely heard by human ears without specialized listening equipment.",
