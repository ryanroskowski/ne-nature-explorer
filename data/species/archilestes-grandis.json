  "nameStory": "",
  "description": "The Great Spreadwing is a large damselfly belonging to the Spreadwing family, characterized by its impressive wingspan and slender abdomen. It is found in New England where it inhabits freshwater environments during the warmer months.",
  "idTips": [
    {
      "label": "Wing Position",
      "description": "Wings are held partially spread or at an angle to the body, unlike most damselflies that fold wings along their body",
      "isPrimary": true
    },
    {
      "label": "Size",
      "description": "One of the larger damselfly species with a noticeably robust body and long wingspan compared to other regional damselflies",
      "isPrimary": false
    },
    {
      "label": "Coloration",
      "description": "Adults display metallic green or bronze coloring on the thorax and abdomen with clear wings",
      "isPrimary": false
    }
  ],
  "habitat": "Great Spreadwings prefer slow-moving streams, marshes, and pond margins with abundant aquatic vegetation in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike most damselflies, spreadwings hold their wings partially open or spread out to the sides, which gives the family its distinctive common name and helps them regulate body temperature.",
