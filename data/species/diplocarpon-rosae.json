  "nameStory": "",
  "description": "Rose Black Spot is a fungal disease caused by Diplocarpon rosae that affects roses throughout New England, causing distinctive dark lesions on leaves and stems. It is one of the most common and damaging rose diseases in humid climates, potentially defoliating plants if left untreated.",
  "idTips": [
    {
      "label": "Black Circular Lesions",
      "description": "Look for round to irregular black spots with feathered or fringed margins on rose leaves, typically starting on lower foliage",
      "isPrimary": true
    },
    {
      "label": "Yellow Halos",
      "description": "Affected leaves often develop yellow zones surrounding the black spots before the leaf yellows and drops",
      "isPrimary": false
    },
    {
      "label": "Stem Cankers",
      "description": "Purplish-black lesions may appear on canes and stems, sometimes girdling them and causing dieback",
      "isPrimary": false
    }
  ],
  "habitat": "Rose Black Spot thrives in New England's cool, moist conditions, particularly on roses in gardens and landscapes with poor air circulation and high humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The fungus overwinters in fallen infected leaves and plant debris, making fall cleanup one of the most effective prevention strategies for controlling rose black spot in the following season.",
