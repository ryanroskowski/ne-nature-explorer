  "nameStory": "",
  "description": "Hypomyces completus is a parasitic fungus in the Hypocreaceae family that infects and transforms the fruiting bodies of other fungi, particularly boletes and other gill fungi. This ascomycete is found in New England's forests where it colonizes mushroom hosts, altering their appearance and texture.",
  "idTips": [
    {
      "label": "Host Colonization",
      "description": "Appears as a white to pale yellow, powdery or crusty coating covering the surface of infected mushroom fruiting bodies",
      "isPrimary": true
    },
    {
      "label": "Texture Changes",
      "description": "Infected mushrooms become hardened and distorted with a distinctive mummified or petrified appearance",
      "isPrimary": false
    },
    {
      "label": "Color Transformation",
      "description": "Host mushroom colors are obscured by the fungal layer, often appearing uniformly pale or white",
      "isPrimary": false
    }
  ],
  "habitat": "Found in deciduous and mixed forests throughout New England, growing on decomposing or living mushroom fruiting bodies on forest floors and dead wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Hypomyces completus is a hyperparasitic fungus that essentially 'mummifies' its host mushroom, converting it into a hardened, unpalatable structure that can persist for extended periods.",
  "confusionNotes": null,
