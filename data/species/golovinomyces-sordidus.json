  "nameStory": "",
  "description": "Golovinomyces sordidus is a fungal pathogen belonging to the Powdery Mildews family (Erysiphaceae) that affects various plant species throughout New England. This obligate parasite forms characteristic white, powdery fungal colonies on plant leaf surfaces, stems, and flowers.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Visible white to grayish powdery fungal growth on leaf surfaces, typically on both sides but more prominent on upper leaf surfaces",
      "isPrimary": true
    },
    {
      "label": "Conidiophores Structure",
      "description": "Microscopic examination reveals foot-cell structures with conidiophores (spore-bearing structures) that are diagnostic for genus and species identification",
      "isPrimary": false
    },
    {
      "label": "Host Plant Association",
      "description": "Identification aided by knowledge of preferred host plants in the region, which helps narrow down species determination",
      "isPrimary": false
    }
  ],
  "habitat": "Golovinomyces sordidus thrives in New England's gardens, woodlands, and cultivated areas on susceptible host plants, preferring cool, dry conditions with moderate humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Powdery mildew fungi are unique among pathogens because they can survive and spread even in dry conditions, as they obtain water directly from plant tissues rather than relying on external moisture.",
