  "nameStory": "",
  "description": "Craterellus foetidus, commonly known as the Stinking Chanterelle or Fetid Chanterelle, is a funnel-shaped fungus characterized by its distinctive foul odor resembling rotting flesh or garlic. Despite its unpleasant smell, it is occasionally eaten in some regions and serves as an important decomposer in forest ecosystems.",
  "idTips": [
    {
      "label": "Foul Odor",
      "description": "Unmistakable putrid smell reminiscent of decaying matter or sulfur compounds",
      "isPrimary": true
    },
    {
      "label": "Funnel Shape",
      "description": "Distinctive trumpet or funnel-shaped fruiting body with a hollow center",
      "isPrimary": false
    },
    {
      "label": "Ridge-like Gills",
      "description": "False gills (ridges) running down the underside of the fruiting body are blunt and forked",
      "isPrimary": false
    }
  ],
  "habitat": "Craterellus foetidus grows on the forest floor in mixed hardwood and coniferous forests throughout New England, preferring moist soil rich in organic matter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The pungent odor of this fungus may help attract insects that aid in spore dispersal, despite the smell deterring most human foragers.",
