  "nameStory": "",
  "description": "Wrinkled psathyrella (Typhrasa gossypina) is a small, delicate mushroom in the Psathyrellaceae family, characterized by its distinctive wrinkled or ridged cap surface. This species is commonly found decomposing wood and plant debris in New England forests and disturbed areas.",
  "idTips": [
    {
      "label": "Wrinkled Cap Surface",
      "description": "The cap displays prominent radial wrinkles or ridges extending from the center, resembling cotton fabric texture (gossypina refers to cotton).",
      "isPrimary": true
    },
    {
      "label": "Brittle Stem",
      "description": "The thin, fragile stem breaks easily when handled, a characteristic typical of brittlestems (Psathyrellaceae family members).",
      "isPrimary": false
    },
    {
      "label": "Dark Spore Print",
      "description": "The mushroom produces a dark brown to blackish spore print when left on paper overnight.",
      "isPrimary": false
    }
  ],
  "habitat": "Wrinkled psathyrella grows on decaying wood, mulch, and leaf litter in moist forests, gardens, and disturbed areas throughout New England.",
  "seasonality": {
