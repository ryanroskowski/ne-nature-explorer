  "nameStory": "",
  "description": "Entoloma vernum is a small, delicate mushroom in the Entolomataceae family characterized by its pale coloring and angular spore print. This spring-fruiting species is commonly found in New England woodlands and grassy areas.",
  "idTips": [
    {
      "label": "Pink Spore Print",
      "description": "Produces a distinctive pink or salmon-colored spore print, a hallmark of the Entoloma genus",
      "isPrimary": true
    },
    {
      "label": "Pale Cap Color",
      "description": "Features a whitish to pale gray or brownish cap that is often radially grooved or striate",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Typically fruiting at 2-5 cm in diameter with a delicate, fragile appearance",
      "isPrimary": false
    }
  ],
  "habitat": "Entoloma vernum grows in mossy areas, disturbed soil, and grassy spaces in deciduous and mixed woodlands throughout New England, appearing in spring.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The pink spore print of Entoloma species was historically used as a reliable field characteristic to distinguish this genus before modern DNA analysis became available to mycologists.",
  "confusionNotes": null,
  "contextualKnowledge": null,
