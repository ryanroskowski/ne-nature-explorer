  "nameStory": "",
  "description": "Pholiota limonella is a small, delicate mushroom in the Strophariaceae family characterized by its pale yellow to lemon-colored cap and stem. This species is commonly found decomposing wood in forested areas throughout New England during the summer and fall months.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Distinctive pale yellow to lemon-yellow cap, often with a slightly sticky or viscid surface when moist",
      "isPrimary": true
    },
    {
      "label": "Partial Veil",
      "description": "Young specimens display a delicate, cobweb-like partial veil that may leave faint ring-like remnants on the stem",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "Gills are adnate to slightly decurrent and display a yellowish color matching the cap",
      "isPrimary": false
    }
  ],
  "habitat": "Pholiota limonella grows on decaying hardwood logs, stumps, and woodchips in mixed deciduous and coniferous forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'limonella' refers to the mushroom's lemon-like color, making it one of the most visually recognizable members of the Pholiota genus in the region.",
