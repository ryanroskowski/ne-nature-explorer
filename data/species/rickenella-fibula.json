  "nameStory": "",
  "description": "Orange Moss Navel (Rickenella fibula) is a tiny, delicate mushroom characterized by its bright orange to reddish-orange coloring and distinctive navel-like depression on its cap. This small fungus belongs to the Rickenellaceae family and is commonly found in mossy, moist environments throughout New England.",
  "idTips": [
    {
      "label": "Navel-shaped cap",
      "description": "The cap features a characteristic central depression or indentation that resembles a navel or belly button",
      "isPrimary": true
    },
    {
      "label": "Vibrant orange color",
      "description": "Fruiting bodies display bright orange to reddish-orange pigmentation on the cap and stem",
      "isPrimary": false
    },
    {
      "label": "Tiny size",
      "description": "Caps typically measure only 5-15 mm in diameter, making it a miniature mushroom species",
      "isPrimary": false
    }
  ],
  "habitat": "Orange Moss Navel thrives in moist, shaded areas among dense moss carpets, particularly in forests and woodlands throughout New England.",
