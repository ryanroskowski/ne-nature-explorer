  "nameStory": "",
  "description": "Drumstick Truffleclub is a fungal species in the Ophiocordycipitaceae family, characterized by its distinctive club-shaped fruiting bodies that resemble small drumsticks. This rare fungus is found in New England forests and plays an important ecological role in nutrient cycling.",
  "idTips": [
    {
      "label": "Club-shaped fruiting bodies",
      "description": "Distinctive elongated, club-like structure with a darker, bulbous head and lighter stem",
      "isPrimary": true
    },
    {
      "label": "Size and color",
      "description": "Small fruiting bodies typically 1-3 cm tall with brown to dark reddish coloration on the head",
      "isPrimary": false
    },
    {
      "label": "Substrate association",
      "description": "Often found emerging from soil or decaying wood in moist forest conditions",
      "isPrimary": false
    }
  ],
  "habitat": "Drumstick Truffleclub thrives in moist, shaded forest floors and wooded areas throughout New England, preferring rich humus and areas with high humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Ophiocordycipitaceae family are known as cordyceps fungi, some of which are parasitic on insects, though Tolypocladium capitatum itself is a soil saprotroph.",
