  "nameStory": "",
  "description": "Sebacina sparassoidea, commonly known as white coral jelly fungus, is a gelatinous fungal species characterized by its delicate, branching coral-like structure. This jelly fungus belongs to the Sebacinaceae family and is found fruiting in moist environments throughout New England.",
  "idTips": [
    {
      "label": "Gelatinous texture",
      "description": "The fruiting body has a translucent, jelly-like consistency that is soft and rubbery when fresh",
      "isPrimary": true
    },
    {
      "label": "Coral-like branching",
      "description": "White to pale cream-colored fruiting bodies form delicate, repeatedly branched structures resembling marine corals",
      "isPrimary": false
    },
    {
      "label": "Microscopic spores",
      "description": "Produces distinctive spherical or ovoid basidiospores visible under magnification, key for confirming identification",
      "isPrimary": false
    }
  ],
  "habitat": "Sebacina sparassoidea fruiting bodies typically appear on moist wood, leaf litter, and decaying plant material in shaded, humid forests and woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate appearance, this fungus plays an important ecological role as it forms mycorrhizal associations with plant roots and helps decompose woody debris in forest ecosystems.",
