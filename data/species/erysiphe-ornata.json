  "nameStory": "",
  "description": "Erysiphe ornata is a powdery mildew fungus that affects various plant species throughout New England, causing the characteristic white, powdery coating on leaves and stems. This obligate parasite requires living plant tissue to survive and reproduces through both asexual and sexual spores.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white or grayish powdery layer on leaf surfaces, stems, and buds that can be wiped off easily",
      "isPrimary": true
    },
    {
      "label": "Cleistothecia Formation",
      "description": "Presence of small dark spherical fruiting bodies (cleistothecia) on affected plant parts, particularly visible in late season",
      "isPrimary": false
    },
    {
      "label": "Host-Specific Damage",
      "description": "Yellowing and distortion of leaves beneath the powdery growth, with potential leaf curling and premature drop",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe ornata thrives in New England gardens, woodlands, and nurseries on ornamental plants and shrubs, preferring areas with moderate humidity, warm days, and cool nights.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many fungi, powdery mildews can actually be inhibited by high humidity and heavy rainfall, preferring dry conditions, which is why they often worsen during periods of drought stress on their host plants.",
  "confusionNotes": null,
  "contextualKnowledge": null,
