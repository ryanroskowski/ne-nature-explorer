  "nameStory": "",
  "description": "Heriades carinata, commonly known as the Carinate Armored-Resin bee, is a small solitary bee species belonging to the Megachilidae family (mason, leafcutter, carder, and resin bees). This New England native is known for its metallic coloration and specialized nesting behavior involving plant resins.",
  "idTips": [
    {
      "label": "Metallic coloration",
      "description": "Displays a distinctive metallic green or blue sheen on the head and thorax, making it stand out among other small bees",
      "isPrimary": true
    },
    {
      "label": "Carinate ridge",
      "description": "Features a prominent ridge or carina on the clypeus (facial area), which is the origin of its common name",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "One of the smaller bee species, typically measuring 6-8 mm in length",
      "isPrimary": false
    }
  ],
  "habitat": "Heriades carinata inhabits gardens, meadows, and woodlands throughout New England where flowering plants and suitable nesting cavities in dead wood or plant stems are available.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many other bees, H. carinata uses plant resins mixed with plant materials to construct and waterproof its nest cells, creating a protective coating that defends against parasites and moisture.",
