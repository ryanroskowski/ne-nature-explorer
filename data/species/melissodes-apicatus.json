  "nameStory": "",
  "description": "The Pickerelweed Longhorn Bee (Melissodes apicatus) is a solitary bee species belonging to the family Apidae, native to eastern North America including New England. This medium-sized bee is named for its preference for pickerelweed flowers and its characteristically long antennae.",
  "idTips": [
    {
      "label": "Long Antennae",
      "description": "Males have notably elongated antennae that are longer than those of most other bee species, a key distinguishing feature.",
      "isPrimary": true
    },
    {
      "label": "Body Color",
      "description": "Dark brown to black body with sparse hair and often a slightly metallic sheen on the abdomen.",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Medium-sized bee, typically 10-15mm in length, making it easily distinguishable from larger bumble bees.",
      "isPrimary": false
    }
  ],
  "habitat": "Pickerelweed Longhorn Bees are found in wetlands, marshes, and areas with shallow water where their host plant, pickerelweed (Pontederia), grows abundantly throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This bee species is a specialist pollinator, showing a strong preference for pickerelweed flowers, and females collect pollen almost exclusively from this plant to provision their underground nests.",
