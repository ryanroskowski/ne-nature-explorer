  "nameStory": "",
  "description": "Hypholoma elongatum, commonly known as the sphagnum brownie, is a small brown mushroom belonging to the Strophariaceae family that thrives in acidic, mossy environments. This delicate fungus is characterized by its modest size and preference for growing directly on or around sphagnum moss.",
  "idTips": [
    {
      "label": "Habitat Association",
      "description": "Grows almost exclusively on sphagnum moss in wet, acidic areas, making habitat the most reliable identifier",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "Small brown to reddish-brown caps, typically 1-3 cm in diameter, with a delicate appearance",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "Gills are attached to the stem and may darken with age, characteristic of Hypholoma species",
      "isPrimary": false
    }
  ],
  "habitat": "Hypholoma elongatum is found in boggy areas, wetlands, and mossy forests throughout New England, where it grows directly on living sphagnum moss in acidic conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The sphagnum brownie's exclusive relationship with sphagnum moss makes it an indicator species for healthy bog ecosystems and pristine wetland habitats.",
