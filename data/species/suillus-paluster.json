  "nameStory": "",
  "description": "The Red Bog Bolete (Suillus paluster) is a small to medium-sized mushroom characterized by its reddish-brown cap and yellow pores underneath, belonging to the Suillaceae family of fungi. It forms mycorrhizal relationships with conifers, particularly larch and pine trees in acidic wetland environments.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Distinctive reddish-brown to burgundy cap that may fade with age, often with a moist or tacky appearance",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "Bright yellow to olive-yellow pores on the underside that may stain slightly when bruised",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Found exclusively near larch and pine trees in boggy, acidic soils of New England",
      "isPrimary": false
    }
  ],
  "habitat": "Red Bog Boletes grow in sphagnum bogs and acidic wetlands throughout New England, where they form symbiotic relationships with larch and pine trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The mycorrhizal partnership between Suillus paluster and larch trees is so specific that finding this mushroom is almost a guarantee that larch trees are nearby, making it a useful indicator species for bog ecology.",
  "confusionNotes": null,
  "contextualKnowledge": null,
