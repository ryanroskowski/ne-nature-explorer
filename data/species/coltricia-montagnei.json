  "nameStory": "",
  "description": "Coltricia montagnei is a small, terrestrial polypore fungus belonging to the Coltriciaceae family, characterized by its diminutive fruiting bodies with a distinctive appearance. This species is found in New England and other temperate regions, typically fruiting on the forest floor.",
  "idTips": [
    {
      "label": "Small, Radially Grooved Cap",
      "description": "The fruiting body is very small (typically 1-3 cm), with a tan to brown cap that exhibits prominent radial grooves or ridges extending from the center",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "The underside features small, angular pores that are typically yellow to brown and may darken with age or pressure",
      "isPrimary": false
    },
    {
      "label": "Thin, Delicate Structure",
      "description": "The fruiting body is relatively thin and fragile compared to larger polypores, with a fine texture throughout",
      "isPrimary": false
    }
  ],
  "habitat": "Coltricia montagnei grows on mossy soil, humus, and decaying wood debris in coniferous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its tiny size, Coltricia montagnei is a legitimate wood-decaying fungus that plays an important ecological role in breaking down organic matter on the forest floor, contributing to nutrient cycling.",
