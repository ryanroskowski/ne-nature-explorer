  "nameStory": "",
  "description": "Lasioglossum nelumbonis is a small, solitary sweat bee native to eastern North America, including New England. These bees are specialists that visit water lilies and related aquatic plants for pollen and nectar.",
  "idTips": [
    {
      "label": "Size",
      "description": "Tiny bee, typically 4-6 mm in length, making it one of the smallest sweat bee species",
      "isPrimary": false
    },
    {
      "label": "Body Color",
      "description": "Dark metallic green or black body with a smooth, shiny appearance characteristic of the genus Lasioglossum",
      "isPrimary": true
    },
    {
      "label": "Habitat Association",
      "description": "Found exclusively or nearly exclusively around water lilies (Nymphaea species) and similar aquatic plants",
      "isPrimary": false
    }
  ],
  "habitat": "This species inhabits shallow freshwater wetlands, ponds, and lakes with abundant water lily populations throughout New England and the northeastern United States.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Water-lily sweat bees have evolved as specialists on water lilies, with their entire life cycle and foraging behavior tightly synchronized to the blooming patterns of their host plants.",
