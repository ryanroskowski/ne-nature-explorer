  "nameStory": "",
  "description": "The Oblong Sweat Bee is a small, metallic green native bee belonging to the Halictidae family, commonly found throughout New England. These solitary to weakly social bees are important pollinators of native wildflowers and cultivated plants during summer months.",
  "idTips": [
    {
      "label": "Body Shape and Size",
      "description": "Elongated, compact body measuring 6-8mm in length with a distinctly oblong or oval profile",
      "isPrimary": true
    },
    {
      "label": "Metallic Coloration",
      "description": "Shiny, metallic green to greenish-black exoskeleton with a somewhat dull abdomen compared to the head and thorax",
      "isPrimary": false
    },
    {
      "label": "Body Hair",
      "description": "Fine, sparse body hair that gives the bee a relatively smooth appearance compared to fuzzy bumblebees",
      "isPrimary": false
    }
  ],
  "habitat": "Oblong Sweat Bees prefer open, sunny areas including gardens, meadows, and fields with abundant wildflowers and native plants throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their name, sweat bees are attracted to human perspiration for the salts it contains, which they need for survival, though they rarely sting unless directly threatened.",
  "confusionNotes": null,
  "contextualKnowledge": null,
