  "nameStory": "",
  "description": "Humaria hemisphaerica, commonly known as the Brown-haired White Cup, is a small cup fungus in the Pyronemataceae family characterized by its distinctive brown, hair-like structures on the exterior. This ascomycete produces delicate cup-shaped fruiting bodies that are whitish inside and brown outside.",
  "idTips": [
    {
      "label": "Brown hairy exterior",
      "description": "The outer surface is covered with distinctive brown, hair-like bristles (setae) that give the fungus its common name",
      "isPrimary": true
    },
    {
      "label": "Cup shape and size",
      "description": "Small, hemispherical to cup-shaped fruiting bodies, typically 3-8 mm in diameter, with a white or pale interior",
      "isPrimary": false
    },
    {
      "label": "Smooth spore-bearing interior",
      "description": "The inner surface is smooth and whitish, contrasting sharply with the hairy brown exterior",
      "isPrimary": false
    }
  ],
  "habitat": "Found on damp soil, sandy areas, and decaying wood in forests and disturbed areas throughout New England, particularly in spring and early summer.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size, Humaria hemisphaerica can be easily spotted on the forest floor after rain because its white interior makes it stand out against dark soil and leaf litter.",
