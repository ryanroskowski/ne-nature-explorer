  "nameStory": "",
  "description": "King Alfred's Cakes (Daldinia concentrica) is a charcoal fungus belonging to the Hypoxylaceae family, characterized by its hard, round, black fruiting bodies that resemble burnt biscuits. Named after King Alfred the Great, legend claims he mistook these fungi for burnt cakes, though this attribution is historically uncertain.",
  "idTips": [
    {
      "label": "Concentric rings",
      "description": "When cut in half, the interior reveals distinctive concentric rings or bands of black and white tissue",
      "isPrimary": true
    },
    {
      "label": "Hard texture",
      "description": "The fruiting bodies are extremely hard and coal-like, resembling small burnt biscuits or charcoal briquettes",
      "isPrimary": false
    },
    {
      "label": "Surface appearance",
      "description": "The exterior is smooth, black, and slightly flattened, typically 1-3 cm in diameter",
      "isPrimary": false
    }
  ],
  "habitat": "King Alfred's Cakes grow on dead or decaying hardwood, particularly ash and beech logs, in woodlands and forested areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "These fungi were historically used as tinder for starting fires because they ignite easily and burn slowly, making them valuable to early travelers and campers.",
