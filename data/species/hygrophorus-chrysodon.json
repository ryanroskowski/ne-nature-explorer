  "nameStory": "",
  "description": "The Gold Dust Waxy Cap is a small, delicate mushroom characterized by its pale cap with a distinctive golden or yellowish dusting, particularly around the edges and on the stem. This species belongs to the Waxcaps family, known for their waxy texture and often vibrant, colorful fruiting bodies.",
  "idTips": [
    {
      "label": "Golden Dusting",
      "description": "Fine golden or yellowish granules coat the cap edges and upper stem, giving the mushroom its 'gold dust' appearance.",
      "isPrimary": true
    },
    {
      "label": "Waxy Gills",
      "description": "Gills are characteristically thick, waxy, and widely spaced, with a whitish to pale yellow color.",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Typically has a small, delicate cap (1-3 cm) and thin stem, distinguishing it from larger mushroom species.",
      "isPrimary": false
    }
  ],
  "habitat": "This species thrives in mossy areas, grassy meadows, and damp woodland edges throughout New England, preferring well-maintained lawns and grasslands with high moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps like Hygrophorus chrysodon are considered indicators of old, undisturbed grasslands and are increasingly rare in intensively managed landscapes due to fungicide and fertilizer use.",
