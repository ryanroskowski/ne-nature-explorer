  "nameStory": "",
  "description": "Cyanosporus livens is a small wood-decaying fungus in the Postiaceae family, characterized by its distinctive blue-staining appearance on wood substrates. This species is commonly found throughout New England where it plays an important role in decomposing deadwood in forest ecosystems.",
  "idTips": [
    {
      "label": "Blue coloration",
      "description": "Displays striking cyan or blue discoloration on affected wood, which is the source of its scientific name",
      "isPrimary": true
    },
    {
      "label": "Wood substrate preference",
      "description": "Typically found on hardwood logs and fallen branches rather than coniferous wood",
      "isPrimary": false
    },
    {
      "label": "Microscopic spore features",
      "description": "Produces small, round spores visible under magnification that help confirm species identification",
      "isPrimary": false
    }
  ],
  "habitat": "Cyanosporus livens thrives on decaying hardwood logs and dead branches in moist, shaded forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The blue pigmentation in Cyanosporus livens serves as a visual indicator of wood decay and has made it useful in research studies examining fungal succession in decomposing wood.",
