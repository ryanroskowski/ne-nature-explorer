  "nameStory": "",
  "description": "Collybiopsis dichroa is a small woodland mushroom belonging to the Omphalotaceae family, characterized by its delicate appearance and distinctive coloration. This fungus is commonly found in the leaf litter and decaying wood of New England forests during the autumn and spring months.",
  "idTips": [
    {
      "label": "Two-toned cap coloration",
      "description": "The cap displays a distinctive bicolored pattern, typically darker at the center fading to a lighter shade at the margins, giving it the 'dichroa' (two-colored) characteristic",
      "isPrimary": true
    },
    {
      "label": "Slender, hollow stem",
      "description": "Features a notably thin, fragile stalk that is often darker than the cap and hollow throughout its length",
      "isPrimary": false
    },
    {
      "label": "Small, distant gills",
      "description": "The gills beneath the cap are widely spaced and typically white or pale, contrasting with the darker cap surface",
      "isPrimary": false
    }
  ],
  "habitat": "Collybiopsis dichroa thrives in moist, shaded forest floors where abundant leaf litter and decaying hardwood provide ideal growing conditions throughout New England woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate appearance, this mushroom is a saprotroph that plays an important ecological role by breaking down dead organic matter and recycling nutrients back into forest soil ecosystems.",
