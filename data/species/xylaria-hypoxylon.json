  "nameStory": "",
  "description": "Candlesnuff Fungus is a common wood-decay fungus characterized by distinctive black fruiting bodies that resemble burnt candles or candlesticks, often appearing in clusters on decaying hardwood logs. It belongs to the Xylariaceae family and plays an important ecological role in decomposing dead wood in forest ecosystems.",
  "idTips": [
    {
      "label": "Candlestick-like appearance",
      "description": "Black, club-shaped fruiting bodies that look like burnt candle wicks, typically 1-4 inches tall with a whitish powder (spore-producing layer) on the upper portion",
      "isPrimary": true
    },
    {
      "label": "Clustered growth pattern",
      "description": "Fruiting bodies emerge in dense groups or clusters directly from dead hardwood logs and branches",
      "isPrimary": false
    },
    {
      "label": "Year-round presence",
      "description": "Persistent fruiting bodies remain visible throughout the year, darkening and hardening over time",
      "isPrimary": false
    }
  ],
  "habitat": "Candlesnuff Fungus thrives on decaying hardwood logs, stumps, and dead branches throughout New England forests, preferring moist conditions and shade.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The whitish powder coating the upper portion of young fruiting bodies is composed of millions of spores, and the fungus gets its name from its striking resemblance to candle stubs that have been snuffed out.",
