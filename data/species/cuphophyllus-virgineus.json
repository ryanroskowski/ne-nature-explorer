  "nameStory": "",
  "description": "The Snowy Waxcap is a small, delicate fungus characterized by its pure white to cream-colored fruiting bodies and distinctive waxy appearance. It is a saprotroph commonly found in grasslands and meadows throughout New England, fruiting from late summer through fall.",
  "idTips": [
    {
      "label": "Bright White Color",
      "description": "Pure white to cream-colored caps and stems with a distinctive waxy sheen that sets it apart from similar species",
      "isPrimary": true
    },
    {
      "label": "Decurrent Gills",
      "description": "Gills are white, widely spaced, and run down the stem (decurrent), giving a characteristic appearance under magnification",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Fruiting bodies are typically 1-3 cm in diameter, making them relatively miniature compared to other waxcaps",
      "isPrimary": false
    }
  ],
  "habitat": "The Snowy Waxcap thrives in well-maintained grasslands, meadows, and lawns with minimal fertilizer, preferring nutrient-poor, acidic soils rich in organic matter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps like Cuphophyllus virgineus are considered indicators of pristine, unimproved grasslands and are increasingly rare due to agricultural intensification and lawn treatment practices.",
