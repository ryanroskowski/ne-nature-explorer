  "nameStory": "",
  "description": "The Brown Birch-bolete (Leccinum scabrum) is a medium-sized fungus in the bolete family, characterized by its brown cap and pale stem with distinctive dark scabrous (rough) spots. It forms mycorrhizal relationships with birch trees and is edible when properly prepared.",
  "idTips": [
    {
      "label": "Scabrous Stem",
      "description": "The stem features prominent dark brown or blackish raised spots or scales on a pale background, which is the most distinctive feature of this species.",
      "isPrimary": true
    },
    {
      "label": "Brown Cap",
      "description": "The cap is typically brown to grayish-brown, convex when young, and becomes flatter with age, measuring 4-10 cm in diameter.",
      "isPrimary": false
    },
    {
      "label": "Pale Pores",
      "description": "The underside features small, pale yellow or whitish pores that may stain slightly when bruised.",
      "isPrimary": false
    }
  ],
  "habitat": "This species grows in birch forests and woodlands throughout New England, fruiting from summer through fall in association with birch trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The scabrous spots on the stem darken with age and bruising, gradually turning from pale to dark brown or black, making older specimens distinctly different in appearance from young ones.",
