  "nameStory": "",
  "description": "White tubelet (Henningsomyces candidus) is a small, delicate fungus belonging to the Porotheleaceae family, characterized by its diminutive white fruiting bodies. This species is a wood-decay fungus that plays an important ecological role in nutrient cycling within forest ecosystems.",
  "idTips": [
    {
      "label": "White tubular fruiting bodies",
      "description": "Produces small, tube-like or cylindrical white structures that are the most distinctive visual characteristic",
      "isPrimary": true
    },
    {
      "label": "Tiny size",
      "description": "Fruiting bodies are typically only a few millimeters in height, requiring close examination to identify",
      "isPrimary": false
    },
    {
      "label": "Smooth surface texture",
      "description": "The fruiting bodies have a smooth, non-textured surface that distinguishes it from similar small fungi",
      "isPrimary": false
    }
  ],
  "habitat": "White tubelet grows on decaying hardwood and softwood substrates in moist forest environments throughout New England, particularly on rotting logs and fallen branches.",
  "seasonality": {
    "spring": "",
    "summer": "",
