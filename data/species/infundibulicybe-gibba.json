  "nameStory": "",
  "description": "Infundibulicybe gibba, commonly known as the Common Funnel, is a small woodland mushroom characterized by its distinctive funnel or trumpet-shaped cap. This delicate fungus belongs to the Omphalinaceae family and is a common sight on the forest floor throughout New England.",
  "idTips": [
    {
      "label": "Funnel-shaped cap",
      "description": "The cap is deeply depressed or funnel-like in the center, distinguishing it from other small mushrooms",
      "isPrimary": true
    },
    {
      "label": "Decurrent gills",
      "description": "Gills run down the stem and are often forked or blunt-edged near the attachment point",
      "isPrimary": false
    },
    {
      "label": "Small size and thin flesh",
      "description": "Usually 1-3 cm in diameter with a thin, fragile fruiting body and pale coloration",
      "isPrimary": false
    }
  ],
  "habitat": "Common Funnels are found on moist forest floors among leaf litter and mosses in deciduous and mixed woodlands throughout New England, fruiting from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their small size, Common Funnels are prolific fruticans that often fruit in large clusters, creating striking carpets of tiny funnels on the forest floor.",
