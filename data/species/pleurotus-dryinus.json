  "nameStory": "",
  "description": "The Veiled Oyster (Pleurotus dryinus) is a wood-decomposing fungus in the oyster mushroom family, characterized by its delicate appearance and distinctive partial veil. Found throughout New England, it plays an important ecological role in breaking down dead hardwood.",
  "idTips": [
    {
      "label": "Partial Veil",
      "description": "A cobweb-like veil connecting the cap margin to the stem, often leaving a ring or partial skirt-like structure",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "White to gray or brownish-gray cap with a silky to slightly scaly surface",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "Decurrent to slightly decurrent gills that run down the stem, typically white to pale gray",
      "isPrimary": false
    }
  ],
  "habitat": "Veiled Oysters grow on dead or dying hardwoods, particularly oak and beech, in moist woodlands throughout New England from spring through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The delicate veil that gives this mushroom its common name is a remnant of the universal veil that protects young mushrooms, making it one of the most elegantly veiled oyster species in North America.",
  "confusionNotes": null,
  "contextualKnowledge": null,
