  "nameStory": "",
  "description": "The Ringed Emerald is a medium-sized dragonfly belonging to the family Corduliidae, characterized by its metallic green body and distinctive pale abdominal markings. This species is commonly found throughout New England and prefers cool, flowing freshwater environments.",
  "idTips": [
    {
      "label": "White Abdominal Rings",
      "description": "Pale or white rings encircle the abdomen, creating a distinctive banded pattern that gives this species its common name",
      "isPrimary": true
    },
    {
      "label": "Metallic Green Coloration",
      "description": "The head, thorax, and base of the abdomen display a bright metallic green sheen typical of emerald dragonflies",
      "isPrimary": false
    },
    {
      "label": "Medium Body Size",
      "description": "Generally smaller than clubtail dragonflies, with a body length typically between 40-48 mm",
      "isPrimary": false
    }
  ],
  "habitat": "The Ringed Emerald inhabits cool, clear streams and rivers with good water quality, often found near vegetation and along rocky or sandy banks.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many dragonflies, Ringed Emeralds are strong fliers that often hunt over water and can hover in place while searching for small insects.",
