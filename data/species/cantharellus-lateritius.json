  "nameStory": "",
  "description": "The Smooth Chanterelle (Cantharellus lateritius) is a small to medium-sized fungus distinguished by its smooth undersurface rather than the ridged gills typical of many chanterelles. This species is a mycorrhizal fungus that forms symbiotic relationships with tree roots in forest ecosystems.",
  "idTips": [
    {
      "label": "Smooth Undersurface",
      "description": "Unlike most chanterelles, this species has a smooth or nearly smooth hymenium (spore-bearing surface) underneath the cap rather than prominent ridges or false gills",
      "isPrimary": true
    },
    {
      "label": "Orange to Reddish Color",
      "description": "Caps are typically bright orange to reddish-orange, funnel or vase-shaped, with a solid or chambered interior when cut lengthwise",
      "isPrimary": false
    },
    {
      "label": "Fruity Aroma",
      "description": "Fresh specimens often emit a pleasant, fruity or slightly apricot-like odor, which aids in field identification",
      "isPrimary": false
    }
  ],
  "habitat": "The Smooth Chanterelle is found in mixed hardwood and coniferous forests throughout New England, typically fruiting in summer and early fall in moist, well-established woodland areas.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite being edible and delicious, Cantharellus lateritius is not commercially cultivated because it requires a living tree host and cannot be grown in laboratory conditions like button mushrooms.",
