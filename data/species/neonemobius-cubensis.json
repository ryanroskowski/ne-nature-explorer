    {
      "label": "Sword-like Ovipositor",
      "description": "Females possess a distinctive long, sword-like ovipositor extending beyond the abdomen, characteristic of the Trigonidiidae family",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Typically found in dense leaf litter, moss, and ground vegetation rather than on plants or in trees",
      "isPrimary": false
    }
  ],
  "habitat": "Cuban Ground Crickets prefer moist leaf litter, decaying vegetation, and the ground layer of forests, gardens, and landscaped areas throughout New England.",
