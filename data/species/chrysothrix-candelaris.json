  "nameStory": "",
  "description": "Gold dust lichen (Chrysothrix candelaris) is a bright yellow-green crustose lichen belonging to the Chrysotrichaceae family, characterized by its powdery or granular appearance. It is commonly found throughout New England on various substrates including tree bark, wood, and rock surfaces.",
  "idTips": [
    {
      "label": "Bright Yellow-Green Color",
      "description": "The lichen displays a distinctive golden-yellow to yellow-green powdery or granular surface that makes it easily recognizable.",
      "isPrimary": true
    },
    {
      "label": "Powdery Texture",
      "description": "The surface appears dusty or granular rather than smooth, giving it its common name 'gold dust' lichen.",
      "isPrimary": false
    },
    {
      "label": "Crustose Form",
      "description": "This lichen grows as a thin, tightly adhered crust without distinct lobes or a visible thallus structure.",
      "isPrimary": false
    }
  ],
  "habitat": "Gold dust lichen thrives in moist, shaded to semi-shaded environments on tree bark, decaying wood, and acidic rocks throughout New England's forests and woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The bright yellow color of Chrysothrix candelaris comes from secondary metabolites, and this lichen is often an indicator of good air quality since it is sensitive to air pollution.",
