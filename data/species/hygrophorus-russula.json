  "nameStory": "",
  "description": "Hygrophorus russula, commonly known as the pinkmottle woodwax, is a striking waxcap fungus characterized by its pink-tinged cap and waxy gill texture. This species belongs to the Hygrophoraceae family and is notable for its delicate appearance and preference for mossy woodland environments.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Pinkish to reddish-brown cap with a distinctive mottled or mottle pattern, often with a slightly waxy or silky surface",
      "isPrimary": true
    },
    {
      "label": "Waxy Gills",
      "description": "Thick, widely-spaced, waxy gills that are whitish to pale pink and run down the stem (decurrent)",
      "isPrimary": false
    },
    {
      "label": "Stem Appearance",
      "description": "Whitish to pale pink stem that is often mottled or streaked with pink coloring, particularly near the base",
      "isPrimary": false
    }
  ],
  "habitat": "Pinkmottle woodwax thrives in moist, mossy coniferous and mixed forests throughout New England, preferring cool, damp woodland floors with abundant moss and leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other waxcaps, Hygrophorus russula is gelatinous and hygroscopic, meaning its tissues absorb and retain moisture from the environment, making it particularly delicate and short-lived after rainfall.",
