  "nameStory": "",
  "description": "Rose Spindles (Clavaria rosea) is a delicate, club-shaped fungus belonging to the antler and spindle fungi family, characterized by its distinctive rose or pink coloring. This small fungus is commonly found in New England forests and grasslands, where it plays a role in decomposition and nutrient cycling.",
  "idTips": [
    {
      "label": "Rose-Pink Color",
      "description": "The distinctive rose or pale pink coloration of the entire fruiting body is the most reliable identifying feature",
      "isPrimary": true
    },
    {
      "label": "Club or Spindle Shape",
      "description": "Fruiting bodies are simple, unbranched clubs or spindles, typically 1-3 inches tall with a rounded or blunt tip",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "These fungi are notably delicate and miniature compared to other clavaria species, requiring close inspection to identify",
      "isPrimary": false
    }
  ],
  "habitat": "Rose Spindles thrive in moist woodlands, mossy areas, and grassy spots throughout New England, particularly in leaf litter and on well-established forest floors.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their delicate appearance, these tiny fungi are important decomposers that help break down organic matter and recycle nutrients back into forest ecosystems.",
