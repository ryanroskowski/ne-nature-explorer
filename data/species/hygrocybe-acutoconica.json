  "nameStory": "",
  "description": "The Persistent Waxcap is a small to medium-sized fungus characterized by its bright red to orange conical cap that persists in shape even as it ages and loses moisture. This species is a member of the Waxcaps and Allies family, known for their waxy, delicate appearance and ecological importance in grassland ecosystems.",
  "idTips": [
    {
      "label": "Conical Cap Shape",
      "description": "The distinctive sharply pointed, cone-shaped cap that remains persistent and maintains its form even when dried out, unlike many other waxcaps that flatten with age",
      "isPrimary": true
    },
    {
      "label": "Bright Red-Orange Color",
      "description": "Vibrant red to orange coloration on the cap that may fade slightly but remains relatively vivid compared to related species",
      "isPrimary": false
    },
    {
      "label": "Waxy, Fragile Texture",
      "description": "Delicate, thin-fleshed gills and cap with a characteristically waxy, translucent appearance typical of Hygrocybe species",
      "isPrimary": false
    }
  ],
  "habitat": "Persistent Waxcap thrives in moist grasslands, meadows, and moss-rich areas throughout New England, preferring nutrient-poor soils and often appearing in fall after rainfall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate appearance, the Persistent Waxcap earned its name because its conical cap shape remarkably maintains its form even as the fruiting body dries out, a trait unusual among the typically soft waxcap fungi.",
  "confusionNotes": null,
  "contextualKnowledge": null,
