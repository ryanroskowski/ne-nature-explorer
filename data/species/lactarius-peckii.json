  "nameStory": "",
  "description": "Peck's milky cap is a medium-sized mushroom belonging to the Lactarius genus, characterized by its distinctive milk-like latex that exudes from gills when damaged. This species is found in New England forests and is part of the diverse milkcap family, which includes many edible and inedible species.",
  "idTips": [
    {
      "label": "Latex color and taste",
      "description": "The white to pale latex that bleeds from cut gills is a key feature; it may slowly change color and has a bitter or acrid taste (spit out immediately after testing)",
      "isPrimary": true
    },
    {
      "label": "Cap appearance",
      "description": "Medium-sized cap with a pale to whitish color, typically 2-4 inches wide, with a slightly depressed center and smooth to slightly wrinkled surface",
      "isPrimary": false
    },
    {
      "label": "Gill structure",
      "description": "Gills are closely spaced, whitish to pale cream, and directly attached to the stem, becoming stained by the exuding latex",
      "isPrimary": false
    }
  ],
  "habitat": "Peck's milky cap grows on the forest floor in mixed woodlands and under hardwoods throughout New England, preferring moist soil and appearing in summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other milkcaps, Lactarius peckii uses its bitter, acrid latex as a chemical defense mechanism to deter insects and small animals from feeding on it.",
  "confusionNotes": null,
