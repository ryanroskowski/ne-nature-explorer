  "nameStory": "",
  "description": "Pluteus chrysophlebius, commonly known as the Yellow Deer Mushroom, is a small woodland fungus characterized by its distinctive yellow-tinged gills and delicate appearance. This species belongs to the Pluteaceae family and is found in New England forests where it plays a role in decomposition.",
  "idTips": [
    {
      "label": "Yellow Gill Edges",
      "description": "The gills have distinctive yellow or golden edges (chrysophlebius means 'golden-veined'), which is the primary diagnostic feature.",
      "isPrimary": true
    },
    {
      "label": "Cap Color and Texture",
      "description": "The cap is typically gray-brown to pale brown with a smooth or slightly fibrous surface and usually measures 2-5 cm in diameter.",
      "isPrimary": false
    },
    {
      "label": "Free Gills",
      "description": "The gills are free from the stem (not attached), white to pale pink, and darken with age—characteristic of the Pluteus genus.",
      "isPrimary": false
    }
  ],
  "habitat": "Yellow Deer Mushrooms fruit on decaying wood, fallen logs, and woody debris in moist hardwood and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The yellow-edged gills of this mushroom may serve as a visual signal to insects and other organisms involved in spore dispersal in dark forest environments.",
