  "nameStory": "",
  "description": "Fibroporia radiculosa is a wood-decay fungus in the Fibroporiaceae family that forms small, delicate fruiting bodies on dead wood. This species is commonly encountered in New England forests where it plays an important ecological role in decomposing woody debris.",
  "idTips": [
    {
      "label": "Pore Surface",
      "description": "Small, angular pores (typically 4-6 per mm) that are white to pale cream-colored and may yellow with age or pressure",
      "isPrimary": true
    },
    {
      "label": "Bracket Structure",
      "description": "Very small, thin, fragile fruiting bodies that are often resupinate (lying flat) or shelf-like, usually less than 1 cm thick",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "Found exclusively on hardwood (deciduous wood), particularly on small diameter branches and twigs in advanced decay stages",
      "isPrimary": false
    }
  ],
  "habitat": "Fibroporia radiculosa colonizes dead hardwood in moist, shaded forest environments throughout New England, thriving on decaying logs and fallen branches on the forest floor.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size and delicate appearance, Fibroporia radiculosa is an aggressive wood-decay fungus that efficiently breaks down complex lignin structures, making it an essential decomposer in forest nutrient cycling.",
