  "nameStory": "",
  "description": "Pholiota granulosa is a small to medium-sized mushroom characterized by its golden-yellow to rusty-brown cap covered in distinctive granular or scaly texture. This wood-decay fungus belongs to the Strophariaceae family and is commonly found decomposing hardwood logs and stumps throughout New England.",
  "idTips": [
    {
      "label": "Granular Cap Surface",
      "description": "The cap displays fine, powdery or granular particles that give it a distinctive textured, non-slimy appearance, even when wet.",
      "isPrimary": true
    },
    {
      "label": "Golden-Yellow to Rusty Coloring",
      "description": "Caps range from bright golden-yellow when young to rusty-brown or ochre with age, often with darker spots or staining.",
      "isPrimary": false
    },
    {
      "label": "Attached Gills",
      "description": "Gills are attached to the stem, yellowish, and may display a partial ring or remain bare as the mushroom matures.",
      "isPrimary": false
    }
  ],
  "habitat": "Pholiota granulosa grows on decaying hardwood logs, stumps, and woody debris in forests and wooded areas throughout New England, preferring damp conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size, Pholiota granulosa is an efficient wood decomposer, playing an important role in nutrient cycling by breaking down dead hardwood in forest ecosystems.",
