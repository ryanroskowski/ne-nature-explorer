  "nameStory": "",
  "description": "The Pink Fringed Faery Cup (Microstoma floccosum) is a delicate, cup-shaped fungus belonging to the Elf Cups family, recognized by its diminutive size and distinctive pink coloration. This tiny ascomycete fruit body is a charming but easily overlooked resident of New England forests.",
  "idTips": [
    {
      "label": "Cup shape with pink fringe",
      "description": "Small, cup-shaped fruiting body (typically 2-5mm) with a characteristic pink or reddish fringed margin around the rim",
      "isPrimary": true
    },
    {
      "label": "Pale interior surface",
      "description": "The inner fertile surface (hymenium) is typically pale white, cream, or light pink, contrasting with the darker exterior",
      "isPrimary": false
    },
    {
      "label": "Hairy or flocculose exterior",
      "description": "The outside of the cup is covered with fine hair-like structures (floccose texture), giving it a fuzzy appearance under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Pink Fringed Faery Cups grow on damp wood, decaying logs, and moist leaf litter in mixed deciduous and coniferous forests throughout New England.",
