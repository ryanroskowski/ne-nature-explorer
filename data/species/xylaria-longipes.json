  "nameStory": "",
  "description": "Dead Moll's Fingers (Xylaria longipes) is a distinctive fungus in the Xylariaceae family, characterized by its long, slender, finger-like fruiting bodies that emerge from wood. Despite its macabre common name, it is a saprobic fungus that plays an important role in decomposing dead hardwood in forest ecosystems.",
  "idTips": [
    {
      "label": "Long, slender stalks",
      "description": "Produces characteristically elongated, thin, dark fruiting bodies that resemble fingers or clubs extending upward from woody substrates",
      "isPrimary": true
    },
    {
      "label": "Dark coloration",
      "description": "Fruiting bodies are typically dark brown to black, often with a whitish or grayish spore-bearing tip",
      "isPrimary": false
    },
    {
      "label": "Grows on wood",
      "description": "Fruiting bodies arise from dead or decaying hardwood logs, stumps, or branches rather than from soil",
      "isPrimary": false
    }
  ],
  "habitat": "Dead Moll's Fingers thrives in moist, forested environments throughout New England, growing on decaying hardwood logs and fallen branches in shaded woodland areas.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The common name 'Dead Moll's Fingers' reflects the uncanny resemblance of the dark, upright fruiting bodies to skeletal fingers emerging from the grave, making it a favorite among nature enthusiasts who appreciate fungi with macabre appellations.",
