  "nameStory": "",
  "description": "Erysiphe vaccinii is a fungal pathogen belonging to the powdery mildew family that specifically infects members of the Ericaceae family, particularly blueberries and cranberries in New England. This obligate parasite forms characteristic white, powdery fungal colonies on plant surfaces, reducing photosynthesis and fruit quality.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish powdery fungal growth appears on leaves, stems, and fruit, which can be easily wiped off",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Primarily infects Vaccinium species (blueberries and cranberries) and other Ericaceae family plants",
      "isPrimary": false
    },
    {
      "label": "Cleistothecia Formation",
      "description": "Small black spherical fruiting bodies (cleistothecia) may develop within or beneath the white mycelium as the season progresses",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe vaccinii thrives in New England's cool, humid conditions on cultivated and wild blueberry and cranberry crops, favoring areas with moderate temperatures and high relative humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews, Erysiphe vaccinii can survive winter as cleistothecia on infected plant debris, allowing it to persist through harsh New England winters and infect new growth in spring.",
  "confusionNotes": null,
