  "nameStory": "",
  "description": "Nomada tiftonensis, known as the Tifton Nomad Bee, is a small cuckoo bee in the family Apidae found in New England and other parts of eastern North America. Like other nomad bees, it is a brood parasite that lays eggs in the nests of host bees rather than constructing its own nests.",
  "idTips": [
    {
      "label": "Small size and coloration",
      "description": "Nomada tiftonensis is a small bee, typically 8-10mm long, with a distinctive pattern of black and reddish-yellow markings on the abdomen",
      "isPrimary": true
    },
    {
      "label": "Lack of pollen baskets",
      "description": "Like all nomad bees, it lacks the specialized pollen-carrying structures (corbiculae) found on other bees, since it doesn't collect pollen for its own brood",
      "isPrimary": false
    },
    {
      "label": "Smooth body appearance",
      "description": "The body appears relatively smooth and shiny compared to the hairy appearance of many other native bee species",
      "isPrimary": false
    }
  ],
  "habitat": "This species is typically found in open woodlands, meadows, and gardens where its host bee species are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, the Tifton Nomad Bee sneaks into the nests of other bee species and lays its eggs among the host's brood, relying entirely on the host bee to provision and care for its larvae.",
