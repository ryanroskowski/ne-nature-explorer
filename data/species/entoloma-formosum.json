  "nameStory": "",
  "description": "Pretty Pinkgill (Entoloma formosum) is a small, delicate mushroom belonging to the Entolomataceae family, characterized by its distinctive pink gills and elegant appearance. This species is found in New England forests and woodlands, where it fruits on mossy ground and decomposing plant matter.",
  "idTips": [
    {
      "label": "Pink Gills",
      "description": "The most distinctive feature is the bright pink to salmon-colored gills that become more pronounced as the mushroom matures, which is diagnostic for many Entoloma species.",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Pretty Pinkgill typically has small caps measuring 1-3 cm in diameter with a pale, pinkish-white to gray coloration.",
      "isPrimary": false
    },
    {
      "label": "Cap Shape",
      "description": "The cap is convex to bell-shaped with a slightly inrolled margin when young, becoming flatter with age.",
      "isPrimary": false
    }
  ],
  "habitat": "Pretty Pinkgill grows on mossy forest floors, rich humus, and decomposing leaf litter in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Entoloma genus are among the few wood-decomposing fungi that are saprobic on plant debris rather than living wood, playing an important role in forest nutrient cycling.",
  "confusionNotes": null,
  "contextualKnowledge": null,
