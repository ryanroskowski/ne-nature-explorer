  "nameStory": "",
  "description": "Apple Scab is a fungal disease caused by Venturia inaequalis that affects apple and crabapple trees throughout New England. It is one of the most economically damaging apple diseases in humid climates, causing lesions on leaves, fruit, and twigs that reduce fruit quality and tree vigor.",
  "idTips": [
    {
      "label": "Leaf Lesions",
      "description": "Dark, olive-brown, velvety spots with irregular margins appear on leaf surfaces, often causing yellowing and premature leaf drop.",
      "isPrimary": true
    },
    {
      "label": "Fruit Spots",
      "description": "Corky, dark brown scab-like lesions develop on the fruit surface, making apples unmarketable despite being safe to eat.",
      "isPrimary": false
    },
    {
      "label": "Twig Cankers",
      "description": "Small, raised lesions appear on young twigs and branches, which may crack and become entry points for other pathogens.",
      "isPrimary": false
    }
  ],
  "habitat": "Apple Scab thrives in cool, wet conditions typical of New England springs and falls, particularly in orchards and gardens where apple trees are grown.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The fungus overwinters in fallen leaves on the orchard floor, releasing spores in spring that can travel hundreds of yards on wind and rain splash to infect new growth.",
