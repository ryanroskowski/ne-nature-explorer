  "nameStory": "",
  "description": "Warlock's Butter (Exidia nigricans) is a gelatinous fungus belonging to the Auriculariaceae family, characterized by its dark, jelly-like fruiting bodies. This wood-decay fungus is commonly found throughout New England and is harmless to humans.",
  "idTips": [
    {
      "label": "Gelatinous Texture",
      "description": "The fruiting body has a distinctive jelly-like or rubbery consistency that is moist and translucent",
      "isPrimary": true
    },
    {
      "label": "Dark Coloration",
      "description": "The fungus appears black, dark brown, or very dark gray, often becoming darker when wet",
      "isPrimary": false
    },
    {
      "label": "Warty or Bumpy Surface",
      "description": "The upper surface is characteristically wrinkled, warty, or brain-like in appearance",
      "isPrimary": false
    }
  ],
  "habitat": "Warlock's Butter grows on dead hardwood logs and branches, particularly oak and maple, in moist woodland areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'Warlock's Butter' likely derives from its dark, mystical appearance and butter-like gelatinous texture, fitting the folklore-rich naming traditions of fungi.",
