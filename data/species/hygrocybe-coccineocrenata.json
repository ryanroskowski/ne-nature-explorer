  "nameStory": "",
  "description": "The bog waxcap is a small, delicate mushroom with a distinctive bright red to orange-red cap and a waxy, translucent appearance characteristic of the Waxcap family. This species is found in nutrient-poor, mossy habitats throughout New England and other acidic regions.",
  "idTips": [
    {
      "label": "Cap color and texture",
      "description": "Bright red to orange-red cap with a waxy, moist appearance and finely scalloped or crenate edges",
      "isPrimary": true
    },
    {
      "label": "Gill attachment",
      "description": "Thick, waxy gills that are decurrent (running down the stem) and fewer in number than many other mushrooms",
      "isPrimary": false
    },
    {
      "label": "Habitat preference",
      "description": "Found in sphagnum moss and acidic grasslands rather than in woods or on decaying wood",
      "isPrimary": false
    }
  ],
  "habitat": "The bog waxcap thrives in wet, mossy areas, sphagnum bogs, and acidic grasslands throughout New England, preferring nutrient-poor soils.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps are among the few fungi that can thrive in acidic, nutrient-poor environments where most other decomposer fungi cannot survive, making them indicators of pristine, undisturbed habitats.",
  "confusionNotes": null,
  "contextualKnowledge": null,
