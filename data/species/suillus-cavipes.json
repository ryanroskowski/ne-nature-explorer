  "nameStory": "",
  "description": "Hollow Bolete is a small to medium mushroom with a yellowish-brown cap and yellow pores beneath, belonging to the Suillaceae family. It is commonly found in coniferous forests throughout New England, often forming mycorrhizal relationships with pine trees.",
  "idTips": [
    {
      "label": "Hollow Stem",
      "description": "The stem is characteristically hollow or chambered inside, which is the primary distinguishing feature of this species.",
      "isPrimary": true
    },
    {
      "label": "Yellow Pores",
      "description": "The underside features small, bright yellow pores that may stain olive or brown when bruised.",
      "isPrimary": false
    },
    {
      "label": "Cap Appearance",
      "description": "The cap is convex with a yellowish-brown to tan surface that may develop a sticky or slimy coating when wet.",
      "isPrimary": false
    }
  ],
  "habitat": "Hollow Bolete is found in coniferous forests throughout New England, particularly under pine and spruce trees where it forms mycorrhizal associations.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The hollow stem of Suillus cavipes is so distinctive that even young specimens can be reliably identified by cutting them lengthwise to reveal the empty interior chamber.",
  "confusionNotes": null,
