  "nameStory": "",
  "description": "White pine blister rust is a destructive fungal disease caused by Cronartium ribicola that primarily affects five-needled pine species, particularly eastern white pine. The pathogen requires both pine and alternate hosts (currants and gooseberries) to complete its complex life cycle.",
  "idTips": [
    {
      "label": "Blister cankers on pine stems",
      "description": "Look for elongated, sunken cankers with a blistered appearance on pine branches and trunks, often oozing pitch or appearing wet",
      "isPrimary": true
    },
    {
      "label": "Aecial pustules on alternate hosts",
      "description": "Bright yellow or orange gelatinous pustules appear on the undersides of currant and gooseberry leaves, particularly visible in spring",
      "isPrimary": false
    },
    {
      "label": "Needle fascicle damage",
      "description": "Infected needle clusters may turn reddish-brown and wilt as cankers girdle the twig",
      "isPrimary": false
    }
  ],
  "habitat": "White pine blister rust thrives in moist, cool New England forests where five-needled pines grow in proximity to wild or cultivated currants and gooseberries, typically at elevations with adequate humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is not native to North America; it was accidentally introduced from Asia in the early 1900s and has since killed millions of white pines across the continent, making it one of the most destructive forest pathogens in North American history.",
