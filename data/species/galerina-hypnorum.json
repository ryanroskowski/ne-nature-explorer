  "nameStory": "",
  "description": "Moss Bell (Galerina hypnorum) is a small, delicate mushroom belonging to the Hymenogastraceae family, characterized by its bell-shaped cap and preference for mossy substrates. Despite its diminutive size, this fungus plays an important ecological role in decomposing organic matter in moist forest environments.",
  "idTips": [
    {
      "label": "Bell-shaped cap",
      "description": "The distinctive campanulate (bell-shaped) cap is the most recognizable feature of this species",
      "isPrimary": true
    },
    {
      "label": "Hygrophanous coloring",
      "description": "The cap appears darker when wet and lighter when dry, changing appearance with moisture conditions",
      "isPrimary": false
    },
    {
      "label": "Growth on moss",
      "description": "Almost exclusively found fruiting directly from or within moss colonies, rarely on bare soil",
      "isPrimary": false
    }
  ],
  "habitat": "Galerina hypnorum thrives in moist, shaded environments throughout New England where dense moss carpets cover forest floors, rotting wood, and damp substrates.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its tiny size (often just 5-15mm across), Moss Bell is one of the few macrofungi specifically adapted to fruit exclusively on living moss, making it a moss-dependent specialist.",
