  "nameStory": "",
  "description": "Hair ice (Exidiopsis effusa) is a delicate fungus in the Auriculariaceae family that forms thin, hair-like filaments on dead wood during cold, damp conditions. This gelatinous fungus appears exclusively in winter and early spring when temperatures hover near freezing and moisture is abundant.",
  "idTips": [
    {
      "label": "Hair-like appearance",
      "description": "Forms fine, silky strands resembling human hair or spider webs on decaying wood",
      "isPrimary": true
    },
    {
      "label": "Seasonal occurrence",
      "description": "Appears only during winter and early spring when temperatures are near or just above freezing",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Grows exclusively on dead hardwood, particularly on rotting logs and branches",
      "isPrimary": false
    }
  ],
  "habitat": "Hair ice occurs in New England forests on moist, decaying hardwood logs and branches during cold, wet winter conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Hair ice was so rare and mysterious that its existence was disputed by scientists until the early 2000s, when researchers discovered that a specific type of bacteria in the wood helps trigger the formation of these delicate ice filaments.",
