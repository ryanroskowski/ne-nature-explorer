  "nameStory": "",
  "description": "Phyllactinia angulata is a powdery mildew fungus that infects various woody plants and shrubs throughout New England. It produces the characteristic white, powdery coating on leaves that defines the powdery mildew family.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Visible white to grayish fungal growth on leaf surfaces, particularly on the upper side of leaves",
      "isPrimary": true
    },
    {
      "label": "Chaetothecial Appendages",
      "description": "Microscopic dark fruiting bodies with distinctive needle-like appendages around their perimeter, visible under magnification",
      "isPrimary": false
    },
    {
      "label": "Host Plants",
      "description": "Commonly found on beech, birch, and other hardwood trees and shrubs in the region",
      "isPrimary": false
    }
  ],
  "habitat": "Phyllactinia angulata thrives in woodlands, forest edges, and ornamental plantings with moderate humidity and adequate air circulation in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews that prefer dry conditions, Phyllactinia angulata can tolerate higher humidity levels and is often more prevalent during cooler, moist springs and falls in New England.",
