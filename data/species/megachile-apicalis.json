  "nameStory": "",
  "description": "Megachile apicalis is a solitary leafcutter bee belonging to the family Megachilidae, native to New England and eastern North America. These medium-sized bees are important pollinators that collect leaf fragments to construct individual nesting cells.",
  "idTips": [
    {
      "label": "Leaf-cutting behavior",
      "description": "Distinctive semi-circular cuts made from plant leaves using powerful mandibles, a signature behavior of leafcutter bees",
      "isPrimary": true
    },
    {
      "label": "Abdominal scopae",
      "description": "Dense brush-like hairs on the underside of the abdomen used for pollen collection, appearing as a dark furry patch",
      "isPrimary": false
    },
    {
      "label": "Body size and color",
      "description": "Medium-sized bee (8-12mm) with black body and metallic green or blue-tinged wings",
      "isPrimary": false
    }
  ],
  "habitat": "Megachile apicalis inhabits gardens, meadows, and woodland edges throughout New England where suitable flowering plants and nesting materials are available.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female leafcutter bees are master engineers, rolling cut leaf pieces into tight cylinders to line their nesting tunnels, creating waterproof chambers for their developing larvae.",
