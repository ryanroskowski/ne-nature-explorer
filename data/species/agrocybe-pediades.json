  "nameStory": "",
  "description": "Common Fieldcap (Agrocybe pediades) is a small, brown mushroom that appears in fields and disturbed areas throughout New England. This cosmopolitan species is known for its delicate appearance and tendency to fruit in large groups during spring and fall.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Light brown to tan cap (8-25mm) with a slightly fibrous surface and hygrophanous texture that fades as it dries",
      "isPrimary": true
    },
    {
      "label": "Stem Characteristics",
      "description": "Thin, hollow stem with a delicate ring or ring zone that may disappear with age",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "Crowded gills that are adnate to adnexed, starting pale and darkening to brown or gray-brown as spores mature",
      "isPrimary": false
    }
  ],
  "habitat": "Common Fieldcap thrives in grassy fields, lawns, and disturbed soil areas throughout New England, often fruiting in clusters after rain.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small, delicate appearance, Agrocybe pediades is one of the most widely distributed mushroom species in the world and has been found on every continent.",
