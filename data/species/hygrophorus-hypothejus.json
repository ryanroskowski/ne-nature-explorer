  "nameStory": "",
  "description": "Herald of Winter (Hygrophorus hypothejus) is a small waxcap mushroom known for fruiting in cold months, often appearing when other fungi have ceased. It belongs to the Hygrophoraceae family, characterized by its waxy, delicate gills and fragile fruiting bodies.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Yellow to olive-yellow cap that may darken with age or moisture, typically 1-3 cm in diameter",
      "isPrimary": true
    },
    {
      "label": "Waxy Gills",
      "description": "Pale yellow, widely-spaced, waxy gills that run down the stem, a hallmark of the Hygrophorus genus",
      "isPrimary": false
    },
    {
      "label": "Fruiting Time",
      "description": "Appears in late fall through winter, often fruiting when frost is present—hence its common name",
      "isPrimary": false
    }
  ],
  "habitat": "Found in moist coniferous and mixed forests of New England, particularly in mossy areas and near decomposing wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Herald of Winter is one of the few waxcap species that thrives in cold temperatures, making it a reliable indicator that winter has arrived in the forest.",
  "confusionNotes": null,
