  "nameStory": "",
  "description": "Gomphus clavatus, commonly known as pig's ears, is a distinctive fungus characterized by its funnel or ear-like shape with a wavy, irregular margin. This edible species belongs to the Gomphaceae family and is prized by foragers in New England woodlands.",
  "idTips": [
    {
      "label": "Funnel Shape",
      "description": "Distinctive funnel or ear-shaped fruiting body with an irregular, often wavy or lobed margin that resembles a pig's ear",
      "isPrimary": true
    },
    {
      "label": "Ridges Instead of Gills",
      "description": "Features blunt, forked ridges (not true gills) running down the underside that are decurrent and often connected by cross-veins",
      "isPrimary": false
    },
    {
      "label": "Color and Texture",
      "description": "Typically tan to yellowish-brown or pinkish-gray with a smooth to slightly wrinkled surface and a hollow interior",
      "isPrimary": false
    }
  ],
  "habitat": "Pig's ears fruit in moist, mixed woodlands and areas with rich humus, often appearing in spring and early summer throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their peculiar appearance, pig's ears are considered choice edibles by experienced foragers and have a delicate, slightly fruity flavor when properly prepared.",
