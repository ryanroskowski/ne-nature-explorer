  "nameStory": "",
  "description": "Hard's Stropharia (Stropharia hardii) is a small mushroom in the Strophariaceae family, characterized by its delicate appearance and distinctive features. It is found in New England and other temperate regions, typically fruiting in woodchips and disturbed soil.",
  "idTips": [
    {
      "label": "Spore Print Color",
      "description": "Produces a dark purple-brown to black spore print, a key characteristic of the Stropharia genus",
      "isPrimary": true
    },
    {
      "label": "Partial Veil Remnants",
      "description": "Young specimens display a delicate ring or veil remnants on the stem that may disappear with age",
      "isPrimary": false
    },
    {
      "label": "Cap and Stem Texture",
      "description": "Small tan to brown cap (usually under 1 inch) with a slender, fragile stem that is often hollow",
      "isPrimary": false
    }
  ],
  "habitat": "Hard's Stropharia thrives in woodchips, mulched areas, and disturbed soil in New England gardens, parks, and forest edges.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size and delicate appearance, Stropharia hardii is a prolific fruiter and can produce multiple flushes throughout the growing season when conditions are favorable.",
