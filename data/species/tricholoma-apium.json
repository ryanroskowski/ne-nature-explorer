  "nameStory": "",
  "description": "Tricholoma apium is a small to medium-sized woodland mushroom in the Tricholomataceae family, characterized by its pale coloring and subtle features. Found throughout New England, it typically fruits in fall and is considered inedible or of uncertain edibility.",
  "idTips": [
    {
      "label": "Gills and Stem",
      "description": "Features white to pale cream-colored gills that are free or nearly free from the stem, with a white, fibrous stem that may have a subtle ring zone",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Small whitish to pale gray cap, typically 2-5 cm wide, with a smooth texture and slight umbo or flattened center",
      "isPrimary": false
    },
    {
      "label": "Odor and Taste",
      "description": "Has a distinctive celery-like or parsnip-like odor (apium refers to celery), which is a key diagnostic feature",
      "isPrimary": true
    }
  ],
  "habitat": "Tricholoma apium grows in mixed deciduous and coniferous forests of New England, often appearing singly or in small groups on the forest floor during fall months.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'apium' refers to its characteristic celery-like smell, which helps distinguish it from similar pale Tricholoma species in the region.",
  "confusionNotes": null,
