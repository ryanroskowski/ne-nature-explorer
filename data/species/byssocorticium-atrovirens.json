  "nameStory": "",
  "description": "Byssocorticium atrovirens is a wood-decay fungus belonging to the Byssocorticiaceae family, characterized by its resupinate (flat, crust-like) fruiting bodies that spread across decaying wood substrates. This corticioid fungus plays an important ecological role in decomposing woody material in forest ecosystems.",
  "idTips": [
    {
      "label": "Dark coloration",
      "description": "The fruiting body displays a distinctly dark greenish-gray to blackish appearance, which is reflected in its species name 'atrovirens' (meaning dark green)",
      "isPrimary": true
    },
    {
      "label": "Resupinate growth form",
      "description": "The fungus grows flat and closely appressed against the wood surface, lacking any shelf-like or upright structures",
      "isPrimary": false
    },
    {
      "label": "Smooth to slightly wrinkled texture",
      "description": "The surface typically appears smooth or has fine wrinkles, with a somewhat velvety appearance under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Byssocorticium atrovirens is commonly found on dead hardwood and softwood logs, branches, and decaying woody debris in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other members of the Byssocorticiaceae family, this fungus produces specialized hyphal structures called byssal hyphae that allow it to efficiently colonize and break down woody substrates in damp conditions.",
