  "nameStory": "",
  "description": "Leccinellum albellum, commonly known as the White Scaber Stalk, is a small to medium-sized bolete with a distinctive pale appearance and scaberlike stem texture. This fungus is found throughout New England and belongs to the Scutellospora family within the boletes.",
  "idTips": [
    {
      "label": "White to Pale Cap",
      "description": "Caps are whitish to pale gray, often with a slightly scaly or finely granular surface texture",
      "isPrimary": false
    },
    {
      "label": "Scabrous Stem",
      "description": "The stem features distinctive small dark scales or scabrous patches against a pale background, giving it a spotted appearance",
      "isPrimary": true
    },
    {
      "label": "Yellow Pores",
      "description": "Pale to yellow pores on the underside that may stain slightly when bruised",
      "isPrimary": false
    }
  ],
  "habitat": "Leccinellum albellum typically fruits on the forest floor in mixed woodlands and under deciduous or coniferous trees, often in mossy areas.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The scaberlike texture on the stem of this bolete is created by the erosion of the universal veil, leaving behind small dark fibrils that give it its distinctive 'scabby' appearance.",
