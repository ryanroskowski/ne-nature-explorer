  "nameStory": "",
  "description": "The Grey Waxcap is a small, delicate mushroom characterized by its distinctive grey coloring and waxy texture, belonging to the diverse Waxcaps and Allies family. This species is commonly found in New England grasslands and meadows, where it plays a role in the ecosystem as a saprotroph.",
  "idTips": [
    {
      "label": "Grey Cap Color",
      "description": "The cap is uniformly grey to pale grey, often with a slightly darker center, and has a distinctive waxy sheen",
      "isPrimary": true
    },
    {
      "label": "Waxcap Texture",
      "description": "The gills and entire fruiting body have a characteristic waxy, almost greasy feel and appearance",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Typically grows 1-3 cm in cap diameter with thin, fragile stems, making it easily overlooked",
      "isPrimary": false
    }
  ],
  "habitat": "Grey Waxcaps thrive in undisturbed grasslands, meadows, and mossy areas throughout New England, preferring nutrient-poor, well-drained soils.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps are considered indicators of high-quality, unimproved grasslands, and their presence suggests the absence of heavy fertilizer use, making them valuable for assessing ecosystem health.",
