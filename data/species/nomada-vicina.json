  "nameStory": "",
  "description": "Neighborly Nomad (Nomada vicina) is a small cuckoo bee native to New England that belongs to the diverse family of bees and their relatives. Like other nomad bees, it is a brood parasite that lays its eggs in the nests of other bee species rather than constructing its own nest.",
  "idTips": [
    {
      "label": "Body Color and Pattern",
      "description": "Bright reddish-orange to yellow markings on the abdomen and face, creating a distinctive spotted or banded appearance",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "One of the smaller bee species, typically 6-8mm in length, making it easy to distinguish from larger native bees",
      "isPrimary": false
    },
    {
      "label": "Lack of Pollen Baskets",
      "description": "Absence of specialized structures (corbiculae) for carrying pollen, as they do not collect pollen for their own offspring",
      "isPrimary": false
    }
  ],
  "habitat": "Neighborly Nomad bees are found in open woodlands, gardens, and meadows throughout New England where their host bee species establish nesting sites.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, the Neighborly Nomad sneaks into the nests of solitary bees and lays its eggs among the host's provisions, allowing the parasitic larvae to develop at the expense of the host bee's offspring.",
  "confusionNotes": null,
