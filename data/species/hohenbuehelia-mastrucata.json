  "nameStory": "",
  "description": "The woolly oyster (Hohenbuehelia mastrucata) is a small, shelf-like fungus in the Pleurotaceae family characterized by its distinctive fuzzy or woolly appearance. It is a wood-decomposing species commonly found throughout New England on dead hardwood branches and logs.",
  "idTips": [
    {
      "label": "Woolly texture",
      "description": "The cap surface is covered in fine, hair-like structures giving it a distinctly fuzzy or woolly appearance, especially when young.",
      "isPrimary": true
    },
    {
      "label": "Small size and shape",
      "description": "Fruiting bodies are typically small (1-3 cm wide) and shelf-like or fan-shaped, often clustered on substrates.",
      "isPrimary": false
    },
    {
      "label": "Decurrent gills",
      "description": "The gills run down the stalk and are relatively crowded, appearing whitish to pale gray.",
      "isPrimary": false
    }
  ],
  "habitat": "Woolly oysters grow on dead hardwood branches, fallen logs, and woody debris in forests and wooded areas throughout New England, preferring moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small and delicate appearance, the woolly oyster is an efficient wood decomposer that plays an important role in nutrient cycling in forest ecosystems.",
