  "nameStory": "",
  "description": "Auricularia angiospermarum, commonly known as the jelly ear fungus, is a gelatinous wood-decay fungus belonging to the Auriculariaceae family. Found throughout New England, it plays an important ecological role in decomposing dead hardwood and is occasionally foraged for culinary purposes.",
  "idTips": [
    {
      "label": "Gelatinous Texture",
      "description": "The fruiting body has a distinctive jelly-like, translucent to dark brown appearance that is rubbery when moist and brittle when dry.",
      "isPrimary": true
    },
    {
      "label": "Ear-like Shape",
      "description": "The fungus typically forms cup or ear-shaped structures with an inner fertile surface and outer sterile surface.",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "It almost exclusively grows on dead or dying hardwood, particularly oak, beech, and maple branches.",
      "isPrimary": false
    }
  ],
  "habitat": "Auricularia angiospermarum thrives on moist, decaying hardwood logs and fallen branches in shaded forests, woodlands, and disturbed areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "In traditional Asian cuisine, related jelly ear fungi are valued ingredients in soups and stir-fries, prized for their unique texture and perceived medicinal properties.",
