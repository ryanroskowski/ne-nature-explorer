  "nameStory": "",
  "description": "The Spine-crowned Clubtail is a dragonfly species belonging to the Clubtail family, characterized by its distinctive club-shaped abdomen and robust body structure. This New England native is an important predator of small flying insects and plays a key role in aquatic ecosystems.",
  "idTips": [
    {
      "label": "Clubbed Abdomen",
      "description": "The abdomen widens noticeably toward the tip, creating the characteristic club shape that gives the family its name",
      "isPrimary": true
    },
    {
      "label": "Spine on Crown",
      "description": "A distinctive spine or projection visible on the head/crown region sets this species apart from other clubtails",
      "isPrimary": false
    },
    {
      "label": "Body Coloration",
      "description": "Typically displays yellow and black or brown markings on the thorax and segments of the abdomen",
      "isPrimary": false
    }
  ],
  "habitat": "The Spine-crowned Clubtail inhabits clear, flowing streams and small rivers with rocky substrates throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all dragonflies, the Spine-crowned Clubtail spends most of its life as an aquatic nymph before emerging as a winged adult, with some individuals spending 2-3 years underwater before their final transformation.",
