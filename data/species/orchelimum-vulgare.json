  "nameStory": "",
  "description": "The Common Meadow Katydid (Orchelimum vulgare) is a medium-sized grasshopper-like insect belonging to the katydid family, known for its prominent role in summer soundscapes throughout New England. Despite their name, katydids are insects, not plants, and are closely related to crickets and grasshoppers.",
  "idTips": [
    {
      "label": "Long Antennae",
      "description": "Extremely long, thread-like antennae that often exceed the body length, distinguishing katydids from grasshoppers",
      "isPrimary": true
    },
    {
      "label": "Leaf-like Wings",
      "description": "Elongated wings that resemble leaves and fold tent-like over the body, providing camouflage in meadow vegetation",
      "isPrimary": false
    },
    {
      "label": "Green Coloration",
      "description": "Predominantly green body color that blends seamlessly with grass and plant stems in meadow habitats",
      "isPrimary": false
    }
  ],
  "habitat": "Common Meadow Katydids inhabit open meadows, grasslands, and weedy fields throughout New England, preferring areas with tall grasses and herbaceous vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male katydids produce their characteristic loud buzzing and chirping calls by rubbing their wings together in a process called stridulation, with each species producing a distinctive song pattern used to attract mates.",
