  "nameStory": "",
  "description": "The Carolina Leafroller Cricket (Camptonotus carolinensis) is a medium-sized raspy cricket native to New England and eastern North America, known for its leaf-rolling behavior and distinctive calls. These crickets are primarily nocturnal and play an important ecological role as both predators and prey in forest ecosystems.",
  "idTips": [
    {
      "label": "Leaf-Rolling Behavior",
      "description": "Characteristic habit of rolling leaves into shelter tubes where the cricket lives and lays eggs",
      "isPrimary": true
    },
    {
      "label": "Raspy Call",
      "description": "Males produce a distinctive rasping or scratchy sound by rubbing their wings together, different from typical cricket chirps",
      "isPrimary": false
    },
    {
      "label": "Body Coloration",
      "description": "Tan to brown coloring with a robust, flattened body shape adapted for navigating leaf structures",
      "isPrimary": false
    }
  ],
  "habitat": "Carolina Leafroller Crickets inhabit deciduous and mixed forests, woodlands, and gardens throughout New England where suitable host plants like oak, maple, and other broad-leaved trees are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "These crickets are skilled architects, using their mandibles to cut and fold fresh leaves into protective shelters that serve as both homes and safe nurseries for their eggs.",
