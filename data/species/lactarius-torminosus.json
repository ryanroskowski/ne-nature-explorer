  "nameStory": "",
  "description": "Woolly Milkcap is a striking fungus with a distinctive woolly or hairy cap surface and a creamy white to pale pink coloration. This Lactarius species is notable for its caustic white latex that stains and its peppery taste, making it toxic if consumed raw.",
  "idTips": [
    {
      "label": "Woolly Cap Surface",
      "description": "The cap has a distinctive fuzzy, hairy, or wooly texture that is easily felt when touched, giving it its common name",
      "isPrimary": true
    },
    {
      "label": "White Latex Staining",
      "description": "When cut or bruised, the gills and flesh release white milk (latex) that slowly stains yellowish or carrot-orange",
      "isPrimary": false
    },
    {
      "label": "Color and Gills",
      "description": "Pale peachy-pink or cream-colored cap with whitish to pale pink crowded gills that are slightly decurrent",
      "isPrimary": false
    }
  ],
  "habitat": "Found in New England in mixed forests, particularly under birch and conifer trees in moist, mossy areas during summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The caustic latex of Woolly Milkcap is so peppery that even a tiny taste will cause a burning sensation on the tongue, which is why it's sometimes called 'Peppery Milkcap.'",
  "confusionNotes": null,
