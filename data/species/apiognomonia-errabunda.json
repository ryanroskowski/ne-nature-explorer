  "nameStory": "",
  "description": "Oak Anthracnose, caused by Apiognomonia errabunda, is a fungal disease that affects oak trees throughout New England, causing leaf spotting and twig dieback. The disease is most problematic during wet springs and can significantly impact tree health and aesthetic appeal when severe.",
  "idTips": [
    {
      "label": "Leaf Spots",
      "description": "Brown to tan irregular spots with darker borders appear on oak leaves, often following the leaf veins",
      "isPrimary": true
    },
    {
      "label": "Twig Cankers",
      "description": "Sunken lesions and dieback occur on young twigs and shoots, particularly on lower branches",
      "isPrimary": false
    },
    {
      "label": "Fungal Fruiting Bodies",
      "description": "Small black fruiting structures (acervuli) are visible on the underside of spotted leaves under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Oak Anthracnose thrives in moist environments and is most prevalent in New England during cool, wet springs when humidity favors spore dispersal and leaf infection.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The disease overwinters in fallen leaves and infected twigs, making sanitation practices like removing debris essential for reducing disease pressure in the following season.",
