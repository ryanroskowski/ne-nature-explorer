  "nameStory": "",
  "description": "Lepiota cristata, commonly known as the Stinking Dapperling, is a small toxic mushroom characterized by its distinctive odor and delicate appearance. This member of the Verrucosporaceae family is commonly encountered throughout New England during wet seasons.",
  "idTips": [
    {
      "label": "Distinctive Odor",
      "description": "Emits a strong, unpleasant smell resembling radishes or crushed bugs when handled or bruised",
      "isPrimary": true
    },
    {
      "label": "Cap Surface",
      "description": "Small white to pale tan cap (1-4 cm) with distinctive reddish-brown scales arranged in concentric rings radiating from the center",
      "isPrimary": false
    },
    {
      "label": "Delicate Structure",
      "description": "Thin, fragile stem with a small ring or collar zone; gills are white and free from the stem",
      "isPrimary": false
    }
  ],
  "habitat": "Lepiota cristata grows on soil, leaf litter, and mulch in grassy areas, gardens, and disturbed ground, preferring moist conditions in lawns and meadows.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size and delicate appearance, the Stinking Dapperling contains amatoxins similar to deadly Amanita species, making it toxic if ingested.",
