  "nameStory": "",
  "description": "The Texas Mason Bee (Osmia texana) is a solitary bee species belonging to the family Megachilidae, known for their efficient pollination capabilities and nest-building behavior. These small, dark bees are named for their habit of constructing nests in cavities using mud or resin as mortar.",
  "idTips": [
    {
      "label": "Body Color and Size",
      "description": "Small metallic-blue or black body, typically 8-12mm in length with a compact, robust frame",
      "isPrimary": true
    },
    {
      "label": "Abdominal Pollen Brush",
      "description": "Dense, branched hairs on the underside of the abdomen (scopa) used to collect and carry pollen",
      "isPrimary": false
    },
    {
      "label": "Facial Structure",
      "description": "Relatively large eyes and broad face compared to other bee species, with a slightly protruding clypeus",
      "isPrimary": false
    }
  ],
  "habitat": "Texas Mason Bees thrive in open woodlands, gardens, and meadows throughout New England where dead wood cavities, hollow stems, and man-made bee houses provide suitable nesting sites.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike honeybees, Osmia texana females are incredibly efficient pollinators—a single mason bee can pollinate as much as 120 honeybees, making them invaluable for agricultural and garden pollination.",
