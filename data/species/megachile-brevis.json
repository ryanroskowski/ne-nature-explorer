  "nameStory": "",
  "description": "Megachile brevis is a small leafcutter bee species native to New England that plays an important role in pollinating native plants and wildflowers. These solitary bees are known for their distinctive behavior of cutting leaf fragments to construct individual nesting cells.",
  "idTips": [
    {
      "label": "Size",
      "description": "Small bee, typically 8-10mm in length, noticeably smaller than many other Megachile species",
      "isPrimary": false
    },
    {
      "label": "Leaf-cutting behavior",
      "description": "Characteristic D-shaped or oval cuts visible on leaves of garden plants and native vegetation where females have harvested material",
      "isPrimary": true
    },
    {
      "label": "Abdominal scopa",
      "description": "Dense brush of hairs on the underside of the abdomen used to collect and carry pollen and leaf pieces",
      "isPrimary": false
    }
  ],
  "habitat": "Megachile brevis inhabits open woodlands, meadows, gardens, and disturbed areas throughout New England where suitable host plants and nesting cavities are available.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female Megachile brevis can cut precise leaf fragments in as little as 30 seconds and may visit hundreds of leaves to gather enough material to line a single brood cell.",
