  "nameStory": "",
  "description": "The Green-legged Spur-throat Grasshopper is a medium-sized member of the Short-horned Grasshopper family (Acrididae) commonly found throughout New England. It is named for its distinctive green hind legs and the small spur-like projection on its thorax.",
  "idTips": [
    {
      "label": "Green Hind Legs",
      "description": "The most distinctive feature is the bright green coloration of the hind legs, which contrasts with the tan or brown body",
      "isPrimary": true
    },
    {
      "label": "Body Color",
      "description": "The body is typically brown, tan, or olive-green with a moderately robust build",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Adults typically measure 13-18 mm in length, making them medium-sized grasshoppers",
      "isPrimary": false
    }
  ],
  "habitat": "This species prefers open, grassy areas including meadows, prairies, roadsides, and disturbed habitats throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Green-legged Spur-throat Grasshoppers produce sound by rubbing their hind legs against their wings, and males use these calls to communicate with females during mating season.",
