  "nameStory": "",
  "description": "Phaeotremella frondosa is a gelatinous fungus in the Phaeotremellaceae family, characterized by its dark, branching fruiting bodies that resemble leafy fronds. This wood-decay fungus is commonly found in New England forests, particularly in cooler, moist environments.",
  "idTips": [
    {
      "label": "Gelatinous Texture",
      "description": "The fruiting body has a distinctive jelly-like, translucent to dark brown texture that becomes rubbery when dry",
      "isPrimary": true
    },
    {
      "label": "Frond-like Branching",
      "description": "Dark brown to black fruiting bodies display elaborate, fan-like or leaf-like branching patterns",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "Grows exclusively on decaying hardwood, typically on logs and dead branches",
      "isPrimary": false
    }
  ],
  "habitat": "Phaeotremella frondosa thrives on rotting hardwood logs and fallen branches in moist, shaded forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus absorbs and releases water dramatically, expanding into a gelatinous mass during wet conditions and shrinking to a hard, crusty form when dry, allowing it to survive harsh conditions.",
