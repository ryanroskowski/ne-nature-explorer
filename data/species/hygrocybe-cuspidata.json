  "nameStory": "",
  "description": "The Candy Apple Waxy Cap is a striking small mushroom characterized by its vibrant red to crimson cap and slender, fragile stem. This delicate fungus belongs to the waxcap family, a group known for their waxy-textured gills and colorful fruiting bodies.",
  "idTips": [
    {
      "label": "Pointed Cap Shape",
      "description": "The cap is distinctively conical to bell-shaped with a sharp point at the apex, which gives the species its name 'cuspidata' (meaning pointed).",
      "isPrimary": true
    },
    {
      "label": "Bright Red Coloration",
      "description": "The fruiting body displays a brilliant candy apple red to crimson color that fades toward the base and becomes pale yellow on the stem.",
      "isPrimary": false
    },
    {
      "label": "Waxy Gills",
      "description": "The gills are widely spaced, thick, waxy in texture, and pale yellow to white, a characteristic feature of the waxcap family.",
      "isPrimary": false
    }
  ],
  "habitat": "Found in grassy meadows, lawns, and well-maintained fields throughout New England, typically in moist conditions during late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps like Hygrocybe cuspidata are considered indicators of undisturbed, healthy grassland ecosystems and are often used by mycologists to assess the ecological quality of meadows.",
  "confusionNotes": null,
  "contextualKnowledge": null,
