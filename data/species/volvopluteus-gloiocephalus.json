  "nameStory": "",
  "description": "Stubble Rosegill (Volvopluteus gloiocephalus) is a small to medium-sized mushroom characterized by its distinctive pink or rose-colored gills and a cup-like volva at the base of its stem. This species belongs to the Pluteaceae family and is commonly found in New England during the growing season.",
  "idTips": [
    {
      "label": "Rose-pink gills",
      "description": "Free gills that are distinctly pink or rose-colored, which is the most distinctive feature of this species",
      "isPrimary": true
    },
    {
      "label": "Volva at base",
      "description": "A cup-like or sack-like structure (volva) at the base of the stem, remnants of the universal veil",
      "isPrimary": false
    },
    {
      "label": "Cap appearance",
      "description": "Small whitish to grayish cap, typically 2-5 cm wide, with a smooth or slightly sticky surface",
      "isPrimary": false
    }
  ],
  "habitat": "Stubble Rosegill typically grows on decaying wood, wood chips, and composted materials in disturbed areas, gardens, and forest edges throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'gloiocephalus' refers to the sticky or gelatinous appearance of the young fruiting bodies, which can make them appear wet or slimy even in dry conditions.",
