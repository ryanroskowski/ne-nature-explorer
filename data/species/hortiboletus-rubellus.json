  "nameStory": "",
  "description": "The Ruby Bolete (Hortiboletus rubellus) is a small to medium-sized fungus in the bolete family, recognizable by its distinctive reddish coloration and yellow pores. It is commonly found in New England forests and is inedible due to its bitter taste and potential gastrointestinal effects.",
  "idTips": [
    {
      "label": "Red to reddish-orange cap",
      "description": "The cap is distinctly red or reddish-orange, which gives the mushroom its common name.",
      "isPrimary": true
    },
    {
      "label": "Yellow pores that bruise blue",
      "description": "The underside has yellow pores that turn blue or blue-green when bruised or handled.",
      "isPrimary": false
    },
    {
      "label": "Red staining on stem",
      "description": "The stem often displays red or reddish coloration, particularly near the base.",
      "isPrimary": false
    }
  ],
  "habitat": "Ruby Boletes are found on the forest floor in mixed hardwood and conifer forests throughout New England, typically fruiting in summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their striking appearance, Ruby Boletes are poisonous and will cause severe nausea and vomiting if consumed, making them an important example of why proper mushroom identification is critical before foraging.",
