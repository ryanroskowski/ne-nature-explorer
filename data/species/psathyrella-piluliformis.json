  "nameStory": "",
  "description": "Common Stump Brittlestem is a small, delicate mushroom characterized by its fragile stems and pale coloring, belonging to the Psathyrellaceae family. It typically fruits in clusters on decaying wood and is widespread throughout New England during cool, moist seasons.",
  "idTips": [
    {
      "label": "Fragile Stems",
      "description": "The stems are notably brittle and break easily when handled, giving the species its common name.",
      "isPrimary": true
    },
    {
      "label": "Small Pale Caps",
      "description": "Caps are small (0.5-1.5 cm), whitish to grayish-brown, and often bell-shaped or conical.",
      "isPrimary": false
    },
    {
      "label": "Clustered Growth",
      "description": "Fruiting bodies grow in dense tufts or clusters directly on dead wood, stumps, or decaying logs.",
      "isPrimary": false
    }
  ],
  "habitat": "Found on decaying hardwood stumps, logs, and woody debris in forests and wooded areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate appearance, Psathyrella piluliformis is a prolific fruiter and can produce multiple flushes of mushrooms throughout the autumn and spring seasons.",
