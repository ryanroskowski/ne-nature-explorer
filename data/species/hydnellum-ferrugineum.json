  "nameStory": "",
  "description": "Hydnellum ferrugineum, commonly known as Mealy Tooth, is a small woodland fungus distinguished by its granular or mealy texture on the cap and stem surfaces. This species is a member of the Boletopsidaceae family and produces spines rather than gills on its underside.",
  "idTips": [
    {
      "label": "Mealy Texture",
      "description": "The cap and stem are covered with a distinctive granular or powdery mealy coating that gives the fungus a frosted appearance",
      "isPrimary": true
    },
    {
      "label": "Spine Color",
      "description": "The pores or spines on the underside range from white to cream-colored and bruise darker when handled",
      "isPrimary": false
    },
    {
      "label": "Cap Color",
      "description": "The cap typically displays shades of brown to reddish-brown, often with a paler, mealy surface layer",
      "isPrimary": false
    }
  ],
  "habitat": "Mealy Tooth is found in cool, moist coniferous and mixed forests throughout New England, typically fruiting in late summer and fall on mossy forest floors.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size and inconspicuous appearance, Hydnellum ferrugineum is notable for its hygrophanous nature, meaning its cap color and texture change significantly with moisture levels, appearing darker and smoother when wet.",
