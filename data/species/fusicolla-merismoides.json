  "nameStory": "",
  "description": "Deer vomit (Fusicolla merismoides) is a small fungus in the Nectriaceae family characterized by its gelatinous, brain-like fruiting bodies. This wood-decay fungus plays an important ecological role in breaking down dead plant material in forest ecosystems.",
  "idTips": [
    {
      "label": "Gelatinous texture",
      "description": "The fruiting body has a distinctive jelly-like, translucent consistency that is soft and moist",
      "isPrimary": true
    },
    {
      "label": "Brain-like appearance",
      "description": "The surface is wrinkled and convoluted, resembling brain tissue, typically ranging from pale tan to orange-red in color",
      "isPrimary": false
    },
    {
      "label": "Size and growth",
      "description": "Forms small fruiting bodies, usually less than 1 inch across, that often appear in clusters on decaying wood",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus is found on dead wood and decaying logs in moist forests throughout New England, particularly in areas with high humidity and shade.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The common name 'deer vomit' refers to the fungus's appearance, though it is harmless to deer and other wildlife that may encounter it in the forest.",
