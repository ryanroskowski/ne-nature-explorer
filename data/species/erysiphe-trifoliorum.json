  "nameStory": "",
  "description": "Erysiphe trifoliorum is a fungal pathogen that causes powdery mildew on clover species throughout New England. This obligate parasite creates distinctive white, powdery fungal growth on plant surfaces, weakening infected plants and reducing forage quality.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Dense white or grayish powdery fungal growth appears on both leaf surfaces, stems, and flower parts",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Infection occurs specifically on clover species (Trifolium spp.), making host identity a key identification feature",
      "isPrimary": false
    },
    {
      "label": "Chasmothecia Formation",
      "description": "Dark, spherical overwintering structures may develop within the powdery coating as temperatures cool in fall",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe trifoliorum thrives in cool to moderate temperatures with high humidity and poor air circulation, making New England's moist spring and fall conditions ideal for infection.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many fungi, powdery mildews do not require free water on leaf surfaces to infect plants—they can germinate and spread in surprisingly dry conditions, making them particularly problematic in certain seasons.",
  "confusionNotes": null,
  "contextualKnowledge": null,
