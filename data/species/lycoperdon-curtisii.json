  "nameStory": "",
  "description": "Curtis's Puffball (Lycoperdon curtisii) is a small to medium-sized puffball fungus characterized by its distinctive warty or spiny surface texture. Found throughout New England, it disperses its spores through a small apical pore that opens at the top of the fruiting body.",
  "idTips": [
    {
      "label": "Spore dispersal pore",
      "description": "A small opening at the apex (top) of the fruiting body through which spores are released when compressed by rain or touch",
      "isPrimary": true
    },
    {
      "label": "Warty or granular surface",
      "description": "The outer layer (peridium) is covered with small warts, spines, or granular projections that distinguish it from smooth puffballs",
      "isPrimary": false
    },
    {
      "label": "Size and color",
      "description": "Typically 1-2 inches in diameter with a whitish to pale brown coloration that darkens with age",
      "isPrimary": false
    }
  ],
  "habitat": "Curtis's Puffball grows in woodlands, grasslands, and disturbed areas of New England, preferring moist soil and often appearing in mossy or leaf-littered environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "When mature, a single puffball can release thousands of microscopic spores in a single puff, which are carried by air currents and dispersed across considerable distances.",
