  "nameStory": "",
  "description": "Destructive Pholiota (Hemipholiota populnea) is a wood-decaying fungus in the Hymenogastraceae family that produces small, yellowish-brown fruiting bodies. It is commonly found in New England where it plays an important ecological role in breaking down dead wood.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Small yellowish-brown to tan caps with fine scales or fibrils, typically 1-3 cm in diameter",
      "isPrimary": true
    },
    {
      "label": "Gills and Attachment",
      "description": "Decurrent to adnate gills that are pale yellow to rusty-brown, becoming darker with age",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Grows in clusters on hardwood logs and stumps, especially aspen and poplar",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives on decaying hardwood, particularly on aspen and poplar logs and stumps throughout New England's forests.",
