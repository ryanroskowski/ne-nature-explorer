  "nameStory": "",
  "description": "The Snakeweed Grasshopper (Hesperotettix viridis) is a small to medium-sized member of the Short-horned Grasshoppers family (Acrididae) found throughout New England and eastern North America. This grasshopper is named for its association with snakeweed and other low vegetation in its preferred habitats.",
  "idTips": [
    {
      "label": "Green coloration",
      "description": "Predominantly green body color that provides excellent camouflage in vegetation",
      "isPrimary": true
    },
    {
      "label": "Short antennae",
      "description": "Characteristic short antennae typical of short-horned grasshoppers, much shorter than body length",
      "isPrimary": false
    },
    {
      "label": "Small to medium size",
      "description": "Body length typically ranges from 12-18 mm, making it one of the smaller grasshopper species",
      "isPrimary": false
    }
  ],
  "habitat": "The Snakeweed Grasshopper inhabits dry, open grasslands, fields, and areas with low herbaceous vegetation, particularly where snakeweed and similar plants are abundant.",
