  "nameStory": "",
  "description": "Entomophthora muscae is an entomopathogenic fungus that parasitizes and kills flies, particularly house flies and other dipterans. It is a member of the Entomophthoraceae family and is commonly found in New England during fall and winter months when fly populations are high.",
  "idTips": [
    {
      "label": "Infected fly appearance",
      "description": "Infected flies exhibit a characteristic 'mummified' appearance with their wings held outstretched and legs extended, often found dead on window sills or walls",
      "isPrimary": true
    },
    {
      "label": "Spore discharge",
      "description": "The fungus produces sticky spores that are violently discharged from the fly's body, creating a halo effect visible under magnification",
      "isPrimary": false
    },
    {
      "label": "Host behavior",
      "description": "Infected flies climb to high points before death, a phenomenon called 'summit disease,' positioning themselves to aid spore dispersal",
      "isPrimary": false
    }
  ],
  "habitat": "Entomophthora muscae thrives in cool, damp environments in New England, particularly in agricultural areas, livestock facilities, and human structures where flies congregate during autumn and winter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus has evolved a sophisticated transmission strategy: infected flies are compelled to climb to elevated positions before dying, maximizing spore dispersal to infect other flies below.",
