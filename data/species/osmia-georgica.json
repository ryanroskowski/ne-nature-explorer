  "nameStory": "",
  "description": "The Georgia Mason Bee (Osmia georgica) is a solitary bee species belonging to the Megachilidae family, known for its efficient pollination of spring-blooming plants. Native to the southeastern United States, this species has expanded its range northward into New England in recent decades.",
  "idTips": [
    {
      "label": "Metallic Green Coloration",
      "description": "Displays a distinctive metallic green to blue-green body color, particularly visible on the head and thorax",
      "isPrimary": true
    },
    {
      "label": "Compact Size",
      "description": "Measures approximately 8-10 mm in length, making it a medium-sized mason bee",
      "isPrimary": false
    },
    {
      "label": "Pollen-Carrying Hairs",
      "description": "Features dense scopal hairs on the underside of the abdomen for carrying pollen loads",
      "isPrimary": false
    }
  ],
  "habitat": "Georgia Mason Bees prefer open woodlands, gardens, and meadows with early spring flowers and available nesting sites in dead wood or hollow stems.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike honeybees, mason bees are solitary nesters and do not produce honey, but they are 100-200 times more efficient pollinators due to their active foraging behavior and larger pollen loads.",
