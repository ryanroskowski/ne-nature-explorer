  "nameStory": "",
  "description": "The Lake Emerald is a medium-sized dragonfly belonging to the Emerald family, characterized by its brilliant metallic green coloration. Found throughout New England, this species is a skilled aerial hunter that frequents freshwater habitats during the warmer months.",
  "idTips": [
    {
      "label": "Metallic Green Abdomen",
      "description": "Distinctive bright emerald-green coloration on the abdomen that gives the species its common name",
      "isPrimary": true
    },
    {
      "label": "Large Compound Eyes",
      "description": "Prominent dark eyes that meet or nearly meet at the top of the head, typical of emerald dragonflies",
      "isPrimary": false
    },
    {
      "label": "Clear Wings",
      "description": "Transparent wings with dark pterostigmata (wing spots) that remain clear throughout the dragonfly's life",
      "isPrimary": false
    }
  ],
  "habitat": "Lake Emeralds thrive in clear, cool freshwater lakes, ponds, and slow-moving streams throughout New England, preferring areas with aquatic vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their delicate appearance, Lake Emeralds are incredibly fast fliers capable of reaching speeds of up to 30 mph while hunting small insects mid-air.",
