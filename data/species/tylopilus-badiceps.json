  "nameStory": "",
  "description": "The Beveled-cap Bolete is a small to medium-sized fungus characterized by its distinctive reddish-brown cap with a beveled or sunken center. It belongs to the boletes family, which are fungi that have tubes instead of gills underneath their caps.",
  "idTips": [
    {
      "label": "Sunken Cap Shape",
      "description": "The cap has a characteristic beveled or deeply depressed center, giving it a funnel-like appearance",
      "isPrimary": true
    },
    {
      "label": "Reddish-Brown Coloring",
      "description": "The cap ranges from reddish-brown to tan, often with a distinctive darker center",
      "isPrimary": false
    },
    {
      "label": "Tube Color",
      "description": "The pores (tubes) underneath are typically yellow to pale yellow, sometimes bruising blue when handled",
      "isPrimary": false
    }
  ],
  "habitat": "Beveled-cap Boletes are found in mixed woodlands and forests throughout New England, typically fruiting in summer through fall on or near decaying wood and rich soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many boletes, this species has small pores instead of gills, which can release millions of spores when mature to spread the fungus throughout the forest.",
