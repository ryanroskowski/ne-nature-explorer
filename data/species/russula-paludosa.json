  "nameStory": "",
  "description": "Hintapink (Russula paludosa) is a small to medium-sized brittlegill mushroom characterized by its distinctive pink or reddish cap and white gills. Like other Russula species, it is inedible and may cause gastrointestinal upset if consumed.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Pale to bright pink or red cap that may fade with age",
      "isPrimary": true
    },
    {
      "label": "Fragile Gills",
      "description": "White to cream-colored gills that are characteristically brittle and easily break apart",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Found exclusively in boggy, wet areas and acidic soils typical of New England wetlands",
      "isPrimary": false
    }
  ],
  "habitat": "Hintapink grows in acidic, moist environments including sphagnum bogs, wetlands, and coniferous forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The brittlegill family (Russulaceae) is named for their characteristically fragile gills that shatter like chalk when handled, which is a key feature distinguishing them from other gilled mushrooms.",
  "confusionNotes": null,
  "contextualKnowledge": null,
