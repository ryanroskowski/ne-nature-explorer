  "nameStory": "",
  "description": "Physalacria inflata, commonly known as bladder stalks, is a small fungus in the Physalacriaceae family characterized by delicate, inflated fruiting bodies that resemble tiny balloons on thin stalks. This species is found in New England and other temperate regions, typically fruiting in moist conditions on decaying wood and leaf litter.",
  "idTips": [
    {
      "label": "Inflated Fruiting Bodies",
      "description": "The most distinctive feature is the balloon-like, hollow cap that appears swollen or bladder-shaped at the apex of thin, slender stalks.",
      "isPrimary": true
    },
    {
      "label": "Size and Delicacy",
      "description": "Very small fruiting bodies, typically 3-8 mm tall, with an extremely fragile structure that collapses easily when touched or dried.",
      "isPrimary": false
    },
    {
      "label": "Spore Bearing Surface",
      "description": "Smooth or slightly wrinkled hymenium (spore-bearing surface) covers the underside of the inflated cap.",
      "isPrimary": false
    }
  ],
  "habitat": "Physalacria inflata grows on moist, decaying hardwood, bark, and woody debris in damp forests and shaded areas throughout New England, preferring humid conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The inflated, balloon-like caps of bladder stalks help disperse spores by allowing them to catch and carry moisture and air currents more effectively than typical fungal structures.",
