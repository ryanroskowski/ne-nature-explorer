  "nameStory": "",
  "description": "Tremella fuciformis, commonly known as snow fungus or white jelly fungus, is a gelatinous fungus in the Tremellaceae family characterized by its delicate, translucent appearance. Though native to East Asia, it occasionally fruits in moist, shaded environments in New England during humid conditions.",
  "idTips": [
    {
      "label": "Gelatinous texture",
      "description": "White to cream-colored, jelly-like fruiting bodies that are soft and watery when moist, becoming brittle when dried",
      "isPrimary": true
    },
    {
      "label": "Fruiting body shape",
      "description": "Forms brain-like or cauliflower-like lobes that are densely branched and clustered together",
      "isPrimary": false
    },
    {
      "label": "Substrate preference",
      "description": "Typically grows on hardwood, particularly on dead or dying wood of trees like oak and maple",
      "isPrimary": false
    }
  ],
  "habitat": "Snow fungus prefers cool, humid hardwood forests with decaying logs and branches, most commonly appearing in New England during fall and early winter months.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Snow fungus has been used in traditional Chinese medicine and cuisine for centuries, valued for its collagen-like properties, and is now commercially cultivated worldwide as a prized culinary and cosmetic ingredient.",
