  "nameStory": "",
  "description": "The Epaulette Metallic Sweat Bee is a small, solitary bee species belonging to the Halictidae family, characterized by its metallic coloring and modest size. These bees are important native pollinators found throughout New England, where they visit a variety of flowering plants during the warmer months.",
  "idTips": [
    {
      "label": "Metallic Green Coloration",
      "description": "The body displays a distinctive metallic green or bronze sheen, particularly visible on the head and thorax",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Adults are typically 4-6 mm in length, making them one of the smallest bee species",
      "isPrimary": false
    },
    {
      "label": "Shoulder Patches",
      "description": "Named for pale or light-colored patches (epaulettes) visible on the sides of the thorax",
      "isPrimary": false
    }
  ],
  "habitat": "These bees thrive in open meadows, gardens, and woodland edges throughout New England, preferring areas with abundant native flowering plants and bare ground for nesting.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike honeybees, Epaulette Metallic Sweat Bees are solitary nesters, with each female creating her own individual burrow in sandy or bare soil rather than living in colonies.",
