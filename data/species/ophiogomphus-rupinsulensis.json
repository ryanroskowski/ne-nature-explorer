  "nameStory": "",
  "description": "Rusty Snaketail is a medium-sized dragonfly in the Clubtail family (Gomphidae) endemic to New England, recognized by its distinctive rusty-brown coloration and clubbed abdomen. This species is a strong flyer found near clean, flowing waterways where it hunts small insects during the warmer months.",
  "idTips": [
    {
      "label": "Rusty coloration",
      "description": "Distinctive rust or bronze-brown coloring on the body and wings, particularly visible on the thorax and abdomen",
      "isPrimary": true
    },
    {
      "label": "Clubbed abdomen",
      "description": "Characteristic clubbed or swollen appearance at the tip of the abdomen, typical of clubtail dragonflies",
      "isPrimary": false
    },
    {
      "label": "Size and build",
      "description": "Medium-sized dragonfly (approximately 1.5-2 inches) with a robust, compact body structure",
      "isPrimary": false
    }
  ],
  "habitat": "Rusty Snaketails inhabit clear, fast-flowing streams and rivers with rocky substrates and minimal pollution, preferring areas with riparian vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other clubtails, male Rusty Snaketails perform elaborate aerial displays and territorial behaviors to establish and defend their preferred perching spots along streams.",
