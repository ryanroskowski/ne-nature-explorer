  "nameStory": "",
  "description": "Megachile inimica is a leafcutter bee native to New England that belongs to the Megachilidae family, known for their remarkable leaf-cutting behavior. These solitary bees are medium-sized and use cut leaf fragments to construct individual brood cells within hollow stems or cavities.",
  "idTips": [
    {
      "label": "Leaf-Cutting Behavior",
      "description": "Look for bees carrying semi-circular or oval pieces of leaves in their mandibles, which is diagnostic for leafcutter bees.",
      "isPrimary": true
    },
    {
      "label": "Body Size and Color",
      "description": "Medium-sized bee (approximately 8-10mm) with a dark body and distinctive abdominal scopa (hair brush) on the underside for pollen collection.",
      "isPrimary": false
    },
    {
      "label": "Facial Features",
      "description": "Males typically have white or pale facial markings, while females are predominantly dark with robust mandibles suited for cutting.",
      "isPrimary": false
    }
  ],
  "habitat": "Megachile inimica thrives in gardens, meadows, and woodland edges throughout New England where flowering plants and suitable nesting cavities in dead stems or trees are available.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female leafcutter bees are incredibly precise architects—they cut leaf pieces almost perfectly to size and arrange them like shingles inside their nesting cavities to create waterproof brood cells for their offspring.",
  "confusionNotes": null,
  "contextualKnowledge": null,
