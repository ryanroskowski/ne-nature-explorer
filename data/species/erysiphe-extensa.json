  "nameStory": "",
  "description": "Erysiphe extensa is a powdery mildew fungus that infects a variety of host plants throughout New England, causing characteristic white powdery coatings on leaves and stems. This obligate parasite is part of the Erysiphaceae family and reproduces through both asexual conidia and sexual chasmothecia structures.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white, flour-like mycelium covers infected leaf surfaces, giving the disease its common name",
      "isPrimary": true
    },
    {
      "label": "Conidiophores Structure",
      "description": "Microscopic examination reveals characteristic foot-cells at the base of conidiophores that are shorter than the first conidium",
      "isPrimary": false
    },
    {
      "label": "Chasmothecia Formation",
      "description": "Dark overwintering structures (cleistothecia) with distinctive appendages develop on infected tissue in late season",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe extensa thrives in cool, dry conditions on various herbaceous and woody plant hosts in New England gardens, woodlands, and agricultural areas.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews, Erysiphe extensa has an unusually broad host range, infecting more than 100 different plant species across multiple plant families.",
  "confusionNotes": null,
  "contextualKnowledge": null,
