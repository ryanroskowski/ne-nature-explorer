  "nameStory": "",
  "description": "Hydnellum scabrosum, commonly known as bitter tooth, is a wood-decomposing fungus characterized by its distinctive tooth-like spines beneath the cap instead of gills. This species belongs to the Boletopsidaceae family and is found throughout New England woodlands.",
  "idTips": [
    {
      "label": "Spines Instead of Gills",
      "description": "Look for small, tooth-like structures (hydnums) on the underside of the cap rather than traditional gills or pores, which is the defining feature of this genus.",
      "isPrimary": true
    },
    {
      "label": "Cap Color and Texture",
      "description": "The cap is typically grayish to dark brown with a scabrous (rough, bumpy) surface texture that gives the species its name.",
      "isPrimary": false
    },
    {
      "label": "Bitter Taste",
      "description": "The fungus has a noticeably bitter taste (never swallow), which is how it earned its common name of bitter tooth.",
      "isPrimary": false
    }
  ],
  "habitat": "Hydnellum scabrosum grows on decaying wood, logs, and woody debris in moist coniferous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many fungi, bitter tooth spines can change color as the fungus matures, sometimes becoming reddish or stained where bruised, making fresh specimens easier to identify than dried specimens.",
