  "nameStory": "",
  "description": "Crinipellis zonata, commonly known as the zoned hairy parachute, is a small delicate mushroom belonging to the Pinwheel Family (Mycenaceae) characterized by its distinctive umbrella-like cap and fine hair-like structures. This fungus is found throughout New England where it plays a role in decomposing organic matter in woodland ecosystems.",
  "idTips": [
    {
      "label": "Zoned Cap",
      "description": "The cap displays concentric zones of lighter and darker colors, creating a distinctive ringed or banded pattern",
      "isPrimary": true
    },
    {
      "label": "Hairy Surface",
      "description": "Fine, hair-like structures (setae) cover the cap surface, giving it a characteristic fuzzy or velvety appearance",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Caps typically measure 0.5-1.5 inches in diameter with proportionally thin, delicate stems",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus grows on decaying wood, leaf litter, and mossy substrates in moist hardwood and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The common name 'parachute' refers to the mushroom's delicate, umbrella-like appearance that seems perfectly designed to distribute spores on woodland air currents.",
