  "nameStory": "",
  "description": "Christmas fern leaf curl is a fungal disease caused by Taphrina polystichi that affects Christmas ferns (Polystichum acrostichoides) in New England forests. The disease causes distinctive curling and distortion of infected fronds, reducing the aesthetic and ecological value of this popular native plant.",
  "idTips": [
    {
      "label": "Frond Distortion",
      "description": "Infected fronds exhibit characteristic curling, twisting, and malformation, often becoming cup-shaped or severely contorted",
      "isPrimary": true
    },
    {
      "label": "Affected Plant Species",
      "description": "The disease specifically targets Christmas fern (Polystichum acrostichoides), a common evergreen fern in the region",
      "isPrimary": false
    },
    {
      "label": "Seasonal Appearance",
      "description": "Symptoms are most visible during winter months when the typically robust Christmas fern foliage appears abnormally twisted",
      "isPrimary": false
    }
  ],
  "habitat": "Christmas fern leaf curl occurs in moist, shaded forest understories and woodland areas throughout New England where Christmas ferns naturally grow.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Taphrina polystichi is one of the few Taphrinaceae species that specifically targets ferns rather than flowering plants, making it a unique fungal pathogen in New England ecosystems.",
