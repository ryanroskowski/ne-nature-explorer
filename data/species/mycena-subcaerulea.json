  "nameStory": "",
  "description": "Mycena subcaerulea is a small, delicate mushroom in the Mycenaceae family characterized by its distinctive bluish or grayish-blue coloration on the cap and stem. This species is commonly found in the moist forest environments of New England during the fall and spring fruiting seasons.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Pale blue to grayish-blue cap, typically 0.5-1.5 cm in diameter, which fades with age or drying",
      "isPrimary": true
    },
    {
      "label": "Stem Characteristics",
      "description": "Slender, fragile stem with blue-tinged coloration at the base, becoming lighter toward the apex",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "Adnate to adnexed gills that are pale and may show a slight bluish tinge",
      "isPrimary": false
    }
  ],
  "habitat": "Mycena subcaerulea grows on decaying hardwood, leaf litter, and mossy substrates in moist deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The bluish coloration of Mycena subcaerulea may serve as a visual cue in its dark forest microhabitat, making it one of the more colorful members of an otherwise inconspicuous genus.",
