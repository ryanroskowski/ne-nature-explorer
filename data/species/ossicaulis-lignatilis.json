  "nameStory": "",
  "description": "Bonestem (Ossicaulis lignatilis) is a small woodland mushroom belonging to the Lyophyllaceae family, characterized by its distinctive rigid, bone-like stem. This species is found in New England and other temperate regions, typically fruiting on decaying wood and woody debris.",
  "idTips": [
    {
      "label": "Rigid, Bone-like Stem",
      "description": "The stem is notably hard, brittle, and pale, resembling bone in texture and appearance—the feature that inspired both its common and scientific names",
      "isPrimary": true
    },
    {
      "label": "Small Cap Size",
      "description": "The cap is typically small (1-3 cm), bell-shaped to convex, and whitish to pale gray in color",
      "isPrimary": false
    },
    {
      "label": "Attached Gills",
      "description": "The gills are crowded, thin, and attached to the stem, running pale white to light gray",
      "isPrimary": false
    }
  ],
  "habitat": "Ossicaulis lignatilis grows on decaying hardwood logs, stumps, and woody debris in moist, shaded woodland environments throughout New England.",
