  "nameStory": "",
  "description": "Nomada obliterata, commonly known as the Obliterated Nomad, is a small cuckoo bee in the family Apidae found throughout New England. These parasitic bees lay their eggs in the nests of other bee species, particularly mining bees, rather than constructing their own nests.",
  "idTips": [
    {
      "label": "Body coloration",
      "description": "Predominantly black body with red or orange markings on the abdomen and thorax, creating a distinctive pattern",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Tiny bee, typically 8-10 mm in length, making it noticeably smaller than honey bees and many other native bees",
      "isPrimary": false
    },
    {
      "label": "Smooth appearance",
      "description": "Relatively sparse body hair compared to pollen-collecting bees, reflecting their non-foraging lifestyle",
      "isPrimary": false
    }
  ],
  "habitat": "Nomada obliterata inhabits open woodlands, meadows, and disturbed areas throughout New England where their host bee species are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, Nomada obliterata is a brood parasite that sneaks into the nests of other bees to lay its eggs, where the nomad larvae consume the host's provisions and sometimes even kill the host larvae.",
  "confusionNotes": null,
