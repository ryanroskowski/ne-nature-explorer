  "nameStory": "",
  "description": "Gomphidius nigricans, commonly known as the Blackening Gomphidius, is a small to medium-sized fungus with a distinctive dark coloration and glutinous texture. This species belongs to the Gomphidiaceae family and is commonly found in coniferous forests throughout New England.",
  "idTips": [
    {
      "label": "Dark coloration and blackening",
      "description": "Caps and stems darken or blacken with age or when bruised, distinguishing it from lighter Gomphidius species",
      "isPrimary": true
    },
    {
      "label": "Slimy, glutinous surface",
      "description": "The cap has a distinctly slippery, sticky coating that is characteristic of the genus",
      "isPrimary": false
    },
    {
      "label": "Forked or ridged gills",
      "description": "The gills are blunt, decurrent, and often have a distinctive forked or ridged appearance",
      "isPrimary": false
    }
  ],
  "habitat": "Gomphidius nigricans thrives in moist coniferous forests, particularly under pine and fir trees, appearing in late summer through fall in New England.",
