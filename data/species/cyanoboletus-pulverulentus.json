  "nameStory": "",
  "description": "The ink stain bolete is a striking fungus characterized by its dark blue-black bruising that appears when the flesh is cut or handled. This bolete is commonly found in New England and belongs to the family Boletaceae, which includes both edible and toxic species.",
  "idTips": [
    {
      "label": "Blue-black bruising",
      "description": "Flesh instantly turns dark blue or blue-black when cut or pressed, creating an ink-like staining effect",
      "isPrimary": true
    },
    {
      "label": "Pore surface color",
      "description": "Yellow pores on the underside of the cap that may also bruise blue when damaged",
      "isPrimary": false
    },
    {
      "label": "Cap appearance",
      "description": "Dark brown to grayish-brown cap with a velvety texture",
      "isPrimary": false
    }
  ],
  "habitat": "The ink stain bolete typically grows on the forest floor in coniferous and mixed woodlands throughout New England, often appearing in summer and early fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The dramatic blue-black bruising occurs due to the oxidation of boletol compounds in the fungal tissue, creating a natural chemical reaction that resembles spilled ink.",
