  "nameStory": "",
  "description": "Graphostroma platystomum is a fungal species in the Graphostromataceae family, characterized by its flattened fruiting structures and dark coloration. This organism plays an important ecological role as a decomposer in New England forests.",
  "idTips": [
    {
      "label": "Flattened Perithecia",
      "description": "The most distinctive feature is the flattened, compressed fruiting bodies (perithecia) that give the species its name 'platystomum' meaning flat-mouthed.",
      "isPrimary": true
    },
    {
      "label": "Dark Coloration",
      "description": "The fruiting structures are typically dark brown to black, making them visible against lighter wood substrates.",
      "isPrimary": false
    },
    {
      "label": "Wood Association",
      "description": "The fungus is found embedded in or on decaying hardwood, particularly on dead branches and logs.",
      "isPrimary": false
    }
  ],
  "habitat": "Graphostroma platystomum thrives in moist forest environments of New England, typically colonizing dead or dying hardwood logs and branches on the forest floor.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a member of the Graphostromataceae family, this fungus produces ascospores within flask-shaped structures that help break down woody plant material, contributing significantly to nutrient cycling in forest ecosystems.",
