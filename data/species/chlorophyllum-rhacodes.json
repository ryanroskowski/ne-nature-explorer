  "nameStory": "",
  "description": "The Shaggy Parasol is a large, distinctive mushroom characterized by its tall stalk and umbrella-like cap covered in shaggy, brownish scales. It belongs to the Lepiota family and is commonly found in woodchips, mulch, and disturbed soils throughout New England.",
  "idTips": [
    {
      "label": "Shaggy Cap Scales",
      "description": "Brown, fibrous scales arranged in concentric rings across the whitish cap surface, becoming more prominent and shaggy toward the center",
      "isPrimary": true
    },
    {
      "label": "Double Ring on Stalk",
      "description": "A distinctive two-part or skirt-like ring (annulus) on the upper stalk that can move freely up and down",
      "isPrimary": false
    },
    {
      "label": "Bruising Reaction",
      "description": "Flesh and gills often stain reddish-brown or orange when bruised or aged, a helpful diagnostic feature",
      "isPrimary": false
    }
  ],
  "habitat": "The Shaggy Parasol thrives in disturbed areas including wood chips, mulch piles, gardens, and landscaped areas throughout New England from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its large, appetizing appearance, the Shaggy Parasol can cause gastrointestinal upset in some people and should never be eaten raw; it must be cooked thoroughly if consumed at all, and many experts recommend avoiding it entirely.",
