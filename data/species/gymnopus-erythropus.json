  "nameStory": "",
  "description": "Gymnopus erythropus is a small, delicate mushroom characterized by its distinctive reddish or pink-tinged stem that gives it its common name. This saprobic fungus belongs to the Omphalotaceae family and is commonly found decomposing woody debris throughout New England.",
  "idTips": [
    {
      "label": "Red or Pink Stems",
      "description": "The most distinctive feature is the bright red or pink coloration on the lower portion of the stem, which contrasts with the pale cap",
      "isPrimary": true
    },
    {
      "label": "Small Size and Cap Shape",
      "description": "Typically has a small, convex to flat pale tan or whitish cap, usually 0.5-1.5 inches in diameter",
      "isPrimary": false
    },
    {
      "label": "Decurrent Gills",
      "description": "Bears pale, narrow gills that extend down the stem and are often connected by cross-veins",
      "isPrimary": false
    }
  ],
  "habitat": "Red-stemmed Gymnopus thrives on rotting hardwood, twigs, and leaf litter in moist forests and woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate appearance, Gymnopus erythropus is a hardy wood-decomposer that can fruit repeatedly on the same substrate throughout the growing season.",
