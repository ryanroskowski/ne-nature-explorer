  "nameStory": "",
  "description": "The streaked clitocybe is a small, delicate mushroom characterized by its pale coloring and distinctive radial streaking on the cap. This fungus belongs to the Waxcaps and Allies family and is commonly found in the moist woodlands and forests of New England.",
  "idTips": [
    {
      "label": "Radial streaks on cap",
      "description": "The defining feature is fine, radiating lines or streaks running from the center to the margin of the pale grayish-brown cap.",
      "isPrimary": true
    },
    {
      "label": "Decurrent gills",
      "description": "The gills are pale and run down the stem in a distinctive decurrent pattern, characteristic of the clitocybe genus.",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "This mushroom is relatively small, typically with caps 1-3 cm in diameter and thin, fragile stems.",
      "isPrimary": false
    }
  ],
  "habitat": "Streaked clitocybe grows in moist woodlands, particularly among leaf litter and mossy areas in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small, inconspicuous appearance, the streaked clitocybe is an important decomposer, playing a crucial role in breaking down dead organic matter in forest ecosystems.",
