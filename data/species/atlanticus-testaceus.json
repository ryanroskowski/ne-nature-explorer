  "nameStory": "",
  "description": "The Protean Shieldback (Atlanticus testaceus) is a cricket-like insect belonging to the katydid family, characterized by its sturdy, compact body and shield-like pronotum. Found throughout New England, this species is primarily nocturnal and is known for its acoustic signals produced during breeding season.",
  "idTips": [
    {
      "label": "Shield-shaped Pronotum",
      "description": "The pronotum (area behind the head) is distinctly broad and shield-like, covering much of the back",
      "isPrimary": true
    },
    {
      "label": "Brown Coloration",
      "description": "Typically tan to dark brown in color with a somewhat flattened body structure",
      "isPrimary": false
    },
    {
      "label": "Short Wings",
      "description": "Wings are reduced in size relative to body length, unlike many other katydids",
      "isPrimary": false
    }
  ],
  "habitat": "Protean Shieldbacks inhabit dry, open areas including fields, meadows, and grasslands with sparse vegetation, preferring sandy or rocky soils throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many katydids known for their loud calls, the Protean Shieldback produces relatively quiet stridulations that are best heard during late summer and early fall nights.",
