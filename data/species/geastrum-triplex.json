  "nameStory": "",
  "description": "The Collared Earthstar is a distinctive puffball fungus characterized by its star-shaped outer layer that peels back to reveal an inner spore sac. Named for the prominent collar-like structure at the base of the inner ball, this species belongs to the Geastraceae family and is commonly found throughout New England.",
  "idTips": [
    {
      "label": "Distinctive Collar",
      "description": "A prominent, raised collar or cup-like structure encircles the base of the inner spore sac, distinguishing it from related earthstar species",
      "isPrimary": true
    },
    {
      "label": "Star-Shaped Rays",
      "description": "The outer layer splits into typically 5-8 pointed rays that fold back star-like, revealing the pale inner ball beneath",
      "isPrimary": false
    },
    {
      "label": "Mouth Opening",
      "description": "The inner spore sac has a distinct opening (mouth) at the top where spores are released when moistened",
      "isPrimary": false
    }
  ],
  "habitat": "Collared Earthstars grow in moist, shaded woodlands, forest floors, and rich soil with abundant leaf litter throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The collar structure acts like a protective ring that helps the fungus maintain moisture and structural integrity as it releases spores through its mouth opening.",
