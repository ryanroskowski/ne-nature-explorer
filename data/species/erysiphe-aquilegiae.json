  "nameStory": "",
  "description": "Erysiphe aquilegiae is a powdery mildew fungus that specifically infects columbine plants (Aquilegia species) throughout New England. This obligate pathogen forms characteristic white, powdery fungal colonies on plant surfaces, reducing photosynthesis and plant vigor.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish powdery coating appears on leaves, stems, and flowers, easily wiped off to reveal affected tissue underneath",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Exclusively found on Aquilegia (columbine) species, making host identification crucial for confirmation",
      "isPrimary": false
    },
    {
      "label": "Cleistothecial Bodies",
      "description": "Microscopic dark, round fruiting bodies (cleistothecia) develop within the fungal coating in late season",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe aquilegiae thrives on columbine plants in moist, cool conditions typical of New England woodland gardens and shaded landscapes, particularly favoring humid springs and early summers.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews that require free water on leaf surfaces, Erysiphe aquilegiae paradoxically prefers relatively dry conditions and can spread effectively in environments where other fungal diseases cannot establish.",
  "confusionNotes": null,
  "contextualKnowledge": null,
