  "nameStory": "",
  "description": "The Ruby Meadowhawk is a small dragonfly in the Skimmer family (Libellulidae) characterized by its brilliant red coloration, making it one of the most recognizable dragonflies in New England. It is a common and widespread species found throughout the region during late summer and fall.",
  "idTips": [
    {
      "label": "Brilliant Red Coloration",
      "description": "Males display a vibrant ruby-red body and wings, while females are more yellow-orange or amber-colored",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "One of the smallest skimmers, with a body length of only 1.2 to 1.5 inches",
      "isPrimary": false
    },
    {
      "label": "Wing Pattern",
      "description": "Clear wings with a distinctive reddish tint at the base in mature males",
      "isPrimary": false
    }
  ],
  "habitat": "Ruby Meadowhawks inhabit shallow ponds, marshes, ditches, and wetlands with emergent vegetation where they hunt for small insects.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many dragonflies that migrate, Ruby Meadowhawks remain in New England year-round, with some individuals surviving into early winter, making them among the last dragonflies seen before cold weather arrives.",
