  "nameStory": "",
  "description": "The Pink Waxcap is a small, delicate fungus characterized by its distinctive pink to reddish coloring and waxy appearance. It belongs to the Waxcaps and Allies family, a group known for their colorful fruiting bodies and preference for grassland ecosystems.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Bright pink to rose-red cap with a waxy, translucent appearance that may fade to pale pink with age",
      "isPrimary": true
    },
    {
      "label": "Gill Structure",
      "description": "Pale pink or whitish gills that are widely spaced and decurrent (running down the stem)",
      "isPrimary": false
    },
    {
      "label": "Waxy Texture",
      "description": "Smooth, waxy surface on both cap and stem that feels slippery when wet and has a characteristic sheen",
      "isPrimary": false
    }
  ],
  "habitat": "Pink Waxcaps are found in moist grasslands, meadows, and mossy areas throughout New England, typically fruiting in late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps are considered indicators of healthy, unimproved grasslands with low nitrogen levels, making them valuable for assessing ecosystem quality and conservation value.",
