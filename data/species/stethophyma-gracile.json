  "nameStory": "",
  "description": "The Graceful Sedge Grasshopper (Stethophyma gracile) is a medium-sized member of the Short-horned Grasshoppers family (Acrididae) found in New England's wetland environments. This species is characterized by its slender build and preference for marshy habitats where sedges and grasses are abundant.",
  "idTips": [
    {
      "label": "Slender body shape",
      "description": "Distinguished by its notably graceful, elongated form compared to other grasshoppers in the region",
      "isPrimary": true
    },
    {
      "label": "Sedge association",
      "description": "Almost exclusively found on or near sedge plants in wetlands, making habitat context important for identification",
      "isPrimary": false
    },
    {
      "label": "Coloration",
      "description": "Displays brown to olive-green coloring that provides camouflage among marsh vegetation",
      "isPrimary": false
    }
  ],
  "habitat": "The Graceful Sedge Grasshopper inhabits freshwater marshes, wetlands, and sedge meadows throughout New England, where it feeds on sedges and other wetland plants.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its preference for wet habitats, this grasshopper can be difficult to locate visually because its coloration and body shape allow it to blend seamlessly with the sedges it inhabits.",
