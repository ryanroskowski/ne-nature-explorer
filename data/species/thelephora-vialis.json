  "nameStory": "",
  "description": "Thelephora vialis is a terrestrial fungus in the Thelephoraceae family, characterized by its funnel-shaped or vase-like fruiting bodies with a distinctive spiny undersurface. This species is commonly found throughout New England and plays an important ecological role as a decomposer in forest ecosystems.",
  "idTips": [
    {
      "label": "Spiny Undersurface",
      "description": "The underside features fine, densely packed spines rather than gills or pores, which is the most reliable diagnostic feature.",
      "isPrimary": true
    },
    {
      "label": "Funnel or Vase Shape",
      "description": "The fruiting body typically forms an irregular funnel or vase-like structure with wavy, lobed margins.",
      "isPrimary": false
    },
    {
      "label": "Dark Brown to Black Coloration",
      "description": "The caps are usually dark brown to blackish, with a somewhat leathery texture and may have a fibrous surface.",
      "isPrimary": false
    }
  ],
  "habitat": "Thelephora vialis grows on soil and among leaf litter in mixed forests, often appearing in disturbed areas, roadsides, and woodland paths throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'vialis' refers to roads or paths, as this species frequently fruiting along trails and disturbed ground makes it one of the more commonly encountered Thelephora species in New England.",
