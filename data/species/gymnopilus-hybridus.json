  "nameStory": "",
  "description": "Gymnopilus hybridus is a small wood-decaying fungus belonging to the Hymenogastraceae family, characterized by its modest fruiting bodies and yellowish coloration. Found throughout New England, it plays an ecological role in decomposing woody substrates in forest ecosystems.",
  "idTips": [
    {
      "label": "Spore Print Color",
      "description": "Produces a rusty-orange to rust-brown spore print, a key distinguishing feature of the genus",
      "isPrimary": true
    },
    {
      "label": "Cap and Stem Appearance",
      "description": "Small caps (typically 1-3 cm) with a yellow to golden-brown color and thin, fragile stems",
      "isPrimary": false
    },
    {
      "label": "Gill Structure",
      "description": "Gills are crowded, thin, and attached to the stem, with a yellowish hue matching the cap",
      "isPrimary": false
    }
  ],
  "habitat": "Gymnopilus hybridus grows on decaying wood, logs, and woody debris in mixed forests throughout New England, preferring damp conditions near forest floors.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Gymnopilus genus are known for their bitter taste and potential psychoactive compounds, though G. hybridus is not typically documented as particularly potent in this regard.",
