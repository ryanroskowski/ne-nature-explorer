  "nameStory": "",
  "description": "The Robust Conehead (Neoconocephalus robustus) is a large katydid named for its distinctively pointed, cone-shaped head and robust body build. It is an insect in the family Tettigoniidae, commonly known as long-horned grasshoppers or katydids, found throughout New England.",
  "idTips": [
    {
      "label": "Cone-shaped Head",
      "description": "The most distinctive feature is the pronounced conical projection of the head, which gives this species its common name.",
      "isPrimary": true
    },
    {
      "label": "Body Size and Build",
      "description": "Robust Coneheads are relatively large katydids with a sturdy, thick-bodied appearance compared to related species.",
      "isPrimary": false
    },
    {
      "label": "Long Antennae",
      "description": "Like all katydids, they possess very long, thread-like antennae that are often longer than their body.",
      "isPrimary": false
    }
  ],
  "habitat": "Robust Coneheads are found in grasslands, meadows, and weedy fields throughout New England, preferring areas with tall vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Robust Coneheads produce loud chirping songs by rubbing their wing covers together, and females can locate them from considerable distances using their specialized hearing organs located on their front legs.",
