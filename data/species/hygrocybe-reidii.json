  "nameStory": "",
  "description": "The Honey Waxcap (Hygrocybe reidii) is a small, delicate mushroom characterized by its distinctive honey-yellow to golden coloring and waxy appearance. This fungus is a member of the Waxcaps and Allies family, known for their gelatinous caps and gills that feel slippery to the touch.",
  "idTips": [
    {
      "label": "Honey-yellow coloring",
      "description": "Distinctive golden to honey-yellow cap and stem that may fade slightly with age",
      "isPrimary": true
    },
    {
      "label": "Waxy, gelatinous texture",
      "description": "Cap and gills have a characteristic slippery, waxy feel when moist",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "Typically produces small fruiting bodies, usually under 2 inches in diameter",
      "isPrimary": false
    }
  ],
  "habitat": "Honey Waxcaps favor grassy areas, meadows, and lawns in New England, particularly in moist conditions during late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps are considered indicators of high-quality, unimproved grasslands, and their presence suggests a healthy, undisturbed ecosystem with minimal pesticide use.",
