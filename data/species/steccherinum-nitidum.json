  "nameStory": "",
  "description": "Steccherinum nitidum is a small, shelf-like wood-decaying fungus characterized by its shiny, cream to pale yellow fruiting bodies and distinctive tooth-like spines on the underside. This species belongs to the Steccherinaceae family and is commonly found throughout New England on dead hardwood.",
  "idTips": [
    {
      "label": "Shiny, Pale Surface",
      "description": "The upper surface is notably glossy and smooth, ranging from cream to pale yellow or tan in color",
      "isPrimary": true
    },
    {
      "label": "Tooth-like Spines",
      "description": "The underside bears small, delicate teeth or spines rather than pores or gills, which are regularly spaced and may branch",
      "isPrimary": false
    },
    {
      "label": "Small, Thin Fruiting Bodies",
      "description": "Brackets are typically small and thin, often resupinate to shelf-like, with a delicate appearance",
      "isPrimary": false
    }
  ],
  "habitat": "Steccherinum nitidum grows on dead hardwood, particularly on decaying logs and branches in moist woodlands and forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The 'nitidum' in its name refers to the fungus's characteristically shiny or glossy appearance, which distinguishes it from related duller species in the genus.",
