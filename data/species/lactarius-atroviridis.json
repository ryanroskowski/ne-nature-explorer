  "nameStory": "",
  "description": "The dark-spotted milkcap is a distinctive mushroom characterized by its dark greenish-gray to blackish cap with prominent darker spots or stains. This fungus belongs to the Lactarius genus, known for producing a milky latex when the gills are damaged.",
  "idTips": [
    {
      "label": "Dark spots on cap",
      "description": "Prominent dark spots or stains covering a greenish-gray to blackish cap surface",
      "isPrimary": true
    },
    {
      "label": "Milk latex color",
      "description": "White to pale yellowish latex that stains or discolors when exposed to air",
      "isPrimary": false
    },
    {
      "label": "Gill attachment",
      "description": "Crowded, pale gills that are decurrent to adnate, becoming stained from the latex",
      "isPrimary": false
    }
  ],
  "habitat": "Dark-spotted milkcaps are found in mixed hardwood and coniferous forests throughout New England, typically fruiting in summer and fall on moist forest floors.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like all milkcaps, Lactarius atroviridis produces a distinctive milky liquid when cut or bruised, which is a key identifying feature and defensive mechanism against insects and other organisms.",
  "confusionNotes": null,
  "contextualKnowledge": null,
