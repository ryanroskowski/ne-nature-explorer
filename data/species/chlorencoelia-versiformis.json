  "nameStory": "",
  "description": "Chlorencoelia versiformis, commonly known as olive-brown cup, is a small fungal species belonging to the Cenangiaceae family that forms distinctive cup-shaped fruiting bodies. Found throughout New England, this wood-decay fungus plays an important ecological role in forest ecosystems by helping decompose dead plant material.",
  "idTips": [
    {
      "label": "Cup Shape and Color",
      "description": "Forms small, olive-brown to dark brown cup-shaped structures (apothecia) that are typically 2-5mm in diameter",
      "isPrimary": true
    },
    {
      "label": "Habitat Association",
      "description": "Grows on decaying hardwood, particularly on sticks and branches in moist conditions",
      "isPrimary": false
    },
    {
      "label": "Spore Characteristics",
      "description": "Produces eight spores per ascus that are colorless and often appear slightly curved or elongated under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Chlorencoelia versiformis thrives on decaying wood and dead branches in moist, shaded forests and woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size, this fungus is a crucial decomposer that helps recycle nutrients back into forest soils, making it an invisible but vital contributor to forest health.",
