  "nameStory": "",
  "description": "Biscogniauxia mediterranea is a wood-decay fungus in the Graphostromataceae family, characterized by its dark, crusty fruiting bodies that form on dead hardwood. This species is notable for its role as a saprotroph, breaking down dead wood in forest ecosystems throughout New England.",
  "idTips": [
    {
      "label": "Dark Stromata",
      "description": "Forms black, irregularly shaped crusty structures on wood surface",
      "isPrimary": true
    },
    {
      "label": "Habitat on Hardwood",
      "description": "Exclusively found on dead branches and logs of hardwood trees",
      "isPrimary": false
    },
    {
      "label": "Perithecia Arrangement",
      "description": "Contains embedded perithecia (flask-shaped fruiting structures) within the dark stroma",
      "isPrimary": false
    }
  ],
  "habitat": "Biscogniauxia mediterranea thrives on dead hardwood substrates in forests, woodlots, and disturbed wooded areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its Mediterranean name, this fungus has expanded its range northward and is now commonly found decomposing dead hardwood in cooler New England forests.",
