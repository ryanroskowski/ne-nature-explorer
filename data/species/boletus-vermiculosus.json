  "nameStory": "",
  "description": "Boletus vermiculosus, commonly known as the Dotted-Stem Bolete, is a medium-sized fungus in the Boletaceae family characterized by its brown cap and distinctive spotted or vermiculated stem. This species is edible and considered choice by many mycophiles in northeastern North America.",
  "idTips": [
    {
      "label": "Vermiculated Stem",
      "description": "The stem features a distinctive pattern of fine lines or dots (vermiculations) that are darker than the base color, creating a worm-like or speckled appearance.",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "The cap is brown to tan, often with a slightly sticky or moist surface, and can reach 4-10 cm in diameter with a convex shape.",
      "isPrimary": false
    },
    {
      "label": "Pore Surface",
      "description": "The underside features small, angular yellow pores that may stain slightly blue-green when bruised, distinguishing it from similar species.",
      "isPrimary": false
    }
  ],
  "habitat": "Boletus vermiculosus grows on the forest floor in association with hardwoods and mixed forests throughout New England, typically fruiting from summer through early fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'vermiculosus' comes from the Latin word for 'worm,' referring to the fine worm-like markings on the stem that make this species relatively easy to identify compared to other brown boletes.",
  "confusionNotes": null,
  "contextualKnowledge": null,
