  "nameStory": "",
  "description": "Yellow Toothcrust (Sarcodontia uda) is a small, gelatinous fungus characterized by its bright yellow coloring and tooth-like or spine-like structures on its undersurface. It belongs to the Meruliaceae family and is commonly found decomposing wood in moist forest environments throughout New England.",
  "idTips": [
    {
      "label": "Bright yellow color",
      "description": "The fruiting body displays a distinctive bright yellow to golden hue that becomes more vibrant when moist",
      "isPrimary": true
    },
    {
      "label": "Gelatinous texture",
      "description": "The fungus has a soft, jelly-like consistency that is elastic and becomes translucent or translucent-yellow when wet",
      "isPrimary": false
    },
    {
      "label": "Tooth-like spines",
      "description": "The underside features small, tooth-like or spine-like projections (hydnoid structures) rather than typical gills or pores",
      "isPrimary": false
    }
  ],
  "habitat": "Yellow Toothcrust grows on dead hardwood branches and logs in damp, shaded forests throughout New England, preferring areas with high moisture and decomposing wood.",
