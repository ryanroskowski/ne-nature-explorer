  "nameStory": "",
  "description": "Sheep Polypore is a small, ground-dwelling fungus characterized by its cream to pale yellow color and delicate pore surface underneath. It forms part of the diverse fungal ecosystem in coniferous and mixed forests throughout New England.",
  "idTips": [
    {
      "label": "Pore Surface",
      "description": "Small, angular pores on the underside that are white to pale yellow and run down the stem",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "Pale cream to pale yellow or brownish cap that is typically 1-3 inches wide",
      "isPrimary": false
    },
    {
      "label": "Stem Attachment",
      "description": "Lateral to eccentric attachment of the stem, meaning it connects off-center or to the side of the cap",
      "isPrimary": false
    }
  ],
  "habitat": "Found fruiting on the forest floor in mossy areas of coniferous and mixed woodlands, particularly under spruce, fir, and pine trees throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size, Sheep Polypore was historically consumed in some European regions and has been studied for potential medicinal compounds.",
