  "nameStory": "",
  "description": "Gymnopilus flavidellus is a small, yellowish mushroom belonging to the Hymenogastraceae family, characterized by its delicate fruiting bodies and distinctive coloration. This fungus is found in New England's forests and woodlands, where it plays a role in wood decomposition.",
  "idTips": [
    {
      "label": "Yellow-Orange Coloration",
      "description": "Pale yellow to golden-yellow caps and stems that are distinctly colored, fading slightly with age",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Miniature fruiting bodies typically under 1 inch in diameter, requiring close inspection to identify",
      "isPrimary": false
    },
    {
      "label": "Gills and Spore Print",
      "description": "Closely spaced gills attached to the stem and a rusty-yellow to ochre spore print",
      "isPrimary": false
    }
  ],
  "habitat": "Gymnopilus flavidellus favors moist hardwood and mixed forests of New England, commonly fruiting on decaying wood, leaf litter, and woody debris in shaded areas.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Gymnopilus genus are known for their bitter taste and some species contain psychoactive compounds, though G. flavidellus toxicity varies and should never be consumed.",
