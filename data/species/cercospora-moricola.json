  "nameStory": "",
  "description": "Mulberry Leaf Spot, caused by the fungus Cercospora moricola, is a foliar disease that affects mulberry trees in New England by creating distinctive lesions on leaves. This fungal pathogen belongs to the Mycosphaerellaceae family and can reduce plant vigor if infections become widespread.",
  "idTips": [
    {
      "label": "Circular Lesions with Dark Borders",
      "description": "Look for small, circular to angular spots with dark brown or black margins and lighter tan centers on mulberry leaves",
      "isPrimary": true
    },
    {
      "label": "Conidial Masses",
      "description": "Fine, dark fungal spore masses may be visible on the undersides of affected leaves, giving them a slightly velvety appearance",
      "isPrimary": false
    },
    {
      "label": "Progressive Leaf Yellowing",
      "description": "Infected leaves often develop yellow halos around lesions before dropping prematurely from the tree",
      "isPrimary": false
    }
  ],
  "habitat": "Cercospora moricola thrives in warm, humid conditions typical of New England summers and prefers moist mulberry foliage, making areas with poor air circulation particularly susceptible.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'Cercospora' comes from the Greek words for 'tail' and 'to bear,' referring to the thread-like structure of the fungal spores that disperse the disease through air and water.",
