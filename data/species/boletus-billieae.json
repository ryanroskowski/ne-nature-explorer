  "nameStory": "",
  "description": "Boletus billieae is a striking bolete fungus characterized by its bright yellow pores and stem, found in New England woodlands. This species is a mycorrhizal fungus that forms beneficial relationships with tree roots.",
  "idTips": [
    {
      "label": "Bright Yellow Pores",
      "description": "The underside features distinctly bright yellow pores that may bruise blue-green when handled or cut",
      "isPrimary": true
    },
    {
      "label": "Yellow Stem with Red Base",
      "description": "The stem is typically yellow with reddish coloring near the base, creating a distinctive two-tone appearance",
      "isPrimary": false
    },
    {
      "label": "Cap Color",
      "description": "The cap is usually brown to tan with a smooth or slightly wrinkled surface",
      "isPrimary": false
    }
  ],
  "habitat": "Boletus billieae grows on forest floors in mixed hardwood and coniferous forests throughout New England, preferring areas with rich soil and established trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many boletes, Boletus billieae forms mycorrhizal partnerships with tree roots, helping trees absorb water and nutrients while receiving sugars in return—a mutually beneficial underground alliance.",
  "confusionNotes": null,
