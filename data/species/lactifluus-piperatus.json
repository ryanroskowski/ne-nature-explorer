  "nameStory": "",
  "description": "The Peppery Milkcap is a small to medium fungus in the Lactifluus genus, characterized by its distinctive peppery taste and white latex that stains yellow. It is a common woodland mushroom found throughout New England and is inedible due to its acrid, peppery flavor.",
  "idTips": [
    {
      "label": "White Latex Reaction",
      "description": "Produces white milk that slowly stains yellow or brown when cut or bruised, distinguishing it from similar species",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Features a smooth, white to pale gray cap that may develop buff or yellowish tones with age",
      "isPrimary": false
    },
    {
      "label": "Taste Test",
      "description": "Known for an intensely peppery, acrid taste that persists on the tongue (spit out after testing)",
      "isPrimary": false
    }
  ],
  "habitat": "Peppery Milkcaps grow in mixed hardwood and coniferous forests throughout New England, appearing from summer through fall in rich, moist soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'piperatus' refers to its peppery taste, which can be so intense that even a tiny piece left on the tongue will cause a burning sensation for several minutes.",
