  "nameStory": "",
  "description": "Handsome Club (Clavulinopsis laeticolor) is a striking coral fungus belonging to the antler and spindle fungi family, characterized by its vibrant golden-yellow to orange coloring. This small, club-shaped fungus is found in woodlands and grasslands throughout New England, where it plays a role in the forest ecosystem.",
  "idTips": [
    {
      "label": "Bright Yellow-Orange Color",
      "description": "The most distinctive feature is its vivid golden-yellow to orange coloration that makes it stand out among leaf litter and moss.",
      "isPrimary": true
    },
    {
      "label": "Club or Spindle Shape",
      "description": "The fruiting body is unbranched or minimally branched, forming a simple club or spindle shape, typically 2-4 inches tall.",
      "isPrimary": false
    },
    {
      "label": "Smooth Surface",
      "description": "The surface is smooth and somewhat waxy-looking, distinguishing it from rougher coral fungi species.",
      "isPrimary": false
    }
  ],
  "habitat": "Handsome Club thrives in moist woodlands, particularly among mosses and leaf litter on the forest floor and in grassy areas.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its appetizing appearance, Handsome Club is not widely consumed and may cause gastrointestinal upset, making proper species identification crucial for foragers.",
