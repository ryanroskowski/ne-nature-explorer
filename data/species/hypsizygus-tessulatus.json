  "nameStory": "",
  "description": "The Beech Mushroom (Hypsizygus tessulatus) is a small, delicate fungus characterized by its clustered growth pattern and pale coloring. Originally cultivated in Japan, it has naturalized in New England woodlands and is prized for its mild, slightly nutty flavor in culinary applications.",
  "idTips": [
    {
      "label": "Clustered Growth",
      "description": "Fruiting bodies grow in dense clusters or tufts from a common base, rarely appearing singly",
      "isPrimary": true
    },
    {
      "label": "Cap Color and Size",
      "description": "Small caps (1-3 cm) that are whitish to pale brown with a delicate, often slightly wrinkled texture",
      "isPrimary": false
    },
    {
      "label": "Gill Arrangement",
      "description": "Gills are decurrent (running down the stem), closely spaced, and white to cream-colored",
      "isPrimary": false
    }
  ],
  "habitat": "Beech Mushrooms fruit on hardwood logs and stumps, particularly beech and other deciduous trees, in moist woodlands throughout New England from late spring through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its common name referencing beech trees, Hypsizygus tessulatus is not exclusive to beech and readily colonizes various hardwoods; it is also commercially cultivated worldwide and is commonly sold in grocery stores as a gourmet mushroom.",
