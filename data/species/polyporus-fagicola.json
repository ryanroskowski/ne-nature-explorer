  "nameStory": "",
  "description": "Polyporus fagicola is a small bracket fungus that grows on dead hardwood, particularly beech trees, throughout New England. It is a decomposer that plays an important role in breaking down woody material in forest ecosystems.",
  "idTips": [
    {
      "label": "Host Preference",
      "description": "Grows almost exclusively on dead beech wood (Fagus species), which is reflected in its scientific name",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Forms small, delicate brackets typically 1-3 inches wide with a thin, shelf-like structure",
      "isPrimary": false
    },
    {
      "label": "Pore Surface",
      "description": "Displays fine, small angular pores on the underside that are initially white to cream-colored, aging to brown",
      "isPrimary": false
    }
  ],
  "habitat": "Polyporus fagicola is found on dead or dying beech logs and branches in moist hardwood forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The fungus is so specialized in its preference for beech wood that it is considered a reliable indicator of beech presence in forest ecosystems and is rarely found on any other tree species.",
