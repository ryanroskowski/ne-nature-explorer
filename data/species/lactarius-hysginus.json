  "nameStory": "",
  "description": "Lactarius hysginus, commonly known as the dyed milkcap, is a small to medium-sized fungus belonging to the Russulaceae family, characterized by its distinctive coloring and milk-like latex. This species is inedible and notable for its chemical properties that produce color changes when exposed to certain reagents.",
  "idTips": [
    {
      "label": "Latex color and staining",
      "description": "Produces white to pale latex that stains tissues and bruised areas reddish or vinaceous brown, a distinctive feature of this species",
      "isPrimary": true
    },
    {
      "label": "Cap appearance",
      "description": "Small cap (1-3 inches) with pale to grayish-tan coloring, often with subtle zoning or mottling, and a slightly depressed center",
      "isPrimary": false
    },
    {
      "label": "Gill characteristics",
      "description": "Close, narrow gills that are pale or whitish, sometimes with a slight pinkish tint, and run down the stem",
      "isPrimary": false
    }
  ],
  "habitat": "Found in mixed hardwood and conifer forests throughout New England, typically fruiting from summer through fall in moist, well-established woodland areas with rich organic soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The latex of Lactarius hysginus reacts dramatically with ferric salts (FeSO₄), turning deep blue-green, making it useful for chemical identification in the field.",
  "confusionNotes": null,
