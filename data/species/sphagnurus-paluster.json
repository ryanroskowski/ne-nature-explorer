  "nameStory": "",
  "description": "The sphagnum greyling is a small mushroom in the Lyophyllaceae family characterized by its delicate, greyish-brown appearance and preference for acidic environments. This fungus plays an important ecological role in New England's boggy and wetland ecosystems where sphagnum moss thrives.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Small, grey to brownish-grey convex cap, often with a slightly darker center",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Gills are close to crowded and whitish to pale grey, running nearly to the stem",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Found exclusively or nearly exclusively on sphagnum moss in wet, acidic conditions",
      "isPrimary": false
    }
  ],
  "habitat": "The sphagnum greyling is specialized for New England's sphagnum-dominated wetlands, bogs, and acidic moist forests where it fruits directly from moss carpets.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This mushroom's intimate association with sphagnum moss makes it an indicator species for healthy, undisturbed bog ecosystems in New England.",
