  "nameStory": "",
  "description": "Oyster Rollrim (Tapinella panuoides) is a small, bracket-like fungus characterized by its distinctive rolled or inturned margins and pale coloring. This wood-decay fungus belongs to the Tapinellaceae family and is commonly found on dead hardwood and softwood throughout New England.",
  "idTips": [
    {
      "label": "Rolled Margins",
      "description": "The cap edges characteristically curl or roll inward, creating a distinctive rim that gives the species its common name.",
      "isPrimary": true
    },
    {
      "label": "Decurrent Gills",
      "description": "The fungus features thin, crowded gills that run down the stem and are typically pale tan to whitish in color.",
      "isPrimary": false
    },
    {
      "label": "Size and Shape",
      "description": "Small brackets or shelf-like fruiting bodies, typically 1-4 cm across, growing in overlapping clusters on wood.",
      "isPrimary": false
    }
  ],
  "habitat": "Tapinella panuoides grows on decaying logs, stumps, and dead branches of both hardwoods and conifers in moist forests and woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite resembling gilled mushrooms, Tapinella panuoides belongs to an ancient fungal lineage and lacks the typical basidiomycete characteristics found in most familiar gill fungi.",
