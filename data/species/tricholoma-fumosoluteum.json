  "nameStory": "",
  "description": "Tricholoma fumosoluteum is a medium-sized mushroom characterized by its smoky gray to brownish cap and distinctive pale gills. This woodland fungus is part of the Tricholomataceae family and is found in New England's mixed and coniferous forests.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Smoky gray to grayish-brown cap with a somewhat fibrous or streaked appearance",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Pale yellowish to whitish gills that are adnate (attached) to the stem",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Whitish to pale gray stem with a fibrous texture, often with a faint ring or ring zone",
      "isPrimary": false
    }
  ],
  "habitat": "Tricholoma fumosoluteum typically grows on the forest floor in mixed deciduous and coniferous woodlands, often fruiting in fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many Tricholoma species, this fungus forms mycorrhizal relationships with tree roots, making it an important part of New England forest ecosystems.",
