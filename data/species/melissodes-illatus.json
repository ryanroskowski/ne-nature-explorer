  "nameStory": "",
  "description": "The Valiant Long-horned Bee (Melissodes illatus) is a solitary bee species belonging to the family Apidae, native to eastern North America including New England. These medium-sized bees are important native pollinators that visit a variety of wildflowers and cultivated plants during summer months.",
  "idTips": [
    {
      "label": "Elongated Head",
      "description": "Males possess notably long antennae that extend well beyond the body length, giving the bee its 'long-horned' common name",
      "isPrimary": true
    },
    {
      "label": "Body Color",
      "description": "Typically dark brown to black with sparse, fine body hair and a somewhat lean appearance compared to bumble bees",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Medium-sized bee, approximately 12-15 mm in length, smaller than bumble bees but larger than many other native bees",
      "isPrimary": false
    }
  ],
  "habitat": "Valiant Long-horned Bees prefer open, sunny areas with abundant flowering plants such as meadows, prairies, gardens, and field margins throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Valiant Long-horned Bees use their exceptionally long antennae to detect pheromones from females, allowing them to locate mates over considerable distances.",
