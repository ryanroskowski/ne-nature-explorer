  "nameStory": "",
  "description": "Hypomyces microspermus is a parasitic fungus in the Hypocreaceae family that infects and colonizes other fungi, particularly gill fungi in forest ecosystems. Found throughout New England, this hyperparasite plays an important ecological role in fungal communities by limiting the spread of its host fungi.",
  "idTips": [
    {
      "label": "Host relationship",
      "description": "Appears as a bright colored (often orange or red) powdery or crusty coating on the gills and surfaces of infected mushrooms",
      "isPrimary": true
    },
    {
      "label": "Microscopic features",
      "description": "Produces characteristic small, single-celled spores (conidia) that give the fungus its species name 'microspermus' meaning tiny-seeded",
      "isPrimary": false
    },
    {
      "label": "Host specificity",
      "description": "Primarily parasitizes gill fungi and other basidiomycetes in moist forest conditions",
      "isPrimary": false
    }
  ],
  "habitat": "Hypomyces microspermus thrives in the moist, shaded forest floors of New England where decomposing wood and fungi are abundant year-round.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Rather than producing fruiting bodies of its own, Hypomyces microspermus hijacks its host mushroom's reproductive structures, essentially creating a 'mummified' fungus that spreads its spores instead of the original host's spores.",
  "confusionNotes": null,
