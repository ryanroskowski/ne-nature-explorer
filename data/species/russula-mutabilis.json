  "nameStory": "",
  "description": "The Orange Bile Mushroom is a medium-sized brittlegill fungus characterized by its variable orange to reddish cap and notably bitter taste. It belongs to the Russula genus, known for their brittle, easily breaking gills and stems.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Orange to reddish cap that may fade or change color with age, giving the species its 'mutabilis' (changeable) name",
      "isPrimary": true
    },
    {
      "label": "Bitter Taste Test",
      "description": "When a small piece is placed on the tongue and spit out, it produces an intensely bitter taste (do not swallow)",
      "isPrimary": false
    },
    {
      "label": "Brittle Gills",
      "description": "White to pale cream-colored gills that are characteristic of Russula species and break easily when handled",
      "isPrimary": false
    }
  ],
  "habitat": "Found in deciduous and mixed forests throughout New England, typically fruiting in summer and fall near hardwood trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Russula comes from the Latin word 'russus' meaning 'red,' reflecting the vibrant coloring common in many species within this genus.",
  "confusionNotes": null,
