  "nameStory": "",
  "description": "The Oak Hairstreak is a small butterfly belonging to the Gossamer-winged Butterflies family, characterized by delicate wings and intricate patterns. This species is found throughout New England and plays an important role in oak forest ecosystems.",
  "idTips": [
    {
      "label": "Tail-like Extensions",
      "description": "Look for distinctive hair-like tails on the hindwings, which give the hairstreak family its common name.",
      "isPrimary": true
    },
    {
      "label": "Gray-Brown Coloration",
      "description": "The wings display muted gray-brown tones on the underside with subtle spot patterns and white markings.",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "These butterflies are quite tiny with a wingspan of approximately 0.9 to 1.1 inches.",
      "isPrimary": false
    }
  ],
  "habitat": "Oak Hairstreaks thrive in oak woodlands and forests throughout New England, preferring areas with abundant oak trees where their caterpillars feed.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The caterpillars of Oak Hairstreaks are attended by ants that protect them from predators in exchange for sweet secretions produced by the caterpillars.",
