  "nameStory": "",
  "description": "Corticium roseum is a small, delicate fungus belonging to the Corticiaceae family, characterized by its distinctive pink or rosy-colored fruiting surface. It is a wood-decay fungus commonly found on decaying hardwood substrates throughout New England.",
  "idTips": [
    {
      "label": "Pink to Rosy Coloration",
      "description": "The fruiting surface displays a pale pink to rosy-red color that is distinctive and easily recognizable in the field.",
      "isPrimary": true
    },
    {
      "label": "Smooth, Waxy Texture",
      "description": "The hymenial surface appears smooth and slightly waxy or gelatinous when fresh, lacking gill or pore structures.",
      "isPrimary": false
    },
    {
      "label": "Thin, Effused Growth",
      "description": "The fungus grows as a thin, crust-like layer that spreads across wood surfaces rather than forming distinct fruiting bodies.",
      "isPrimary": false
    }
  ],
  "habitat": "Corticium roseum grows on dead or decaying hardwood, particularly in moist, shaded forest environments and wooded areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The pink pigmentation in Corticium roseum is thought to serve as a UV protectant, helping the delicate fungus survive exposure on exposed wood surfaces.",
