  "nameStory": "",
  "description": "The Spotted Bird Grasshopper (Schistocerca lineata) is a medium-sized grasshopper belonging to the Short-horned Grasshoppers family (Acrididae), found throughout New England and eastern North America. It is named for the distinctive spotted pattern on its body and wings that resembles bird markings.",
  "idTips": [
    {
      "label": "Spotted wing pattern",
      "description": "Dark spots or mottled markings on the wings and body are the most distinctive feature",
      "isPrimary": true
    },
    {
      "label": "Size and build",
      "description": "Medium-sized grasshopper, typically 1.5-2 inches long, with a robust body",
      "isPrimary": false
    },
    {
      "label": "Coloration",
      "description": "Brown or tan base color with darker patterns and spots throughout the body",
      "isPrimary": false
    }
  ],
  "habitat": "The Spotted Bird Grasshopper prefers open grasslands, meadows, fields, and prairie-like areas with low to medium vegetation in New England.",
