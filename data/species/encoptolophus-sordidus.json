  "nameStory": "",
  "description": "The Clouded Grasshopper (Encoptolophus sordidus) is a medium-sized member of the Short-horned Grasshoppers family (Acrididae) found throughout New England. It is named for its distinctly mottled and clouded appearance, which provides effective camouflage in its natural environment.",
  "idTips": [
    {
      "label": "Clouded coloration",
      "description": "Dark brown to gray body with distinctive cloudy, mottled patterns that create a speckled appearance",
      "isPrimary": true
    },
    {
      "label": "Body size",
      "description": "Medium-sized grasshopper, typically 18-25 mm in length",
      "isPrimary": false
    },
    {
      "label": "Short antennae",
      "description": "Characteristic short antennae typical of short-horned grasshoppers in the Acrididae family",
      "isPrimary": false
    }
  ],
  "habitat": "This species prefers dry, open grasslands and field margins throughout New England, often found in areas with sparse vegetation and sandy or gravelly soils.",
