  "nameStory": "",
  "description": "Craterellus caeruleofuscus, commonly known as the blue-footed chanterelle or smoky chanterelle, is a small funnel-shaped mushroom characterized by its dark bluish-gray coloring and false gills. This species belongs to the Hydnaceae family and is a choice edible mushroom found throughout New England's forests.",
  "idTips": [
    {
      "label": "Color",
      "description": "Distinctive dark bluish-gray to smoky brown cap and stem, which darkens with age or when bruised",
      "isPrimary": true
    },
    {
      "label": "False Gills",
      "description": "Ridges (not true gills) that are blunt, forked, and run down the stem, typically lighter in color than the cap",
      "isPrimary": false
    },
    {
      "label": "Funnel Shape",
      "description": "Cup or funnel-shaped fruiting body with inrolled edges when young, becoming more wavy and irregular at maturity",
      "isPrimary": false
    }
  ],
  "habitat": "Craterellus caeruleofuscus fruits in mixed hardwood and conifer forests of New England, typically appearing in summer and fall on mossy ground and leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike toxic look-alikes such as the false chanterelle, this species has blunt, forked ridges that run down the stem, making it a reliable and safe edible once properly identified.",
