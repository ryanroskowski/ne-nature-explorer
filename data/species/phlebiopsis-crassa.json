  "nameStory": "",
  "description": "Phlebiopsis crassa is a wood-decay fungus in the Phanerochaetaceae family, characterized by its thick, fleshy fruiting bodies. This species plays an important ecological role in decomposing dead wood in forest ecosystems throughout New England.",
  "idTips": [
    {
      "label": "Thick, Fleshy Texture",
      "description": "The fruiting body is notably thick and robust, unlike the thin, delicate structures of many related species",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "Features a distinctive pore surface (not gills) that is initially whitish to cream-colored, often becoming bruised or discolored with age",
      "isPrimary": false
    },
    {
      "label": "Growth Pattern",
      "description": "Typically grows in shelf-like or bracket formations on hardwood logs and dead trees",
      "isPrimary": false
    }
  ],
  "habitat": "Phlebiopsis crassa thrives on decaying hardwood logs and dead trees in moist, shaded forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a member of the white-rot fungi group, Phlebiopsis crassa produces powerful enzymes that break down lignin, one of the most difficult organic compounds to decompose in nature.",
