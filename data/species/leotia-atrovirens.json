  "nameStory": "",
  "description": "Leotia atrovirens is a small, gelatinous fungus in the Leotiaceae family characterized by its dark greenish to blackish coloration. It is found in moist woodlands throughout New England and fruits during summer and fall months.",
  "idTips": [
    {
      "label": "Dark Coloration",
      "description": "The fruiting body is distinctly dark greenish-black to nearly black, which distinguishes it from lighter Leotia species.",
      "isPrimary": true
    },
    {
      "label": "Gelatinous Texture",
      "description": "The cap and stem have a distinctly slimy, gelatinous consistency, especially when moist.",
      "isPrimary": false
    },
    {
      "label": "Wrinkled Cap",
      "description": "The cap surface is characteristically wrinkled or folded rather than smooth, with a mitre-like or brain-like appearance.",
      "isPrimary": false
    }
  ],
  "habitat": "Leotia atrovirens grows in rich, moist forest humus and decaying leaf litter in deciduous and mixed woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'atrovirens' means 'dark green,' referring to the species' distinctive dark coloration that makes it notably darker than its closest relatives in the genus.",
