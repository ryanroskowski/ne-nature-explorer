  "nameStory": "",
  "description": "Hydnellum scrobiculatum, commonly known as Ridged Tooth, is a wood-decomposing fungus characterized by its distinctive spiny undersurface rather than typical gills or pores. This species belongs to the Boletopsidaceae family and plays an important ecological role in New England forests by breaking down dead wood.",
  "idTips": [
    {
      "label": "Spiny Undersurface",
      "description": "The underside features prominent tooth-like spines (hydnoid structures) that are distinctive of the Hydnellum genus, distinguishing it from boletes and other fungi",
      "isPrimary": true
    },
    {
      "label": "Cap Texture",
      "description": "The cap surface is typically dark brown to grayish-brown with a somewhat scrobiculate (pitted or furrowed) texture, giving it a distinctive wrinkled appearance",
      "isPrimary": false
    },
    {
      "label": "Brittle Flesh",
      "description": "The flesh is fragile and brittle, breaking apart easily when handled, with a color that may stain or bruise darker when cut",
      "isPrimary": false
    }
  ],
  "habitat": "Hydnellum scrobiculatum is found in New England forests, typically growing on well-decayed hardwood or softwood logs and woody debris in moist woodland environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their tooth-like spines resembling those of edible hedgehog mushrooms, Hydnellum species like H. scrobiculatum are not palatable and are primarily of interest to mycologists and fungi enthusiasts rather than foragers.",
