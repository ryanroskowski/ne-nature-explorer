  "nameStory": "",
  "description": "The Texas Leafcutter Bee (Megachile texana) is a solitary bee species belonging to the Megachilidae family, known for its distinctive leaf-cutting behavior used to construct nesting cells. This medium-sized bee is adapted to various environments across New England and uses cut leaf pieces to line and seal its brood cells.",
  "idTips": [
    {
      "label": "Leaf-Cutting Behavior",
      "description": "Observable habit of cutting precise, semicircular pieces from plant leaves using their strong mandibles",
      "isPrimary": true
    },
    {
      "label": "Body Size and Color",
      "description": "Medium-sized bee (10-12mm) with a dark body, often appearing black or dark brown with lighter abdominal bands",
      "isPrimary": false
    },
    {
      "label": "Pollen Brush",
      "description": "Dense scopal hairs (pollen-collecting brush) on the underside of the abdomen that appear as a distinctive light-colored patch",
      "isPrimary": false
    }
  ],
  "habitat": "Texas Leafcutter Bees thrive in open woodlands, gardens, meadows, and areas with diverse flowering plants and suitable host plants for leaf-cutting in New England's temperate climate.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female Texas Leafcutter Bees are master architects—they can cut leaf pieces with remarkable precision and arrange them like shingles inside hollow stems or cavities to create individual brood cells for their offspring.",
  "confusionNotes": null,
  "contextualKnowledge": null,
