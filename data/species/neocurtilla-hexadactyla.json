  "nameStory": "",
  "description": "The Northern Mole Cricket (Neocurtilla hexadactyla) is a burrowing insect belonging to the Orthoptera order, not actually a plant as commonly misunderstood. This cricket is adapted for underground life with powerful front legs and a cylindrical body, found in the northeastern United States including New England.",
  "idTips": [
    {
      "label": "Powerful Front Legs",
      "description": "Enlarged, shovel-like front legs with multiple claws used for digging and burrowing",
      "isPrimary": true
    },
    {
      "label": "Cylindrical Body Shape",
      "description": "Compact, elongated body built for tunnel movement, distinct from typical crickets",
      "isPrimary": false
    },
    {
      "label": "Cerci and Ovipositor",
      "description": "Long, slender cerci at the rear end and a visible ovipositor in females",
      "isPrimary": false
    }
  ],
  "habitat": "Northern Mole Crickets inhabit moist soils in gardens, fields, and grasslands throughout New England, preferring areas near water sources where they tunnel beneath the surface.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Northern Mole Crickets produce a distinctive chirping sound by rubbing their wings together while positioned in their underground burrows, which acts as a natural amplifier for their calls.",
