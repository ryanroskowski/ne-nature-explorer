  "nameStory": "",
  "description": "Tricholoma davisiae is a terrestrial mushroom in the Tricholomataceae family, characterized by its distinctive appearance and woodland habitat associations. This species is found in New England forests and is of interest to mycologists studying regional fungal diversity.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Grayish to brownish cap with a fibrillose or slightly scaly surface",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Adnate to slightly decurrent gills that are typically whitish or pale in color",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Solid, cylindrical stem with a pale base and possible slight striations near the apex",
      "isPrimary": false
    }
  ],
  "habitat": "Tricholoma davisiae occurs in mixed deciduous and coniferous forests throughout New England, typically fruiting in autumn among leaf litter and forest floor debris.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many Tricholoma species, T. davisiae has been historically difficult to distinguish from related species without microscopic examination, making it a valuable subject for modern DNA barcoding studies in fungal taxonomy.",
