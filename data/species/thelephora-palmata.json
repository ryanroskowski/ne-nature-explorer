  "nameStory": "",
  "description": "Thelephora palmata, commonly known as stinking earthfan, is a terrestrial fungus belonging to the Thelephoraceae family, characterized by its distinctive fan or spatula-shaped fruiting bodies. Despite its unpleasant odor, this species plays an important ecological role as a decomposer in forest ecosystems.",
  "idTips": [
    {
      "label": "Fruiting Body Shape",
      "description": "Distinctive fan-shaped or spatula-like fruiting bodies that are often divided into lobes, resembling an open hand or palm",
      "isPrimary": true
    },
    {
      "label": "Spore-Bearing Surface",
      "description": "The undersurface consists of tooth-like projections or ridges rather than gills, which is characteristic of the Thelephoraceae family",
      "isPrimary": false
    },
    {
      "label": "Odor",
      "description": "Distinctive unpleasant or acrid smell that gives this species its common name",
      "isPrimary": false
    }
  ],
  "habitat": "Thelephora palmata is found in moist, acidic forest soils, particularly in coniferous and mixed forests throughout New England, often appearing in mossy areas and on decaying wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'earthfan' refers to its fan-like appearance, while 'stinking' references its distinctive acrid odor that can intensify when the fruiting bodies are handled or disturbed.",
