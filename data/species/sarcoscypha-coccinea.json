  "nameStory": "",
  "description": "Scarlet Cup (Sarcoscypha coccinea) is a striking fungus featuring brilliant red, cup-shaped fruiting bodies that emerge in early spring. This small fungus is a saprotroph, feeding on decaying wood in moist forest environments.",
  "idTips": [
    {
      "label": "Scarlet Red Interior",
      "description": "The inner surface of the cup is vivid scarlet to crimson red, which is the most distinctive and diagnostic feature of this species.",
      "isPrimary": true
    },
    {
      "label": "Cup Shape",
      "description": "The fruiting body forms a distinctive cup or goblet shape, typically 0.5 to 2 inches wide, with a smooth rim.",
      "isPrimary": false
    },
    {
      "label": "Pale Exterior",
      "description": "The outside of the cup is much paler, usually white to pale pink or tan, contrasting sharply with the brilliant red interior.",
      "isPrimary": false
    }
  ],
  "habitat": "Scarlet Cup grows on decaying hardwood logs and branches in moist, shaded woodlands and along streams throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The bright red color of Scarlet Cup may serve to attract insects that help disperse its spores, making it one of nature's most visually striking spring fungi.",
