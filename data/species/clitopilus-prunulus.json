  "nameStory": "",
  "description": "Clitopilus prunulus, commonly known as the Sweetbread Mushroom, is a small to medium-sized fungus characterized by its delicate appearance and distinctive fruity aroma. This edible species is valued by foragers in New England for its pleasant almond-like scent and mild flavor.",
  "idTips": [
    {
      "label": "Pink Gills",
      "description": "Mature specimens display distinctive pink or salmon-colored gills that run down the stem, a key feature of the Entolomataceae family",
      "isPrimary": true
    },
    {
      "label": "Fruity Aroma",
      "description": "The mushroom emits a pleasant, sweet almond-like or fruity smell that is characteristic and helps distinguish it from similar species",
      "isPrimary": false
    },
    {
      "label": "Cap Appearance",
      "description": "Pale gray to whitish convex cap that becomes depressed with age, typically 2-6 cm in diameter with a fine, velvety surface",
      "isPrimary": false
    }
  ],
  "habitat": "Clitopilus prunulus thrives in mixed hardwood and coniferous forests throughout New England, preferring moist soil rich in leaf litter and organic matter, typically fruiting in summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'prunulus' refers to its plum-like appearance, and it was historically prized in European cuisine as a delicacy before modern identification standards were established.",
