  "nameStory": "",
  "description": "Cystoderma aureum, commonly known as the Golden Cap, is a small terrestrial mushroom characterized by its distinctive golden-yellow to orange coloring and granular surface texture. This member of the Squamanitaceae family is found throughout New England, typically appearing in summer and fall months in various woodland and grassland settings.",
  "idTips": [
    {
      "label": "Golden coloration",
      "description": "Caps display a bright golden-yellow to orange hue, which gives the species its common name",
      "isPrimary": true
    },
    {
      "label": "Granular surface",
      "description": "The cap has a distinctive finely granular or scaly texture that feels velvety to the touch",
      "isPrimary": false
    },
    {
      "label": "Attached gills",
      "description": "Gills are pale yellow to white and are attached or slightly decurrent on the stem",
      "isPrimary": false
    }
  ],
  "habitat": "Golden Caps are found in well-drained soils of mixed woodlands, coniferous forests, and grassy areas throughout New England, often appearing in clusters or rings.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The granular texture on the cap of Cystoderma aureum is composed of specialized cells that help protect the mushroom from drying out in exposed habitats.",
