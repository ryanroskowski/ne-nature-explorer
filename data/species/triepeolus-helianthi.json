  "nameStory": "",
  "description": "The Sunflower Cuckoo Nomad Bee (Triepeolus helianthi) is a small, solitary cuckoo bee native to New England that parasitizes other bee species rather than building its own nests. Despite its name, it is not actually a plant but a bee species in the family Apidae, known for its nomadic lifestyle and association with sunflower habitats.",
  "idTips": [
    {
      "label": "Cuckoo bee morphology",
      "description": "Small bee (8-10mm) with a smooth, shiny exoskeleton lacking the dense hair covering typical of pollen-collecting bees",
      "isPrimary": true
    },
    {
      "label": "Coloration pattern",
      "description": "Dark body with distinctive yellow or reddish-orange markings on the face and abdomen segments",
      "isPrimary": false
    },
    {
      "label": "Host association",
      "description": "Commonly observed in or near sunflower patches where its host bees (particularly Melissodes species) are active",
      "isPrimary": false
    }
  ],
  "habitat": "This species is found in sunny, open areas across New England, particularly in fields and gardens where sunflowers and other composite flowers bloom during late summer and fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Triepeolus helianthi is a cleptoparasite that lays its eggs in the nests of host bees; the cuckoo bee larvae consume the host's pollen provisions, essentially stealing resources for their development.",
