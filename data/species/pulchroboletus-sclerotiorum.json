  "nameStory": "",
  "description": "Whitey's Bolete is a striking fungus characterized by its white or pale pores that bruise blue and a robust, bulbous stem base. This bolete is prized by foragers in New England for its firm flesh and excellent culinary quality.",
  "idTips": [
    {
      "label": "Pore Color and Bruising",
      "description": "White to cream-colored pores on the underside that distinctly turn blue when handled or cut",
      "isPrimary": true
    },
    {
      "label": "Stem Characteristics",
      "description": "Thick, pale stem with a prominent bulbous base and fine red or pink netting in the upper portion",
      "isPrimary": false
    },
    {
      "label": "Cap Appearance",
      "description": "Brown to reddish-brown cap that is dry and velvety when young, with a robust overall structure",
      "isPrimary": false
    }
  ],
  "habitat": "Whitey's Bolete grows in mixed hardwood and coniferous forests throughout New England, particularly favoring oak and beech associates from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their appearance, Whitey's Boletes are completely edible and considered choice edibles by experienced mushroom hunters, making them one of the most sought-after boletes in the region.",
