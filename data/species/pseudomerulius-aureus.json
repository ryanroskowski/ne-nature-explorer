  "nameStory": "",
  "description": "Pseudomerulius aureus, commonly known as the golden false merulius, is a wood-decay fungus in the Tapinellaceae family that produces distinctive golden-yellow fruiting bodies. This polypore species is found throughout New England where it plays an important ecological role in decomposing hardwood substrates.",
  "idTips": [
    {
      "label": "Golden-yellow coloration",
      "description": "The fruiting body displays a distinctive bright golden-yellow to orange-yellow color on both the cap surface and underside",
      "isPrimary": true
    },
    {
      "label": "Waxy pore surface",
      "description": "The underside features small, angular pores that feel waxy or gelatinous to the touch, often appearing somewhat irregular or wrinkled",
      "isPrimary": false
    },
    {
      "label": "Bracket or fan shape",
      "description": "Fruiting bodies typically grow as overlapping shelves or brackets on wood, with a soft to gelatinous texture",
      "isPrimary": false
    }
  ],
  "habitat": "Pseudomerulius aureus grows on dead or dying hardwood logs and branches, particularly on oak and maple, in moist woodlands and forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The gelatinous pore layer of this fungus can absorb and release water based on humidity levels, making it more resilient to drying conditions than many other wood-decay fungi.",
