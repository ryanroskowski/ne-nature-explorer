  "nameStory": "",
  "description": "Osmia distincta, commonly known as the Beardtongue scraper bee, is a small native bee species in the Megachilidae family that specializes in collecting pollen from beardtongue flowers. This solitary bee is an important pollinator found throughout New England and plays a crucial role in plant reproduction.",
  "idTips": [
    {
      "label": "Specialized Pollen Baskets",
      "description": "This species has dense scopae (hair brushes) on its hind legs adapted specifically for scraping pollen from beardtongue flowers",
      "isPrimary": true
    },
    {
      "label": "Metallic Blue-Green Coloration",
      "description": "Osmia distincta displays a distinctive iridescent blue-green body typical of many mason bees in the genus",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "This bee is relatively small, typically measuring 8-10 mm in length, making it one of the more petite mason bee species",
      "isPrimary": false
    }
  ],
  "habitat": "Osmia distincta thrives in open woodlands, meadows, and gardens throughout New England where beardtongue plants (Penstemon species) bloom in spring and early summer.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This bee is so specialized in its foraging behavior that it almost exclusively visits beardtongue flowers, demonstrating remarkable floral fidelity and co-evolutionary adaptation with its preferred plant host.",
