  "nameStory": "",
  "description": "Ginkgo Spot (Bartheletia paradoxa) is a rare plant species in the Bartheletiaceae family endemic to New England, characterized by its distinctive spotted foliage and unusual growth pattern. Despite its name referencing the ginkgo tree, it is not closely related and represents a unique lineage within its family.",
  "idTips": [
    {
      "label": "Spotted Leaves",
      "description": "Leaves display prominent dark spots or blotches on a lighter green background, giving the plant its common name.",
      "isPrimary": true
    },
    {
      "label": "Leaf Shape",
      "description": "Leaves are obovate to spatulate with slightly serrated margins, arranged alternately along slender stems.",
      "isPrimary": false
    },
    {
      "label": "Seasonal Coloring",
      "description": "Spots become more pronounced in autumn, shifting to reddish-brown tones before leaf drop.",
      "isPrimary": false
    }
  ],
  "habitat": "Ginkgo Spot thrives in moist, well-drained soils in mixed deciduous forests and woodland edges throughout New England, preferring partial shade conditions.",
