  "nameStory": "",
  "description": "Mountain Laurel Leaf Blight, caused by Diaporthe kalmiae, is a fungal disease that affects mountain laurel (Kalmia latifolia) and related plants throughout New England. The pathogen belongs to the Diaporthaceae family and primarily targets the foliage, causing leaf spotting and potential defoliation.",
  "idTips": [
    {
      "label": "Leaf Spots",
      "description": "Tan to reddish-brown circular or irregular spots with darker borders appear on infected leaves, often starting from leaf margins",
      "isPrimary": true
    },
    {
      "label": "Fruiting Bodies",
      "description": "Small black pycnidia (fungal fruiting structures) may be visible within or around the lesions on affected leaves",
      "isPrimary": false
    },
    {
      "label": "Progressive Defoliation",
      "description": "Severe infections cause leaves to yellow and drop, particularly affecting lower canopy foliage first",
      "isPrimary": false
    }
  ],
  "habitat": "This blight thrives in moist, humid conditions typical of New England woodlands and cultivated landscapes where mountain laurel grows, particularly in areas with poor air circulation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Diaporthe kalmiae is host-specific to Kalmia species, making mountain laurel and related plants its primary targets, while most other Diaporthe species have broader host ranges.",
