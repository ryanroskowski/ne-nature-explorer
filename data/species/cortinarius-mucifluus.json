  "nameStory": "",
  "description": "Cortinarius mucifluus, commonly known as the slimy webcap, is a small to medium-sized mushroom characterized by its distinctly slimy or viscid cap surface. This fungus belongs to the Webcaps family (Cortinariaceae) and is found in the forests of New England during late summer and fall.",
  "idTips": [
    {
      "label": "Slimy Cap",
      "description": "The cap is covered with a thick, gelatinous slime layer that gives the mushroom its 'slimy' common name, making it distinctly slippery to the touch.",
      "isPrimary": true
    },
    {
      "label": "Rusty Spore Deposit",
      "description": "Like other webcaps, it produces rusty-brown or cinnamon-colored spore prints, a key family characteristic.",
      "isPrimary": false
    },
    {
      "label": "Cortina Present",
      "description": "Young specimens display a delicate web-like veil (cortina) connecting the cap edge to the stem, which breaks as the mushroom matures.",
      "isPrimary": false
    }
  ],
  "habitat": "Cortinarius mucifluus typically grows in coniferous and mixed forests, often found near mossy areas and damp woodland floors in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The thick slime layer on the slimy webcap's cap serves as a water-resistant coating, helping the mushroom retain moisture in forest environments.",
  "confusionNotes": null,
  "contextualKnowledge": null,
