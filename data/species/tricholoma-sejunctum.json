  "nameStory": "",
  "description": "Tricholoma sejunctum, commonly known as the Deceiving Knight, is a woodland mushroom characterized by its grayish to brownish cap and white gills that may develop yellow staining with age. Despite its edible appearance, this species is considered inedible to poisonous, hence its deceptive common name.",
  "idTips": [
    {
      "label": "Cap appearance",
      "description": "Gray to brownish cap with a distinctive radial fibrous texture and often a slightly darker center",
      "isPrimary": false
    },
    {
      "label": "Gills and staining",
      "description": "White gills that become notched near the stem and often display yellow or greenish staining, particularly when bruised or with age",
      "isPrimary": true
    },
    {
      "label": "Smell",
      "description": "Distinctive unpleasant or acrid odor that becomes more noticeable when crushed or aged",
      "isPrimary": false
    }
  ],
  "habitat": "Tricholoma sejunctum grows on the forest floor in mixed hardwood and coniferous forests throughout New England, typically appearing from late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'Deceiving Knight' refers to how this mushroom closely resembles edible Tricholoma species, making it a classic example of why proper mushroom identification is essential before consumption.",
  "confusionNotes": null,
