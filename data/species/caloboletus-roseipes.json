  "nameStory": "",
  "description": "Caloboletus roseipes, commonly known as the rosy-footed bolete, is a woodland mushroom belonging to the boletes family (Boletaceae). It is a mycorrhizal fungus found in association with various tree species throughout New England.",
  "idTips": [
    {
      "label": "Rosy-pink stem base",
      "description": "The distinctive reddish or rose-pink coloration at the base of the stem is the most characteristic feature of this species.",
      "isPrimary": true
    },
    {
      "label": "Pale cap and yellow pores",
      "description": "The cap is typically whitish to pale brown, with yellow pores underneath that may bruise slightly greenish when handled.",
      "isPrimary": false
    },
    {
      "label": "Firm, solid flesh",
      "description": "The mushroom has dense, white to pale flesh that is firm and does not change color dramatically when cut.",
      "isPrimary": false
    }
  ],
  "habitat": "Caloboletus roseipes grows in mixed forests and hardwood areas of New England, forming mycorrhizal relationships with oak, beech, and other deciduous trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The rosy-pink coloration at the stem base distinguishes this bolete from its look-alike relatives and intensifies with age, making mature specimens especially striking in the forest.",
