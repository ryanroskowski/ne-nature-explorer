  "nameStory": "",
  "description": "Neogyromitra brunnea is a small, brown false morel fungus belonging to the Discinaceae family, characterized by its cup-shaped to disc-like fruiting body. This species is found in spring woodlands throughout New England and other temperate regions of North America.",
  "idTips": [
    {
      "label": "Cap Shape",
      "description": "Distinctive disc-like or cup-shaped cap that is brown and often irregularly lobed or wavy at the edges",
      "isPrimary": true
    },
    {
      "label": "Underside Structure",
      "description": "Ridges on the underside (hymenium) are false gills—they do not reach the stem and are more irregular than true gills",
      "isPrimary": false
    },
    {
      "label": "Stem Attachment",
      "description": "Hollow stem that is lighter in color than the cap and attached directly to the underside of the disc",
      "isPrimary": false
    }
  ],
  "habitat": "Neogyromitra brunnea typically fruits in spring (April-May) on the ground in hardwood or mixed forests, often appearing near decomposing wood and leaf litter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other members of Discinaceae, Neogyromitra brunnea contains gyromitrin, a potentially toxic compound, making it important to distinguish from edible mushroom species.",
