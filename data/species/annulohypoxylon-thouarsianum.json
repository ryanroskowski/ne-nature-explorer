  "nameStory": "",
  "description": "Cramp Balls are small, hard, spherical fruiting bodies of the fungus Annulohypoxylon thouarsianum, belonging to the Hypoxylaceae family of wood-decay fungi. These dark, charcoal-like structures develop on dead hardwood branches and logs, typically appearing in clusters.",
  "idTips": [
    {
      "label": "Spherical Shape",
      "description": "Distinctive round, ball-like fruiting bodies, typically 5-15mm in diameter",
      "isPrimary": true
    },
    {
      "label": "Hard Texture",
      "description": "Extremely hard and brittle when dry, with a smooth or slightly wrinkled dark brown to black surface",
      "isPrimary": false
    },
    {
      "label": "Wood Substrate",
      "description": "Found embedded in or emerging from dead hardwood branches, particularly birch, oak, and other deciduous trees",
      "isPrimary": false
    }
  ],
  "habitat": "Cramp Balls are found throughout New England on dead hardwood branches and logs in forests, woodlands, and disturbed areas where decaying wood is present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Historically, cramp balls were carried in pockets or placed under pillows as folk remedies for leg cramps and rheumatism, though there is no scientific evidence supporting these claims.",
