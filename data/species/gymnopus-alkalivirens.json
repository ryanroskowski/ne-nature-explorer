  "nameStory": "",
  "description": "Gymnopus alkalivirens is a small woodland mushroom in the Omphalotaceae family, characterized by its delicate appearance and preference for alkaline soil environments. This species is found in New England and other temperate regions where it plays a role in forest floor decomposition.",
  "idTips": [
    {
      "label": "Stalk characteristics",
      "description": "Thin, wiry, and typically dark brown to black stems that are distinctly hollow and brittle",
      "isPrimary": true
    },
    {
      "label": "Cap appearance",
      "description": "Small convex to flat caps (5-15 mm) with a pale tan to grayish-brown color and a distinctive central depression",
      "isPrimary": false
    },
    {
      "label": "Gill attachment",
      "description": "Adnate to slightly decurrent gills that are whitish and relatively distant from one another",
      "isPrimary": false
    }
  ],
  "habitat": "Gymnopus alkalivirens grows on decaying wood, leaf litter, and mossy areas in hardwood and mixed forests with alkaline or neutral soil conditions throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'alkalivirens' reflects its unusual preference for alkaline soil environments, making it a useful indicator of soil chemistry in forest ecosystems.",
