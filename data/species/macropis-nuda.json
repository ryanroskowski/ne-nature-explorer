  "nameStory": "",
  "description": "Macropis nuda, commonly known as the Dark-footed Yellow Loosestrife Bee, is a solitary bee species in the family Melittidae found throughout New England. This specialized bee has a strong ecological relationship with yellow loosestrife plants (Lysichiton species), which are its primary pollen and nectar sources.",
  "idTips": [
    {
      "label": "Dark Legs",
      "description": "Distinctive dark brown to black legs, particularly the hind legs, contrasting with the bee's otherwise yellow and black body coloration",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Notably small for a bee, typically measuring 6-8 mm in length, making it one of the smallest native New England bees",
      "isPrimary": false
    },
    {
      "label": "Facial Features",
      "description": "Pale or yellowish facial markings and relatively short antennae compared to other melittid bees",
      "isPrimary": false
    }
  ],
  "habitat": "Macropis nuda inhabits meadows, wetland margins, and open fields throughout New England where yellow loosestrife plants grow abundantly.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike honeybees, Macropis nuda bees collect oil from loosestrife flowers using specialized combs on their hind legs, mixing it with pollen to provision their underground nests.",
