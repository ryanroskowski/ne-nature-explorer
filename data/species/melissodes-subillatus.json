  "nameStory": "",
  "description": "Melissodes subillatus is a solitary bee species belonging to the family Apidae, commonly known as long-horned bees due to their notably elongated antennae. These native bees are important pollinators found throughout New England, where they visit a variety of flowering plants during the warmer months.",
  "idTips": [
    {
      "label": "Elongated Antennae",
      "description": "Males possess distinctly long antennae that are nearly as long as the body, a characteristic feature of the Melissodes genus",
      "isPrimary": true
    },
    {
      "label": "Body Size and Color",
      "description": "Medium-sized bees, typically 10-14 mm long, with a robust black body and sparse to moderate hair coverage",
      "isPrimary": false
    },
    {
      "label": "Pollen Baskets",
      "description": "Females display visible scopae (dense hair patches) on their hind legs used for carrying pollen",
      "isPrimary": false
    }
  ],
  "habitat": "Melissodes subillatus prefers open, sunny areas including meadows, prairies, gardens, and woodland edges where diverse wildflowers bloom.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Melissodes subillatus bees use their exceptionally long antennae to detect pheromones from females, allowing them to locate mates across distances in open habitats.",
