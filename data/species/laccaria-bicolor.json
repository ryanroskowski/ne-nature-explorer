  "nameStory": "",
  "description": "Laccaria bicolor, commonly known as the Bicoloured Deceiver, is a small woodland mushroom characterized by its distinctive two-toned coloration that shifts with moisture levels. This species is a mycorrhizal fungus that forms beneficial relationships with tree roots, particularly conifers and hardwoods.",
  "idTips": [
    {
      "label": "Bicoloured Cap",
      "description": "Cap displays two distinct color zones: darker when moist, lighter when dry, creating a characteristic ringed or zoned appearance",
      "isPrimary": true
    },
    {
      "label": "Decurrent Gills",
      "description": "Gills are widely spaced, thick, and run down the stem (decurrent), often appearing waxy and pinkish to purple-tinged",
      "isPrimary": false
    },
    {
      "label": "Small to Medium Size",
      "description": "Typically 2-6 cm in diameter with a thin, fibrous stem that is often the same color as the darker cap zone",
      "isPrimary": false
    }
  ],
  "habitat": "Laccaria bicolor thrives in mixed woodlands throughout New England, particularly in mossy areas and leaf litter where it forms mycorrhizal associations with both coniferous and deciduous trees.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The 'Deceiver' part of its common name refers to its variable appearance depending on moisture conditions, which can make identification confusing for novice mushroom foragers.",
