  "nameStory": "",
  "description": "Macrolepiota pallida is a medium to large umbrella-shaped mushroom belonging to the Agaricaceae family, characterized by its pale coloring and distinctive ring on the stem. Found throughout New England, it is an edible species that closely resembles other Macrolepiota species and requires careful identification.",
  "idTips": [
    {
      "label": "Pale Cap with Fine Scales",
      "description": "The cap is whitish to cream-colored with small, fine grayish-brown scales arranged in a delicate pattern, distinguishing it from darker relatives like M. procera.",
      "isPrimary": true
    },
    {
      "label": "Movable Ring on Stem",
      "description": "A distinctive double-edged ring (annulus) encircles the stem and can be slid up and down freely, a key feature of the Macrolepiota genus.",
      "isPrimary": false
    },
    {
      "label": "Free Gills and Bulbous Base",
      "description": "The gills are white and do not attach to the stem, and the stem has a distinctive bulbous or rooting base that helps confirm identification.",
      "isPrimary": false
    }
  ],
  "habitat": "Macrolepiota pallida grows in grassy meadows, disturbed areas, and open woodlands throughout New England, preferring well-drained soils and typically fruiting in summer through early fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Macrolepiota species, M. pallida exhibits a phenomenon called 'deliquescence,' where the gills gradually dissolve into an inky liquid as the mushroom ages, serving to disperse spores.",
