  "nameStory": "",
  "description": "Armillaria sinapina is a wood-decaying fungus in the Physalacriaceae family that forms small to medium-sized fruiting bodies with a characteristic honey-mushroom appearance. This species is found in New England where it plays an important ecological role as a decomposer of dead wood.",
  "idTips": [
    {
      "label": "Partial veil remnants",
      "description": "Young specimens display a delicate ring (annulus) on the stem that may disappear with age",
      "isPrimary": true
    },
    {
      "label": "Yellow to brown coloration",
      "description": "Caps and stems display golden-yellow to russet-brown tones, often darker at the center",
      "isPrimary": false
    },
    {
      "label": "White to pale yellow gills",
      "description": "Gills are densely arranged and run nearly to the stem, distinguishing it from other similar species",
      "isPrimary": false
    }
  ],
  "habitat": "Armillaria sinapina grows on dead or dying hardwood logs and stumps in forests throughout New England, preferring moist woodland environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Armillaria species, A. sinapina can produce bioluminescent mycelium that glows faintly in the dark, a phenomenon known as foxfire.",
