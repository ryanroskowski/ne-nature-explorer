  "nameStory": "",
  "description": "Pileolaria brevipes, commonly known as poison ivy rust, is a fungal pathogen that infects poison ivy plants throughout New England. This rust fungus is part of the Pileolariaceae family and completes its life cycle primarily on its host plant.",
  "idTips": [
    {
      "label": "Aecial Cups on Leaves",
      "description": "Look for small, cup-shaped fruiting structures (aecia) on the undersides of poison ivy leaves, typically appearing as yellow-orange or rust-colored bumps arranged in clusters",
      "isPrimary": true
    },
    {
      "label": "Spore Color",
      "description": "The rust-colored spores are diagnostic and give the fungus its common name, appearing as powdery deposits on infected leaf surfaces",
      "isPrimary": false
    },
    {
      "label": "Host Specificity",
      "description": "This rust only infects poison ivy (Toxicodendron radicans and related species), making the host plant an important identification clue",
      "isPrimary": false
    }
  ],
  "habitat": "Pileolaria brevipes is found on poison ivy plants growing in woodlands, disturbed areas, and along forest edges throughout New England, particularly in moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many rust fungi that require alternate hosts, Pileolaria brevipes completes its entire life cycle on poison ivy alone, making it an autoecious rust fungus.",
