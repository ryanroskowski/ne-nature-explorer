  "nameStory": "",
  "description": "The Slender Groundhopper (Tetrix subulata) is a small, elongated pygmy grasshopper found throughout New England and northeastern North America. Despite their small size, these insects are active jumpers and play a role in grassland and wetland ecosystems.",
  "idTips": [
    {
      "label": "Pronotum Shape",
      "description": "Distinctively pointed and cone-shaped pronotum that extends backward over the abdomen",
      "isPrimary": true
    },
    {
      "label": "Body Size",
      "description": "Very small, typically 7-10mm in length with a slender, compressed body",
      "isPrimary": false
    },
    {
      "label": "Wing Development",
      "description": "Wings are reduced or absent in many populations, though some individuals may have shortened wings",
      "isPrimary": false
    }
  ],
  "habitat": "Slender Groundhoppers inhabit moist areas including marshes, pond margins, wet meadows, and streamside vegetation throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite being one of the smallest grasshoppers in North America, Slender Groundhoppers can jump up to 20 times their body length to escape predators.",
