  "nameStory": "",
  "description": "The Broad-winged Bush Katydid is a medium-sized katydid characterized by its broad, rounded wings and green coloration that provides excellent camouflage in vegetation. This insect is an important member of New England's grassland and shrubland ecosystems, known for its distinctive singing behavior during late summer and fall.",
  "idTips": [
    {
      "label": "Broad Wings",
      "description": "Notably wider and more rounded wings compared to other katydid species, giving it a stockier appearance",
      "isPrimary": true
    },
    {
      "label": "Green Coloration",
      "description": "Predominantly green body that blends seamlessly with foliage and leafy vegetation",
      "isPrimary": false
    },
    {
      "label": "Ovipositor Shape",
      "description": "Females possess a distinctively shaped, slightly curved ovipositor visible at the abdomen's tip",
      "isPrimary": false
    }
  ],
  "habitat": "Broad-winged Bush Katydids inhabit brushy fields, shrublands, and the edges of deciduous forests throughout New England, preferring areas with dense low vegetation and shrubs.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Males produce their characteristic buzzing and ticking songs by rubbing their wings together, with each species having a unique 'acoustic signature' that helps females locate mates in the darkness.",
