  "nameStory": "",
  "description": "Xerocomelus tenax is a small bolete fungus characterized by its brown cap and yellow pores that stain blue when bruised. This species is commonly found throughout New England and is notable for its firm, persistent flesh that resists decay.",
  "idTips": [
    {
      "label": "Blue-staining pores",
      "description": "Yellow pores underneath the cap turn blue-green when pressed or bruised, a key identifying feature of this species",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Typically has a cap diameter of 2-5 cm with a brown, sometimes grayish-brown surface",
      "isPrimary": false
    },
    {
      "label": "Firm texture",
      "description": "The flesh is notably tough and persistent, not soft or easily breaking apart like many other boletes",
      "isPrimary": false
    }
  ],
  "habitat": "Xerocomelus tenax grows in mixed hardwood and coniferous forests throughout New England, often appearing in mossy areas and on acidic soil from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'tenax' means 'tenacious' or 'holding fast,' referring to its remarkably firm and durable flesh that persists longer than most boletes before decomposing.",
