  "nameStory": "",
  "description": "The Landscaping Black Morel (Morchella importuna) is a distinctive fungus characterized by its dark, honeycomb-like cap and hollow stem, making it one of the most prized edible mushrooms in North America. This species has become increasingly common in landscaped areas and disturbed soils throughout New England since its introduction.",
  "idTips": [
    {
      "label": "Cap Structure",
      "description": "Dark brown to black honeycomb-patterned cap with distinct ridges and pits arranged in a regular lattice",
      "isPrimary": true
    },
    {
      "label": "Hollow Interior",
      "description": "Completely hollow stem and cap with no chambers or cottony material inside when cut vertically",
      "isPrimary": false
    },
    {
      "label": "Attachment Point",
      "description": "Cap attaches directly to the stem at the base, rather than hanging freely like false morels",
      "isPrimary": false
    }
  ],
  "habitat": "Found in disturbed soils, mulched areas, landscaped gardens, and near dead elm, ash, and apple trees in New England from April through early June.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Morchella importuna is believed to have been introduced to North America from Asia and has rapidly expanded its range, making it one of the most commonly foraged morels in eastern North America today.",
