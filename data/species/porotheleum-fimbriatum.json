  "nameStory": "",
  "description": "Porotheleum fimbriatum is a small, crustose lichen in the Porotheleaceae family characterized by its distinctive fringed or bordered appearance. This species is found in New England where it colonizes suitable substrates in cool, moist environments.",
  "idTips": [
    {
      "label": "Fringed margins",
      "description": "The thallus has a characteristic fimbriated (fringed or toothed) border that distinguishes it from similar species",
      "isPrimary": true
    },
    {
      "label": "Crustose growth form",
      "description": "Forms a thin, tightly adhered crust on the substrate surface without lobes or leafy structures",
      "isPrimary": false
    },
    {
      "label": "Perithecia presence",
      "description": "Dark, flask-shaped fruiting bodies (perithecia) are embedded in the thallus and visible under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Porotheleum fimbriatum grows on rocks and stone surfaces in shaded, humid microhabitats typical of New England woodlands and similar cool, moist regions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Porotheleaceae family are pyrenomycete lichens, meaning they reproduce through flask-shaped fruiting bodies rather than the cup-shaped structures found in many other lichens.",
