  "nameStory": "",
  "description": "Peach Leaf Curl is a fungal disease caused by Taphrina deformans that affects stone fruit trees, particularly peaches and nectarines, causing distinctive leaf deformation and reduced yields. This disease is common in New England's cool, wet spring conditions and can significantly impact fruit production if left untreated.",
  "idTips": [
    {
      "label": "Leaf Deformation",
      "description": "Affected leaves become severely curled, thickened, and distorted with a characteristic reddish or yellowish discoloration, appearing waxy and brittle",
      "isPrimary": true
    },
    {
      "label": "Fungal Coating",
      "description": "A whitish, powdery bloom of spores may be visible on the undersides of curled leaves, particularly in spring when conditions are moist",
      "isPrimary": false
    },
    {
      "label": "Seasonal Timing",
      "description": "Symptoms appear in spring as new leaves emerge and develop, typically within 2-3 weeks of bud break during cool, wet weather",
      "isPrimary": false
    }
  ],
  "habitat": "Peach Leaf Curl thrives in New England's cool, moist spring environments, infecting trees during leaf emergence when temperatures range from 50-68°F and water is present on developing foliage.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The fungus overwinters as dormant spores on tree bark and buds, waiting for spring moisture and cool temperatures to trigger infection—making it one of the earliest fungal diseases to strike in the growing season.",
