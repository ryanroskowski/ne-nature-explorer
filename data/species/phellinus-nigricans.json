  "nameStory": "",
  "description": "Phellinus nigricans is a wood-decay fungus that forms dark, crusty brackets on dead hardwood trees throughout New England. This polypore produces a black or dark brown upper surface and belongs to the Hymenochaetaceae family, known for their role in decomposing woody material.",
  "idTips": [
    {
      "label": "Dark coloration",
      "description": "Upper surface is black to dark brown, often with a charred or sooty appearance that distinguishes it from lighter-colored polypores",
      "isPrimary": true
    },
    {
      "label": "Bracket shape",
      "description": "Forms hoof-shaped or shelf-like brackets that project from wood, typically 2-8 cm wide with a hard, crusty texture"
    },
    {
      "label": "Pore surface",
      "description": "Underside features small, angular pores that are brown to reddish-brown and stain darker when scratched"
    }
  ],
  "habitat": "Phellinus nigricans typically grows on dead or dying hardwood trees, particularly on oak and other hardwoods in forests and woodlots throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Phellinus species, P. nigricans is a perennial fungus that continues to produce new spores year after year, with the same fruiting body persisting on wood for multiple seasons.",
