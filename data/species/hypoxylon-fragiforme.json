  "nameStory": "",
  "description": "Beech Woodwart is a fungus that forms distinctive fruiting bodies on dead beech wood, appearing as small, crusty, coal-like structures on logs and branches. It is a saprotroph that plays an important ecological role in decomposing dead wood in New England forests.",
  "idTips": [
    {
      "label": "Color and texture",
      "description": "Appears as black or dark brown, crusty, warty outgrowths on wood surface",
      "isPrimary": true
    },
    {
      "label": "Host specificity",
      "description": "Found almost exclusively on dead beech wood, rarely on other hardwoods",
      "isPrimary": false
    },
    {
      "label": "Spore-producing structures",
      "description": "Contains small flask-shaped perithecia embedded in the crusty surface that release spores",
      "isPrimary": false
    }
  ],
  "habitat": "This species grows on dead or dying beech branches, logs, and stumps in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its crusty, coal-like appearance, Beech Woodwart belongs to the Xylariaceae family and is sometimes called a 'canker fungus,' though it only colonizes already-dead or severely stressed wood rather than killing healthy trees.",
