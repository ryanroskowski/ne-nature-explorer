  "nameStory": "",
  "description": "Ceriporia spissa is a wood-decaying fungus in the Irpicaceae family, characterized by its small pores and thin fruiting bodies. It plays an important ecological role in breaking down deadwood in forest ecosystems throughout New England.",
  "idTips": [
    {
      "label": "Pore Size",
      "description": "Extremely small, angular pores (5-7 per mm) that are the defining characteristic of this species",
      "isPrimary": true
    },
    {
      "label": "Fruiting Body Texture",
      "description": "Thin, resupinate to slightly effused-reflexed fruiting bodies with a delicate, papery consistency",
      "isPrimary": false
    },
    {
      "label": "Color",
      "description": "Whitish to pale cream-colored pore surface that may become slightly brown with age or bruising",
      "isPrimary": false
    }
  ],
  "habitat": "Ceriporia spissa grows on decaying hardwood, particularly on the undersides of fallen logs and dead branches in moist, shaded forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is a white-rot decomposer, meaning it breaks down both the cellulose and lignin in wood, making it especially important for nutrient cycling in forest ecosystems.",
