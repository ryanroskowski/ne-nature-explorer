  "nameStory": "",
  "description": "The Riverine Clubtail is a dragonfly species belonging to the Clubtail family, characterized by its slender body and distinctive club-shaped abdomen. This species is found in New England and prefers fast-flowing freshwater environments.",
  "idTips": [
    {
      "label": "Club-shaped abdomen",
      "description": "The posterior abdominal segments are noticeably swollen, creating a distinctive club or paddle-like shape",
      "isPrimary": true
    },
    {
      "label": "Yellow and black patterning",
      "description": "Features a combination of yellow spots and stripes on a dark brown or black body",
      "isPrimary": false
    },
    {
      "label": "Small to medium size",
      "description": "Typically measures between 1.5 to 2 inches in length, smaller than many other dragonfly species",
      "isPrimary": false
    }
  ],
  "habitat": "The Riverine Clubtail inhabits clear, fast-flowing rivers and rocky streams with moderate to strong currents in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other clubtail dragonflies, the Riverine Clubtail hunts by perching on rocks and vegetation near water, making quick aerial sorties to catch small insects mid-flight.",
