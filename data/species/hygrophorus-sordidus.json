  "nameStory": "",
  "description": "Hygrophorus sordidus is a small to medium waxcap mushroom characterized by its dull, grayish-brown coloring and waxy texture typical of the Hygrophoraceae family. This species is found in the forests and grasslands of New England during the fall and early winter months.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Dull grayish-brown to brownish cap with a moist, waxy appearance and slightly fibrillose surface",
      "isPrimary": true
    },
    {
      "label": "Gill Characteristics",
      "description": "White to pale cream gills that are widely spaced, waxy, and decurrent (running down the stem)",
      "isPrimary": false
    },
    {
      "label": "Stem Features",
      "description": "Slender, whitish to pale grayish stem that is smooth, waxy, and may display some discoloration at the base",
      "isPrimary": false
    }
  ],
  "habitat": "Hygrophorus sordidus typically grows in mixed hardwood and coniferous forests, grasslands, and boggy areas of New England, preferring mossy substrates and well-drained soils.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other waxcaps, Hygrophorus sordidus produces a distinctive waxy coating on its gills and cap that helps repel moisture, allowing it to fruit in wet autumn conditions when many other fungi struggle to appear.",
  "confusionNotes": null,
