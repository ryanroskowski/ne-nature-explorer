  "nameStory": "",
  "description": "Xanthoconium purpureum is a bolete fungus characterized by its distinctive purplish-red coloring and yellow pore surface that bruises blue when handled. This species is found in New England forests and is considered inedible.",
  "idTips": [
    {
      "label": "Purple-red cap",
      "description": "The fruiting body displays a prominent purplish-red to burgundy colored cap",
      "isPrimary": true
    },
    {
      "label": "Yellow bruising pores",
      "description": "Yellow pores on the underside turn blue-green when pressed or damaged",
      "isPrimary": false
    },
    {
      "label": "Reticulated stem",
      "description": "The stem typically shows a network-like (reticulated) pattern of coloring",
      "isPrimary": false
    }
  ],
  "habitat": "Xanthoconium purpureum grows in mixed deciduous and coniferous forests of New England, typically fruiting from summer through fall in association with various tree species.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The striking blue bruising reaction of this bolete's pores is caused by a chemical oxidation process that occurs when cells are damaged, making it an easy field characteristic to verify.",
