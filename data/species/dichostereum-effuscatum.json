  "nameStory": "",
  "description": "Dichostereum effuscatum is a small, resupinate fungus in the Lachnocladiaceae family that forms thin, delicate fruiting bodies on decaying wood substrates. This species is part of a group of wood-decay fungi commonly found in the moist forest ecosystems of New England.",
  "idTips": [
    {
      "label": "Resupinate Growth Form",
      "description": "The fruiting body lies flat against the substrate with spore-bearing surface facing outward, characteristic of many Dichostereum species",
      "isPrimary": true
    },
    {
      "label": "Microscopic Spore Morphology",
      "description": "Produces distinctive smooth, thin-walled basidiospores that are diagnostic under magnification",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "Found exclusively on hardwood substrates, particularly on the underside of decaying logs and branches",
      "isPrimary": false
    }
  ],
  "habitat": "Dichostereum effuscatum thrives on decaying hardwood in moist, shaded forest environments throughout New England, playing an important role in wood decomposition.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size and inconspicuous appearance, this fungus is an important decomposer that helps recycle nutrients locked in dead wood back into forest ecosystems.",
