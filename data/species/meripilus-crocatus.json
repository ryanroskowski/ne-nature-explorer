  "nameStory": "",
  "description": "Meripilus crocatus, commonly known as the Blackening Polypore, is a wood-decay fungus in the Meripilaceae family characterized by its distinctive color-changing properties. Found throughout New England, this polypore grows as a shelf-like fruiting body on hardwood logs and stumps.",
  "idTips": [
    {
      "label": "Blackening Reaction",
      "description": "Flesh and pores bruise or stain dark brown to black when handled or aged, a highly distinctive feature",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "White to cream-colored pores that are small and decurrent (running down the stem), becoming darker with age or pressure",
      "isPrimary": false
    },
    {
      "label": "Growth Pattern",
      "description": "Forms large, tiered shelf-like brackets or rosette clusters at the base of dead hardwoods, often appearing in spring to fall",
      "isPrimary": false
    }
  ],
  "habitat": "Meripilus crocatus grows on dead or dying hardwoods, particularly oak, maple, and birch, in moist woodlands and forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The blackening reaction is so pronounced that this fungus was historically used as a natural dye source by indigenous peoples and early colonists in North America.",
