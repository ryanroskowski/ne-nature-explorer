  "nameStory": "",
  "description": "The Common Checkered-Skipper (Burnsius communis) is a small butterfly belonging to the Skippers family, characterized by its distinctive checkered wing pattern. This species is commonly found throughout New England and other regions of North America, where it thrives in open, sunny areas.",
  "idTips": [
    {
      "label": "Checkered Wing Pattern",
      "description": "Distinctive black and white checkered pattern on the wings, particularly visible on the forewings",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "One of the smaller skipper species, with a wingspan of approximately 0.75 to 1.25 inches",
      "isPrimary": false
    },
    {
      "label": "Dark Coloration",
      "description": "Overall dark brown to black coloration on the upperside of wings with white spots and patches",
      "isPrimary": false
    }
  ],
  "habitat": "The Common Checkered-Skipper prefers open, disturbed areas including roadsides, weedy fields, gardens, and cultivated areas with low-growing vegetation.",
