  "nameStory": "",
  "description": "Peniophora incarnata, commonly known as Rosy Crust, is a crust fungus in the Peniophoraceae family characterized by its distinctive pinkish or salmon-colored fruiting surface. This wood-decay fungus plays an important ecological role in breaking down dead hardwood in forest ecosystems.",
  "idTips": [
    {
      "label": "Color",
      "description": "Distinctive rosy-pink to salmon coloration on the smooth to slightly bumpy fruiting surface",
      "isPrimary": true
    },
    {
      "label": "Growth Form",
      "description": "Thin, closely adhering crust that grows flat against the substrate without forming shelf-like structures",
      "isPrimary": false
    },
    {
      "label": "Texture",
      "description": "Waxy or velvet-like appearance with a slightly wrinkled or granular surface when examined closely",
      "isPrimary": false
    }
  ],
  "habitat": "Rosy Crust is found on decaying hardwood, particularly oak and other fallen logs and branches, in moist forests and woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many shelf fungi, Peniophora incarnata grows as a thin, smooth crust that is easily missed, but its striking rosy hue makes it one of the most visually distinctive crust fungi when encountered.",
