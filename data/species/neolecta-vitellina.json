  "nameStory": "",
  "description": "Neolecta vitellina is a small, gelatinous fungus belonging to the primitive Neolectaceae family, characterized by its bright yellow to orange coloring. This species is found in moist woodlands throughout New England and is considered one of the most ancient lineages of cup fungi.",
  "idTips": [
    {
      "label": "Bright Yellow-Orange Color",
      "description": "The fruiting bodies display a distinctive vivid yellow to golden-orange hue that helps distinguish it from other woodland fungi",
      "isPrimary": true
    },
    {
      "label": "Gelatinous Texture",
      "description": "The caps have a characteristic jelly-like or gelatinous consistency that feels soft and somewhat rubbery when moist",
      "isPrimary": false
    },
    {
      "label": "Small Cup Shape",
      "description": "Fruiting bodies are typically small (5-15mm), forming delicate cup-like or funnel shapes with inrolled margins",
      "isPrimary": false
    }
  ],
  "habitat": "Neolecta vitellina thrives in damp, mossy areas of deciduous and mixed forests, often appearing on rotting wood or rich humus after periods of heavy moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Neolecta vitellina belongs to one of the earliest-diverging lineages of ascomycete fungi, making it a living link to ancient fungal evolution dating back hundreds of millions of years.",
