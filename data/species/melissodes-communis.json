  "nameStory": "",
  "description": "The Common Longhorn Bee (Melissodes communis) is a solitary bee species in the family Apidae, named for its characteristically long antennae. These medium-sized bees are important native pollinators found throughout New England and eastern North America.",
  "idTips": [
    {
      "label": "Long Antennae",
      "description": "Males possess notably elongated antennae that are longer than their body length, which is the defining characteristic of the genus Melissodes",
      "isPrimary": true
    },
    {
      "label": "Body Color",
      "description": "They display a dark brown to black body with sparse, light-colored body hair and a slightly fuzzy appearance compared to honeybees",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Medium-sized bees, typically 12-15 mm in length, larger than honeybees but smaller than many bumble bees",
      "isPrimary": false
    }
  ],
  "habitat": "Common Longhorn Bees inhabit open fields, meadows, gardens, and woodland edges where native wildflowers and cultivated plants provide abundant pollen sources.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Melissodes bees are famous for their distinctive mating behavior, where they patrol flowering plants at dawn and dusk searching for females, often hovering persistently around blooms.",
