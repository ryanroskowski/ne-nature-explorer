  "nameStory": "",
  "description": "Cluster Cap (Connopus acervatus) is a small, delicate fungus belonging to the Omphalotaceae family, characterized by its clustered growth pattern and diminutive fruiting bodies. Found throughout New England, this species typically appears in late summer and fall on decaying wood and forest floors.",
  "idTips": [
    {
      "label": "Clustered Growth",
      "description": "Fruiting bodies grow in dense, interconnected clusters rather than as individual mushrooms",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Caps are typically 2-5mm in diameter, making them easily overlooked without close inspection",
      "isPrimary": false
    },
    {
      "label": "Funnel-like Shape",
      "description": "Caps are deeply depressed or funnel-shaped with thin, fragile gills running down to the stem",
      "isPrimary": false
    }
  ],
  "habitat": "Cluster Cap thrives on moist, decaying hardwood logs and woody debris in shaded forest understories throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their tiny size, these mushrooms are persistent fruiting throughout the autumn season and often go unnoticed by casual mushroom hunters who focus on larger species.",
