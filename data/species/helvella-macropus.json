  "nameStory": "",
  "description": "The long-stalked gray cup (Helvella macropus) is a distinctive fungus belonging to the Helvellaceae family, characterized by its cup-shaped fruiting body supported by an elongated stalk. This ascomycete is found in wooded areas throughout New England, typically appearing in spring and early summer.",
  "idTips": [
    {
      "label": "Long, Prominent Stalk",
      "description": "The most distinctive feature is its notably tall, slender stalk that can reach several inches in length, supporting the cup above the forest floor.",
      "isPrimary": true
    },
    {
      "label": "Gray Cup Shape",
      "description": "The cup or goblet-shaped fruiting body is gray to brownish-gray in color and often has an irregular, wavy margin.",
      "isPrimary": false
    },
    {
      "label": "Smooth Interior Surface",
      "description": "The inner surface of the cup is smooth and pale, while the outer surface may be slightly wrinkled or ridged.",
      "isPrimary": false
    }
  ],
  "habitat": "Long-stalked gray cup grows in moist, wooded areas and mixed forests of New England, often appearing near rotting wood, leaf litter, and rich soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Helvellaceae family, including H. macropus, produce spores in sac-like structures called asci, making them part of the ascomycete group—one of the largest divisions of fungi.",
