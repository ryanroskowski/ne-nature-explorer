  "nameStory": "",
  "description": "Infundibulicybe squamulosa is a small, delicate mushroom in the Omphalinaceae family characterized by its funnel-shaped cap and fine squamose (scaly) texture. This species is found in New England forests and is notable for its distinctive appearance among similar omphalinoid fungi.",
  "idTips": [
    {
      "label": "Funnel-shaped cap with fine scales",
      "description": "The cap is deeply depressed or funnel-like with a characteristic scaly or squamose surface that helps distinguish it from smooth-capped relatives",
      "isPrimary": true
    },
    {
      "label": "Decurrent gills",
      "description": "Gills run down the stem (decurrent) and are typically thin and crowded, typical of the Omphalinaceae family",
      "isPrimary": false
    },
    {
      "label": "Small fruiting bodies",
      "description": "This species fruits as relatively small mushrooms, usually with caps less than 2-3 cm in diameter",
      "isPrimary": false
    }
  ],
  "habitat": "Infundibulicybe squamulosa grows in moist deciduous and mixed forests of New England, typically appearing on rich soil or among leaf litter during wet seasons.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'squamulosa' refers to the fine scales covering the cap, which give it a distinctive textured appearance that resembles tiny roof shingles under magnification.",
