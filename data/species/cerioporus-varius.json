  "nameStory": "",
  "description": "The Elegant Polypore is a delicate bracket fungus characterized by its fan-shaped fruiting bodies with a distinctive scalloped or wavy margin. This wood-decomposing fungus is an important saprotroph that helps recycle nutrients in forest ecosystems throughout New England.",
  "idTips": [
    {
      "label": "Fan-shaped with scalloped edges",
      "description": "The fruiting body has an elegant, fan or shell-like shape with distinctively wavy or scalloped margins that give it its common name.",
      "isPrimary": true
    },
    {
      "label": "Pore surface coloration",
      "description": "The underside displays fine, decurrent pores that are typically whitish to pale yellow and bruise brownish when handled.",
      "isPrimary": false
    },
    {
      "label": "Thin, papery texture",
      "description": "The fruiting body is relatively thin and delicate with a papery or leathery consistency, distinguishing it from thicker polypores.",
      "isPrimary": false
    }
  ],
  "habitat": "The Elegant Polypore grows on dead hardwood logs and stumps, particularly on oak and other deciduous trees throughout New England's forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This species is one of the few polypores that fruits prolifically in spring, making it a welcome early sign of the growing season for mushroom enthusiasts.",
