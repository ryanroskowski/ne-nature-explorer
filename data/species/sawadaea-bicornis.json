  "nameStory": "",
  "description": "Sawadaea bicornis is a powdery mildew fungus that affects various plants in New England, forming characteristic white powdery coatings on leaves and stems. This ascomycete fungus is named for its distinctive two-horned appendages on its spore-producing structures.",
  "idTips": [
    {
      "label": "Bicornute appendages",
      "description": "Two horn-like structures extending from the perithecia (spore cases) are the defining diagnostic feature",
      "isPrimary": true
    },
    {
      "label": "White powdery coating",
      "description": "Distinctive white to grayish fungal growth appears on leaf surfaces and can be wiped off easily",
      "isPrimary": false
    },
    {
      "label": "Host plant association",
      "description": "Commonly found on woody plants and shrubs, particularly members of the Rosaceae family",
      "isPrimary": false
    }
  ],
  "habitat": "Sawadaea bicornis thrives in cool, humid conditions typical of New England forests and cultivated gardens, preferring moderate temperatures and shaded to partially shaded plant environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'bicornis' literally means 'two-horned,' referring to the distinctive paired appendages that make this mildew species instantly recognizable under magnification.",
