  "nameStory": "",
  "description": "Pseudomicrostroma juglandis is a microscopic fungal pathogen that affects walnut trees and related species throughout New England. This fungus is notable for its specialized parasitic relationship with its host plants, causing characteristic leaf and stem symptoms.",
  "idTips": [
    {
      "label": "Host Specificity",
      "description": "Primarily infects Juglans (walnut) species and related plants in the Juglandaceae family",
      "isPrimary": true
    },
    {
      "label": "Microscopic Spore Structure",
      "description": "Produces distinctive spore formations visible only under magnification, characteristic of the Pseudomicrostroma genus",
      "isPrimary": false
    },
    {
      "label": "Leaf Lesions",
      "description": "Creates visible necrotic spots or discoloration on infected walnut foliage during growing season",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives in the moist forest environments and cultivated walnut groves of New England, particularly in areas with high humidity and moderate temperatures.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Pseudomicrostroma juglandis demonstrates remarkable host specificity, having evolved to parasitize primarily walnut trees, making it an important consideration for regional forestry and nut crop management.",
