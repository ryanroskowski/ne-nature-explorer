  "nameStory": "",
  "description": "Lysurus sphaerocephalus, commonly known as the basket stinkhorn, is a saprobic fungus in the Lysuraceae family characterized by its distinctive spherical, latticed fruiting body that emerges from a white volva. This species is notable for its foul odor, which attracts flies and other insects that aid in spore dispersal.",
  "idTips": [
    {
      "label": "Latticed Sphere Structure",
      "description": "The fruiting body forms a hollow, spherical mesh or latticed cage-like structure with openings throughout, distinguishing it from other stinkhorns",
      "isPrimary": true
    },
    {
      "label": "Foul Odor",
      "description": "A distinctive carrion-like or fecal smell emanates from the fruiting body, especially noticeable in warm conditions",
      "isPrimary": false
    },
    {
      "label": "Whitish Volva Base",
      "description": "The fruiting body emerges from a cup-like, spongy white structure (volva) that remains at the base",
      "isPrimary": false
    }
  ],
  "habitat": "Lysurus sphaerocephalus grows in disturbed soils, mulched areas, and wood chips in New England, typically fruiting from summer through fall in warm, moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its repulsive smell to humans, the basket stinkhorn's odor is irresistible to carrion flies, which crawl over the spore-bearing surface and effectively distribute spores across distances.",
