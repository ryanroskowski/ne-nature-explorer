  "nameStory": "",
  "description": "Chalciporus rubinellus, commonly known as the Rosy Bolete, is a small to medium-sized fungus belonging to the bolete family (Boletaceae). It is characterized by its distinctive reddish-pink pores and is found in coniferous and mixed forests throughout New England.",
  "idTips": [
    {
      "label": "Rosy-Red Pores",
      "description": "The underside displays bright pink to reddish pores that are a defining characteristic and stain blue when bruised",
      "isPrimary": true
    },
    {
      "label": "Yellow to Olive Cap",
      "description": "The cap is typically yellowish-brown to olive-brown and may have a slightly velvety texture",
      "isPrimary": false
    },
    {
      "label": "Thin Stem",
      "description": "The stem is thin, cylindrical, and often displays similar coloring to the cap with possible reddish tones near the base",
      "isPrimary": false
    }
  ],
  "habitat": "Chalciporus rubinellus grows in acidic soils beneath coniferous trees, particularly spruce and fir, as well as in mixed hardwood-conifer forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'rubinellus' refers to its ruby-like reddish pores, which make it one of the most visually striking boletes in the forest and a favorite among mycologists for photography.",
