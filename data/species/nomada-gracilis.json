  "nameStory": "",
  "description": "Nomada gracilis, commonly known as the Gracile Nomad bee, is a small cuckoo bee in the Apidae family native to New England and eastern North America. These parasitic bees lay their eggs in the nests of host bees, where their larvae develop at the expense of the host's offspring.",
  "idTips": [
    {
      "label": "Small size and slender build",
      "description": "Gracile nomad bees are notably small (5-7mm) with a slender, delicate body shape that distinguishes them from stouter bee species",
      "isPrimary": true
    },
    {
      "label": "Yellow and black patterning",
      "description": "They display distinctive yellow markings on the face and abdomen against a predominantly black body",
      "isPrimary": false
    },
    {
      "label": "Lack of pollen baskets",
      "description": "Like all cuckoo bees, they lack the specialized structures (corbiculae) on their hind legs used for collecting pollen",
      "isPrimary": false
    }
  ],
  "habitat": "Nomada gracilis inhabits open woodlands, gardens, and meadows throughout New England where host bee species nest in sandy or bare soil and hollow stems.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, Nomada gracilis is a brood parasite that sneaks into the nests of other bee species, laying its eggs so that its larvae consume the host's food provisions without contributing to pollination or nest maintenance.",
