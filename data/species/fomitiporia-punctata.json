  "nameStory": "",
  "description": "Elbowpatch Crust (Fomitiporia punctata) is a wood-decay fungus in the Hymenochaetaceae family that forms thin, crusty brackets on dead hardwoods throughout New England. This polypore plays an important ecological role as a decomposer, breaking down woody debris in forest ecosystems.",
  "idTips": [
    {
      "label": "Pore Surface",
      "description": "Small, round pores on the underside that are initially cream-colored to pale yellow, darkening with age and bruising to brown",
      "isPrimary": true
    },
    {
      "label": "Crust Appearance",
      "description": "Thin, adnate (tightly attached) brown to blackish crust with a bumpy or uneven upper surface resembling patches of elbow wear on fabric",
      "isPrimary": false
    },
    {
      "label": "Growth Pattern",
      "description": "Forms resupinate to effused-reflexed brackets that closely hug the substrate without forming shelf-like projections",
      "isPrimary": false
    }
  ],
  "habitat": "Elbowpatch Crust occurs on dead hardwood branches and logs, particularly oak and beech, in moist woodland environments throughout New England.",
