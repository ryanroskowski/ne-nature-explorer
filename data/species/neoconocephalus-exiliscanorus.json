  "nameStory": "",
  "description": "The Slightly Musical Conehead Katydid is a slender, green insect belonging to the katydid family, characterized by its cone-shaped head and relatively quiet acoustic signals. Found throughout New England, this species is primarily nocturnal and feeds on plants and insects.",
  "idTips": [
    {
      "label": "Conical Head",
      "description": "Distinctive pointed, cone-shaped head that extends forward, giving the insect its 'conehead' name",
      "isPrimary": true
    },
    {
      "label": "Wing Pattern",
      "description": "Long, narrow wings that extend well beyond the abdomen with a slight greenish coloration",
      "isPrimary": false
    },
    {
      "label": "Body Color",
      "description": "Predominantly pale green body with a lean, elongated physique",
      "isPrimary": false
    }
  ],
  "habitat": "This katydid inhabits tall grasses, weeds, and shrubby vegetation in meadows, field edges, and woodland margins throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many loud katydids, the Slightly Musical Conehead produces only subtle, quiet chirping sounds that are often difficult for humans to hear without amplification equipment.",
