  "nameStory": "",
  "description": "Ashen coral (Tremellodendropsis tuberosa) is a gelatinous fungus in the Tremellodendropsidaceae family, characterized by its pale, branching fruiting bodies that resemble delicate corals. This jelly fungus is found primarily in New England and other temperate regions, fruiting on decaying wood and leaf litter.",
  "idTips": [
    {
      "label": "Gelatinous texture",
      "description": "The fruiting body has a wet, rubbery, translucent appearance that becomes firm when dry",
      "isPrimary": true
    },
    {
      "label": "Coral-like branching",
      "description": "Features delicate, repeatedly forked branches creating an intricate, antler-like or fan-like structure",
      "isPrimary": false
    },
    {
      "label": "Pale coloration",
      "description": "Typically white, cream, or ashen gray in color, distinguishing it from more brightly colored jelly fungi",
      "isPrimary": false
    }
  ],
  "habitat": "Ashen coral grows on decaying hardwood logs, branches, and moist leaf litter in mixed forests and woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other tremelloid fungi, ashen coral is composed of gelatinous cells that can rapidly rehydrate after drying, allowing it to revive and continue fruiting after rain.",
