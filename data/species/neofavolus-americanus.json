  "nameStory": "",
  "description": "Neofavolus americanus, commonly known as the American Hexagonal-pored Polypore, is a wood-decaying bracket fungus that forms distinctive shelf-like fruiting bodies on hardwood trees. This species is characterized by its unique hexagonal pore structure and is found throughout New England, where it plays an important ecological role as a decomposer.",
  "idTips": [
    {
      "label": "Hexagonal Pores",
      "description": "The underside features large, distinctive hexagonal or angular pores rather than round ones, which is the most reliable distinguishing feature of this species.",
      "isPrimary": true
    },
    {
      "label": "Bracket Shape",
      "description": "Forms hard, woody, fan-shaped or shelf-like fruiting bodies that project horizontally from tree trunks, typically without a stem.",
      "isPrimary": false
    },
    {
      "label": "Pale to Tan Coloring",
      "description": "The upper surface is typically pale cream to tan colored, often with a yellowish or brownish tinge, and becomes darker or stained with age.",
      "isPrimary": false
    }
  ],
  "habitat": "Neofavolus americanus grows on dead or dying hardwood trees, particularly oak, beech, and maple, in forests and wooded areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The hexagonal pore structure of this fungus is a fascinating example of nature's geometric efficiency, allowing the fungus to release spores through optimally-shaped openings while maintaining structural strength in the fruiting body.",
