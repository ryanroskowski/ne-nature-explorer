  "nameStory": "",
  "description": "Arrhenia epichysium, commonly known as the brown goblet, is a small woodland fungus belonging to the Waxcaps and Allies family (Hygrocybaceae). It is characterized by its delicate, cup-shaped fruiting bodies and is found in moist forest environments throughout New England.",
  "idTips": [
    {
      "label": "Goblet Shape",
      "description": "Distinctive funnel or goblet-shaped fruiting body with a thin, fragile structure",
      "isPrimary": true
    },
    {
      "label": "Brown Coloration",
      "description": "Grayish-brown to dark brown cap and stem with a slightly darker center",
      "isPrimary": false
    },
    {
      "label": "Decurrent Ridges",
      "description": "Blunt, widely-spaced gill-like ridges that run down the stem rather than true gills",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives in moist, shaded areas of deciduous and mixed forests, often found among mosses and leaf litter on well-established forest floors in New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its small size and delicate appearance, Arrhenia epichysium is a decomposer that plays an important role in breaking down organic matter in forest ecosystems, contributing to nutrient cycling.",
