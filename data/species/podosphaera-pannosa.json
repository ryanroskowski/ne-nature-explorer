  "nameStory": "",
  "description": "Rose Powdery Mildew (Podosphaera pannosa) is a fungal disease that affects roses and related plants, characterized by a white powdery coating on leaves, stems, and flowers. This obligate parasite thrives in moderate temperatures and can severely impact plant aesthetics and vigor if left untreated.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish powder covering leaf surfaces, typically on the upper side but can appear on both sides",
      "isPrimary": true
    },
    {
      "label": "Affected Plant Parts",
      "description": "Young leaves, shoots, flower buds, and petals are most susceptible and show the coating early in infection",
      "isPrimary": false
    },
    {
      "label": "Curling and Distortion",
      "description": "Infected leaves often curl, pucker, or become stunted with a grayish discoloration beneath the powdery growth",
      "isPrimary": false
    }
  ],
  "habitat": "Rose Powdery Mildew thrives in New England gardens on cultivated and wild roses, particularly in areas with moderate temperatures (60-75°F), high humidity, and poor air circulation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews, Podosphaera pannosa produces spores year-round on infected plant material, making it capable of surviving New England winters on dormant rose canes.",
  "confusionNotes": null,
