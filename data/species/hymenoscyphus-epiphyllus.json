  "nameStory": "",
  "description": "Hymenoscyphus epiphyllus is a small ascomycete fungus in the Helotiaceae family, characterized by its delicate cup-shaped fruiting bodies. This species is commonly found throughout New England where it plays a role in the decomposition of leaf litter and woody debris.",
  "idTips": [
    {
      "label": "Cup-shaped fruiting bodies",
      "description": "Produces small, translucent to whitish apothecia (cup-shaped structures) typically 1-3 mm in diameter",
      "isPrimary": true
    },
    {
      "label": "Epiphyllous growth",
      "description": "Grows on the surface of decaying leaves, particularly on the upper leaf surface, giving it its species name",
      "isPrimary": false
    },
    {
      "label": "Hairlike setae",
      "description": "Features distinctive hair-like structures (setae) around the cup margin when viewed under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Hymenoscyphus epiphyllus thrives in moist, shaded forest floors and woodlands of New England where it decomposes fallen leaves and leaf debris on the ground.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'epiphyllus' literally means 'upon the leaf,' referencing the fungus's habit of fruiting directly on decaying leaf surfaces rather than within the soil.",
