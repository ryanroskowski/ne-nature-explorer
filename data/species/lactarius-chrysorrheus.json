  "nameStory": "",
  "description": "The Yellowdrop Milkcap is a small to medium-sized fungus characterized by its distinctive yellow milk (latex) that stains and may turn greenish over time. This mycorrhizal species belongs to the Lactarius genus, known for their milky secretions when cut or bruised.",
  "idTips": [
    {
      "label": "Yellow Latex",
      "description": "Fresh cuts or bruises reveal bright yellow milk that may oxidize to greenish-yellow or green, making this the most reliable identifying feature",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "Typically pale yellowish to buff-colored cap with a convex shape and often a slightly depressed center at maturity",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "Gills are adnate to slightly decurrent and may have a faintly yellowish hue, helping distinguish from similar milkcaps",
      "isPrimary": false
    }
  ],
  "habitat": "Found in New England woodlands forming mycorrhizal relationships with hardwoods and mixed forests, fruiting from summer through fall in moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The yellow latex of this milkcap oxidizes to green when exposed to air, creating a color-changing effect that is both a useful identification tool and a visually striking natural chemistry demonstration.",
  "confusionNotes": null,
