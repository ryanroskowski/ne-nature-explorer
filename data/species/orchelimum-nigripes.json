  "nameStory": "",
  "description": "The Black-legged Meadow Katydid is a medium-sized insect belonging to the Tettigoniidae family (katydids), characterized by its distinctive dark legs and green coloration. This species is commonly found throughout New England meadows and grasslands during late summer and fall.",
  "idTips": [
    {
      "label": "Black Legs",
      "description": "The most distinctive feature is the dark or black coloration on the hind legs, which contrasts sharply with the green body.",
      "isPrimary": true
    },
    {
      "label": "Green Body",
      "description": "The insect displays predominantly green coloration on its body and wings, providing camouflage in grassy environments.",
      "isPrimary": false
    },
    {
      "label": "Long Antennae",
      "description": "Like all katydids, it possesses notably long antennae that are often as long as or longer than the body.",
      "isPrimary": false
    }
  ],
  "habitat": "Black-legged Meadow Katydids thrive in open meadows, grasslands, and weedy fields throughout New England where vegetation provides adequate cover and food sources.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Black-legged Meadow Katydids produce their distinctive chirping calls by rubbing their wings together, and they use these sounds primarily to attract females during the breeding season in late summer.",
