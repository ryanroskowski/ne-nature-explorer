  "nameStory": "",
  "description": "The Bunch Grass Locust (Pseudopomala brachyptera) is a small to medium-sized grasshopper belonging to the Short-horned Grasshoppers family (Acrididae), native to New England and eastern North America. This species is characterized by its relatively short wings and preference for open, grassy habitats.",
  "idTips": [
    {
      "label": "Short Wings",
      "description": "Notably shortened wings that do not fully extend to the abdomen, giving it a compact appearance compared to long-winged grasshopper species.",
      "isPrimary": true
    },
    {
      "label": "Coloration",
      "description": "Typically brown or tan with darker markings on the face and legs, providing excellent camouflage in dried grass and vegetation.",
      "isPrimary": false
    },
    {
      "label": "Antenna Length",
      "description": "Relatively short antennae compared to long-horned grasshoppers, consistent with the Short-horned Grasshopper family characteristic.",
      "isPrimary": false
    }
  ],
  "habitat": "Bunch Grass Locusts inhabit open, dry grasslands, meadows, and prairie-like areas throughout New England, preferring areas with sparse vegetation and exposed soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many other grasshoppers, Bunch Grass Locusts produce sounds primarily through leg-rubbing rather than wing-rubbing, creating distinctive chirping calls during late summer and early fall.",
