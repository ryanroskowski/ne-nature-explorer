  "nameStory": "",
  "description": "The Blue Cheese Polypore is a small, bracket fungus characterized by its distinctive blue-gray coloring and delicate, shelf-like fruiting bodies. Named for its striking blue hues, this polypore is a wood-decaying fungus commonly found throughout New England's forests.",
  "idTips": [
    {
      "label": "Blue-gray coloring",
      "description": "Upper surface displays distinctive blue-gray to slate-blue tones, sometimes with whitish margins",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Fruiting bodies are typically 1-3 cm wide, creating delicate, thin brackets on wood",
      "isPrimary": false
    },
    {
      "label": "Pore surface",
      "description": "Underside features pale to whitish pores that may become stained or discolored with age",
      "isPrimary": false
    }
  ],
  "habitat": "Blue Cheese Polypore grows on dead hardwood and softwood logs in moist forests, woodlands, and areas with adequate shade and humidity typical of New England ecosystems.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The striking blue coloration in this fungus is produced by a rare pigment compound, making it one of nature's most visually distinctive wood-decay fungi.",
