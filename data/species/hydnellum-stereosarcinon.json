  "nameStory": "",
  "description": "Stereo Tooth (Hydnellum stereosarcinon) is a small woodland fungus belonging to the Boletopsidaceae family, characterized by its delicate structure and microscopic features. This species is found in the New England region where it plays a role in forest ecosystems as a wood decomposer.",
  "idTips": [
    {
      "label": "Spore-bearing teeth",
      "description": "Features distinctive tooth-like or spine-like structures (hydnoid spores) on the underside rather than gills or pores, which is the defining characteristic of Hydnellum species",
      "isPrimary": true
    },
    {
      "label": "Small fruiting body size",
      "description": "Produces small, delicate fruiting bodies that are easily overlooked on the forest floor, typically just a few centimeters in width",
      "isPrimary": false
    },
    {
      "label": "Pale coloration",
      "description": "Generally displays whitish to pale cream or tan coloring on both the cap and teeth, distinguishing it from darker Hydnellum species",
      "isPrimary": false
    }
  ],
  "habitat": "Stereo Tooth is found on decaying wood and leaf litter in mixed deciduous and coniferous forests throughout New England, preferring moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other members of the Boletopsidaceae family, Hydnellum stereosarcinon produces tooth-like spore structures rather than the gills or pores seen in typical mushrooms, representing an ancient fungal body form.",
