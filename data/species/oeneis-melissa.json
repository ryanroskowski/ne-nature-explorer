  "nameStory": "",
  "description": "The Melissa Arctic is a small, cryptically-colored butterfly in the Nymphalidae family, characterized by muted brown and gray tones that provide excellent camouflage in its alpine environment. Found in the mountains of New England, this species is adapted to cold climates and short growing seasons at high elevations.",
  "idTips": [
    {
      "label": "Eyespot Pattern",
      "description": "Small, circular eyespots on the hindwings are a key diagnostic feature, typically appearing as dark rings with lighter centers",
      "isPrimary": true
    },
    {
      "label": "Wing Color",
      "description": "Predominantly dull brown to grayish coloration on both wings with subtle tan or buff markings that blend with rocky terrain",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Noticeably smaller than many other New England butterflies, with a wingspan typically under 2 inches",
      "isPrimary": false
    }
  ],
  "habitat": "The Melissa Arctic inhabits rocky alpine tundra and high-elevation meadows above the treeline in northern New England mountains, particularly in harsh, wind-exposed environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Melissa Arctic is one of the few butterfly species in New England that survives in extreme alpine conditions, where it has adapted to complete its entire life cycle during the brief Arctic summer.",
