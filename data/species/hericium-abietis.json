  "nameStory": "",
  "description": "Bear's Head (Hericium abietis) is a striking white or cream-colored fungus belonging to the Tooth Fungi family, characterized by its distinctive cascading, icicle-like spines. This edible species is prized by foragers for its delicate, seafood-like flavor and tender texture.",
  "idTips": [
    {
      "label": "Hanging Spines",
      "description": "Long, thin, tooth-like spines hang downward from the fruiting body, resembling icicles or a bear's shaggy head",
      "isPrimary": true
    },
    {
      "label": "Color",
      "description": "White to cream-colored when fresh, sometimes developing yellow or tan tones with age",
      "isPrimary": false
    },
    {
      "label": "Branching Structure",
      "description": "Features a highly branched, cascading form with spine-covered branches extending from a central base",
      "isPrimary": false
    }
  ],
  "habitat": "Found on dead or dying conifer trees, particularly firs and spruce, in cool, moist forests throughout New England.",
  "seasonality": {
    "spring": "",
