  "nameStory": "",
  "description": "Cystodermella cinnabarina, commonly known as the cinnabar powdercap, is a small mushroom characterized by its distinctive reddish to brick-red coloring and fine, powdery texture. This fungus is found in New England and belongs to a family of fungi with unique spore characteristics that aid in identification.",
  "idTips": [
    {
      "label": "Cinnabar-red coloring",
      "description": "Distinctive brick-red to reddish-orange cap surface that is the defining characteristic of the species",
      "isPrimary": true
    },
    {
      "label": "Powdery texture",
      "description": "Fine granular or powdery coating on the cap that is easily wiped away, giving it a distinctive feel",
      "isPrimary": false
    },
    {
      "label": "Small size with white gills",
      "description": "Typically small fruiting bodies with white to pale gills that are free or nearly free from the stem",
      "isPrimary": false
    }
  ],
  "habitat": "Cystodermella cinnabarina grows in mossy areas, leaf litter, and decaying wood in mixed forests and woodland floors throughout New England.",
