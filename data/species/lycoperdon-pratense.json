  "nameStory": "",
  "description": "Meadow Puffball is a small, round fungus that releases spores through a central pore when mature, creating the characteristic 'puffing' effect that gives the family its name. This species is commonly found in grassy areas throughout New England during late summer and fall.",
  "idTips": [
    {
      "label": "Small rounded shape",
      "description": "Typically 1-3 cm in diameter with a nearly spherical to slightly flattened form",
      "isPrimary": false
    },
    {
      "label": "Central spore opening",
      "description": "A single pore at the top opens to release spores when the fruiting body matures and dries",
      "isPrimary": true
    },
    {
      "label": "Whitish to tan color",
      "description": "Young specimens are pale white, gradually becoming tan or brown with age",
      "isPrimary": false
    }
  ],
  "habitat": "Meadow Puffball thrives in open grasslands, meadows, and pastures with well-established turf throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "When mature and squeezed, Meadow Puffballs release a visible cloud of spores—a mechanism that helped early naturalists understand how fungi spread their microscopic reproductive cells.",
