  "nameStory": "",
  "description": "Frosted Comma Lichen (Chrysothrix caesia) is a crustose lichen belonging to the Chrysotrichaceae family, characterized by its distinctive pale, powdery appearance. This small lichen is commonly found in New England and thrives in moist, shaded environments.",
  "idTips": [
    {
      "label": "Frosted Appearance",
      "description": "The thallus has a white to pale gray, granular or powdery surface that resembles frost or hoarfrost",
      "isPrimary": true
    },
    {
      "label": "Comma-shaped Soredia",
      "description": "Produces small, comma-shaped asexual reproductive units (soredia) scattered across the surface",
      "isPrimary": false
    },
    {
      "label": "Small Crustose Form",
      "description": "Forms thin, tightly adherent crusts on rock and bark surfaces, typically less than 1 cm in height",
      "isPrimary": false
    }
  ],
  "habitat": "Frosted Comma Lichen grows on moist, shaded rocks, boulders, and occasionally tree bark in humid forests and woodland areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The powdery appearance of Chrysothrix caesia comes from its soredia, which are specialized structures that allow the lichen to reproduce asexually and spread efficiently through wind dispersal.",
