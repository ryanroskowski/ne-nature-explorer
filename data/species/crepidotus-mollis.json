  "nameStory": "",
  "description": "The Peeling Oysterling (Crepidotus mollis) is a small, gelatinous fungus characterized by its delicate, cream to pale brown coloring and tendency to curl or peel at the edges when dry. This common decomposer in New England typically grows on decaying wood and is notable for its soft, jelly-like texture.",
  "idTips": [
    {
      "label": "Gills and Spore Print",
      "description": "Features crowded, thin gills that are attached to a stub rather than the stem, with a rusty-brown spore print that distinguishes it from similar species",
      "isPrimary": true
    },
    {
      "label": "Texture and Appearance",
      "description": "Small caps (typically 1-3 cm) with a distinctly gelatinous, translucent texture that becomes papery and peels at the margins when dried",
      "isPrimary": false
    },
    {
      "label": "Growth Pattern",
      "description": "Usually grows in shelving formations on rotting hardwood logs and branches, often in moist conditions",
      "isPrimary": false
    }
  ],
  "habitat": "Peeling Oysterlings thrive on dead hardwood, particularly logs and fallen branches in moist, shaded woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its delicate, fragile appearance, Crepidotus mollis is an efficient wood decomposer that plays an important ecological role in breaking down dead trees and recycling nutrients back into forest ecosystems.",
