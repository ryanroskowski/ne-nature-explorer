  "nameStory": "",
  "description": "Epeolus minimus, the Least Cellophane-cuckoo Bee, is a small parasitic bee in the Apidae family that doesn't collect pollen or nectar itself. Instead, it lays its eggs in the nests of other bee species, particularly sweat bees, making it a cuckoo or kleptoparasitic bee.",
  "idTips": [
    {
      "label": "Small Size",
      "description": "One of the smallest Epeolus species, typically 4-6 mm in length",
      "isPrimary": false
    },
    {
      "label": "Cellophane-like Wings",
      "description": "Clear, translucent wings with a characteristic cellophane appearance that gives the genus its common name",
      "isPrimary": true
    },
    {
      "label": "Yellow and Black Banding",
      "description": "Alternating bands of yellow and dark coloring on the abdomen, typical of Epeolus species",
      "isPrimary": false
    }
  ],
  "habitat": "Found in New England meadows, gardens, and open areas where host bee species nest in sandy or bare soil substrates.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike most bees, the Least Cellophane-cuckoo Bee is a brood parasite—it sneaks into the nests of solitary bees and lays its eggs so the host bee raises the cuckoo bee's offspring instead of its own.",
