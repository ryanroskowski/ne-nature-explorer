  "nameStory": "",
  "description": "Donkia pulcherrima is a wood-decay fungus belonging to the Phanerochaetaceae family, characterized by its distinctive appearance and ecological role as a decomposer. This species is notable for its presence in New England forests where it plays an important role in nutrient cycling.",
  "idTips": [
    {
      "label": "Pore Surface",
      "description": "Features small, angular pores on the underside of the fruiting body that are typically white to cream-colored",
      "isPrimary": true
    },
    {
      "label": "Texture and Color",
      "description": "The upper surface is often decorative with varied coloration, ranging from pale to darker tones, giving it an attractive appearance",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "Primarily found on hardwood logs and dead wood, preferring decaying deciduous trees",
      "isPrimary": false
    }
  ],
  "habitat": "Donkia pulcherrima grows on dead hardwood, particularly on fallen logs and decaying branches in moist forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a member of the Phanerochaetaceae family, this fungus is capable of producing powerful enzymes that break down lignin, making it one of nature's most efficient wood decomposers.",
