  "nameStory": "",
  "description": "Velvet Tooth (Hydnellum spongiosipes) is a small woodland fungus characterized by its velvety cap and delicate tooth-like spines beneath the surface. This species belongs to the Boletopsidaceae family and is commonly found in the moist forests of New England during late summer and fall.",
  "idTips": [
    {
      "label": "Velvety Cap Texture",
      "description": "The cap surface has a distinctive soft, velvety appearance with a dark brown to gray coloration",
      "isPrimary": true
    },
    {
      "label": "Tooth-like Spines",
      "description": "Underneath the cap are fine, brittle spines (teeth) rather than gills that readily stain reddish-brown when bruised",
      "isPrimary": false
    },
    {
      "label": "Spongy Base",
      "description": "The stem is characteristically spongy and fragile with similar coloring to the cap",
      "isPrimary": false
    }
  ],
  "habitat": "Velvet Tooth grows on the forest floor in mixed hardwood and coniferous forests of New England, preferring moist, well-established woodlands with rich organic matter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many fungi, Hydnellum spongiosipes produces teeth instead of gills for spore dispersal, making it a member of the tooth fungi group that evolved separately from traditional gill-bearing mushrooms.",
  "confusionNotes": null,
