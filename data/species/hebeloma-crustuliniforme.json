  "nameStory": "",
  "description": "Poison Pie (Hebeloma crustuliniforme) is a small, brown mushroom with a distinctive radish-like odor and a characteristic rim of moisture-beaded gills. Despite its ominous common name, it is inedible rather than dangerously toxic, though it can cause gastrointestinal upset if consumed.",
  "idTips": [
    {
      "label": "Radish Odor",
      "description": "Emits a distinctive, strong smell resembling raw radish or horseradish, which is the most reliable identifying feature",
      "isPrimary": true
    },
    {
      "label": "Beaded Gills",
      "description": "Gill edges display characteristic droplets or beads of moisture (guttation), especially visible on young specimens",
      "isPrimary": false
    },
    {
      "label": "Cap and Color",
      "description": "Small brownish cap (1-3 inches) with a pale, often frosted or silvery appearance at the margin",
      "isPrimary": false
    }
  ],
  "habitat": "Poison Pie grows on the forest floor in mixed hardwood and coniferous forests throughout New England, typically fruiting in spring and fall near rotting wood and rich soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Hebeloma derives from Greek words meaning 'youth' and 'fringe,' referencing the distinctive beaded water droplets that hang from the gill edges like a decorative border.",
  "confusionNotes": null,
