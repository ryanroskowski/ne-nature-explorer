  "nameStory": "",
  "description": "The Prairie Meadow Katydid is a medium-sized orthopteran insect belonging to the family Tettigoniidae, characterized by its elongated body and specialized sound-producing organs. This species is commonly found throughout New England meadows and grasslands, where it plays an important ecological role as both herbivore and prey for various predators.",
  "idTips": [
    {
      "label": "Long, thread-like antennae",
      "description": "Distinctive antennae that are much longer than the body, used for sensory detection",
      "isPrimary": false
    },
    {
      "label": "Leaf-like wings (tegmina)",
      "description": "Wings that closely resemble green leaves, providing camouflage in vegetation",
      "isPrimary": true
    },
    {
      "label": "Ovipositor in females",
      "description": "Females possess a prominent, sword-like ovipositor extending from the abdomen",
      "isPrimary": false
    }
  ],
  "habitat": "Prairie Meadow Katydids inhabit open grasslands, meadows, and weedy fields throughout New England, preferring areas with dense herbaceous vegetation.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male katydids produce their characteristic chirping sounds by rubbing their wings together in a process called stridulation, with each species having a unique call pattern used to attract mates.",
