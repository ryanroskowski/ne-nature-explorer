  "nameStory": "",
  "description": "Sprucecone cap (Strobilurus esculentus) is a small, delicate mushroom in the Physalacriaceae family that frusts directly from spruce and fir cones in New England forests. Despite its modest size, it is edible and prized by foragers for its delicate flavor.",
  "idTips": [
    {
      "label": "Growing from cones",
      "description": "Fruiting bodies emerge directly from fallen conifer cones, particularly spruce and fir, which is the most distinctive feature.",
      "isPrimary": true
    },
    {
      "label": "Cap appearance",
      "description": "Small tan to reddish-brown caps, typically 0.5-1.5 cm wide, with a delicate, convex shape.",
      "isPrimary": false
    },
    {
      "label": "Pale gills and slender stem",
      "description": "Features crowded, whitish to pale yellow gills and a thin, hollow stem that connects directly to the cone substrate.",
      "isPrimary": false
    }
  ],
  "habitat": "Found in New England coniferous and mixed forests on moist, decaying spruce and fir cones on the forest floor, typically fruiting in spring and early summer.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Strobilurus esculentus is one of the few mushrooms that has evolved to fruit exclusively from cone substrates, making it a fascinating example of specialized fungal adaptation to a specific ecological niche.",
