  "nameStory": "",
  "description": "Cracked Cap Polypore is a wood-decay fungus that forms small, hard shelf-like fruiting bodies on dead hardwood trees. It belongs to the Hymenochaetaceae family, a group of fungi known for their typically brown coloring and role in decomposing woody substrates.",
  "idTips": [
    {
      "label": "Cracked Cap Surface",
      "description": "The top surface displays a distinctive pattern of radial cracks or fissures, creating a mosaic-like appearance that gives the fungus its common name.",
      "isPrimary": true
    },
    {
      "label": "Reddish-Brown Color",
      "description": "The fruiting body typically exhibits warm reddish-brown to tawny coloring, which may darken with age.",
      "isPrimary": false
    },
    {
      "label": "Small, Hard Brackets",
      "description": "Forms small, shelf-like polypores (1-3 cm wide) that are extremely hard and brittle, often found in overlapping clusters.",
      "isPrimary": false
    }
  ],
  "habitat": "Cracked Cap Polypore grows on dead or dying hardwoods, particularly black locust and other legume species, in the forests and woodlands of New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is a specialist decomposer with a particular affinity for black locust wood, making it an important ecological indicator of dead hardwood diversity in eastern North American forests.",
