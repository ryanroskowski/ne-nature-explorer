  "nameStory": "",
  "description": "Hoplitis producta, commonly known as the Produced Small Mason Bee, is a solitary bee species belonging to the family Megachilidae, which includes mason, leafcutter, carder, and resin bees. This small native bee is found throughout New England and plays an important role in pollinating native plants and crops.",
  "idTips": [
    {
      "label": "Body Size and Color",
      "description": "Hoplitis producta is a small bee, typically 8-10mm in length, with a dark body and sparse pale hair",
      "isPrimary": false
    },
    {
      "label": "Abdominal Scopa",
      "description": "Like other mason bees, females have a distinctive brush of hairs (scopa) on the underside of the abdomen used to collect and carry pollen",
      "isPrimary": true
    },
    {
      "label": "Face Structure",
      "description": "The bee has a relatively broad face with closely-spaced eyes, characteristic of Hoplitis genus members",
      "isPrimary": false
    }
  ],
  "habitat": "Hoplitis producta inhabits gardens, meadows, and woodland edges throughout New England where native flowering plants and suitable nesting cavities are available.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other mason bees, Hoplitis producta females create individual nesting chambers in natural cavities or hollow stems, provisioning each cell with pollen and nectar before sealing it with mud or plant material.",
