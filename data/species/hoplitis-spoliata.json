  "nameStory": "",
  "description": "Hoplitis spoliata, commonly known as the Dilated-horned Small Mason bee, is a solitary bee species belonging to the family Megachilidae, which includes mason, leafcutter, carder, and resin bees. This small bee is found throughout New England and is an important native pollinator for wild plants and gardens.",
  "idTips": [
    {
      "label": "Dilated horns",
      "description": "Males have distinctively enlarged or dilated antennae (horns), which is the characteristic that gives this species its common name",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "This species is relatively small compared to other mason bees, making it easily distinguishable from larger Hoplitis species",
      "isPrimary": false
    },
    {
      "label": "Dark coloration",
      "description": "The bee typically has a dark brown to black body with minimal body hair, giving it a sleek appearance",
      "isPrimary": false
    }
  ],
  "habitat": "Hoplitis spoliata prefers open, sunny areas with flowering plants and access to nesting sites such as hollow stems, reeds, or pre-made bee houses throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike honeybees, male mason bees emerge first in spring and wait for females to appear, using their enlarged antennae to detect pheromones and locate potential mates.",
