  "nameStory": "",
  "description": "Pluteus atromarginatus, commonly known as the blackedged shield, is a small wood-decomposing mushroom characterized by its distinctive dark-margined caps and free gills. This species belongs to the Pluteaceae family and is notable for its ecological role in breaking down dead wood in forest ecosystems.",
  "idTips": [
    {
      "label": "Dark gill edges",
      "description": "The gill edges are distinctly blackened or dark-colored, which is the most reliable distinguishing feature of this species",
      "isPrimary": true
    },
    {
      "label": "Cap appearance",
      "description": "Small, grayish to brownish caps (typically 2-5 cm) with darker margins that become more pronounced with age",
      "isPrimary": false
    },
    {
      "label": "Free gills",
      "description": "The gills are free (not attached to the stem) and whitish to pale pink, with notably darkened edges",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus fruits on decaying hardwood logs, stumps, and woody debris throughout New England's deciduous and mixed forests, typically appearing from spring through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The blackened gill edges are thought to result from spore maturation processes and give this delicate mushroom a distinctive appearance that helps distinguish it from other small Pluteus species in the field.",
