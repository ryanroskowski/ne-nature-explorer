  "nameStory": "",
  "description": "The Stygian Shadowdragon is a dark, medium-sized dragonfly endemic to New England wetlands and streams. Despite its common name suggesting mythical origins, it is a real species in the Emerald Dragonfly family known for its cryptic coloration and elusive behavior.",
  "idTips": [
    {
      "label": "Dark metallic coloration",
      "description": "Deep black to charcoal body with minimal iridescence, distinguishing it from brighter emerald relatives",
      "isPrimary": true
    },
    {
      "label": "Wing venation pattern",
      "description": "Distinctive dark pterostigma and reduced wing clarity compared to other dragonflies",
      "isPrimary": false
    },
    {
      "label": "Size and body shape",
      "description": "Relatively compact build, typically 35-42mm in length with a proportionally shorter abdomen",
      "isPrimary": false
    }
  ],
  "habitat": "The Stygian Shadowdragon inhabits clear, cool streams and acidic wetlands in forested regions throughout New England, preferring shaded areas with dense aquatic vegetation.",
