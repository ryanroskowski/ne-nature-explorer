  "nameStory": "",
  "description": "Benzoin Bracket is a woody polypore fungus that grows on hardwood trees throughout New England, identifiable by its distinctive aromatic compounds that smell like benzoin resin. This shelf fungus is a decomposer that plays an important ecological role in breaking down dead wood in forest ecosystems.",
  "idTips": [
    {
      "label": "Aromatic Scent",
      "description": "Fresh specimens emit a pleasant benzoin or balsamic resin-like odor, particularly when crushed or heated",
      "isPrimary": true
    },
    {
      "label": "Shelf-like Form",
      "description": "Grows as bracket or shelf-shaped fruiting bodies protruding from tree trunks, typically brown with a woody texture",
      "isPrimary": false
    },
    {
      "label": "Pore Surface",
      "description": "Underside displays small, cream-colored to tan pores rather than gills, characteristic of polypore fungi",
      "isPrimary": false
    }
  ],
  "habitat": "Benzoin Bracket colonizes dead or dying hardwood trees, particularly on oak, maple, and birch species in moist New England forests and woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The fungus's distinctive benzoin-like aroma comes from aromatic compounds in its fruiting body, which may help attract spore-dispersing insects and give the species its evocative common name.",
