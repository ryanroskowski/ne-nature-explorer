  "nameStory": "",
  "description": "Panus conchatus, commonly known as the Lilac Oysterling, is a small bracket fungus characterized by its delicate, fan-shaped fruiting bodies with a distinctive lilac to purple coloration. Despite its small size and thin flesh, this species is a wood-decay fungus that plays an important ecological role in decomposing dead hardwood.",
  "idTips": [
    {
      "label": "Color",
      "description": "Distinctive lilac, purple, or mauve coloring on the caps, sometimes fading to grayish with age",
      "isPrimary": true
    },
    {
      "label": "Cap Shape",
      "description": "Small, thin, fan or oyster-shaped fruiting bodies, typically 1-3 cm wide, often clustered or overlapping",
      "isPrimary": false
    },
    {
      "label": "Gills",
      "description": "Decurrent gills that run down the attachment point, appearing pale or whitish compared to the colored cap",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus is found on dead or dying hardwood, particularly oak and other deciduous trees in mixed and hardwood forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Lilac Oysterling is one of the few mushrooms with a distinctly purple hue, making it relatively easy to spot among the browns and whites of decaying wood once you know what to look for.",
