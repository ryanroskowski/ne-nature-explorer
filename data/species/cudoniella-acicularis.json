  "nameStory": "",
  "description": "Oak pin (Cudoniella acicularis) is a small fungal species belonging to the Tricladiaceae family, characterized by its delicate, pin-like fruiting structures. This wood-decaying fungus plays an important ecological role in New England forests by breaking down dead oak wood and other hardwoods.",
  "idTips": [
    {
      "label": "Pin-like fruiting bodies",
      "description": "Distinctive needle-shaped or awl-like ascomata that give the species its common name",
      "isPrimary": true
    },
    {
      "label": "Substrate preference",
      "description": "Typically found on decaying oak and other hardwood logs and branches",
      "isPrimary": false
    },
    {
      "label": "Microscopic features",
      "description": "Eight-spored asci and filiform ascospores visible under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Oak pin grows on dead hardwood substrates, particularly decaying oak logs and branches in moist forest environments throughout New England.",
