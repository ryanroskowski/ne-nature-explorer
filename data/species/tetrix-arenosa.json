  "nameStory": "",
  "description": "The Obscure Grouse Locust (Tetrix arenosa) is a small pygmy grasshopper found throughout New England, characterized by its cryptic coloration and diminutive size. These insects are ground-dwellers that blend seamlessly into their surroundings as a defense mechanism.",
  "idTips": [
    {
      "label": "Size",
      "description": "Extremely small, typically 7-10 mm in length, making it one of the smallest grasshoppers in the region",
      "isPrimary": false
    },
    {
      "label": "Pronotum Shape",
      "description": "The pronotum (thorax covering) extends back over the abdomen and has a distinctive conical or tent-like appearance",
      "isPrimary": true
    },
    {
      "label": "Coloration",
      "description": "Mottled gray, brown, or tan coloring that provides excellent camouflage against sandy or gravelly substrates",
      "isPrimary": false
    }
  ],
  "habitat": "Obscure Grouse Locusts prefer dry, sandy, or gravelly areas including dunes, beaches, and exposed ground near water bodies throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite their tiny size, pygmy grasshoppers like Tetrix arenosa can jump up to 40 times their body length when disturbed, making them remarkable jumpers relative to their diminutive stature.",
