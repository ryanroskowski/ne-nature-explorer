  "nameStory": "",
  "description": "Resupinatus applicatus, commonly known as Smoked Oysterling, is a small, delicate fungus characterized by its thin, fan-shaped fruiting bodies that typically grow in tiered clusters. Despite its name, it is not a true oyster mushroom but belongs to the Resupinataceae family and is edible, though small and not typically harvested.",
  "idTips": [
    {
      "label": "Gill Arrangement",
      "description": "Gills run from the point of attachment to the margin and are relatively distant from each other, a distinctive feature of the genus Resupinatus",
      "isPrimary": true
    },
    {
      "label": "Color and Texture",
      "description": "Caps are grayish-brown to smoky in color with a delicate, thin, papery texture that becomes darker with age or when dried",
      "isPrimary": false
    },
    {
      "label": "Size and Shape",
      "description": "Fruiting bodies are small (typically 0.5-2 inches across), fan or bracket-shaped, and grow in overlapping clusters on substrate",
      "isPrimary": false
    }
  ],
  "habitat": "Smoked Oysterling is found on dead hardwood logs, branches, and decaying woody debris throughout New England, preferring moist, shaded forest environments.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Resupinatus refers to the mushroom's upside-down appearance, as its gills and spore-producing surfaces are positioned on what would normally be considered the underside of a typical mushroom cap.",
