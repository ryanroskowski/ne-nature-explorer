  "nameStory": "",
  "description": "Trichaptum laricinum, commonly known as the larch polypore, is a wood-decay fungus in the Hymenochaetaceae family that produces distinctive fruiting bodies on conifer wood. This species is particularly notable for its prevalence on larch trees throughout New England and eastern North America.",
  "idTips": [
    {
      "label": "Pore Surface Color",
      "description": "The underside features small, angular pores that are typically yellow to orange, often darkening to reddish-brown or purple-brown with age or when bruised",
      "isPrimary": true
    },
    {
      "label": "Host Preference",
      "description": "Almost exclusively found on larch (Larix) species, making host identification a reliable field clue",
      "isPrimary": false
    },
    {
      "label": "Bracket Morphology",
      "description": "Forms thin, shelf-like brackets or crusts that are often lobed or wavy at the margins, with a rusty-brown to gray upper surface",
      "isPrimary": false
    }
  ],
  "habitat": "Trichaptum laricinum grows on dead or dying larch logs, stumps, and fallen branches in forests, woodlots, and landscaped areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The pores of this fungus can dramatically change color from yellow-orange to deep purple when scratched or bruised, a trait that makes it particularly useful for field identification.",
