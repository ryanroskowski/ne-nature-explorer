  "nameStory": "",
  "description": "Wart Lichen (Hydropunctaria maura) is a crustose lichen belonging to the Verrucariaceae family, characterized by its small, wart-like fruiting bodies embedded in a thin, dark crust. This species is commonly found in New England and other temperate regions where it colonizes rock surfaces and stone structures.",
  "idTips": [
    {
      "label": "Warty Perithecia",
      "description": "Distinctive small, wart-like or pustule-like bumps (perithecia) that protrude from or sit flush with the surface of the lichen crust, giving the species its common name",
      "isPrimary": true
    },
    {
      "label": "Dark Crust Color",
      "description": "Forms a thin, dark gray to black crustose thallus that tightly adheres to rock surfaces",
      "isPrimary": false
    },
    {
      "label": "Substrate Preference",
      "description": "Grows almost exclusively on siliceous rocks and stone, appearing as small discrete patches rather than extensive colonies",
      "isPrimary": false
    }
  ],
  "habitat": "Wart Lichen thrives on exposed siliceous rock surfaces, boulder faces, and stone walls in New England's temperate climate, preferring areas with good light exposure and moderate moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The perithecia of Hydropunctaria maura are technically fruiting bodies containing asci and spores, making them the lichen's reproductive structures—each tiny wart is essentially a miniature 'fruit'.",
