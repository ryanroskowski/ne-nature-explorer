  "nameStory": "",
  "description": "Peppery Bolete is a small to medium-sized fungus characterized by its reddish-brown cap and bright yellow pores underneath that bruise blue when touched. Despite its unpleasant peppery taste, it is not toxic but is considered inedible due to its intense, unpalatable flavor.",
  "idTips": [
    {
      "label": "Pores bruise blue",
      "description": "The yellow pores on the underside turn blue when pressed or handled, a distinctive feature of this species.",
      "isPrimary": true
    },
    {
      "label": "Reddish-brown cap",
      "description": "The cap is typically rusty-brown to reddish-brown and becomes paler with age.",
      "isPrimary": false
    },
    {
      "label": "Small, thin stem",
      "description": "The stem is thin, yellow above and reddish-brown below, often with no distinct ring.",
      "isPrimary": false
    }
  ],
  "habitat": "Peppery Bolete grows in acidic soils in coniferous and mixed forests throughout New England, appearing from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The species name 'piperatus' refers to its intensely peppery taste, which is so strong that merely tasting and spitting out a piece can leave your mouth burning for hours.",
