  "nameStory": "",
  "description": "Erysiphe vanbruntiana is a fungal pathogen belonging to the powdery mildews family that primarily affects woody plants and shrubs throughout New England. This obligate parasite forms characteristic white, powdery colonies on leaf surfaces, significantly impacting plant health and aesthetics.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to grayish powdery fungal growth covering leaf surfaces, which can be easily rubbed off with a finger",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Primarily infects members of the Rosaceae family, including hawthorn, serviceberry, and similar woody ornamentals",
      "isPrimary": false
    },
    {
      "label": "Cleistothecia Formation",
      "description": "Presence of small dark fruiting bodies embedded in the fungal mat, particularly visible in late season",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe vanbruntiana thrives in warm, dry conditions on the leaves of susceptible woody plants in woodlands, hedgerows, and cultivated gardens throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews that require high humidity, E. vanbruntiana actually prefers dry conditions and spreads efficiently through wind-dispersed spores even in arid periods.",
  "confusionNotes": null,
  "contextualKnowledge": null,
