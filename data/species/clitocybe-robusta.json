  "nameStory": "",
  "description": "Robust clitocybe (Clitocybe robusta) is a large, sturdy mushroom in the Clitocybaceae family, characterized by its thick, pale fruiting bodies and funnel-like cap. This species is commonly found in wooded areas throughout New England during fall months.",
  "idTips": [
    {
      "label": "Cap Shape",
      "description": "Large, convex to funnel-shaped cap that is whitish to pale tan, often becoming more depressed in the center with age",
      "isPrimary": true
    },
    {
      "label": "Gill Attachment",
      "description": "Decurrent gills (running down the stem) that are white to pale cream-colored and crowded together",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Thick, solid, white to pale stem that is often bulbous at the base and lacks a ring",
      "isPrimary": false
    }
  ],
  "habitat": "Robust clitocybe grows on the forest floor in mixed hardwood and coniferous forests throughout New England, fruiting from late summer through fall in moist leaf litter and rich soil.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its large, appetizing appearance, Clitocybe robusta is considered inedible to potentially toxic and should never be consumed, as it can cause gastrointestinal distress.",
