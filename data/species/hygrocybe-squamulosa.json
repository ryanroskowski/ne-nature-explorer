  "nameStory": "",
  "description": "Hygrocybe squamulosa, commonly known as the Scaly Waxcap, is a small to medium-sized mushroom characterized by its distinctive scaly or granular cap surface. This delicate fungus belongs to the Hygrocybaceae family and is notable for its colorful appearance and preference for mossy, grassy habitats.",
  "idTips": [
    {
      "label": "Scaly Cap Surface",
      "description": "The cap is covered with small, dark scales or granules on a lighter background, creating a distinctive textured appearance that gives the species its name.",
      "isPrimary": true
    },
    {
      "label": "Waxy Gills",
      "description": "Gills are typically pale yellow to whitish and have the characteristic waxy, smooth texture typical of waxcaps, distinguishing them from other fungi.",
      "isPrimary": false
    },
    {
      "label": "Small Fruiting Bodies",
      "description": "The mushrooms are relatively small, generally 1-3 cm in cap diameter, making them easy to overlook in the field.",
      "isPrimary": false
    }
  ],
  "habitat": "Hygrocybe squamulosa thrives in moist, mossy areas such as lawns, meadows, and grasslands throughout New England, particularly in undisturbed or semi-natural habitats.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Waxcaps like H. squamulosa are considered indicators of unimproved grasslands and are increasingly rare due to agricultural intensification, making them valuable for conservation assessment.",
  "confusionNotes": null,
