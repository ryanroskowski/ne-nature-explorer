  "nameStory": "",
  "description": "The Broad-tipped Conehead (Neoconocephalus triops) is a medium-sized katydid recognized by its distinctive cone-shaped head and characteristic song. This insect is an important part of New England's grassland ecosystems and is primarily active during late summer and fall.",
  "idTips": [
    {
      "label": "Broad, flattened cone-shaped head",
      "description": "The head tapers to a blunt, rounded point with a distinctive broad appearance that is wider than in related species",
      "isPrimary": true
    },
    {
      "label": "Three ocelli (simple eyes)",
      "description": "Look for three simple eyes arranged in a triangle on the head between the compound eyes, which gives the species its name 'triops'",
      "isPrimary": false
    },
    {
      "label": "Pale green to brown coloration",
      "description": "Body color ranges from light green to tan or brown, with wings that typically match the body color",
      "isPrimary": false
    }
  ],
  "habitat": "Broad-tipped Coneheads prefer open grasslands, meadows, and weedy fields throughout New England, thriving in areas with tall vegetation and moderate moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Broad-tipped Coneheads produce their distinctive buzzing calls by rubbing their wings together at frequencies around 20-30 kHz, creating the characteristic 'bzzzzzzt' sound heard in late summer evenings.",
  "confusionNotes": null,
