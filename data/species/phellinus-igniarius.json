  "nameStory": "",
  "description": "Phellinus igniarius, commonly known as Willow Bracket, is a wood-decay fungus that forms hard, hoof-shaped fruiting bodies on trees. This perennial polypore is a pathogenic species that causes white rot in its hosts, primarily willows and birches throughout New England.",
  "idTips": [
    {
      "label": "Fruiting Body Shape",
      "description": "Forms distinctive hoof or bracket-shaped fruiting bodies that are woody and hard, persisting on trees for many years",
      "isPrimary": true
    },
    {
      "label": "Pore Surface Color",
      "description": "Displays small, round pores on the underside that are cinnamon to dark brown, becoming darker with age",
      "isPrimary": false
    },
    {
      "label": "Host Preference",
      "description": "Most commonly found on willows and birches, helping distinguish it from closely related bracket fungi",
      "isPrimary": false
    }
  ],
  "habitat": "Willow Bracket grows on living and dead hardwood trees, particularly willows and birches, in forests and disturbed areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Historically, this fungus was used as tinder to start fires due to its flammable nature, earning it the scientific name 'igniarius' meaning 'fire-making.'",
