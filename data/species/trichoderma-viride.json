  "nameStory": "",
  "description": "Trichoderma viride is a filamentous fungus belonging to the Hypocreaceae family, commonly found in soil and decaying plant material throughout New England. This versatile organism is known for its antagonistic properties against plant pathogens and its applications in biocontrol and biotechnology.",
  "idTips": [
    {
      "label": "Green Spore Color",
      "description": "Produces distinctive green conidia (spores) that give colonies their characteristic green appearance, distinguishing it from other Trichoderma species.",
      "isPrimary": true
    },
    {
      "label": "Rapid Growth",
      "description": "Forms fast-growing, cottony colonies that quickly colonize growth media, often dominating petri dishes within days.",
      "isPrimary": false
    },
    {
      "label": "Characteristic Odor",
      "description": "Emits a distinctive coconut-like or musty smell due to volatile organic compounds it produces during growth.",
      "isPrimary": false
    }
  ],
  "habitat": "Trichoderma viride thrives in moist soil, decomposing wood, leaf litter, and compost throughout New England's temperate forest ecosystems.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This fungus is a prolific producer of cellulase enzymes and has been extensively studied for industrial applications, including biofuel production and textile manufacturing.",
