  "nameStory": "",
  "description": "Laxitextum bicolor is a small tooth fungus characterized by its distinctive two-toned coloration on the fruiting body. This wood-decay fungus belongs to the Hydnaceae family and is commonly found throughout New England's forests.",
  "idTips": [
    {
      "label": "Bicolor appearance",
      "description": "The cap displays contrasting light and dark zones, typically with a whitish upper surface and darker lower surface",
      "isPrimary": true
    },
    {
      "label": "Tooth-like spines",
      "description": "Fine, needle-like spines line the underside of the cap instead of traditional gills",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "Fruiting bodies are typically small, usually less than 3 cm in diameter",
      "isPrimary": false
    }
  ],
  "habitat": "Laxitextum bicolor grows on decaying hardwood logs and branches in moist, shaded forest environments throughout New England.",
