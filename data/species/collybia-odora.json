  "nameStory": "",
  "description": "The Aniseed Funnel (Collybia odora) is a small, delicate woodland mushroom recognizable by its distinctive anise or licorice-like aroma. This fungus is a common saprotroph found throughout New England, where it plays an important role in decomposing leaf litter and woody debris.",
  "idTips": [
    {
      "label": "Distinctive Aroma",
      "description": "Strong smell of anise or licorice when fresh, which is the primary identifying feature",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "Grayish-brown to olive-brown cap, typically 1-2 inches wide with a funnel-like depression in the center",
      "isPrimary": false
    },
    {
      "label": "Gill Appearance",
      "description": "Pale cream to grayish gills that run down the stem and are decurrent (extending down the stalk)",
      "isPrimary": false
    }
  ],
  "habitat": "This species thrives in mixed deciduous and coniferous forests of New England, growing in clusters among leaf litter, moss, and decaying wood from late summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The anise scent of Collybia odora is produced even after the mushroom has been dried for years, making it useful for long-term identification in herbarium collections.",
