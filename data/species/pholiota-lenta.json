  "nameStory": "",
  "description": "Pholiota lenta is a small woodland mushroom belonging to the Strophariaceae family, characterized by its delicate appearance and sticky cap surface. This species is commonly encountered in New England forests, particularly during wet seasons when moisture levels are favorable for fruiting.",
  "idTips": [
    {
      "label": "Sticky Cap",
      "description": "The cap is notably viscid (slimy) when moist, with a yellow to brownish color that becomes darker when wet",
      "isPrimary": true
    },
    {
      "label": "Attached Gills",
      "description": "Gills are crowded and attached to the stem, typically yellow-orange in color, becoming darker with age and spore maturation",
      "isPrimary": false
    },
    {
      "label": "Fibrous Stem",
      "description": "The stem is hollow or pithy, colored similarly to the cap, and may display remnants of a ring zone or small scales",
      "isPrimary": false
    }
  ],
  "habitat": "Pholiota lenta grows on rotting wood, leaf litter, and woody debris in mixed hardwood and coniferous forests throughout New England, fruiting from summer through fall.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The genus name Pholiota literally means 'scaly' due to the characteristic scale-like appearance found on many species in this group, though P. lenta displays this feature more subtly than its relatives.",
