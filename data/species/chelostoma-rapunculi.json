  "nameStory": "",
  "description": "The Rampion Scissor Bee (Chelostoma rapunculi) is a solitary bee species belonging to the family Megachilidae, which includes mason, leafcutter, carder, and resin bees. This small, dark bee is a specialist pollinator strongly associated with rampion plants (Campanula species) throughout New England.",
  "idTips": [
    {
      "label": "Body Color and Size",
      "description": "Small bee, typically 7-9mm long, with a predominantly black body and sparse hair coverage",
      "isPrimary": false
    },
    {
      "label": "Facial Features",
      "description": "Distinctive scissor-like mandibles that are notably large relative to head size, used for cutting plant material",
      "isPrimary": true
    },
    {
      "label": "Pollen Basket",
      "description": "Females display scopa (pollen-carrying hairs) on the underside of the abdomen rather than on hind legs like honeybees",
      "isPrimary": false
    }
  ],
  "habitat": "Rampion Scissor Bees are found in open meadows, gardens, and disturbed areas throughout New England where their host plant rampion (Campanula) blooms in late spring and summer.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This bee is an extreme specialist, with females gathering pollen almost exclusively from rampion flowers and nesting in pre-existing cavities in dead plant stems or wood.",
