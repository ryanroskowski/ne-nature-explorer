  "nameStory": "",
  "description": "Rhytisma decolorans is a fungal pathogen that causes leaf spotting on various hardwood trees, particularly maples and sycamores, throughout New England. This ascomycete fungus creates distinctive dark lesions on host leaves during the growing season.",
  "idTips": [
    {
      "label": "Dark Leaf Lesions",
      "description": "Look for irregular, dark brown to black spots or streaks that develop on the upper surface of leaves, often with a somewhat sunken appearance.",
      "isPrimary": true
    },
    {
      "label": "Host Preference",
      "description": "Most commonly found on maple (Acer) species and sycamore (Platanus) trees in northeastern forests and landscapes.",
      "isPrimary": false
    },
    {
      "label": "Seasonal Timing",
      "description": "Symptoms become most visible in late summer and fall as lesions darken and become more prominent on living foliage.",
      "isPrimary": false
    }
  ],
  "habitat": "Rhytisma decolorans thrives in moist, wooded areas and landscapes of New England where susceptible hardwood hosts grow, particularly in regions with adequate humidity during the growing season.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike some of its relatives in the Rhytismataceae family, Rhytisma decolorans does not produce the prominent black, tar-like fruiting structures (stromata) that characterize other Rhytisma species, making it more subtle in appearance.",
