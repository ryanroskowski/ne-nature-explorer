  "nameStory": "",
  "description": "Wood Pinkgill (Entoloma rhodopolium) is a small, delicate mushroom characterized by its pale grayish-brown cap and distinctive pink gills that develop as the fungus matures. This species belongs to the Entolomataceae family and is commonly encountered in woodlands throughout New England.",
  "idTips": [
    {
      "label": "Pink Gills",
      "description": "Gills start white or pale and gradually turn pink to salmon-colored as the mushroom ages, which is the defining feature of the genus Entoloma",
      "isPrimary": true
    },
    {
      "label": "Cap Color and Texture",
      "description": "Small grayish-brown to silvery-gray cap (1-4 cm diameter) with a slightly hygrophanous appearance that darkens when wet",
      "isPrimary": false
    },
    {
      "label": "Angular Gill Edges",
      "description": "Gills are notably angular and often unequal in length, a characteristic trait of Entoloma species",
      "isPrimary": false
    }
  ],
  "habitat": "Wood Pinkgill grows on decaying wood, leaf litter, and mossy areas in deciduous and mixed forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many Entoloma species, Wood Pinkgill has angular spores visible under a microscope, a unique feature that helps mycologists distinguish this genus from other pink-gilled mushrooms.",
  "confusionNotes": null,
  "contextualKnowledge": null,
