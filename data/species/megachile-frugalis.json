  "nameStory": "",
  "description": "Megachile frugalis is a solitary leafcutter bee species native to New England that plays an important role in pollinating wildflowers and garden plants. Despite their name, these bees are gentle and non-aggressive, making them valuable native pollinators in residential and natural areas.",
  "idTips": [
    {
      "label": "Leaf-Cutting Behavior",
      "description": "Look for precise, semicircular cuts in leaves of roses, lilacs, and other plants—a distinctive signature of leafcutter bees gathering nesting material.",
      "isPrimary": true
    },
    {
      "label": "Body Structure",
      "description": "Medium-sized bee (12-15mm) with a dark body and visible pollen-carrying hairs (scopa) on the underside of the abdomen.",
      "isPrimary": false
    },
    {
      "label": "Nesting Sites",
      "description": "Often found nesting in hollow stems, dead wood cavities, or provided bee hotels rather than in ground nests.",
      "isPrimary": false
    }
  ],
  "habitat": "Megachile frugalis thrives in open woodlands, meadows, gardens, and areas with flowering plants in New England's temperate climate.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female leafcutter bees use their mandibles to cut precise leaf pieces, which they roll into cylindrical shapes and transport back to their nests to construct waterproof brood cells for their offspring.",
