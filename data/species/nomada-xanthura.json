  "nameStory": "",
  "description": "The Yellow-banded Nomad is a small cuckoo bee species in the Apidae family, characterized by distinctive yellow markings on its abdomen. These solitary bees are parasitic, laying their eggs in the nests of other bee species rather than constructing their own nests.",
  "idTips": [
    {
      "label": "Yellow abdominal bands",
      "description": "Bright yellow stripes alternate with dark brown or black segments on the abdomen",
      "isPrimary": true
    },
    {
      "label": "Small body size",
      "description": "Typically 8-10mm long, making it noticeably smaller than honey bees",
      "isPrimary": false
    },
    {
      "label": "Smooth, shiny appearance",
      "description": "Less hairy than bumble bees with a polished cuticle that reflects light",
      "isPrimary": false
    }
  ],
  "habitat": "Yellow-banded Nomads are found in open woodlands, meadows, and gardens throughout New England where their host bee species are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, Nomada xanthura is a brood parasite that sneaks into the nests of mining bees and other ground-nesting species, leaving its own larvae to be raised by the unsuspecting host parents.",
  "confusionNotes": null,
