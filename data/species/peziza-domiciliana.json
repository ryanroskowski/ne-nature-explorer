  "nameStory": "",
  "description": "The Home Cup (Peziza domiciliana) is a small, cup-shaped fungus belonging to the Ascomycota family, commonly found in damp indoor environments and disturbed soils throughout New England. Despite its indoor association, it also appears in gardens, greenhouses, and other moist habitats.",
  "idTips": [
    {
      "label": "Cup-shaped fruiting body",
      "description": "Distinctive shallow to deep cup or bowl shape, typically 0.5-2 cm in diameter with a smooth to slightly wavy rim",
      "isPrimary": true
    },
    {
      "label": "Inner surface color",
      "description": "Brownish, tan, or ochre-colored inner surface (hymenium) that contrasts with the paler exterior",
      "isPrimary": false
    },
    {
      "label": "Habitat preference",
      "description": "Often found on damp wood, mulch, or soil in basements, cellars, and other indoor damp locations",
      "isPrimary": false
    }
  ],
  "habitat": "Home Cup thrives in consistently moist environments, particularly on decaying wood, soil, and organic debris in damp indoor spaces, cellars, and gardens throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "This species earned its common name 'Home Cup' because it frequently fruitsindoors on damp basement walls and wooden structures, making it one of the few wild fungi that people commonly encounter in their homes.",
