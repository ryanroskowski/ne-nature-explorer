  "nameStory": "",
  "description": "The Obliterated Longhorn-Cuckoo (Triepeolus obliteratus) is a parasitic bee in the family Apidae, known for its cuckoo-like behavior of laying eggs in the nests of other bees rather than building its own. This small bee is found throughout New England and represents an important ecological role in native bee communities.",
  "idTips": [
    {
      "label": "Obliterated Markings",
      "description": "Named for its worn or 'obliterated' appearance, with faint or reduced facial and body markings compared to related species",
      "isPrimary": true
    },
    {
      "label": "Small Size",
      "description": "Notably smaller than many native bees, typically 6-8mm in length with a compact body",
      "isPrimary": false
    },
    {
      "label": "Body Color",
      "description": "Dark body coloration with sparse, fine hair and minimal pale markings or bands on the abdomen",
      "isPrimary": false
    }
  ],
  "habitat": "This species thrives in open woodlands, meadows, and gardens throughout New England where its host bees, particularly long-horned bees (Melissodes species), are active.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cuckoo bee, Triepeolus obliteratus does not collect pollen or nectar itself; instead, it relies entirely on parasitizing the nests of host bees, making it a 'brood parasite' similar to cuckoo birds.",
