  "nameStory": "",
  "description": "Dark fanvault (Hodophilus hymenocephalus) is a small, delicate fungus belonging to the Clavariaceae family, characterized by its dark-colored, branching fruiting bodies. This species is found in moist forest environments throughout New England and other northeastern regions.",
  "idTips": [
    {
      "label": "Dark Coloration",
      "description": "Fruiting bodies are distinctly dark brown to blackish, distinguishing it from lighter-colored coral fungi",
      "isPrimary": true
    },
    {
      "label": "Branching Structure",
      "description": "Features delicate, repeatedly forked branches that resemble miniature antlers or spindles",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Typically reaches only 2-5 cm in height, making it easy to overlook in leaf litter",
      "isPrimary": false
    }
  ],
  "habitat": "Dark fanvault thrives in moist, shaded forest floors rich in decaying organic matter, particularly among mosses and leaf litter in mixed hardwood and coniferous forests.",
