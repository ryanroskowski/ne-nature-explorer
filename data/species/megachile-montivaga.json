  "nameStory": "",
  "description": "The Silver-tailed Petalcutter (Megachile montivaga) is a medium-sized leafcutter bee belonging to the family Megachilidae, which includes mason, leafcutter, carder, and resin bees. This species is found in New England and is known for its distinctive silvery hair on the abdomen and its leaf-cutting behavior for nest construction.",
  "idTips": [
    {
      "label": "Silver abdominal hair",
      "description": "Distinctive silvery or white hair covering the tail end of the abdomen, giving the bee its common name",
      "isPrimary": true
    },
    {
      "label": "Medium body size",
      "description": "Ranges from 10-13 mm in length, making it a medium-sized bee in the Megachile genus",
      "isPrimary": false
    },
    {
      "label": "Dark body coloration",
      "description": "Black or dark brown body with the characteristic contrasting silver tail hairs",
      "isPrimary": false
    }
  ],
  "habitat": "Silver-tailed Petalcutters thrive in woodlands, gardens, and meadows throughout New England where flowering plants and suitable nesting materials are available.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female Silver-tailed Petalcutters use their large mandibles to cut precise, circular or oval pieces from plant leaves to line their nests and create individual brood cells for their larvae.",
  "confusionNotes": null,
  "contextualKnowledge": null,
