  "nameStory": "",
  "description": "The Striped Sedge Grasshopper is a medium-sized member of the Acrididae family, characterized by its distinctive longitudinal stripes and preference for wetland environments across New England. This grasshopper plays an important ecological role in marsh and sedge meadow ecosystems as both herbivore and prey species.",
  "idTips": [
    {
      "label": "Longitudinal Stripes",
      "description": "Dark stripes run lengthwise along the body and legs, providing the primary identifying feature",
      "isPrimary": true
    },
    {
      "label": "Coloration",
      "description": "Brown to reddish-brown body with lighter lateral stripes along the sides",
      "isPrimary": false
    },
    {
      "label": "Size and Build",
      "description": "Medium-sized grasshopper with relatively short antennae typical of short-horned grasshoppers (Acrididae)",
      "isPrimary": false
    }
  ],
  "habitat": "Found in wet meadows, marshes, and sedge-dominated grasslands throughout New England, preferring areas with dense vegetation and high moisture.",
