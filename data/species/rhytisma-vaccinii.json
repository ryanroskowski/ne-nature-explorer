  "nameStory": "",
  "description": "Rhytisma vaccinii is a fungal pathogen belonging to the Rhytismataceae family that causes leaf spot disease on blueberry and cranberry plants throughout New England. The disease is characterized by distinctive black, tar-like lesions that develop on infected leaves, giving rise to its common name 'tar spot.'",
  "idTips": [
    {
      "label": "Black tar-like lesions",
      "description": "Look for shiny, black, raised lesions that resemble tar spots on the surface of blueberry and cranberry leaves",
      "isPrimary": true
    },
    {
      "label": "Summer appearance",
      "description": "Lesions typically become visible and prominent during mid to late summer months as the fungus matures",
      "isPrimary": false
    },
    {
      "label": "Host specificity",
      "description": "Primarily infects members of the Ericaceae family, particularly blueberry (Vaccinium) species",
      "isPrimary": false
    }
  ],
  "habitat": "Rhytisma vaccinii thrives in moist, shaded areas of New England where wild and cultivated blueberries and cranberries grow, particularly in regions with high humidity and adequate moisture.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The fungus overwinters as dormant structures on fallen leaves, making leaf sanitation an effective management strategy for controlling tar spot disease in blueberry cultivation.",
