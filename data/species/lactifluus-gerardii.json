  "nameStory": "",
  "description": "Lactifluus gerardii is a milkcap fungus belonging to the Rusulaceae family, characterized by its distinctive appearance and latex-producing gills. This species is found in New England woodlands and is part of a diverse group of fungi known for their milk-like spore-bearing structures.",
  "idTips": [
    {
      "label": "Latex Production",
      "description": "Gills exude a white or cream-colored latex when cut or bruised, which is a defining characteristic of Lactifluus species",
      "isPrimary": true
    },
    {
      "label": "Cap Color and Texture",
      "description": "Caps are typically pale to whitish or pale buff-colored with a smooth to slightly wrinkled surface",
      "isPrimary": false
    },
    {
      "label": "Gill Attachment",
      "description": "Gills are decurrent to subdecurrent (running down the stem) and are relatively crowded",
      "isPrimary": false
    }
  ],
  "habitat": "Lactifluus gerardii grows in mixed hardwood and coniferous forests of New England, typically fruiting in summer to fall on mossy soil or near decaying wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The latex produced by Lactifluus species may change color when exposed to air, oxidizing from white to yellow or other hues, which can aid in field identification.",
