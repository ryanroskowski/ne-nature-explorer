  "nameStory": "",
  "description": "Erysiphe liriodendri is a powdery mildew fungus that specifically infects tulip trees (Liriodendron tulipifera), causing a characteristic white fungal coating on leaves and stems. This obligate parasite is commonly found throughout New England and other eastern North American regions where its host plant occurs.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Dense white to grayish fungal growth covers leaf surfaces, creating a distinctive powder-like appearance",
      "isPrimary": true
    },
    {
      "label": "Host Specificity",
      "description": "Found exclusively on tulip trees (Liriodendron tulipifera), making host identification crucial for species confirmation",
      "isPrimary": false
    },
    {
      "label": "Cleistothecia Formation",
      "description": "Small dark fruiting bodies may develop within the white coating as the fungus matures in late season",
      "isPrimary": false
    }
  ],
  "habitat": "Erysiphe liriodendri thrives in moist conditions and moderate temperatures typical of New England's deciduous forests and cultivated landscapes where tulip trees are planted.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildew species, Erysiphe liriodendri can survive harsh winters by forming specialized overwintering structures called cleistothecia, allowing it to persist and reinfect new growth each spring.",
  "confusionNotes": null,
  "contextualKnowledge": null,
