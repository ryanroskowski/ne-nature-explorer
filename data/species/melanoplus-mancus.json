  "nameStory": "",
  "description": "Smith's Spur-throat Grasshopper (Melanoplus mancus) is a medium-sized member of the Short-horned Grasshoppers family (Acrididae) commonly found throughout New England. It is an important part of grassland ecosystems and serves as a food source for birds and other wildlife.",
  "idTips": [
    {
      "label": "Spur on Hind Leg",
      "description": "A distinctive spine or spur is present on the inside of the hind femur, characteristic of spur-throat grasshoppers",
      "isPrimary": true
    },
    {
      "label": "Coloration",
      "description": "Typically brownish or grayish with a mottled pattern, helping it blend into dry grass and vegetation",
      "isPrimary": false
    },
    {
      "label": "Size and Build",
      "description": "Medium-sized grasshopper with moderate leg length relative to body size, distinguishing it from larger or smaller grasshopper species",
      "isPrimary": false
    }
  ],
  "habitat": "Smith's Spur-throat Grasshopper thrives in dry grasslands, meadows, and weedy fields throughout New England, preferring areas with sparse vegetation and sandy or well-drained soils.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other grasshoppers, Smith's Spur-throat Grasshopper produces sound by rubbing its hind legs against its wings, creating a distinctive stridulation that serves as a mating call during late summer and fall.",
