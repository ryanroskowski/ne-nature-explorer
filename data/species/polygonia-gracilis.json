  "nameStory": "",
  "description": "The Hoary Comma is a medium-sized butterfly in the Nymphalidae family, characterized by its angular, comma-shaped wings and cryptic coloration. Named for the small silvery comma-shaped mark on the underside of its hindwings, this species is adapted to cooler northern regions including New England.",
  "idTips": [
    {
      "label": "Silvery Comma Mark",
      "description": "Look for the distinctive silvery or white comma-shaped mark on the underside of the hindwings, which gives the species its name",
      "isPrimary": true
    },
    {
      "label": "Angular Wing Shape",
      "description": "The wings have prominent jagged edges and sharp angles, giving the butterfly a distinctive silhouette compared to other commas",
      "isPrimary": false
    },
    {
      "label": "Hoary Coloration",
      "description": "The wings display a grayish or hoary appearance on the underside, providing excellent camouflage on lichen and bark",
      "isPrimary": false
    }
  ],
  "habitat": "Hoary Commas prefer open woodlands, forest edges, and disturbed areas where their host plants, particularly nettles and elms, are abundant in the cooler climates of New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Polygonia species, Hoary Commas have a remarkable ability to overwinter as adults, hiding under bark or in leaf litter and emerging on warm winter days before returning to dormancy.",
