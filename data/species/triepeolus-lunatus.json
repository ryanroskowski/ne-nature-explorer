  "nameStory": "",
  "description": "The Lunate Longhorn-cuckoo Bee (Triepeolus lunatus) is a small, dark cuckoo bee that parasitizes other bee species rather than collecting pollen itself. As a member of the Apidae family, it relies on host bees to provision nests that it then exploits for reproduction.",
  "idTips": [
    {
      "label": "Crescent-shaped markings",
      "description": "Distinctive lunate (crescent-shaped) white or pale markings on the abdominal segments, which give this species its name",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Typically 5-8mm in length, making it one of the smaller bee species in New England",
      "isPrimary": false
    },
    {
      "label": "Dark coloration",
      "description": "Overall dark brown to black body with minimal hair compared to non-parasitic bees",
      "isPrimary": false
    }
  ],
  "habitat": "Found in open meadows, gardens, and disturbed areas throughout New England where populations of host bees, particularly mining bees and sweat bees, are abundant.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Cuckoo bees like Triepeolus lunatus are called 'cuckoos' because they lay their eggs in the nests of other bee species, much like cuckoo birds do with bird nests—the host bee unknowingly raises the cuckoo bee's offspring.",
