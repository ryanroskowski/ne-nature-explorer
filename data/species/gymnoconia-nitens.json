  "nameStory": "",
  "description": "Gymnoconia nitens is a rust fungus in the Phragmidiaceae family that parasitizes plants in New England and other temperate regions. Despite its small size and microscopic nature, it plays an important ecological role as a plant pathogen in forest and field ecosystems.",
  "idTips": [
    {
      "label": "Aecial cups",
      "description": "Produces distinctive cup-shaped fruiting bodies (aecia) on infected plant tissue that release bright orange or yellow spores",
      "isPrimary": true
    },
    {
      "label": "Host specificity",
      "description": "Typically infects specific plant hosts, requiring microscopic examination and host identification for accurate species determination",
      "isPrimary": false
    },
    {
      "label": "Spore characteristics",
      "description": "Produces chains of unicellular spores with distinctive wall patterns visible under magnification",
      "isPrimary": false
    }
  ],
  "habitat": "Gymnoconia nitens inhabits moist woodlands, meadows, and disturbed areas throughout New England where suitable host plants are present.",
