  "nameStory": "",
  "description": "Bothia castanella is a small bolete fungus characterized by its chestnut-brown coloring and delicate structure. Found throughout New England, it is a woodland species that plays an important ecological role in forest ecosystems.",
  "idTips": [
    {
      "label": "Cap Color",
      "description": "Distinctive chestnut to chocolate-brown cap that is typically small, ranging from 1-3 cm in diameter",
      "isPrimary": true
    },
    {
      "label": "Pore Surface",
      "description": "Yellow to olive-yellow pores on the underside that stain blue or blue-green when bruised",
      "isPrimary": false
    },
    {
      "label": "Stem Characteristics",
      "description": "Slender, pale stem that may have subtle coloring matching the cap",
      "isPrimary": false
    }
  ],
  "habitat": "Bothia castanella grows on the forest floor in mixed woodlands, particularly near decaying wood and in mossy areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many boletes, Bothia castanella forms mycorrhizal relationships with tree roots, making it an important fungal partner in forest nutrient cycling.",
