  "nameStory": "",
  "description": "Phellodon confluens, commonly known as the Fused Tooth, is a small woodland fungus characterized by its distinctive fused or confluent tooth-like spines on the underside of its fruiting body. This species belongs to the Bankeraceae family, which are tooth fungi known for their spine-bearing hymenium rather than traditional gills.",
  "idTips": [
    {
      "label": "Fused Spines",
      "description": "The defining feature is the spines on the underside that are partially or completely fused together, creating a labyrinthine or wavy pattern rather than individual teeth",
      "isPrimary": true
    },
    {
      "label": "Cap Appearance",
      "description": "Small, thin, grayish to brownish cap, typically 1-3 cm wide, with a delicate texture and often a somewhat scaly or fibrous surface",
      "isPrimary": false
    },
    {
      "label": "Spore Print",
      "description": "White to pale tan spore print, which helps distinguish it from similar species in the Phellodon genus",
      "isPrimary": false
    }
  ],
  "habitat": "Phellodon confluens is typically found on soil or well-decayed wood in mixed coniferous and deciduous forests throughout New England, preferring cool, moist, acidic forest floors.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The fused spines of P. confluens are an adaptation that increases surface area for spore dispersal while providing structural stability in the delicate fruiting bodies of these small fungi.",
