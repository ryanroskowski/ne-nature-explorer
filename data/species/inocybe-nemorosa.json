  "nameStory": "",
  "description": "Inocybe nemorosa is a small woodland mushroom belonging to the Inocybaceae family, characterized by its delicate fibrous cap and thin stature. Like other members of the Fibercaps group, it is toxic and should never be consumed.",
  "idTips": [
    {
      "label": "Fibrous Cap Surface",
      "description": "The cap displays fine, radial fibers or streaks running from the center outward, giving it a distinctly textured appearance rather than being smooth.",
      "isPrimary": true
    },
    {
      "label": "Thin Stature",
      "description": "This species is notably delicate with a slender stem and small cap, rarely exceeding 3-4 cm in diameter.",
      "isPrimary": false
    },
    {
      "label": "Angular Gills",
      "description": "The gills are angular, crowded, and often unequal in length, typically displaying a pale to whitish color that may darken with age.",
      "isPrimary": false
    }
  ],
  "habitat": "Inocybe nemorosa prefers moist, shaded woodland environments in New England, often appearing near leaf litter and decaying wood in mixed or deciduous forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Inocybe genus contain muscarine, a toxic alkaloid that affects the nervous system, making them among the most dangerous small mushrooms to accidentally consume.",
