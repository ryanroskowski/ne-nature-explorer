  "nameStory": "",
  "description": "Scutellinia setosa, commonly known as the Yellow Eyelash Cup, is a small cup fungus in the Pyronemataceae family characterized by its bright yellow to orange coloration and distinctive hair-like setae (bristles) around its rim. This delicate fungus is found in moist, wooded areas throughout New England and fruits primarily in spring and early summer.",
  "idTips": [
    {
      "label": "Eyelash-like Setae",
      "description": "Dark brown to black hair-like bristles fringe the cup margin, resembling eyelashes—the most distinctive and diagnostic feature of this species.",
      "isPrimary": true
    },
    {
      "label": "Cup Shape and Color",
      "description": "Small cups measuring 3-8 mm across with a bright yellow to golden-orange interior surface and paler exterior.",
      "isPrimary": false
    },
    {
      "label": "Smooth Spore Surface",
      "description": "Microscopic examination reveals smooth, colorless spores that lack ornamentation, distinguishing it from similar species.",
      "isPrimary": false
    }
  ],
  "habitat": "Yellow Eyelash Cup grows on wet, decaying wood, leaf litter, and rich soil in shaded forests and moist woodlands throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The distinctive black setae (bristles) around the cup's rim are thought to help protect the developing spores from moisture loss and may aid in spore dispersal.",
