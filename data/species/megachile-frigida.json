  "nameStory": "",
  "description": "Megachile frigida is a solitary leafcutter bee native to New England that cuts precise circular pieces from leaves and flower petals to construct and line its nesting cells. This hardy bee is adapted to cooler climates and plays an important role in pollinating native plants throughout the northeastern United States.",
  "idTips": [
    {
      "label": "Leaf-Cutting Behavior",
      "description": "Distinctive habit of using mandibles to cut perfect circular or oval pieces from leaves, which are then transported back to nest sites",
      "isPrimary": true
    },
    {
      "label": "Body Size and Color",
      "description": "Medium-sized bee (10-12 mm) with a dark body and dense hair; females have a distinctive pollen basket on hind legs",
      "isPrimary": false
    },
    {
      "label": "Abdominal Banding",
      "description": "Pale hair bands visible on the abdomen, contrasting with darker body coloration",
      "isPrimary": false
    }
  ],
  "habitat": "Megachile frigida inhabits open woodlands, gardens, meadows, and areas with mixed flowering plants throughout New England, nesting in hollow stems, dead wood, or abandoned insect tunnels.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female leafcutter bees are skilled architects that carefully arrange their cut leaf pieces like shingles to create waterproof, cylindrical cells for their larvae, demonstrating remarkable engineering instincts without ever being taught.",
  "confusionNotes": null,
