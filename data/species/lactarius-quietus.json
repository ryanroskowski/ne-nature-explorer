  "nameStory": "",
  "description": "The Oakbug Milkcap is a small to medium-sized fungus in the Lactarius genus, characterized by its distinctive oaky or fruity odor and mild latex secretions. It is a common woodland mushroom found throughout New England, typically fruiting in summer and fall.",
  "idTips": [
    {
      "label": "Distinctive Odor",
      "description": "Smells strongly of crushed bugs or oak leaves when fresh, which is the source of its common name",
      "isPrimary": true
    },
    {
      "label": "Milk Latex",
      "description": "Produces white to pale latex when gills are cut or bruised, which may slowly stain yellowish",
      "isPrimary": false
    },
    {
      "label": "Cap and Gill Appearance",
      "description": "Has a grayish-brown to tan cap (1-3 inches) with pale gills that run down the stem",
      "isPrimary": false
    }
  ],
  "habitat": "The Oakbug Milkcap grows on the forest floor in deciduous and mixed oak woodlands throughout New England, fruiting singly or in scattered groups.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its unpleasant name and odor, the Oakbug Milkcap is edible and has been consumed in some European regions, though its strong smell makes it an acquired taste.",
