  "nameStory": "",
  "description": "The Attenuated Bluet is a small damselfly species belonging to the Coenagrionidae family, characterized by its slender blue and black body. Found throughout New England, this species is adapted to freshwater environments and plays an important role in aquatic ecosystems as both predator and prey.",
  "idTips": [
    {
      "label": "Elongated Body Shape",
      "description": "Distinctively thin and attenuated (narrowed) body, particularly noticeable at the abdomen, which gives the species its common name",
      "isPrimary": true
    },
    {
      "label": "Coloration Pattern",
      "description": "Males display bright blue coloring on the abdomen with black markings, while females are typically more dull with greenish or brownish tones",
      "isPrimary": false
    },
    {
      "label": "Wing Position",
      "description": "Narrow wings held parallel to the body when at rest, a characteristic feature of bluet damselflies",
      "isPrimary": false
    }
  ],
  "habitat": "The Attenuated Bluet prefers clear, flowing streams and small rivers with abundant aquatic vegetation in New England's temperate forests and meadows.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Attenuated Bluets engage in elaborate tandem mating flights, where the male grasps the female from behind as they fly together in a coordinated aerial display before egg-laying.",
