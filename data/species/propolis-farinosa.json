  "nameStory": "",
  "description": "Propolis farinosa is a distinctive flowering plant native to New England, belonging to the Propoliaceae family. It is characterized by its unique powdery or mealy appearance and small clustered flowers.",
  "idTips": [
    {
      "label": "Powdery Coating",
      "description": "Distinctive white or grayish waxy powder covers stems and leaves, giving the plant a frosted appearance",
      "isPrimary": true
    },
    {
      "label": "Flower Clusters",
      "description": "Produces small, densely packed flowers arranged in compact terminal clusters or panicles",
      "isPrimary": false
    },
    {
      "label": "Leaf Texture",
      "description": "Leaves are relatively small and may appear somewhat succulent or fleshy beneath the powdery coating",
      "isPrimary": false
    }
  ],
  "habitat": "Propolis farinosa thrives in well-drained, sandy or rocky soils in open woodlands and meadows throughout New England.",
