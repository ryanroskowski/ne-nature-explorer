  "nameStory": "",
  "description": "Laetiporus huroniensis is a wood-decay fungus in the Laetiporaceae family, commonly known as chicken of the woods, characterized by its bright coloration and shelf-like fruiting bodies. This species is one of several Laetiporus species found in North America and is notable for its presence in New England forests.",
  "idTips": [
    {
      "label": "Pore Surface",
      "description": "Small, angular pores on the underside that are yellow to orange and may bruise brown when touched",
      "isPrimary": true
    },
    {
      "label": "Color and Texture",
      "description": "Bright orange to yellow fruiting bodies with a soft, spongy texture when fresh that becomes brittle when dry",
      "isPrimary": false
    },
    {
      "label": "Growth Pattern",
      "description": "Forms shelf-like or bracket fruiting bodies that typically grow in overlapping clusters on dead hardwood logs and stumps",
      "isPrimary": false
    }
  ],
  "habitat": "Laetiporus huroniensis is found on dead or dying hardwood trees throughout New England forests, particularly on oak, maple, and other deciduous wood.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its culinary nickname 'chicken of the woods,' some individuals may experience gastrointestinal upset from consuming Laetiporus species, especially when eaten raw or in large quantities.",
