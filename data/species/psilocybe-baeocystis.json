  "nameStory": "",
  "description": "Psilocybe baeocystis is a small, dark mushroom belonging to the Hymenogastraceae family, characterized by its modest fruiting bodies and psychoactive compounds. This species is found in the Pacific Northwest and parts of New England, typically appearing in moist forest environments during fall months.",
  "idTips": [
    {
      "label": "Small, bell-shaped caps",
      "description": "Caps are typically 1-3 cm in diameter with a dark brown to blackish coloration that often becomes lighter when bruised or aged",
      "isPrimary": true
    },
    {
      "label": "Blue-bruising reaction",
      "description": "Flesh turns blue or blue-green when damaged, a key characteristic of psilocybin-containing species",
      "isPrimary": false
    },
    {
      "label": "Thin, fragile stems",
      "description": "Slender stems are whitish to pale brown and often become hollow at maturity",
      "isPrimary": false
    }
  ],
  "habitat": "Psilocybe baeocystis prefers cool, moist coniferous and mixed forests with rich soil and high humidity, often fruiting near decaying wood, mossy areas, and disturbed forest floors.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The name 'baeocystis' derives from Greek words meaning 'small cyst,' referring to the diminutive size of the spore-bearing cells, making it one of the smallest psilocybin-containing mushrooms.",
