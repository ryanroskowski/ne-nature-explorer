  "nameStory": "",
  "description": "Deer-colored Trametes (Trametopsis cervina) is a wood-decaying fungus in the Irpicaceae family characterized by its distinctive tan to brownish coloring and small pores. This polypore fungus plays an important ecological role in breaking down dead wood in forest ecosystems.",
  "idTips": [
    {
      "label": "Pore Surface",
      "description": "Small, angular pores (3-6 per mm) on the underside that are whitish to pale buff and become darker with age",
      "isPrimary": true
    },
    {
      "label": "Cap Color",
      "description": "Upper surface ranges from tan to reddish-brown or deer-colored, often with concentric zones and a velvety texture",
      "isPrimary": false
    },
    {
      "label": "Fruiting Body",
      "description": "Bracket-shaped or hoof-like growth pattern on dead hardwood, typically appearing in overlapping clusters",
      "isPrimary": false
    }
  ],
  "habitat": "Trametopsis cervina is found on dead and decaying hardwood, particularly on fallen logs and dead branches throughout New England's deciduous and mixed forests.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other polypore fungi, Deer-colored Trametes is a perennial fungus that can persist on wood for several years, continuing to decompose wood and recycle nutrients back into the forest ecosystem.",
