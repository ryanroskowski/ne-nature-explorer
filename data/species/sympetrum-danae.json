  "nameStory": "",
  "description": "The Black Meadowhawk is a small dragonfly species belonging to the Skimmer family (Libellulidae), characterized by its dark coloration and rapid, agile flight. Found throughout New England, this species is common in freshwater habitats during late summer and fall.",
  "idTips": [
    {
      "label": "Black coloration",
      "description": "Males are predominantly black or very dark brown, while females may show more amber or golden tones on the abdomen",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "One of the smallest meadowhawks, with a body length of only 28-32 mm",
      "isPrimary": false
    },
    {
      "label": "Red face",
      "description": "Both males and females typically display a reddish or orange-red face and upper head region",
      "isPrimary": false
    }
  ],
  "habitat": "Black Meadowhawks inhabit marshes, pond edges, ditches, and wetland areas with emergent vegetation, preferring open spaces near shallow freshwater.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The Black Meadowhawk is one of the latest-flying dragonfly species in New England, remaining active well into October and sometimes November, often appearing when other dragonflies have disappeared for the season.",
