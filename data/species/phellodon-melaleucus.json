  "nameStory": "",
  "description": "Grey Tooth (Phellodon melaleucus) is a tooth fungus characterized by its distinctive grey to blackish coloration and small, delicate spines on its underside. This species belongs to the Bankeraceae family and is found in coniferous and mixed forests throughout New England.",
  "idTips": [
    {
      "label": "Color",
      "description": "Dark grey to blackish upper surface with a pale or white underside",
      "isPrimary": true
    },
    {
      "label": "Spines",
      "description": "Small, fine teeth (spines) on the underside that are tightly packed and easily bruise to blackish tones",
      "isPrimary": false
    },
    {
      "label": "Texture",
      "description": "Brittle, cork-like consistency with a somewhat velvety or scaly cap surface",
      "isPrimary": false
    }
  ],
  "habitat": "Grey Tooth grows on the forest floor among mosses and leaf litter in cool, moist coniferous and mixed hardwood forests throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike mushrooms that release spores from gills, tooth fungi like Phellodon melaleucus release spores from their tiny spine-like structures called hydnums, which gives the family its distinctive appearance.",
