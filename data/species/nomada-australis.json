  "nameStory": "",
  "description": "The Five-spined Nomad (Nomada australis) is a cleptoparasitic bee species belonging to the Apidae family, known for laying eggs in the nests of host bees rather than building their own. Despite its common name suggesting five spines, this small bee exhibits the characteristic features of nomad bees, including reduced pollen-carrying structures and a sleek body adapted for nest infiltration.",
  "idTips": [
    {
      "label": "Body coloration",
      "description": "Typically displays a combination of black and reddish-brown or yellow markings on the abdomen and thorax, distinctive of Nomada species",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Measures approximately 6-8mm in length, making it noticeably smaller than most native bee species in New England",
      "isPrimary": false
    },
    {
      "label": "Reduced scopae",
      "description": "Lacks the dense pollen baskets (scopae) found on typical bees, reflecting its parasitic lifestyle",
      "isPrimary": false
    }
  ],
  "habitat": "This species is found in open woodlands, gardens, and meadows throughout New England where suitable host bee colonies are present.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "As a cleptoparasitic or 'cuckoo' bee, Nomada australis sneaks into the nests of other bee species to lay its eggs, allowing the host bee to provision the nomad's offspring as their own.",
  "confusionNotes": null,
