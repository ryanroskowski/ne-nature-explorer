  "nameStory": "",
  "description": "Protandrena compositarum, commonly known as the Composite Bare-Miner, is a small solitary bee species belonging to the family of mining bees found throughout New England. These native bees are important pollinators that nest in bare ground and have a strong preference for composite flowers.",
  "idTips": [
    {
      "label": "Body Size and Color",
      "description": "Small bee (4-6mm) with a dark body and sparse hair coverage, appearing relatively 'bare' compared to other bee species",
      "isPrimary": true
    },
    {
      "label": "Flower Preference",
      "description": "Strongly associated with composite flowers (Asteraceae family), particularly asters and goldenrod",
      "isPrimary": false
    },
    {
      "label": "Nesting Behavior",
      "description": "Creates individual burrows in bare or sparsely vegetated ground, often nesting in aggregations with other mining bees",
      "isPrimary": false
    }
  ],
  "habitat": "Protandrena compositarum thrives in open, sunny areas with bare patches of soil such as meadows, field edges, and disturbed areas throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Male Composite Bare-Miners emerge earlier in spring than females and spend their time patrolling low vegetation waiting for females to emerge, making them one of the season's earliest native bees.",
