  "nameStory": "",
  "description": "Spring Polypore (Lentinus arcularius) is a small, delicate bracket fungus that appears in early spring on dead hardwood logs and branches. Despite its common name suggesting it's a polypore, it's actually a gilled fungus that resembles bracket fungi in growth form.",
  "idTips": [
    {
      "label": "Gilled Underside",
      "description": "Features distinctive gill-like structures (radial folds) rather than true pores, which can distinguish it from actual polypores",
      "isPrimary": true
    },
    {
      "label": "Small Size and Shape",
      "description": "Typically small, fan or shelf-shaped fruiting bodies, usually 1-3 inches wide, with a thin, delicate structure",
      "isPrimary": false
    },
    {
      "label": "Seasonal Timing",
      "description": "Appears early in spring (March-May in New England), often one of the first bracket fungi to fruit after winter",
      "isPrimary": false
    }
  ],
  "habitat": "Found on decaying hardwood logs, branches, and dead wood in forests throughout New England, preferring moist conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Spring Polypore is one of the earliest wood-decaying fungi to fruit in New England, often appearing while snow still patches the forest floor, earning its 'spring' designation.",
