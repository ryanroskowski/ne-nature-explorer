  "nameStory": "",
  "description": "Psilocybe fuscofulva is a small, brown mushroom species belonging to the Hymenogastraceae family, native to the New England region of North America. This fungus is characterized by its modest size and subtle coloration, making it a subject of mycological interest in temperate forest ecosystems.",
  "idTips": [
    {
      "label": "Spore Print Color",
      "description": "Produces a dark purple-brown to black spore print, which is diagnostic for Psilocybe species",
      "isPrimary": true
    },
    {
      "label": "Cap Coloration",
      "description": "Displays a distinctive fuscous (dark brownish) to fulvous (reddish-brown) colored cap that often darkens with moisture",
      "isPrimary": false
    },
    {
      "label": "Size",
      "description": "Small mushroom with caps typically 1-3 cm in diameter, making it easily overlooked in leaf litter",
      "isPrimary": false
    }
  ],
  "habitat": "Psilocybe fuscofulva grows in rich, moist forest soils and woodchip beds throughout New England, particularly in deciduous and mixed forests with high organic matter content.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other Psilocybe species, P. fuscofulva may exhibit a blue-green discoloration when handled or bruised, a chemical reaction caused by oxidation of psilocin compounds.",
