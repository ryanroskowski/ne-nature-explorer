  "nameStory": "",
  "description": "Dingy Twiglet (Simocybe centunculus) is a small, delicate mushroom belonging to the Crepidotaceae family, characterized by its modest size and subtle coloration. This fungus is commonly found throughout New England, where it plays a role in wood decomposition in forest ecosystems.",
  "idTips": [
    {
      "label": "Cap Color and Texture",
      "description": "Small, dingy brown to grayish-brown cap, typically 0.5-1.5 cm across, with a slightly hygrophanous appearance that fades when dry",
      "isPrimary": true
    },
    {
      "label": "Gills and Spore Print",
      "description": "Crowded gills that are rusty-brown to cinnamon-colored, with a rusty-brown spore print diagnostic of the Crepidotaceae family",
      "isPrimary": false
    },
    {
      "label": "Habitat Association",
      "description": "Grows on decaying wood, twigs, and moss-covered logs, typically in small clusters or scattered individuals",
      "isPrimary": false
    }
  ],
  "habitat": "Dingy Twiglet thrives on decaying hardwood, mossy substrates, and decomposing plant matter in damp forests and woodlands throughout New England.",
