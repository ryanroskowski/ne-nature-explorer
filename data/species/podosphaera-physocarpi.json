  "nameStory": "",
  "description": "Podosphaera physocarpi is a fungal pathogen that causes powdery mildew specifically on Ninebark (Physocarpus) shrubs throughout New England. This obligate parasite forms white, powdery colonies on leaves, stems, and flower buds, potentially weakening the plant over time.",
  "idTips": [
    {
      "label": "White Powdery Coating",
      "description": "Distinctive white to gray powdery fungal growth covering leaf surfaces, petioles, and stems",
      "isPrimary": true
    },
    {
      "label": "Affected Plant Species",
      "description": "Infection occurs almost exclusively on Ninebark (Physocarpus species), making host specificity a key identification feature",
      "isPrimary": false
    },
    {
      "label": "Leaf Distortion",
      "description": "Infected leaves may curl, become stunted, or display yellowing beneath the powdery coating",
      "isPrimary": false
    }
  ],
  "habitat": "Podosphaera physocarpi thrives on Ninebark shrubs in open to partially shaded locations throughout New England, with increased severity during warm, dry growing seasons with moderate humidity.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many powdery mildews, Podosphaera physocarpi is highly host-specific to Ninebark plants, rarely infecting other ornamental or woody shrubs in the landscape.",
