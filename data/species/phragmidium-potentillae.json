  "nameStory": "",
  "description": "Cinquefoil Rust (Phragmidium potentillae) is a fungal pathogen belonging to the Phragmidiaceae family that infects cinquefoil plants, particularly in cool, moist climates of New England. This rust fungus completes its life cycle on Potentilla species and is characterized by orange to reddish pustules on leaf surfaces.",
  "idTips": [
    {
      "label": "Pustule Color and Texture",
      "description": "Look for bright orange to rust-colored, powdery pustules (spore-producing structures) on the undersides of cinquefoil leaves, which are the most visible indicator of infection.",
      "isPrimary": true
    },
    {
      "label": "Leaf Damage Pattern",
      "description": "Infected leaves may show yellowing or browning around the pustule areas, and severe infections can cause premature leaf drop.",
      "isPrimary": false
    },
    {
      "label": "Host Plant Specificity",
      "description": "The fungus primarily affects Potentilla species (cinquefoils), helping distinguish it from other rust fungi in the region.",
      "isPrimary": false
    }
  ],
  "habitat": "Cinquefoil Rust thrives in New England's cool, moist forest understories, meadows, and disturbed areas where its Potentilla hosts grow, especially during humid spring and fall conditions.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like many rust fungi, Phragmidium potentillae produces multiple spore types throughout its life cycle, including aeciospores and teliospores, allowing it to overwinter and infect new growth in successive seasons.",
