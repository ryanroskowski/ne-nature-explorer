  "nameStory": "",
  "description": "Amorphous bird's nest fungus (Nidularia deformis) is a small, cup-shaped fungus belonging to the bird's nest fungi family, characterized by its irregular and often deformed appearance. Found in New England and other temperate regions, it produces tiny egg-like structures (peridioles) that contain spores.",
  "idTips": [
    {
      "label": "Deformed cup shape",
      "description": "Unlike the more regular bird's nest fungi, this species has an irregular, asymmetrical cup form that lacks the typical neat, nested appearance",
      "isPrimary": true
    },
    {
      "label": "Small size",
      "description": "Fruiting bodies are typically 3-8 mm in diameter, making them quite miniature and requiring close inspection to spot",
      "isPrimary": false
    },
    {
      "label": "Peridioles inside",
      "description": "The cup contains small, lens-shaped spore packages (peridioles) that appear as tiny 'eggs' within the nest",
      "isPrimary": false
    }
  ],
  "habitat": "Amorphous bird's nest fungus grows on decaying hardwood, wood chips, and organic debris in moist, shaded forest environments throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other bird's nest fungi, this species uses a splash-cup mechanism where raindrops knock the spore-containing peridioles out of the cup, allowing them to stick to nearby vegetation and spread.",
