  "nameStory": "",
  "description": "The Rainbow Bluet is a small damselfly belonging to the family Coenagrionidae, characterized by its delicate build and vibrant blue coloration. Males display brilliant iridescent blue on their bodies, while females show more variable coloring with green, bronze, or blue tones depending on age and morph.",
  "idTips": [
    {
      "label": "Antennal spots",
      "description": "Distinctive pale spots or rings on the antennae are a key identifying feature",
      "isPrimary": true
    },
    {
      "label": "Blue coloration pattern",
      "description": "Males display bright blue segments on the abdomen with characteristic black markings between segments",
      "isPrimary": false
    },
    {
      "label": "Small size",
      "description": "One of the smaller damselfly species, typically 28-35mm in body length",
      "isPrimary": false
    }
  ],
  "habitat": "Rainbow Bluets prefer clear, clean streams and small rivers with good water quality and vegetated margins throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Female Rainbow Bluets exhibit remarkable color polymorphism, with some individuals mimicking male coloration to avoid unwanted mating attempts—a strategy called andromorphism.",
