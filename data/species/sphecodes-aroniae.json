  "nameStory": "",
  "description": "Sphecodes aroniae is a small sweat bee species belonging to the family Halictidae, found throughout New England. These solitary bees are important pollinators that are attracted to the salt in human perspiration, hence their common name.",
  "idTips": [
    {
      "label": "Small Size",
      "description": "Sphecodes aroniae are tiny bees, typically 4-6mm in length, making them among the smallest native bees in the region.",
      "isPrimary": false
    },
    {
      "label": "Red Abdomen",
      "description": "This species displays a distinctive reddish or rust-colored abdomen contrasting with a dark head and thorax, a key visual characteristic.",
      "isPrimary": true
    },
    {
      "label": "Metallic Sheen",
      "description": "Look for a subtle metallic or iridescent quality to their body surface, particularly visible in good lighting.",
      "isPrimary": false
    }
  ],
  "habitat": "Sphecodes aroniae thrives in open, sunny areas including meadows, gardens, and forest edges throughout New England where flowering plants are abundant.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Unlike many bee species, Sphecodes aroniae are cleptoparasites, meaning females lay their eggs in the nests of other sweat bee species, allowing the host to raise their young.",
