  "nameStory": "",
  "description": "Turbinellus kauffmanii is a small, funnel-shaped fungus belonging to the Gomphaceae family, characterized by its distinctive ridged undersurface and delicate structure. This species is found in the forest floors of New England, where it plays a role in the woodland ecosystem as a decomposer.",
  "idTips": [
    {
      "label": "Funnel Shape",
      "description": "The distinctive trumpet or funnel-like cap that tapers toward the base is a characteristic feature of this species.",
      "isPrimary": true
    },
    {
      "label": "Ridged Undersurface",
      "description": "The ridges or false gills running down the underside of the cap are blunt, forked, and decurrent, distinguishing it from true gilled fungi.",
      "isPrimary": false
    },
    {
      "label": "Small Size",
      "description": "Turbinellus kauffmanii typically reaches only 1-3 inches in height, making it a relatively diminutive woodland mushroom.",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus grows on the rich, moist forest floors of deciduous and mixed woodlands in New England, often fruiting in summer through fall among leaf litter and decaying organic matter.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Members of the Gomphaceae family, including Turbinellus kauffmanii, are sometimes called 'chanterelle relatives' because they share similar funnel-shaped morphology with true chanterelles, though they are not closely related evolutionarily.",
