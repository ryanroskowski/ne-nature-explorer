  "nameStory": "",
  "description": "The Rufous Milkcap is a small to medium-sized mushroom characterized by its distinctive reddish-brown to rusty coloring and the white or pale latex it exudes when cut or bruised. This fungus is a member of the Milkcap family and is commonly found in coniferous forests throughout New England.",
  "idTips": [
    {
      "label": "Reddish-brown cap",
      "description": "The cap is rusty red to reddish-brown in color, often with a slightly depressed center and can reach 2-4 inches in diameter",
      "isPrimary": true
    },
    {
      "label": "White milky latex",
      "description": "Distinctive white or pale milk-like liquid is released from gills and flesh when cut or bruised, which may slowly turn gray or yellow",
      "isPrimary": true
    },
    {
      "label": "Crowded gills",
      "description": "The gills are closely spaced, pale, and run down the stem, matching the cap color or slightly lighter",
      "isPrimary": false
    }
  ],
  "habitat": "The Rufous Milkcap grows in association with conifers, particularly spruce and fir forests, preferring moist, acidic soils in New England's woodlands.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Despite its attractive appearance, the Rufous Milkcap is inedible and can cause gastrointestinal upset; its acrid taste is a natural defense mechanism against consumption by animals.",
  "confusionNotes": null,
