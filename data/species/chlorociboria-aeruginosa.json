  "nameStory": "",
  "description": "The Turquoise Elfcup is a small, cup-shaped fungus known for its distinctive blue-green coloration, which comes from a pigment called xylindein. This wood-decomposing fungus plays an important ecological role in breaking down dead hardwood in forest ecosystems.",
  "idTips": [
    {
      "label": "Blue-Green Color",
      "description": "Distinctive turquoise to blue-green hue on the cup's interior and exterior surfaces",
      "isPrimary": true
    },
    {
      "label": "Cup Shape",
      "description": "Small, delicate cup-shaped fruiting bodies typically 2-8mm in diameter",
      "isPrimary": false
    },
    {
      "label": "Wood Association",
      "description": "Found fruiting on decaying hardwood logs and branches, often in clusters",
      "isPrimary": false
    }
  ],
  "habitat": "This fungus thrives on dead hardwood, particularly in moist woodlands and forests throughout New England where fallen logs and branches provide abundant substrate for decomposition.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "The striking turquoise pigment produced by this fungus stains the wood it colonizes, and historically, woodworkers and craftspeople have valued wood discolored by this fungus for decorative inlay work and artistic applications.",
