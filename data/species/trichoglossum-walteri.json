  "nameStory": "",
  "description": "Trichoglossum walteri, commonly known as the Short-spored Earthtongue, is a small fungal fruiting body in the Geoglossaceae family characterized by its distinctive club-like or tongue-shaped appearance. This species is found in New England and other temperate regions, typically fruiting in moist conditions during late summer and fall.",
  "idTips": [
    {
      "label": "Club-shaped fruiting body",
      "description": "The fertile head is distinctly club-shaped or flattened, typically dark brown to black, and much shorter than the stalk",
      "isPrimary": true
    },
    {
      "label": "Short spores",
      "description": "Microscopic examination reveals relatively short ascospores compared to related earthtongue species, which is the defining characteristic of this species",
      "isPrimary": false
    },
    {
      "label": "Small stature",
      "description": "Fruiting bodies are typically 1-3 inches tall with a pale to dark stem supporting the darker fertile head",
      "isPrimary": false
    }
  ],
  "habitat": "Short-spored Earthtongues prefer moist, mossy areas in forests, woodlands, and occasionally grassy meadows throughout New England.",
  "seasonality": {
    "spring": "",
    "summer": "",
    "fall": "",
    "winter": ""
  },
  "funFact": "Like other earthtongues, Trichoglossum walteri produces spores within elongated sacs called asci, and is believed to play a role in nutrient cycling in forest ecosystems through decomposition.",
