# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# pipeline cache
/.cache

# pipeline intermediate data
/data/pipeline

# large data files not needed in deployment (dead code or legacy duplicates)
/data/nature-areas-species.json
/data/taxonomy.json
/data/commonality.json
/data/browse-index.json
/data/search-index.json
/data/seasonal-guide.json

# backups
/backups

# claude code
/.claude

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
